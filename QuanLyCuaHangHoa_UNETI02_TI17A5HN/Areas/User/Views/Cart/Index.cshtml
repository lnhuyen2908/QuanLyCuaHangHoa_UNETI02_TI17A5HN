                            <p class="font-body-sm text-body-sm text-on-surface-variant">Giấy mỹ thuật Cotton dập nổi, ướp hương hoa cam thảo mộc.</p>
                        </div>
                        <div class="flex items-center justify-between pt-space-xs">
                            <span class="font-title-sm text-title-sm text-primary">+35.000₫</span>
                            <button class="addon-btn px-3 py-1.5 rounded-full bg-surface-container-lowest text-primary hover:bg-primary hover:text-on-primary font-label-md text-label-md transition-colors shadow-sm" onclick="toggleAddon(this, 35000, 'Thiệp hoa sáp thơm')" type="button">
                                + Thêm
                            </button>
                        </div>
                    </div>
                    <!-- Addon 2 -->
                    <div class="bg-surface-container-low p-space-md rounded-xl flex flex-col justify-between space-y-space-sm hover:shadow-md transition-shadow">
                        <div class="space-y-space-xs">
                            <div class="h-28 rounded-lg overflow-hidden">
                                <img class="w-full h-full object-cover" alt="Ruy-băng lụa dập kim" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBMH1ATbw0HLi48TOMsu8fWtgccQ7LserwLKLkxQuxo3_NYQzVooTXAZf7ybM7I8UgYjZRjQ4Hv9TnH4YcoH4W23AQ5RrzLbsQjl1xB17qTVI3nZ520kAn-UmSrjcHn-1mJIxZA-hUJh5p0lsWMaXotETMb1jE1xlto6nj1nSLpqmwtgIT-DkhJX8bUfpu7FJCKN5Eiwu2z0AY9G4CIdP_cS5ppMvCSodTl-IGdff8g-mqZzYOPl0x47g">
