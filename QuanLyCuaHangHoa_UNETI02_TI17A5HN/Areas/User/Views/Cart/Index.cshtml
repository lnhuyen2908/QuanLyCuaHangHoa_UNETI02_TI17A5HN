                            <p class="font-body-sm text-body-sm text-on-surface-variant">Lụa tơ tằm dệt mép tưa mộc mạc, ép kim biểu tượng Atelier.</p>
                        </div>
                        <div class="flex items-center justify-between pt-space-xs">
                            <span class="font-title-sm text-title-sm text-primary">+45.000₫</span>
                            <button class="addon-btn px-3 py-1.5 rounded-full bg-surface-container-lowest text-primary hover:bg-primary hover:text-on-primary font-label-md text-label-md transition-colors shadow-sm" onclick="toggleAddon(this, 45000, 'Ruy-băng lụa dập kim')" type="button">
                                + Thêm
                            </button>
                        </div>
                    </div>
                    <!-- Addon 3 -->
                    <div class="bg-surface-container-low p-space-md rounded-xl flex flex-col justify-between space-y-space-sm hover:shadow-md transition-shadow">
                        <div class="space-y-space-xs">
                            <div class="h-28 rounded-lg overflow-hidden">
                                <img class="w-full h-full object-cover" alt="Gói dưỡng hoa Chrysal (Hà Lan)" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB3TQGi2beq7lD8k1zqszzlhrPmu_PANcgP5FdY3GI1-U-2mxKxJf1HI4TAt7X6xWP0w_wZ0sg8odXDjE0ug83_JAEA5T2NlDtMLyZ7jWU2B8Xr8g4CXzatzvRTYrwuli2-C_AefDI8mwcjab2wve1jWxjHNl2oHKLXw5GsKt6QyPsmePAKDmouN5Bhb2-HGb-1dD7P4gvjdTXZy5MKYWy4qi2gik-pnMx9s1_mQ_9VTBPbkcvnZBoLWQ">
