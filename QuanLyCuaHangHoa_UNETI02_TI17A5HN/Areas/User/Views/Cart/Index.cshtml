        <!-- Right Column: Order Summary & Sticky Checkout (approx 35% / 4 cols) -->
        <div class="lg:col-span-4 flex flex-col space-y-space-md sticky top-28">
            <div class="bg-surface-container-lowest rounded-xl p-space-md sm:p-space-lg shadow-sm space-y-space-md">
                <div class="flex items-center justify-between pb-space-xs">
                    <h2 class="font-headline-sm text-headline-sm text-on-surface">Tóm Tắt Đơn Hoa</h2>
                    <span class="w-2.5 h-2.5 rounded-full bg-tertiary"></span>
                </div>
                <!-- Promo Code Form -->
                <div class="space-y-space-xs">
                    <label class="font-label-md text-label-md text-secondary uppercase tracking-wider block" for="promo-input">
                        Mã Ưu Đãi / Voucher Atelier
                    </label>
                    <div class="flex items-center gap-2">
                        <div class="relative flex-1">
                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-[18px] text-outline">sell</span>
                            <input class="w-full pl-9 pr-3 py-2 rounded-lg bg-surface-container-low font-body-sm text-body-sm text-on-surface uppercase tracking-wider focus:outline-none focus:ring-1 focus:ring-primary shadow-sm" id="promo-input" placeholder="Nhập mã ưu đãi..." type="text" value="FLORISSAVIP">
                        </div>
                        <button class="px-space-md py-2 rounded-lg bg-primary text-on-primary font-label-lg text-label-lg hover:bg-primary-container transition-colors shadow-sm" id="apply-voucher-btn" onclick="applyVoucher()" type="button">
                            Áp dụng
                        </button>
                    </div>
                    <!-- Applied Voucher Notification Tag -->
                    <div class="flex items-center justify-between p-2 rounded-lg bg-secondary-container text-on-secondary-container text-body-sm font-body-sm" id="voucher-badge">
                        <div class="flex items-center gap-1.5">
                            <span class="material-symbols-outlined text-[16px] text-primary">verified</span>
                            <span class="">Voucher <strong>FLORISSAVIP</strong></span>
                        </div>
                        <span class="font-title-sm text-primary">-50.000₫</span>
                    </div>
                </div>
                <div class="h-px bg-surface-container"></div>
                <!-- Price Calculation Rows -->
                <div class="space-y-space-sm font-body-sm text-body-sm text-on-surface-variant">
                    <div class="flex items-center justify-between">
                        <span class="">Tạm tính hoa tươi (<span id="cart-item-count" class="">2</span> tác phẩm)</span>
                        <span class="font-title-sm text-on-surface" id="subtotal-display">3.200.000₫</span>
                    </div>
                    <!-- Dynamic add-ons subtotal row -->
                    <div class="hidden flex items-center justify-between" id="addons-summary-row">
                        <span class="">Phụ kiện &amp; Thiệp thủ công</span>
                        <span class="font-title-sm text-on-surface" id="addons-display">0₫</span>
                    </div>
                    <div class="flex items-center justify-between text-primary">
                        <span class="">Ưu đãi thành viên Web quản lý hoa tươi</span>
                        <span class="font-title-sm" id="discount-display">-50.000₫</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1">
                            <span class="">Vận chuyển xe lạnh chuyên dụng</span>
                            <span class="material-symbols-outlined text-[14px] text-outline cursor-help" title="Hoa được chuyển bằng xe chuyên dụng giữ nhiệt độ mát 18°C suốt hành trình">info</span>
                        </div>
                        <span class="font-title-sm text-tertiary">Miễn phí</span>
                    </div>
                    <div class="flex items-center justify-between text-on-surface-variant/80">
                        <span class="">Quà tặng đính kèm</span>
                        <span class="font-label-md text-label-md text-tertiary">01 Thiệp Cotton &amp; Gói dưỡng hoa (0₫)</span>
                    </div>
                </div>
                <div class="h-px bg-surface-container"></div>
                <!-- Total Due -->
                <div class="flex items-baseline justify-between pt-1">
                    <div>
                        <span class="font-title-md text-title-md text-on-surface block">Tổng Thanh Toán Dự Kiến</span>
                        <span class="font-label-md text-label-md text-secondary">Đã bao gồm VAT &amp; bảo hiểm hoa</span>
                    </div>
                    <div class="text-right">
                        <span class="font-display-lg text-[28px] text-primary font-semibold block tracking-tight" id="final-total-display">3.150.000₫</span>
                    </div>
                </div>
                <!-- Main CTA: Proceed to Checkout -->
                <a class="w-full py-3.5 px-space-lg rounded-full bg-primary text-on-primary font-label-lg text-label-lg hover:bg-primary-container transition-all flex items-center justify-center gap-space-xs shadow-md hover:shadow-lg group" asp-controller="Home" asp-action="Checkout">
                    <span class="">Tiến Hành Đặt Hoa &amp; Chọn Giờ Giao</span>
                    <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
                </a>
                <!-- Secure Payment Note -->
                <div class="flex items-center justify-center gap-space-xs text-secondary font-label-md text-[11px] text-center">
                    <span class="material-symbols-outlined text-[14px] text-tertiary">lock</span>
                    <span class="">Thanh toán bảo mật chuẩn SSL • Chấp nhận Thẻ / Chuyển khoản / COD</span>
                </div>
            </div>

            <!-- Atelier Guarantees Card -->
            <div class="bg-surface-container-low rounded-xl p-space-md space-y-space-sm">
                <span class="font-label-md text-label-md text-primary uppercase tracking-widest block">Cam kết độc bản từ Web quản lý hoa tươi</span>
                <div class="space-y-space-sm font-body-sm text-body-sm text-on-surface-variant">
                    <div class="flex items-start gap-space-xs">
                        <span class="material-symbols-outlined text-primary text-[18px] mt-0.5 flex-shrink-0">browse_activity</span>
                        <p class=""><strong class="font-medium text-on-surface">Giao hỏa tốc trong 2 giờ</strong> đảm bảo hoa giữ nguyên độ bung nở và ẩm mượt.</p>
                    </div>
                    <div class="flex items-start gap-space-xs">
                        <span class="material-symbols-outlined text-primary text-[18px] mt-0.5 flex-shrink-0">photo_camera</span>
                        <p class=""><strong class="font-medium text-on-surface">Gửi ảnh thực tế qua Zalo:</strong> Nghệ nhân chụp ảnh tác phẩm hoàn thiện gửi quý khách duyệt trước khi xuất xưởng.</p>
                    </div>
                    <div class="flex items-start gap-space-xs">
                        <span class="material-symbols-outlined text-primary text-[18px] mt-0.5 flex-shrink-0">workspace_premium</span>
                        <p class=""><strong class="font-medium text-on-surface">Đổi mới 100%:</strong> Bù đắp sản phẩm mới nếu hoa bị dập nát, héo úa hoặc không đúng thiết kế ban đầu.</p>
                    </div>
                </div>
            </div>

            <!-- Florist Consultation Contact Box -->
            <div class="p-space-md rounded-xl bg-surface-container-lowest shadow-sm flex items-center justify-between">
                <div class="flex items-center gap-space-xs">
                    <div class="w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[20px]">support_agent</span>
                    </div>
                    <div>
                        <span class="font-title-sm text-title-sm text-on-surface block">Cần chỉnh tone hoa riêng?</span>
                        <span class="font-body-sm text-body-sm text-secondary">Trực tiếp trò chuyện với Florist</span>
                    </div>
                </div>
                <a class="px-3 py-1.5 rounded-full bg-surface-container font-label-md text-label-md text-primary hover:bg-primary hover:text-on-primary transition-colors" asp-controller="Home" asp-action="Contact">
                    Chat Zalo
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let cartState = {
            items: {
                1: { price: 1950000, qty: 1 },
                2: { price: 1250000, qty: 1 }
            },
            addonsTotal: 0,
            discount: 50000
        };

        function formatVND(amount) {
            return new Intl.NumberFormat('vi-VN').format(amount) + '₫';
        }

        function recalculateTotals() {
            let subtotal = 0;
            let itemCount = 0;

            for (let id in cartState.items) {
                subtotal += cartState.items[id].price * cartState.items[id].qty;
                itemCount += cartState.items[id].qty;
            }

            const subtotalEl = document.getElementById('subtotal-display');
            const finalTotalEl = document.getElementById('final-total-display');
            const countEl = document.getElementById('cart-item-count');
            const addonsEl = document.getElementById('addons-display');
            const addonsRow = document.getElementById('addons-summary-row');

            if (subtotalEl) subtotalEl.textContent = formatVND(subtotal);
            if (countEl) countEl.textContent = itemCount;

            if (cartState.addonsTotal > 0) {
                if (addonsRow) addonsRow.classList.remove('hidden');
                if (addonsEl) addonsEl.textContent = formatVND(cartState.addonsTotal);
            } else {
                if (addonsRow) addonsRow.classList.add('hidden');
            }

            const finalAmount = Math.max(0, subtotal + cartState.addonsTotal - cartState.discount);
            if (finalTotalEl) finalTotalEl.textContent = formatVND(finalAmount);
        }

        function updateQty(itemId, delta) {
            if (!cartState.items[itemId]) return;
            const currentQty = cartState.items[itemId].qty;
            const newQty = currentQty + delta;

            if (newQty < 1) {
                if (confirm('Quý khách có muốn gỡ tác phẩm hoa này khỏi giỏ hàng?')) {
                    removeItem('cart-item-' + itemId, cartState.items[itemId].price);
                }
                return;
            }

            cartState.items[itemId].qty = newQty;
            const qtyEl = document.getElementById('qty-' + itemId);
            if (qtyEl) qtyEl.textContent = newQty;

            const itemPriceEl = document.getElementById('item-price-' + itemId);
            if (itemPriceEl) {
                itemPriceEl.textContent = formatVND(cartState.items[itemId].price * newQty);
            }

            recalculateTotals();
        }

        function removeItem(elementId, price) {
            const el = document.getElementById(elementId);
            if (el) {
                el.style.opacity = '0';
                el.style.transform = 'translateY(10px)';
                el.style.transition = 'all 0.3s ease';
                setTimeout(() => {
                    el.remove();
                    const idMatch = elementId.replace('cart-item-', '');
                    delete cartState.items[idMatch];
                    recalculateTotals();
                }, 300);
            }
        }

        function toggleAddon(btn, price, name) {
            const isAdded = btn.getAttribute('data-added') === 'true';

            if (!isAdded) {
                btn.setAttribute('data-added', 'true');
                btn.textContent = '✓ Đã thêm';
                btn.classList.add('bg-primary', 'text-on-primary');
                btn.classList.remove('bg-surface-container-lowest', 'text-primary');
                cartState.addonsTotal += price;
            } else {
                btn.setAttribute('data-added', 'false');
                btn.textContent = '+ Thêm';
                btn.classList.remove('bg-primary', 'text-on-primary');
                btn.classList.add('bg-surface-container-lowest', 'text-primary');
                cartState.addonsTotal -= price;
            }
            recalculateTotals();
        }

        function applyVoucher() {
            const input = document.getElementById('promo-input');
            const badge = document.getElementById('voucher-badge');
            const discountEl = document.getElementById('discount-display');

            if (input && input.value.trim().toUpperCase() === 'FLORISSAVIP') {
                cartState.discount = 50000;
                if (badge) badge.classList.remove('hidden');
                if (discountEl) discountEl.textContent = '-50.000₫';
                alert('Áp dụng mã FLORISSAVIP thành công! Bạn nhận được đặc quyền giảm 50.000₫.');
            } else {
                alert('Mã ưu đãi không hợp lệ hoặc đã hết hạn.');
            }
            recalculateTotals();
        }

        function editCardMessage(id) {
            const currentEl = document.getElementById('card-msg-' + id);
            const prevText = currentEl ? currentEl.textContent.replace(/^"|"$/g, '') : '';
            const newMsg = prompt('Nhập lời chúc muốn viết tay lên thiệp gửi người thương:', prevText);
            if (newMsg !== null && newMsg.trim() !== '') {
                if (currentEl) {
                    currentEl.textContent = `"${newMsg.trim()}"`;
                }
            }
        }

        function clearCart() {
            if (confirm('Quý khách có chắc chắn muốn xóa tất cả hoa trong giỏ hàng?')) {
                const items = document.querySelectorAll('.cart-item');
                items.forEach(el => el.remove());
                cartState.items = {};
                recalculateTotals();
            }
        }
    </script>
}
