@{
    ViewData["Title"] = "Giỏ hoa của bạn - Web quản lý hoa tươi";
}

<!-- Subtle Ambient Glow -->
<div class="relative w-full max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-space-lg lg:py-space-xl">
    <div class="absolute top-10 left-1/4 w-96 h-96 bg-primary-fixed-dim/20 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-1/2 right-10 w-80 h-80 bg-secondary-fixed/40 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <!-- Editorial Header & Step Indicator -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md pb-space-lg">
        <div class="space-y-space-xs">
            <div class="flex items-center gap-space-xs text-primary font-label-md uppercase tracking-widest">
                <span class="material-symbols-outlined text-[16px]">local_florist</span>
                <span class="">Boutique Floral Cart</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Giỏ Hoa Tuyển Chọn</h1>
            <p class="font-body-md text-body-md text-on-surface-variant">Trang bị chăm chút từng nhành hoa và thông điệp yêu thương trước khi chuyển giao bàn tay nghệ nhân.</p>
        </div>
        <!-- Checkout Step Progress -->
        <div class="flex items-center gap-space-sm font-label-md uppercase tracking-wider text-on-surface-variant self-start md:self-auto bg-surface-container-low px-space-md py-2 rounded-full shadow-sm">
            <div class="flex items-center gap-1.5 text-primary font-title-sm">
                <span class="w-5 h-5 rounded-full bg-primary text-on-primary flex items-center justify-center text-[10px]">1</span>
                <span class="">Giỏ Hàng</span>
            </div>
            <span class="text-outline-variant font-light">/</span>
            <div class="flex items-center gap-1.5 opacity-60">
                <span class="w-5 h-5 rounded-full bg-surface-variant text-on-surface flex items-center justify-center text-[10px]">2</span>
                <span class="">Địa Chỉ &amp; Lời Chúc</span>
            </div>
            <span class="text-outline-variant font-light">/</span>
            <div class="flex items-center gap-1.5 opacity-60">
                <span class="w-5 h-5 rounded-full bg-surface-variant text-on-surface flex items-center justify-center text-[10px]">3</span>
                <span class="">Hoàn Tất</span>
            </div>
        </div>
    </div>

    <!-- Main Grid Layout (65% / 35%) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-start">
        <!-- Left Column: Cart Items & Upsells (approx 65% / 8 cols) -->
        <div class="lg:col-span-8 flex flex-col space-y-space-lg">
            <!-- Free Shipping Progress Tracker Banner -->
            <div class="bg-surface-container-lowest p-space-md sm:p-space-lg rounded-xl shadow-sm space-y-space-sm">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-xs">
                    <div class="flex items-center gap-space-xs text-primary font-title-sm text-title-sm">
                        <span class="material-symbols-outlined text-[20px]">redeem</span>
                        <span class="">Đặc quyền vận chuyển cao cấp</span>
                    </div>
                    <span class="font-label-md text-label-md text-secondary">Mục tiêu: Đơn từ 3.000.000₫</span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">
                    Bạn đã đạt <span class="font-title-sm text-primary">3.200.000₫</span>! Bạn được <span class="font-title-sm text-tertiary">MIỄN PHÍ VẬN CHUYỂN BẢO QUẢN LẠNH</span> toàn thành phố và tặng kèm <span class="font-title-sm text-primary">Thiệp Mỹ Thuật Dập Kim</span> cao cấp.
                </p>
                <!-- Animated Progress Bar -->
                <div class="w-full bg-surface-container rounded-full h-2.5 overflow-hidden">
                    <div class="bg-primary h-2.5 rounded-full transition-all duration-700 ease-out" style="width: 100%"></div>
                </div>
                <div class="flex items-center justify-between font-label-md text-label-md text-on-surface-variant pt-1">
                    <span class="flex items-center gap-1 text-tertiary">
                        <span class="material-symbols-outlined text-[14px]">check_circle</span>
                        Đã mở khóa Quà tặng &amp; Freeship
                    </span>
                    <span class="text-primary font-medium">100% hoàn thành</span>
                </div>
            </div>

            <!-- Cart Items List Container -->
            <div class="bg-surface-container-lowest rounded-xl p-space-md sm:p-space-lg shadow-sm space-y-space-lg">
                <div class="flex items-center justify-between pb-space-sm border-b border-surface-container">
                    <span class="font-title-md text-title-md text-on-surface">Tác phẩm hoa đã chọn (02)</span>
                    <span class="font-label-md text-label-md text-secondary tracking-widest uppercase">Web quản lý hoa tươi Signature</span>
                </div>

                <!-- Item 1: Bó hoa "Rosée Éternelle" -->
                <div class="cart-item group relative flex flex-col md:flex-row gap-space-md p-space-md bg-surface-container-low rounded-xl transition-all duration-300 hover:shadow-md" data-price="1950000" id="cart-item-1">
                    <!-- Flower Thumbnail -->
                    <div class="w-full md:w-44 h-48 md:h-auto rounded-lg overflow-hidden flex-shrink-0 relative">
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Rosée Éternelle • Bó hoa tươi nghệ thuật" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBtEHcKMpyPHGVX7n4NSK2rZNn9hLmBdaPko3FTHPlPqJEpw_6kP0TlFd-PK_Bbk8MtlYpFlb-4whgGszH6HDec1gYu1mvUmg161tyL8Z9onrSfaOAxc86qssjNDV_VuVgwegYAPNuxpgtaJf40ZoGzHBQRSYyRt5mZOCDTLY8KAN6aeNzKmCq1eIddmp5d742pmwxvcFmxzmq_OSLgQ6njMSexlWsUY7sw1y2y5ZQ1pZGncw0znDuOfg">
                        <span class="absolute top-2 left-2 px-2 py-0.5 rounded-full bg-surface-container-lowest/90 backdrop-blur-sm text-primary font-label-md text-[10px] tracking-widest uppercase shadow-sm">
                            Thiết kế chính
                        </span>
                    </div>
                    <!-- Flower Details & Bespoke Form -->
                    <div class="flex-1 flex flex-col justify-between space-y-space-sm min-w-0">
                        <div class="space-y-space-xs">
                            <div class="flex items-start justify-between gap-space-sm">
                                <div>
                                    <span class="font-label-md text-label-md text-secondary uppercase tracking-wider block">Bó hoa tươi nghệ thuật</span>
                                    <h3 class="font-headline-sm text-headline-sm text-on-surface">Rosée Éternelle</h3>
                                </div>
                                <div class="text-right">
                                    <span class="font-headline-sm text-headline-sm text-primary font-semibold block" id="item-price-1">1.950.000₫</span>
                                    <span class="font-body-sm text-body-sm text-secondary line-through">2.150.000₫</span>
                                </div>
                            </div>
                            <!-- Flower Specs Pills -->
                            <div class="flex flex-wrap gap-1.5 pt-1">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md">
                                    <span class="material-symbols-outlined text-[13px] text-primary">filter_vintage</span>
                                    Cỡ Deluxe (25 cành hoa tuyển chọn)
                                </span>
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md">
                                    <span class="material-symbols-outlined text-[13px] text-primary">texture</span>
                                    Giấy gói Kraft xám ấm &amp; Petal Rose
                                </span>
                            </div>
                            <!-- Bespoke Stationery Card Note Attached -->
                            <div class="mt-space-sm p-3 rounded-lg bg-surface-container-lowest shadow-sm flex items-start gap-space-xs">
                                <span class="material-symbols-outlined text-primary text-[18px] mt-0.5 flex-shrink-0">edit_note</span>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center justify-between">
                                        <span class="font-title-sm text-title-sm text-on-surface">Thiệp viết tay đính kèm:</span>
                                        <button class="font-label-md text-label-md text-primary hover:underline" onclick="editCardMessage(1)" type="button">Chỉnh sửa</button>
                                    </div>
                                    <p class="font-body-sm text-body-sm text-on-surface-variant italic mt-0.5 line-clamp-1" id="card-msg-1">"Chúc mừng sinh nhật em yêu - Mãi rực rỡ và bình yên như những đóa hồng ban mai."</p>
                                </div>
                            </div>
                        </div>
                        <!-- Quantity Controls & Actions -->
                        <div class="flex flex-wrap items-center justify-between gap-space-sm pt-space-xs">
                            <div class="flex items-center bg-surface-container-lowest rounded-full p-1 shadow-sm">
                                <button aria-label="Giảm số lượng" class="w-7 h-7 rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors" onclick="updateQty(1, -1)" type="button">
                                    <span class="material-symbols-outlined text-[16px]">remove</span>
                                </button>
                                <span class="w-8 text-center font-title-sm text-title-sm text-on-surface" id="qty-1">1</span>
                                <button aria-label="Tăng số lượng" class="w-7 h-7 rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors" onclick="updateQty(1, 1)" type="button">
                                    <span class="material-symbols-outlined text-[16px]">add</span>
                                </button>
                            </div>
                            <div class="flex items-center gap-space-sm text-on-surface-variant font-label-md text-label-md">
                                <button class="hover:text-primary flex items-center gap-1 transition-colors" type="button">
                                    <span class="material-symbols-outlined text-[16px]">bookmark_border</span>
                                    <span class="">Lưu lại sau</span>
                                </button>
                                <span class="text-outline-variant">•</span>
                                <button class="hover:text-error flex items-center gap-1 transition-colors" onclick="removeItem('cart-item-1', 1950000)" type="button">
                                    <span class="material-symbols-outlined text-[16px]">delete_outline</span>
                                    <span class="">Xóa</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Item 2: Giỏ hoa mây mộc "Vũ Điệu Ánh Dương" -->
                <div class="cart-item group relative flex flex-col md:flex-row gap-space-md p-space-md bg-surface-container-low rounded-xl transition-all duration-300 hover:shadow-md" data-price="1250000" id="cart-item-2">
                    <!-- Flower Thumbnail -->
                    <div class="w-full md:w-44 h-48 md:h-auto rounded-lg overflow-hidden flex-shrink-0 relative">
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Vũ Điệu Ánh Dương • Giỏ hoa bàn tiệc cao cấp" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAlY7CeociItNgMqxvEBCXiYUqEj0cu3Tn5Gz14tkVMl_dMtGgMdmCjhmfq-zHQLwpSaN9Ey_lRnigrOL7URsBSeaqtKTRDDar_ZA1KoQv5T1PaE1b8Ix6CScG6t3lW1GeseCgmEVvv-wOaKb_Iwcmoq_UrmVTkhb4oD2FMvRtFMHbHmwjqwMzhOvPYv3WWn3U4UeNsdVykeQKzFGpe3e0Qsx_Uz1eWm8XGU7cX9EyW0W_oxEHBydFNDw">
                        <span class="absolute top-2 left-2 px-2 py-0.5 rounded-full bg-surface-container-lowest/90 backdrop-blur-sm text-tertiary font-label-md text-[10px] tracking-widest uppercase shadow-sm">
                            Giỏ Mây Mộc
                        </span>
                    </div>
                    <!-- Flower Details & Bespoke Form -->
                    <div class="flex-1 flex flex-col justify-between space-y-space-sm min-w-0">
                        <div class="space-y-space-xs">
                            <div class="flex items-start justify-between gap-space-sm">
                                <div>
                                    <span class="font-label-md text-label-md text-secondary uppercase tracking-wider block">Giỏ hoa bàn tiệc cao cấp</span>
                                    <h3 class="font-headline-sm text-headline-sm text-on-surface">Vũ Điệu Ánh Dương</h3>
                                </div>
                                <div class="text-right">
                                    <span class="font-headline-sm text-headline-sm text-primary font-semibold block" id="item-price-2">1.250.000₫</span>
                                </div>
                            </div>
                            <!-- Flower Specs Pills -->
                            <div class="flex flex-wrap gap-1.5 pt-1">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md">
                                    <span class="material-symbols-outlined text-[13px] text-tertiary">aspect_ratio</span>
                                    Kích cỡ: Tiêu chuẩn để bàn tiệc
                                </span>
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md">
                                    <span class="material-symbols-outlined text-[13px] text-tertiary">wb_sunny</span>
                                    Tone vàng kem hoàng kim &amp; cam san hô
                                </span>
                            </div>
                            <!-- Default note reminder -->
                            <div class="mt-space-sm p-3 rounded-lg bg-surface-container-lowest shadow-sm flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-outline text-[18px]">drafts</span>
                                    <span class="font-body-sm text-body-sm text-on-surface-variant">Chưa chọn nội dung thiệp cho tác phẩm này</span>
                                </div>
                                <button class="font-label-md text-label-md text-primary hover:underline" onclick="editCardMessage(2)" type="button">+ Thêm thiệp (0₫)</button>
                            </div>
                        </div>
                        <!-- Quantity Controls & Actions -->
                        <div class="flex flex-wrap items-center justify-between gap-space-sm pt-space-xs">
                            <div class="flex items-center bg-surface-container-lowest rounded-full p-1 shadow-sm">
                                <button aria-label="Giảm số lượng" class="w-7 h-7 rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors" onclick="updateQty(2, -1)" type="button">
                                    <span class="material-symbols-outlined text-[16px]">remove</span>
                                </button>
                                <span class="w-8 text-center font-title-sm text-title-sm text-on-surface" id="qty-2">1</span>
                                <button aria-label="Tăng số lượng" class="w-7 h-7 rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface-container transition-colors" onclick="updateQty(2, 1)" type="button">
                                    <span class="material-symbols-outlined text-[16px]">add</span>
                                </button>
                            </div>
                            <div class="flex items-center gap-space-sm text-on-surface-variant font-label-md text-label-md">
                                <button class="hover:text-primary flex items-center gap-1 transition-colors" type="button">
                                    <span class="material-symbols-outlined text-[16px]">bookmark_border</span>
                                    <span class="">Lưu lại sau</span>
                                </button>
                                <span class="text-outline-variant">•</span>
                                <button class="hover:text-error flex items-center gap-1 transition-colors" onclick="removeItem('cart-item-2', 1250000)" type="button">
                                    <span class="material-symbols-outlined text-[16px]">delete_outline</span>
                                    <span class="">Xóa</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bottom Action Buttons: Continue Browsing & Clear Cart -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm pt-space-md">
                    <a class="inline-flex items-center gap-2 font-title-sm text-title-sm text-secondary hover:text-primary transition-colors py-2" asp-controller="Home" asp-action="Products">
                        <span class="material-symbols-outlined text-[18px]">west</span>
                        <span class="">Tiếp tục ngắm hoa (Xem danh mục)</span>
                    </a>
                    <button class="text-on-surface-variant hover:text-error font-body-sm text-body-sm transition-colors flex items-center gap-1 self-start sm:self-auto" onclick="clearCart()" type="button">
                        <span class="material-symbols-outlined text-[16px]">remove_shopping_cart</span>
                        <span class="">Xóa toàn bộ giỏ hàng</span>
                    </button>
                </div>
            </div>

            <!-- Add-on Upsells: Bespoke Floral Extras -->
            <div class="bg-surface-container-lowest rounded-xl p-space-md sm:p-space-lg shadow-sm space-y-space-md">
                <div class="space-y-space-xs">
                    <div class="flex items-center gap-space-xs text-primary font-label-md text-label-md uppercase tracking-wider">
                        <span class="material-symbols-outlined text-[18px]">add_circle</span>
                        <span class="">Gợi Ý Nâng Cấp Tinh Tế</span>
                    </div>
                    <h3 class="font-headline-sm text-headline-sm text-on-surface">Thêm phần trọn vẹn cho món quà của bạn</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Những phụ kiện thủ công độc bản được chế tác riêng biệt từ xưởng thủ công Web quản lý hoa tươi.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md pt-space-xs">
                    <!-- Addon 1 -->
                    <div class="bg-surface-container-low p-space-md rounded-xl flex flex-col justify-between space-y-space-sm hover:shadow-md transition-shadow">
                        <div class="space-y-space-xs">
                            <div class="h-28 rounded-lg overflow-hidden">
                                <img class="w-full h-full object-cover" alt="Thiệp hoa sáp thơm viết tay" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCNNfPl6iF4Ar6ZBvnTBMwqcbPABGvnp2kk3NgqyXzay1wCx-uh_eLg7gHS9iR_VrN8gVgo-akooBwoYpxkvSGONoI6dAxOJlVreA6VuC3R2zuQ4RutaL16eCE_IVs0OsCdF3Ghk_GQpXg05-2nXiVDx3RwxEdVMboV5BmM2WGARugOicj_79-cxGC9ryjB72u2P_E0tsOtxJyeUKIGgsXAEjVAtUYgLS1vgCQWX3Of4mJCPPREh2tsbQ">
