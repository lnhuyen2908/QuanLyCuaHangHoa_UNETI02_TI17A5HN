<!-- JAVASCRIPT LOGIC FOR PRODUCT DETAIL -->
<script>
    function switchMainVisual(buttonEl, imgSrc) {
        const mainImg = document.getElementById('mainProductVisual');
        if (mainImg && imgSrc) {
            mainImg.src = imgSrc;
        }

        const thumbBtns = document.querySelectorAll('.thumb-btn');
        thumbBtns.forEach(btn => {
            btn.classList.remove('ring-2', 'ring-primary', 'active');
        });

        if (buttonEl) {
            buttonEl.classList.add('ring-2', 'ring-primary', 'active');
        }
    }

    function toggleWishlist(btnEl) {
        const icon = btnEl.querySelector('.material-symbols-outlined');
        if (icon) {
            if (icon.style.fontVariationSettings && icon.style.fontVariationSettings.includes("'FILL' 1")) {
                icon.style.fontVariationSettings = "'FILL' 0";
                icon.classList.remove('text-primary');
            } else {
                icon.style.fontVariationSettings = "'FILL' 1";
                icon.classList.add('text-primary');
            }
        }
    }

    function selectSize(cardEl, sizeName, priceNum, origPriceNum, detailText) {
        const sizeCards = document.querySelectorAll('.size-card');
        sizeCards.forEach(card => {
            card.classList.remove('border-2', 'border-primary', 'active');
            card.classList.add('border', 'border-outline-variant');
            
            const checkIcon = card.querySelector('.check-indicator');
            if (checkIcon) {
                checkIcon.textContent = 'radio_button_unchecked';
                checkIcon.classList.remove('text-primary');
                checkIcon.classList.add('text-outline-variant');
            }
        });

        cardEl.classList.remove('border', 'border-outline-variant');
        cardEl.classList.add('border-2', 'border-primary', 'active');

        const activeCheck = cardEl.querySelector('.check-indicator');
        if (activeCheck) {
            activeCheck.textContent = 'check_circle';
            activeCheck.classList.remove('text-outline-variant');
            activeCheck.classList.add('text-primary');
        }

        const label = document.getElementById('selectedSizeLabel');
        if (label) {
            label.textContent = sizeName;
        }

        const priceEl = document.getElementById('displayPrice');
        if (priceEl) {
            priceEl.textContent = priceNum.toLocaleString('vi-VN') + '₫';
        }

        const origPriceEl = document.getElementById('displayOriginalPrice');
        if (origPriceEl) {
            origPriceEl.textContent = origPriceNum.toLocaleString('vi-VN') + '₫';
        }
    }

    function selectWrap(cardEl, wrapName) {
        const wrapCards = document.querySelectorAll('.wrap-card');
        wrapCards.forEach(card => {
            card.classList.remove('border-2', 'border-primary', 'active');
            card.classList.add('border', 'border-outline-variant');
        });

        cardEl.classList.remove('border', 'border-outline-variant');
        cardEl.classList.add('border-2', 'border-primary', 'active');

        const label = document.getElementById('selectedWrapLabel');
        if (label) {
            label.textContent = wrapName;
        }
    }

    function toggleGreetingInput() {
        const container = document.getElementById('greetingContainer');
        const arrow = document.getElementById('greetingArrow');
        if (container) {
            container.classList.toggle('hidden');
        }
        if (arrow) {
            arrow.classList.toggle('rotate-180');
        }
    }

    function changeQuantity(delta) {
        const input = document.getElementById('quantityInput');
        if (input) {
            let val = parseInt(input.value) || 1;
            val += delta;
            if (val < 1) val = 1;
            if (val > 20) val = 20;
            input.value = val;
        }
    }

    function switchSpecTab(tabId, btnEl) {
        const specPanes = document.querySelectorAll('.spec-tab-pane');
        specPanes.forEach(pane => pane.classList.add('hidden'));

        const specLinks = document.querySelectorAll('.spec-tab-link');
        specLinks.forEach(link => {
            link.classList.remove('text-primary', 'border-primary', 'active');
            link.classList.add('text-on-surface-variant', 'border-transparent');
        });

        const targetPane = document.getElementById(tabId);
        if (targetPane) {
            targetPane.classList.remove('hidden');
        }

        btnEl.classList.remove('text-on-surface-variant', 'border-transparent');
        btnEl.classList.add('text-primary', 'border-primary', 'active');
    }
</script>
