@* Họ và tên: Nguyễn Thị Phương Anh
Mã sinh viên: 23103100267
Nội dung thực hiện: Thiết kế giao diện chi tiết mẫu hoa, hiển thị thành phần và mẫu hoa liên quan *@

@model QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.Entities.MauSanPham

@{
    ViewData["Title"] = Model.TenMau;
}
<!-- BREADCRUMB SECTION -->
<div class="w-full bg-surface-container-low/70 py-space-sm px-margin-mobile md:px-margin lg:px-margin-desktop">
    <div class="max-w-7xl mx-auto flex items-center flex-wrap gap-space-xs font-label-md text-label-md text-on-surface-variant">
        <a class="hover:text-primary transition-colors flex items-center gap-1" asp-area="User" asp-controller="Home" asp-action="Index">
            <span class="material-symbols-outlined text-[16px]">home</span>
            <span>Trang chủ</span>
        </a>
        <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
        <a class="hover:text-primary transition-colors" asp-area="User" asp-controller="MauSanPham" asp-action="Index">Mẫu hoa tươi</a>
        <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
        <a class="hover:text-primary transition-colors" asp-area="User" asp-controller="MauSanPham" asp-action="Index">Bó hoa cao cấp</a>
        <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
        <span class="text-on-surface font-title-sm truncate max-w-xs md:max-w-md">@Model.TenMau</span>
        <span class="ml-2 px-2 py-0.5 rounded-full bg-surface-container-highest text-secondary text-[10px] tracking-wider uppercase">Mã: #@Model.MaMau</span>
    </div>
</div>

<!-- MAIN PRODUCT DETAIL SECTION -->
<section class="w-full max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-space-lg md:py-space-xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-start">

        <!-- LEFT COLUMN: VISUAL GALLERY & PROMISES -->
        <div class="lg:col-span-6 xl:col-span-7 flex flex-col gap-space-md">
            <!-- Main Large Image Container -->
            <div class="relative w-full rounded-2xl overflow-hidden bg-surface-container-lowest shadow-[0_4px_24px_-4px_rgba(41,37,36,0.08)] group">
                <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                    <img id="mainProductVisual"
                         alt="@Model.TenMau"
                         class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                         src="@Url.Content(string.IsNullOrWhiteSpace(Model.HinhAnh) ? "~/images/no-image.png" : Model.HinhAnh)" />
                </div>
                <!-- Top Action Tags -->
                <div class="absolute top-4 left-4 flex flex-col gap-2 pointer-events-none">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary text-on-primary font-label-md text-label-md tracking-wider uppercase shadow-md">
                        <span class="material-symbols-outlined text-[14px]">local_fire_department</span>
                        BESTSELLER WEBQH
                    </span>
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-surface-container-lowest/90 backdrop-blur-md text-tertiary font-label-md text-[11px] shadow-sm">
                        <span class="material-symbols-outlined text-[13px]">eco</span>
                        Hoa nhập khẩu loại 1
                    </span>
                </div>
                <!-- Interactive Action Buttons -->
                <div class="absolute top-4 right-4 flex flex-col gap-2">
                    <button id="btnWishlist" type="button" onclick="toggleWishlist(this)" title="Lưu vào danh sách yêu thích"
                            class="w-10 h-10 rounded-full bg-surface-container-lowest/90 hover:bg-surface-container-lowest text-on-surface shadow-md flex items-center justify-center transition-all duration-300 hover:scale-110 group/btn">
                        <span class="material-symbols-outlined text-[20px] group-hover/btn:text-primary transition-colors">favorite</span>
                    </button>
                    <button type="button" title="Phóng to ảnh"
                            class="w-10 h-10 rounded-full bg-surface-container-lowest/90 hover:bg-surface-container-lowest text-on-surface shadow-md flex items-center justify-center transition-all duration-300 hover:scale-110">
                        <span class="material-symbols-outlined text-[20px]">zoom_in</span>
                    </button>
                </div>
                <!-- Bottom Floating Badge: Florist Artisan Tag -->
                <div class="absolute bottom-4 left-4 right-4 p-3 rounded-xl bg-surface-container-lowest/85 backdrop-blur-md shadow-md flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-8 h-8 rounded-full bg-secondary-container flex items-center justify-center text-primary font-serif font-bold text-sm">
                            F
                        </div>
                        <div class="flex flex-col">
                            <span class="font-title-sm text-title-sm text-on-surface leading-tight">Master Florist Handcrafted</span>
                            <span class="font-body-sm text-[11px] text-on-surface-variant">Bó hoa cắm mới thủ công hoàn toàn sau khi xác nhận đơn</span>
                        </div>
                    </div>
                    <span class="material-symbols-outlined text-tertiary text-[20px]">workspace_premium</span>
                </div>
            </div>

            <!-- Thumbnails Gallery -->
            <div class="grid grid-cols-4 gap-space-sm">
                <button type="button"
                        onclick="switchMainVisual(this, document.getElementById('mainProductVisual').src)"
                        class="thumb-btn active relative aspect-square rounded-xl overflow-hidden
                    bg-surface-container-low ring-2 ring-primary">
                    <img alt="@Model.TenMau"
                         class="w-full h-full object-cover"
                         src="@Url.Content(string.IsNullOrWhiteSpace(Model.HinhAnh)
                                                  ? "~/images/no-image.png"
                                                  : Model.HinhAnh)" />
                </button>
            </div>


            <!-- Quality Commitment Box -->
            <div class="mt-space-xs p-space-md rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col gap-space-sm">
                <div class="flex items-center gap-space-xs text-primary font-title-sm text-title-sm uppercase tracking-wide">
                    <span class="material-symbols-outlined text-[20px]">verified_user</span>
                    <span>Cam kết dịch vụ độc quyền tại Web quản lý hoa tươi</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-space-sm pt-space-xs">
                    <div class="flex items-start gap-space-xs p-2 rounded-xl bg-surface-container-low">
                        <span class="material-symbols-outlined text-tertiary text-[20px] flex-shrink-0 mt-0.5">photo_camera</span>
                        <div class="flex flex-col">
                            <span class="font-title-sm text-[12px] text-on-surface">Chụp ảnh duyệt trước</span>
                            <span class="font-body-sm text-[11px] text-on-surface-variant leading-tight">Gửi ảnh hoa thành phẩm qua Zalo trước khi giao</span>
                        </div>
                    </div>
                    <div class="flex items-start gap-space-xs p-2 rounded-xl bg-surface-container-low">
                        <span class="material-symbols-outlined text-tertiary text-[20px] flex-shrink-0 mt-0.5">spa</span>
                        <div class="flex flex-col">
                            <span class="font-title-sm text-[12px] text-on-surface">Bảo hành hoa 5-7 ngày</span>
                            <span class="font-body-sm text-[11px] text-on-surface-variant leading-tight">Cam kết hoa tươi cắt mới, không dùng hoa ủ lạnh</span>
                        </div>
                    </div>
                    <div class="flex items-start gap-space-xs p-2 rounded-xl bg-surface-container-low">
                        <span class="material-symbols-outlined text-tertiary text-[20px] flex-shrink-0 mt-0.5">published_with_changes</span>
                        <div class="flex flex-col">
                            <span class="font-title-sm text-[12px] text-on-surface">Đổi mới 100%</span>
                            <span class="font-body-sm text-[11px] text-on-surface-variant leading-tight">Nếu hoa dập nát, thiếu cành hoặc sai mẫu yêu cầu</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: PRODUCT SPECIFICATION & ACTIONS -->
        <div class="lg:col-span-6 xl:col-span-5 flex flex-col gap-space-md">
            <!-- Header Info & Category -->
            <div class="flex flex-col gap-1.5">
                <div class="flex items-center justify-between">
                    <span class="font-label-md text-label-md text-primary font-bold tracking-widest uppercase flex items-center gap-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary inline-block"></span>
                        Mẫu hoa tươi
                    </span>
                    <span class="px-2.5 py-1 rounded-full bg-surface-container font-label-md text-on-surface-variant text-[11px]">
                        ID: @Model.MaMau
                    </span>
                </div>
                <h1 class="font-headline-lg text-headline-lg text-on-surface leading-tight tracking-tight">
                    @Model.TenMau
                </h1>
                <p class="font-body-md text-body-md text-on-surface-variant">
                    Kiểu dáng: @Model.KieuSanPham
                    @if (Model.DipSuDung != null)
                    {
                        <span> | Dịp sử dụng: @Model.DipSuDung.TenDip</span>
                    }
                </p>
                <!-- Ratings & Verification -->
                <div class="flex items-center gap-3 pt-1">
                    <div class="flex items-center text-[#e6a23c]">
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                        <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">star</span>
                    </div>
                    <span class="font-title-sm text-title-sm text-on-surface">5.0</span>
                    <span class="text-outline-variant">•</span>
                    <a class="font-body-sm text-body-sm text-primary hover:underline" href="#reviews">
                        86 lượt đánh giá thực tế
                    </a>
                    <span class="text-outline-variant">•</span>
                    <span class="font-label-md text-[11px] text-tertiary flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">check_circle</span> 100% Khách hài lòng
                    </span>
                </div>
            </div>

            <!-- Price Panel & Stock Status -->
            <div class="p-space-md rounded-2xl bg-surface-container-low flex flex-col gap-2">
                <div class="flex items-baseline justify-between flex-wrap gap-2">
                    <div class="flex items-baseline gap-3">
                        <span id="displayPrice" class="font-headline-lg text-headline-lg text-primary font-bold">@Model.GiaCoBan.ToString("N0")₫</span>

                    </div>
                    <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-label-md text-[11px]">
                        <span class="w-2 h-2 rounded-full bg-tertiary animate-pulse"></span>
                        <span>Hoa tươi sẵn có trong ngày</span>
                    </div>
                </div>
                <p class="font-body-sm text-body-sm text-secondary">
                    Đã bao gồm VAT, thiệp viết tay theo yêu cầu, nơ satin cao cấp và túi vận chuyển giữ ẩm chuyên dụng.
                </p>
            </div>

            <!-- Size Selection (Bespoke Sizing) -->
            <div class="flex flex-col gap-space-xs">
                <div class="flex items-center justify-between">
                    <span class="font-title-sm text-title-sm text-on-surface">Chọn kích cỡ bó hoa:</span>
                    <span id="selectedSizeLabel" class="font-body-sm text-body-sm text-secondary">Tiêu chuẩn (15 cành)</span>
                </div>
                <div id="sizeSelectorContainer" class="grid grid-cols-1 sm:grid-cols-3 gap-space-sm">
                    <div class="size-card active p-3 rounded-xl bg-surface-container-lowest border-2 border-primary shadow-sm text-left flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-1">
                                <span class="font-title-sm text-title-sm text-on-surface">@Model.KieuSanPham</span>
                                <span class="material-symbols-outlined text-primary text-[18px]">check_circle</span>
                            </div>
                            <p class="font-body-sm text-[11px] text-on-surface-variant leading-tight">Giá theo mẫu hoa đang chọn</p>
                        </div>
                        <div class="mt-2 pt-2 border-t border-surface-container font-title-sm text-primary">
                            @Model.GiaCoBan.ToString("N0")₫
                        </div>
                    </div>
                </div>
            </div>

            <!-- Wrapping & Ribbon Customization -->
            <div class="flex flex-col gap-space-xs">
                <div class="flex items-center justify-between">
                    <span class="font-title-sm text-title-sm text-on-surface">Tùy chọn giấy gói &amp; ruy-băng:</span>
                    <span id="selectedWrapLabel" class="font-body-sm text-body-sm text-primary">Kraft xám ấm &amp; nơ dusty rose</span>
                </div>
                <div id="wrapSelectorContainer" class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                    <button type="button" onclick="selectWrap(this, 'Kraft xám ấm &amp; nơ dusty rose')"
                            class="wrap-card active p-2.5 rounded-xl bg-surface-container-lowest border-2 border-primary shadow-sm flex items-center gap-2.5 transition-all duration-200">
                        <div class="w-6 h-6 rounded-full bg-[#baa697] flex items-center justify-center flex-shrink-0 shadow-inner">
                            <span class="w-2.5 h-2.5 rounded-full bg-primary"></span>
                        </div>
                        <span class="font-body-sm text-[12px] text-on-surface text-left">Kraft xám &amp; Rose</span>
                    </button>
                    <button type="button" onclick="selectWrap(this, 'Trắng kem hoàng gia &amp; nơ ngọc trai')"
                            class="wrap-card p-2.5 rounded-xl bg-surface-container-lowest border border-outline-variant shadow-sm flex items-center gap-2.5 transition-all duration-200">
                        <div class="w-6 h-6 rounded-full bg-[#f4f1ea] border border-outline-variant flex items-center justify-center flex-shrink-0">
                            <span class="w-2.5 h-2.5 rounded-full bg-[#fdfbf7]"></span>
                        </div>
                        <span class="font-body-sm text-[12px] text-on-surface text-left">Trắng kem cao cấp</span>
                    </button>
                    <button type="button" onclick="selectWrap(this, 'Đen mờ huyền bí &amp; nơ đỏ Bordeaux')"
                            class="wrap-card p-2.5 rounded-xl bg-surface-container-lowest border border-outline-variant shadow-sm flex items-center gap-2.5 transition-all duration-200">
                        <div class="w-6 h-6 rounded-full bg-[#2a2728] flex items-center justify-center flex-shrink-0">
                            <span class="w-2.5 h-2.5 rounded-full bg-[#751624]"></span>
                        </div>
                        <span class="font-body-sm text-[12px] text-on-surface text-left">Đen mờ &amp; Bordeaux</span>
                    </button>
                </div>
            </div>

            <!-- Recipient Message Note Accordion -->
            <div class="p-space-sm rounded-xl bg-surface-container-low flex flex-col gap-2">
                <div class="flex items-center justify-between cursor-pointer" onclick="toggleGreetingInput()">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-primary text-[18px]">edit_note</span>
                        <span class="font-title-sm text-title-sm text-on-surface">Lời chúc đính kèm thiệp (Miễn phí)</span>
                    </div>
                    <span id="greetingArrow" class="material-symbols-outlined text-outline text-[18px] transition-transform duration-200">expand_more</span>
                </div>
                <div id="greetingContainer" class="flex flex-col gap-2 pt-2">
                    <textarea class="w-full px-3 py-2 rounded-xl bg-surface-container-lowest font-body-sm text-body-sm text-on-surface placeholder:text-outline focus:outline-none focus:ring-1 focus:ring-primary shadow-inner"
                              placeholder="Nhập lời chúc bạn muốn gửi đến người thương (Web quản lý hoa tươi sẽ nắn nót viết tay trên thiệp mỹ thuật dập nhũ)..."
                              rows="2"></textarea>
                    <div class="flex items-center justify-between text-[11px] text-on-surface-variant font-label-md">
                        <span>Mẫu thiệp: Bìa thư giấy mỹ thuật dập nhũ vàng 24K</span>
                        <span>Tối đa 180 ký tự</span>
                    </div>
                </div>
            </div>

            <!-- Quantity & Order Actions -->
            <div class="flex flex-col gap-space-sm pt-2">
                <div class="flex items-center gap-space-sm">
                    <!-- Quantity Box -->
                    <div class="flex items-center rounded-full bg-surface-container-low p-1 shadow-inner">
                        <button type="button" onclick="changeQuantity(-1)"
                                class="w-9 h-9 rounded-full bg-surface-container-lowest text-on-surface hover:bg-surface-container flex items-center justify-center transition-colors">
                            <span class="material-symbols-outlined text-[18px]">remove</span>
                        </button>
                        <input id="quantityInput" type="number" value="1" min="1" max="20" readonly
                               class="w-12 text-center bg-transparent font-title-sm text-title-sm text-on-surface focus:outline-none" />
                        <button type="button" onclick="changeQuantity(1)"
                                class="w-9 h-9 rounded-full bg-surface-container-lowest text-on-surface hover:bg-surface-container flex items-center justify-center transition-colors">
                            <span class="material-symbols-outlined text-[18px]">add</span>
                        </button>
                    </div>

                    @* Đặng Thị Mai Hương - 23103100293 *@
                    <!-- Primary Action: Buy Now -->
                    <form asp-area="User"
                          asp-controller="Checkout"
                          asp-action="BuyNow"
                          method="post"
                          onsubmit="return guiMuaNgay(this)"
                          class="flex-1">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="maMau" value="@Model.MaMau" />
                        <input type="hidden" name="soLuong" />
                        <input type="hidden" name="giayGoiRuyBang" />
                        <input type="hidden" name="loiChuc" />

                        <button type="submit"
                                class="w-full py-3 px-space-lg rounded-full bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container shadow-md transition-all duration-300 flex items-center justify-center gap-2">

                            <span class="material-symbols-outlined text-[20px]">bolt</span>
                            <span>Đặt hoa ngay • Giao hỏa tốc</span>

                        </button>
                    </form>
                    <script>
                                            // Lấy các tùy chọn khách đang chọn để chuyển sang Checkout.
                                            function guiMuaNgay(form) {

                                                // Số lượng hoa
                                                form.elements["soLuong"].value =
                                                    document.getElementById("quantityInput").value;

                                                // Giấy gói và ruy-băng
                                                form.elements["giayGoiRuyBang"].value =
                                                    document.getElementById("selectedWrapLabel").textContent.trim();

                                                // Lời chúc (có thể để trống)
                                                form.elements["loiChuc"].value =
                                                    document.querySelector("#greetingContainer textarea").value;

                                                return true;
                                            }
                    </script>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
                    <!-- Secondary Action: Add to Cart -->
                    <form action="/User/Cart/Add" method="post"
                          onsubmit="return guiVaoGio(this)">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="maMau" value="@ViewContext.RouteData.Values["id"]" />
                        <input type="hidden" name="soLuong" />
                        <input type="hidden" name="giayGoiRuyBang" />
                        <input type="hidden" name="loiChuc" />

                        <button type="submit" class="py-2.5 px-space-md rounded-full bg-secondary-container text-on-secondary-container flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">shopping_bag</span>
                            <span>Thêm vào giỏ hàng</span>
                        </button>
                    </form>

                    <script>
                                            function guiVaoGio(form) {
                                                form.elements["soLuong"].value =
                                                    document.getElementById("quantityInput").value;

                                                form.elements["giayGoiRuyBang"].value =
                                                    document.getElementById("selectedWrapLabel").textContent.trim();

                                                form.elements["loiChuc"].value =
                                                    document.querySelector("#greetingContainer textarea").value;

                                                return true;
                                            }
                    </script>
                    @* HẾT PHẦN CỦA HƯƠNG *@

                    <!-- Custom Bespoke Action -->
                    <a asp-area="User" asp-controller="Home" asp-action="CustomDesign"
                       class="py-2.5 px-space-md rounded-full bg-surface-container-lowest text-primary hover:bg-surface-container-low shadow-sm font-title-sm text-title-sm transition-colors flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-[18px]">brush</span>
                        <span>Yêu cầu thiết kế riêng</span>
                    </a>
                </div>
            </div>

            <!-- Value Add Ons Perks -->
            <div class="pt-space-xs flex flex-col gap-2 font-body-sm text-body-sm text-on-surface-variant">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-tertiary text-[18px]">card_giftcard</span>
                    <span>Tặng thiệp nghệ thuật ép kim Web quản lý hoa tươi hoặc banner chúc mừng</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-tertiary text-[18px]">science</span>
                    <span>Tặng kèm 02 gói dinh dưỡng dưỡng hoa Chrysal Hà Lan</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-tertiary text-[18px]">schedule</span>
                    <span>Hẹn giờ giao chính xác (Sai lệch không quá 15 phút)</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- PRODUCT SPECIFICATIONS & TECHNICAL DETAILS TABS -->
<section class="w-full bg-surface-container-low/40 py-space-xl">
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop">
        <div class="bg-surface-container-lowest rounded-3xl p-space-md md:p-space-xl shadow-[0_2px_16px_rgba(41,37,36,0.04)]">
            <!-- Tab Navigation Bar -->
            <div class="flex items-center space-x-2 md:space-x-4 border-b border-surface-container overflow-x-auto pb-2 scrollbar-none">
                <button type="button" onclick="switchSpecTab('tab-flowers', this)"
                        class="spec-tab-link active font-title-sm text-title-sm pb-3 px-2 text-primary border-b-2 border-primary whitespace-nowrap flex items-center gap-2 transition-colors">
                    <span class="material-symbols-outlined text-[18px]">psychiatry</span>
                    <span>Thành phần hoa &amp; Tiêu chuẩn cắm</span>
                </button>
                <button type="button" onclick="switchSpecTab('tab-delivery', this)"
                        class="spec-tab-link font-title-sm text-title-sm pb-3 px-2 text-on-surface-variant hover:text-on-surface border-b-2 border-transparent whitespace-nowrap flex items-center gap-2 transition-colors">
                    <span class="material-symbols-outlined text-[18px]">local_shipping</span>
                    <span>Lịch giao hoa &amp; Vận chuyển 2h</span>
                </button>
