@* Họ và tên: Nguyễn Thị Phương Anh 
Mã sinh viên: 23103100267
Nội dung thực hiện:Thiết kế giao diện danh sách mẫu hoa, tìm kiếm, lọc và sắp xếp sản phẩm  *@

@model QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels.MauSanPhamListViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Tất cả mẫu hoa - Web quản lý hoa tươi";
}

<!-- Top Breadcrumb & Page Banner Area -->
<section class="w-full bg-surface-container-low py-space-md">
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop">
        <!-- Breadcrumb -->
        @* <nav aria-label="Breadcrumb" class="flex items-center gap-space-xs text-secondary font-label-md text-label-md uppercase tracking-wider mb-space-sm">
            <a class="hover:text-primary transition-colors flex items-center gap-1" asp-controller="Home" asp-action="Index">
                <span class="material-symbols-outlined text-[16px]">home</span>
                Trang chủ
            </a>
            <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
            <a class="hover:text-primary transition-colors" asp-controller="Home" asp-action="Products">Danh mục</a>
            <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
            <span class="text-primary font-semibold">Tất cả mẫu hoa</span>
        </nav> *@
        <!-- Page Editorial Headline -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
            <div class="space-y-space-xs max-w-2xl">
               
                <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Tất cả mẫu hoa thiết kế</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">Tuyển tập những tác phẩm hoa nghệ thuật được kết nối tỉ mỉ bởi các nghệ nhân Web quản lý hoa tươi. Mỗi sắc thái và kiểu dáng đều mang một thông điệp tình cảm tinh tế.</p>
            </div>
            <div class="flex items-center gap-space-xs bg-surface-container px-space-md py-space-sm rounded-full self-start md:self-auto shadow-sm">
                <span class="w-2.5 h-2.5 rounded-fulla bg-tertiary animate-pulse"></span>
                <span class="font-label-lg text-label-lg text-on-surface">
                    Hiển thị
                    <span class="text-primary font-bold">@Model.DanhSachMau.TongSoBanGhi</span>
                    mẫu hoa
                </span>
            </div>
        </div>
    </div>
</section>

<!-- Main Content Layout (Sidebar Filter & Product Showcase) -->
<section class="max-w-7xl mx-auto w-full px-margin-mobile md:px-margin lg:px-margin-desktop py-space-xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-start">
        <!-- LEFT SIDEBAR FILTER (Sticky) -->
        <aside class="lg:col-span-4 xl:col-span-3">
            <div class="sticky top-28 bg-surface-container-lowest rounded-xl p-space-lg shadow-sm space-y-space-lg">
                <!-- Filter Header & Reset -->
                <div class="flex items-center justify-between pb-space-xs">
                    <div class="flex items-center gap-space-xs">
                        <span class="material-symbols-outlined text-primary text-[20px]">tune</span>
                        <h3 class="font-title-md text-title-md text-on-surface">Bộ lọc nâng cao</h3>
                    </div>
                    <button class="font-label-sm text-label-md text-secondary hover:text-primary transition-colors uppercase tracking-wider flex items-center gap-1" id="reset-all-btn" type="button">
                        <span class="material-symbols-outlined text-[13px]">refresh</span>
                        Xóa tất cả
                    </button>
                </div>

                <!-- Keyword Search -->
                <form method="get"
                  asp-area="User"
                  asp-controller="MauSanPham"
                  asp-action="Index"
                  class="relative" id="search-filter-form">

                <input name="tuKhoa"
                       value="@Model.TuKhoa"
                       class="w-full pl-9 pr-space-md py-2 bg-surface-container-low text-on-surface placeholder:text-outline rounded-lg font-body-sm text-body-sm focus:outline-none focus:bg-surface-container-lowest transition-colors shadow-inner"
                       id="filter-search-input"
                       placeholder="Tên mẫu hoa, loại hoa..."
                       type="text" />

                <span class="material-symbols-outlined absolute left-2.5 top-2.5 text-[18px] text-outline">
                    search
                </span>
            </form>

                <!-- Kiểu sản phẩm (Bó hoa, Giỏ hoa, Hộp hoa, Kệ hoa) -->
                <form method="get"
                      asp-area="User"
                      asp-controller="MauSanPham"
                      asp-action="Index"
                      class="grid grid-cols-2 gap-space-xs">

                    <input type="hidden" name="tuKhoa" value="@Model.TuKhoa" />
                    <input type="hidden" name="maDip" value="@Model.MaDip" />
                    <input type="hidden" name="giaTu" value="@Model.GiaTu" />
                    <input type="hidden" name="giaDen" value="@Model.GiaDen" />
                    <input type="hidden" name="sapXep" value="@Model.SapXep" />
                    <input type="hidden" name="mauSac" value="@(Context.Request.Query["mauSac"].ToString())" />

                    @foreach (var kieu in Model.DanhSachKieu)
                    {
                        <label class="flex items-center gap-space-xs p-2 rounded-lg bg-surface-container-low hover:bg-secondary-container transition-colors cursor-pointer select-none">
                            <input type="radio"
                                   name="kieuSanPham"
                                   value="@kieu.Value"
                                   checked="@(Model.KieuSanPham == kieu.Value)"
                                   class="w-4 h-4 accent-primary cursor-pointer" />

                            <span class="font-body-sm text-body-sm text-on-surface">
                                @kieu.Text
                            </span>
                        </label>
                    }
                </form>

                <!-- Khoảng giá (Dual Range & Quick Chips) -->
                <div class="space-y-space-sm">
                    <div class="flex items-center justify-between">
                        <span class="font-title-sm text-title-sm text-on-surface">Khoảng giá (VND)</span>
                        <span class="font-label-md text-label-md text-primary font-semibold" id="price-range-display">500.000đ - 3.200.000đ</span>
                    </div>
                    <!-- Price Inputs (Min - Max) -->
                    <div class="grid grid-cols-2 gap-space-xs items-center">
                        <div class="relative">
                            <input class="w-full px-2.5 py-1.5 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-lg focus:outline-none text-center shadow-inner" id="min-price-val" name="giaTu" type="number" min="0" step="10000" value="@(Model.GiaTu?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)">
                            <span class="font-label-md text-[10px] text-outline block text-center mt-0.5">Tối thiểu</span>
                        </div>
                        <div class="relative">
                            <input class="w-full px-2.5 py-1.5 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-lg focus:outline-none text-center shadow-inner" id="max-price-val" name="giaDen" type="number" min="0" step="10000" value="@(Model.GiaDen?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty)">
                            <span class="font-label-md text-[10px] text-outline block text-center mt-0.5">Tối đa</span>
                        </div>
                    </div>
                    <!-- Một thanh giá với hai nút kéo tối thiểu/tối đa -->
                    <div id="price-range-track" class="relative h-8 pt-3 pb-2">
                        <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-1.5 rounded-full bg-surface-container"></div>
                        <div id="price-range-selected" class="absolute top-1/2 -translate-y-1/2 h-1.5 rounded-full bg-primary"></div>
                        <input id="min-price-range" type="range" min="0" max="5000000" step="50000"
                               value="@(Model.GiaTu ?? 500000)" aria-label="Giá tối thiểu"
                               class="price-range-thumb absolute inset-0 w-full h-full appearance-none bg-transparent pointer-events-none" />
                        <input id="max-price-range" type="range" min="0" max="5000000" step="50000"
                               value="@(Model.GiaDen ?? 3200000)" aria-label="Giá tối đa"
                               class="price-range-thumb absolute inset-0 w-full h-full appearance-none bg-transparent pointer-events-none" />
                    </div>
                    <style>
                        .price-range-thumb::-webkit-slider-thumb { appearance:none; width:18px; height:18px; border-radius:9999px; background:#914957; cursor:pointer; pointer-events:auto; border:0; }
                        .price-range-thumb::-moz-range-thumb { width:18px; height:18px; border-radius:9999px; background:#914957; cursor:pointer; pointer-events:auto; border:0; }
                        .price-range-thumb::-webkit-slider-runnable-track { background:transparent; }
                        .price-range-thumb::-moz-range-track { background:transparent; }
                        #min-price-range { z-index: 3; }
                        #max-price-range { z-index: 4; }
                    </style>
                    <!-- Quick price chips -->
                    <div class="flex flex-wrap gap-1.5 pt-1">
                        <button data-min="0" data-max="500000" class="price-chip px-2 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md hover:bg-secondary-container transition-colors" type="button">&lt; 500k</button>
                        <button data-min="500000" data-max="1000000" class="price-chip px-2 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md hover:bg-secondary-container transition-colors" type="button">500k - 1tr</button>
                        <button data-min="1000000" data-max="2000000" class="price-chip px-2 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md hover:bg-secondary-container transition-colors" type="button">1tr - 2tr</button>
                        <button data-min="2000000" data-max="" class="price-chip px-2 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md hover:bg-secondary-container transition-colors" type="button">&gt; 2tr</button>
                    </div>
                </div>

                <!-- Tông màu chủ đạo: chọn được trên giao diện -->
                <div class="space-y-space-sm">
                    <div class="flex items-center justify-between">
                        <span class="font-title-sm text-title-sm text-on-surface">Tông màu hoa</span>
                        <span id="selected-color-label" class="font-label-md text-label-md text-outline">Chưa chọn màu</span>
                    </div>
                    <div id="flower-color-options" class="flex items-center justify-between gap-1">
                        <button data-color="Đỏ" aria-label="Đỏ" class="color-swatch w-7 h-7 rounded-full bg-[#8a4853] shadow-sm flex items-center justify-center hover:scale-110 transition-transform" title="Đỏ" type="button"></button>
                        <button data-color="Hồng" aria-label="Hồng" class="color-swatch w-7 h-7 rounded-full bg-[#ffd9dd] shadow-sm flex items-center justify-center hover:scale-110 transition-transform" title="Hồng" type="button"></button>
                        <button data-color="Trắng" aria-label="Trắng" class="color-swatch w-7 h-7 rounded-full bg-[#ffffff] shadow-sm flex items-center justify-center hover:scale-110 transition-transform" title="Trắng" type="button"></button>
                        <button data-color="Vàng" aria-label="Vàng" class="color-swatch w-7 h-7 rounded-full bg-[#fde047] shadow-sm flex items-center justify-center hover:scale-110 transition-transform" title="Vàng" type="button"></button>
                        <button data-color="Tím" aria-label="Tím" class="color-swatch w-7 h-7 rounded-full bg-[#c084fc] shadow-sm flex items-center justify-center hover:scale-110 transition-transform" title="Tím" type="button"></button>
                        <button data-color="Cam" aria-label="Cam" class="color-swatch w-7 h-7 rounded-full bg-[#fb923c] shadow-sm flex items-center justify-center hover:scale-110 transition-transform" title="Cam" type="button"></button>
                        <button data-color="Xanh lam" aria-label="Xanh lam" class="color-swatch w-7 h-7 rounded-full bg-[#abd197] shadow-sm flex items-center justify-center hover:scale-110 transition-transform" title="Xanh lam" type="button"></button>
                    </div>
                    <p id="color-filter-note" class="text-xs text-outline" hidden>Mẫu hoa được lọc theo màu của các loại hoa thành phần.</p>
                </div>

                <!-- Loại hoa thành phần: chưa tạo bộ lọc giả bằng dữ liệu tĩnh.
                     Muốn lọc theo tên hoa cần dùng đúng thuộc tính trong entity HoaTuoi. -->
                <div class="space-y-space-sm">
                    <div class="flex items-center justify-between">
                        <span class="font-title-sm text-title-sm text-on-surface">Loại hoa thành phần</span>
                        <span class="material-symbols-outlined text-[16px] text-outline">info</span>
                    </div>
                    <p class="text-xs text-outline">
                        Danh sách loại hoa cần được lấy từ database để bộ lọc phản ánh đúng dữ liệu thực tế.
                    </p>
                </div>

                <!-- Dịp sử dụng: lấy trực tiếp từ database -->
                <div class="space-y-space-sm">
                    <label for="dip-filter" class="font-title-sm text-title-sm text-on-surface">Dịp trao gửi</label>
                    <select id="dip-filter" name="maDip" class="w-full p-2 rounded-lg bg-surface-container-low text-on-surface font-body-sm" onchange="applyFlowerFilters()">
                        <option value="">Tất cả dịp sử dụng</option>
                        @foreach (var dip in Model.DanhSachDip)
                        {
                            <option value="@dip.Value" selected="@(Model.MaDip?.ToString() == dip.Value)">@dip.Text</option>
                        }
                    </select>
                </div>

                <!-- Sắp xếp kết quả -->
                <div class="space-y-2">
                    <label for="sidebar-sort" class="font-title-sm text-title-sm text-on-surface block">Sắp xếp mẫu hoa</label>
                    <select id="sidebar-sort" name="sapXep"
                            onchange="applyFlowerFilters({ sapXep: this.value })"
                            class="w-full bg-surface-container-low text-on-surface font-title-sm text-title-sm px-3 py-2 rounded-lg focus:outline-none cursor-pointer">
                        <option value="moi-nhat" selected="@(Model.SapXep == "moi-nhat" || string.IsNullOrEmpty(Model.SapXep))">Mẫu hoa mới nhất</option>
                        <option value="gia-tang" selected="@(Model.SapXep == "gia-tang")">Giá: Thấp đến cao</option>
                        <option value="gia-giam" selected="@(Model.SapXep == "gia-giam")">Giá: Cao đến thấp</option>
                        <option value="ten-a-z" selected="@(Model.SapXep == "ten-a-z")">Tên mẫu: A - Z</option>
                        <option value="ten-z-a" selected="@(Model.SapXep == "ten-z-a")">Tên mẫu: Z - A</option>
                    </select>
                </div>

                <!-- Action Buttons -->
                <div class="pt-space-xs flex flex-col gap-space-md">
                    <button id="apply-filter-btn" class="w-full py-2.5 rounded-full bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-all shadow-sm flex items-center justify-center gap-space-xs" type="button" onclick="applyFlowerFilters()">
                        <span class="material-symbols-outlined text-[18px]">filter_alt</span>
                        Áp dụng bộ lọc
                    </button>
                    <button class="w-full py-2 rounded-full bg-secondary-container text-on-secondary-container font-label-lg text-label-lg hover:bg-surface-container transition-colors text-center" id="default-reset-btn" type="button">
                        Đặt lại mặc định
                    </button>
                </div>
            </div>
        </aside>

        <!-- RIGHT PRODUCT SHOWCASE & SORTING AREA -->
        <main class="lg:col-span-8 xl:col-span-9 flex flex-col gap-space-lg">
            <!-- Top Controls: Active Filter Badges & Sort Dropdown -->
            <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-space-md">
                <!-- Bộ lọc đang bật: lấy từ lựa chọn thực tế -->
                <div class="flex flex-wrap items-center gap-space-xs" id="active-filter-tags">
                    <span class="font-label-md text-label-md text-secondary uppercase tracking-wider mr-1">Bộ lọc đang bật:</span>
                    @if (!string.IsNullOrWhiteSpace(Model.TuKhoa))
                    {
                        <span class="px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-body-sm">Từ khóa: @Model.TuKhoa</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.KieuSanPham))
                    {
                        <span class="px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-body-sm">Kiểu: @Model.KieuSanPham</span>
                    }
                    @if (Model.MaDip.HasValue)
                    {
                        var tenDipDangChon = Model.DanhSachDip.FirstOrDefault(d => d.Value == Model.MaDip.Value.ToString())?.Text;
                        <span class="px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-body-sm">Dịp: @tenDipDangChon</span>
                    }
                    @if (Model.GiaTu.HasValue || Model.GiaDen.HasValue)
                    {
                        <span class="px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-body-sm">
                            Giá: @(Model.GiaTu?.ToString("N0") ?? "0")đ - @(Model.GiaDen?.ToString("N0") ?? "Không giới hạn")
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Context.Request.Query["mauSac"].ToString()))
                    {
                        <span class="px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-body-sm">
                            Màu: @Context.Request.Query["mauSac"]
                        </span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.SapXep) && Model.SapXep != "moi-nhat")
                    {
                        <span class="px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-body-sm">
                            Sắp xếp: @Model.SapXep
                        </span>
                    }
                    @if (string.IsNullOrWhiteSpace(Model.TuKhoa) && string.IsNullOrWhiteSpace(Model.KieuSanPham) && !Model.MaDip.HasValue && !Model.GiaTu.HasValue && !Model.GiaDen.HasValue && string.IsNullOrWhiteSpace(Context.Request.Query["mauSac"].ToString()) && (string.IsNullOrWhiteSpace(Model.SapXep) || Model.SapXep == "moi-nhat"))
                    {
                        <span class="text-sm text-secondary">Chưa áp dụng bộ lọc nào</span>
                    }
                    <button class="font-label-md text-label-md text-primary hover:underline ml-1" type="button"
                            onclick="window.location.href=window.location.pathname">Xóa hết</button>
                </div>
            </div>

            <!-- 12-Product Visual Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-gutter">

                @if (Model.DanhSachMau?.DuLieu != null && Model.DanhSachMau.DuLieu.Any())
                {
                    @foreach (var mau in Model.DanhSachMau.DuLieu)
                    {
                        @await Html.PartialAsync(
                            "~/Areas/User/Views/Shared/_ProductCard.cshtml",
                            mau
                        )
                    }
                }
                else
                {
                    <div class="col-span-full text-center py-10">
                        <p class="text-on-surface-variant">
                            Không tìm thấy mẫu hoa phù hợp.
                        </p>
                    </div>
                }

            </div>

            <!-- Pagination Section -->
            <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col sm:flex-row items-center justify-between gap-space-md mt-space-sm">
                <p class="font-body-sm text-body-sm text-on-surface-variant">
                    @if (Model.DanhSachMau.TongSoBanGhi > 0)
                    {
                        var batDau = (Model.DanhSachMau.TrangHienTai - 1) * Model.DanhSachMau.SoBanGhiMoiTrang + 1;
                        var ketThuc = Math.Min(Model.DanhSachMau.TrangHienTai * Model.DanhSachMau.SoBanGhiMoiTrang, Model.DanhSachMau.TongSoBanGhi);

                        <text>
                            Đang hiển thị
                            <span class="font-semibold text-on-surface">@batDau - @ketThuc</span>
                            trong tổng số
                            <span class="font-semibold text-primary">@Model.DanhSachMau.TongSoBanGhi</span>
                            mẫu hoa
                        </text>
                    }
                    else
                    {
                        <text>Không có mẫu hoa phù hợp.</text>
                    }
                </p>

                <nav aria-label="Phân trang danh mục" class="flex items-center gap-1">

                    @if (Model.DanhSachMau.TrangHienTai > 1)
                    {
                        <a asp-area="User"
                           asp-controller="MauSanPham"
                           asp-action="Index"
                           asp-route-page="@(Model.DanhSachMau.TrangHienTai - 1)"
                           asp-route-tuKhoa="@Model.TuKhoa"
                           asp-route-maDip="@Model.MaDip"
                           asp-route-kieuSanPham="@Model.KieuSanPham"
                           asp-route-giaTu="@Model.GiaTu"
                           asp-route-giaDen="@Model.GiaDen"
                           asp-route-sapXep="@Model.SapXep"
                           asp-route-mauSac="@(Context.Request.Query["mauSac"].ToString())"
                           class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-secondary-container font-title-sm">
                            Trước
                        </a>
                    }

                    @for (int i = 1; i <= Model.DanhSachMau.TongSoTrang; i++)
                    {
                        <a asp-area="User"
                           asp-controller="MauSanPham"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-tuKhoa="@Model.TuKhoa"
                           asp-route-maDip="@Model.MaDip"
                           asp-route-kieuSanPham="@Model.KieuSanPham"
                           asp-route-giaTu="@Model.GiaTu"
                           asp-route-giaDen="@Model.GiaDen"
                           asp-route-sapXep="@Model.SapXep"
                           asp-route-mauSac="@(Context.Request.Query["mauSac"].ToString())"
                           class="w-9 h-9 rounded-lg font-title-sm flex items-center justify-center
                                  @(i == Model.DanhSachMau.TrangHienTai ? "bg-primary text-on-primary" : "bg-surface-container hover:bg-secondary-container text-on-surface")">
                            @i
                        </a>
                    }

                    @if (Model.DanhSachMau.TrangHienTai < Model.DanhSachMau.TongSoTrang)
                    {
                        <a asp-area="User"
                           asp-controller="MauSanPham"
                           asp-action="Index"
                           asp-route-page="@(Model.DanhSachMau.TrangHienTai + 1)"
                           asp-route-tuKhoa="@Model.TuKhoa"
                           asp-route-maDip="@Model.MaDip"
                           asp-route-kieuSanPham="@Model.KieuSanPham"
                           asp-route-giaTu="@Model.GiaTu"
                           asp-route-giaDen="@Model.GiaDen"
                           asp-route-sapXep="@Model.SapXep"
                           asp-route-mauSac="@(Context.Request.Query["mauSac"].ToString())"
                           class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-secondary-container font-title-sm">
                            Tiếp theo
                        </a>
                    }

                </nav>
            </div>

            <!-- Bespoke Floral Service Callout Card -->
            <div class="rounded-xl bg-gradient-to-r from-secondary-container via-surface-container to-surface-container-low p-space-lg flex flex-col md:flex-row items-center justify-between gap-space-lg shadow-sm">
                <div class="flex items-center gap-space-md">
                    <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0 text-primary">
                        <span class="material-symbols-outlined text-[32px]">palette</span>
                    </div>
                    <div>
                        <span class="font-label-md text-label-md text-primary font-bold uppercase tracking-wider">Dịch vụ cá nhân hóa • Bespoke Atelier</span>
                        <h4 class="font-headline-sm text-headline-sm text-on-surface mt-0.5">Bạn chưa tìm thấy mẫu hoa ưng ý?</h4>
                        <p class="font-body-sm text-body-sm text-on-surface-variant max-w-lg mt-1">Florist của chúng tôi sẽ thiết kế riêng theo màu sắc, loài hoa và ngân sách chính xác theo yêu cầu cảm xúc của bạn.</p>
                    </div>
                </div>
                <a class="px-space-lg py-2.5 rounded-full bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-colors shadow-sm flex items-center gap-space-xs whitespace-nowrap" asp-controller="Home" asp-action="CustomDesign">
                    <span class="material-symbols-outlined text-[18px]">draw</span>
                    <span class="">Đặt thiết kế riêng</span>
                </a>
            </div>
        </main>
    </div>
</section>

@section Scripts {
    <script>
        function applyFlowerFilters(overrides = {}) {
            const params = new URLSearchParams(window.location.search);
            const search = document.getElementById('filter-search-input');
            const minInput = document.getElementById('min-price-val');
            const maxInput = document.getElementById('max-price-val');
            const typeInput = document.querySelector('input[name="kieuSanPham"]:checked');
            const dipInput = document.getElementById('dip-filter');
            const sortInput = document.querySelector('select[name="sapXep"]');

            const values = {
                tuKhoa: search ? search.value.trim() : '',
                giaTu: minInput ? minInput.value : '',
                giaDen: maxInput ? maxInput.value : '',
                kieuSanPham: typeInput ? typeInput.value : '',
                maDip: dipInput ? dipInput.value : '',
                sapXep: sortInput ? sortInput.value : (params.get('sapXep') || 'moi-nhat'),
                mauSac: params.get('mauSac') || '',
                page: '1'
            };
            Object.assign(values, overrides);
            for (const [key, value] of Object.entries(values)) {
                if (value === null || value === undefined || String(value).trim() === '') params.delete(key);
                else params.set(key, value);
            }
            window.location.assign(window.location.pathname + (params.toString() ? '?' + params.toString() : ''));
        }

        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('filter-search-input');
            const minInput = document.getElementById('min-price-val');
            const maxInput = document.getElementById('max-price-val');
            const minRange = document.getElementById('min-price-range');
            const maxRange = document.getElementById('max-price-range');
            const dipInput = document.getElementById('dip-filter');
            const resetButtons = [document.getElementById('reset-all-btn'), document.getElementById('default-reset-btn')];
            let searchTimer;

            // Tự tìm kiếm sau khi người dùng ngừng gõ một chút.
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    clearTimeout(searchTimer);
                    searchTimer = setTimeout(() => applyFlowerFilters(), 450);
                });
                searchInput.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') { e.preventDefault(); clearTimeout(searchTimer); applyFlowerFilters(); }
                });
            }

            // Khi thay đổi khoảng giá hoặc dịp sử dụng, tải kết quả ngay.
            [minInput, maxInput].forEach(el => {
                if (el) {
                    el.addEventListener('keydown', e => {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            applyFlowerFilters();
                        }
                    });
                }
            });

            if (dipInput) {
                dipInput.addEventListener('change', () => applyFlowerFilters());
            }

            // Các lựa chọn kiểu sản phẩm tự cập nhật kết quả.
            document.querySelectorAll('input[name="kieuSanPham"]').forEach(el => {
                el.addEventListener('change', () => applyFlowerFilters({ kieuSanPham: el.value }));
            });

            // Đồng bộ thanh kéo giá với ô nhập số.
            function formatVnd(value) {
                return Number(value || 0).toLocaleString('vi-VN') + 'đ';
            }
            function syncPriceFromRanges(changedRange) {
                if (!minRange || !maxRange || !minInput || !maxInput) return;
                let minValue = Number(minRange.value);
                let maxValue = Number(maxRange.value);
                if (minValue > maxValue) {
                    if (changedRange === minRange) {
                        maxValue = minValue;
                        maxRange.value = String(maxValue);
                    } else {
                        minValue = maxValue;
                        minRange.value = String(minValue);
                    }
                }
                minInput.value = String(minValue);
                maxInput.value = String(maxValue);
                const display = document.getElementById('price-range-display');
                if (display) display.textContent = formatVnd(minValue) + ' - ' + formatVnd(maxValue);
                const selectedTrack = document.getElementById('price-range-selected');
                if (selectedTrack) {
                    const left = (minValue / 5000000) * 100;
                    const right = (maxValue / 5000000) * 100;
                    selectedTrack.style.left = left + '%';
                    selectedTrack.style.width = Math.max(0, right - left) + '%';
                }
            }
            function syncRangesFromInputs() {
                if (minRange && minInput && minInput.value !== '') minRange.value = String(Math.min(5000000, Math.max(0, Number(minInput.value))));
                if (maxRange && maxInput && maxInput.value !== '') maxRange.value = String(Math.min(5000000, Math.max(0, Number(maxInput.value))));
                if (minRange && maxRange) syncPriceFromRanges(null);
            }
            [minRange, maxRange].forEach(range => {
                if (!range) return;
                range.addEventListener('input', () => syncPriceFromRanges(range));
                range.addEventListener('change', () => {
                    syncPriceFromRanges(range);
                    applyFlowerFilters();
                });
            });
            [minInput, maxInput].forEach(input => {
                if (input) input.addEventListener('input', syncRangesFromInputs);
            });

            // Chọn tông màu: giữ trạng thái trên URL và lọc từ database.
            const colorLabel = document.getElementById('selected-color-label');
            const colorNote = document.getElementById('color-filter-note');
            const colorSwatches = Array.from(document.querySelectorAll('.color-swatch'));

            function setSelectedColor(color) {
                colorSwatches.forEach(swatch => {
                    const selected = swatch.dataset.color === color;
                    swatch.classList.toggle('ring-2', selected);
                    swatch.classList.toggle('ring-primary', selected);
                    swatch.classList.toggle('scale-110', selected);
                    swatch.innerHTML = selected
                        ? '<span class="material-symbols-outlined text-[16px] text-primary">check</span>'
                        : '';
                });
                if (colorLabel) colorLabel.textContent = color ? 'Đã chọn: ' + color : 'Chưa chọn màu';
                if (colorNote) colorNote.hidden = !color;
            }

            const currentColor = new URLSearchParams(window.location.search).get('mauSac') || '';
            setSelectedColor(currentColor);

            colorSwatches.forEach(button => {
                button.addEventListener('click', function () {
                    const selectedColor = new URLSearchParams(window.location.search).get('mauSac') || '';
                    // Nhấn lại màu đang chọn sẽ bỏ lọc màu.
                    const nextColor = selectedColor === this.dataset.color ? '' : this.dataset.color;
                    applyFlowerFilters({ mauSac: nextColor });
                });
            });

            // Chọn khoảng giá nhanh.
            document.querySelectorAll('.price-chip').forEach(button => {
                button.addEventListener('click', function () {
                    if (minInput) minInput.value = this.dataset.min || '';
                    if (maxInput) maxInput.value = this.dataset.max || '';
                    if (minRange) minRange.value = this.dataset.min || '0';
                    if (maxRange) maxRange.value = this.dataset.max || '5000000';
                    applyFlowerFilters({ giaTu: this.dataset.min || '', giaDen: this.dataset.max || '' });
                });
            });

            // Xóa toàn bộ bộ lọc, trở về danh sách mặc định.
            resetButtons.forEach(button => {
                if (button) button.addEventListener('click', function () {
                    window.location.href = window.location.pathname;
                });
            });
        });
    </script>
}
