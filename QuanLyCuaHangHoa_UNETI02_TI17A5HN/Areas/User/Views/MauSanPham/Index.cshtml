@{
    ViewData["Title"] = "Tất cả mẫu hoa - Web quản lý hoa tươi";
}

<!-- Top Breadcrumb & Page Banner Area -->
<section class="w-full bg-surface-container-low py-space-md">
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop">
        <!-- Breadcrumb -->
        @* <nav aria-label="Breadcrumb" class="flex items-center gap-space-xs text-secondary font-label-md text-label-md uppercase tracking-wider mb-space-sm">
            <a class="hover:text-primary transition-colors flex items-center gap-1" asp-controller="Home" asp-action="Index">
                <span class="material-symbols-outlined text-[16px]">home</span>
                Trang chủ
            </a>
            <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
            <a class="hover:text-primary transition-colors" asp-controller="Home" asp-action="Products">Danh mục</a>
            <span class="material-symbols-outlined text-[14px] text-outline-variant">chevron_right</span>
            <span class="text-primary font-semibold">Tất cả mẫu hoa</span>
        </nav> *@
        <!-- Page Editorial Headline -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
            <div class="space-y-space-xs max-w-2xl">
               
                <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Tất cả mẫu hoa thiết kế</h1>
                <p class="font-body-md text-body-md text-on-surface-variant">Tuyển tập những tác phẩm hoa nghệ thuật được kết nối tỉ mỉ bởi các nghệ nhân Web quản lý hoa tươi. Mỗi sắc thái và kiểu dáng đều mang một thông điệp tình cảm tinh tế.</p>
            </div>
            <div class="flex items-center gap-space-xs bg-surface-container px-space-md py-space-sm rounded-full self-start md:self-auto shadow-sm">
                <span class="w-2.5 h-2.5 rounded-full bg-tertiary animate-pulse"></span>
                <span class="font-label-lg text-label-lg text-on-surface">Hiển thị <span class="text-primary font-bold">36</span> mẫu hoa tinh tuyển</span>
            </div>
        </div>
    </div>
</section>

<!-- Main Content Layout (Sidebar Filter & Product Showcase) -->
<section class="max-w-7xl mx-auto w-full px-margin-mobile md:px-margin lg:px-margin-desktop py-space-xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-start">
        <!-- LEFT SIDEBAR FILTER (Sticky) -->
        <aside class="lg:col-span-4 xl:col-span-3">
            <div class="sticky top-28 bg-surface-container-lowest rounded-xl p-space-lg shadow-sm space-y-space-lg">
                <!-- Filter Header & Reset -->
                <div class="flex items-center justify-between pb-space-xs">
                    <div class="flex items-center gap-space-xs">
                        <span class="material-symbols-outlined text-primary text-[20px]">tune</span>
                        <h3 class="font-title-md text-title-md text-on-surface">Bộ lọc nâng cao</h3>
                    </div>
                    <button class="font-label-sm text-label-md text-secondary hover:text-primary transition-colors uppercase tracking-wider flex items-center gap-1" id="reset-all-btn" type="button">
                        <span class="material-symbols-outlined text-[13px]">refresh</span>
                        Xóa tất cả
                    </button>
                </div>

                <!-- Keyword Search -->
                <div class="space-y-space-xs">
                    <label class="font-title-sm text-title-sm text-on-surface block" for="filter-search-input">Từ khóa tìm kiếm</label>
                    <div class="relative">
                        <input class="w-full pl-9 pr-space-md py-2 bg-surface-container-low text-on-surface placeholder:text-outline rounded-lg font-body-sm text-body-sm focus:outline-none focus:bg-surface-container-lowest transition-colors shadow-inner" id="filter-search-input" placeholder="Tên hoa, loại hoa (Ohara, Tulip...)" type="text" value="Hoa hồng Ohara">
                        <span class="material-symbols-outlined absolute left-2.5 top-2.5 text-[18px] text-outline">search</span>
                    </div>
                </div>

                <!-- Kiểu sản phẩm (Bó hoa, Giỏ hoa, Hộp hoa, Kệ hoa) -->
                <div class="space-y-space-sm">
                    <div class="flex items-center justify-between">
                        <span class="font-title-sm text-title-sm text-on-surface">Kiểu sản phẩm</span>
                        <span class="font-label-md text-label-md text-primary font-semibold">4 kiểu</span>
                    </div>
                    <div class="grid grid-cols-2 gap-space-xs">
                        <label class="flex items-center gap-space-xs p-2 rounded-lg bg-surface-container-low hover:bg-secondary-container transition-colors cursor-pointer select-none">
                            <input checked="" class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm text-on-surface">Bó hoa</span>
                            <span class="text-outline font-label-md ml-auto text-[11px]">(18)</span>
                        </label>
                        <label class="flex items-center gap-space-xs p-2 rounded-lg bg-surface-container-low hover:bg-secondary-container transition-colors cursor-pointer select-none">
                            <input checked="" class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm text-on-surface">Giỏ hoa</span>
                            <span class="text-outline font-label-md ml-auto text-[11px]">(9)</span>
                        </label>
                        <label class="flex items-center gap-space-xs p-2 rounded-lg bg-surface-container-low hover:bg-secondary-container transition-colors cursor-pointer select-none">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm text-on-surface">Hộp hoa</span>
                            <span class="text-outline font-label-md ml-auto text-[11px]">(5)</span>
                        </label>
                        <label class="flex items-center gap-space-xs p-2 rounded-lg bg-surface-container-low hover:bg-secondary-container transition-colors cursor-pointer select-none">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm text-on-surface">Kệ hoa</span>
                            <span class="text-outline font-label-md ml-auto text-[11px]">(4)</span>
                        </label>
                    </div>
                </div>

                <!-- Khoảng giá (Dual Range & Quick Chips) -->
                <div class="space-y-space-sm">
                    <div class="flex items-center justify-between">
                        <span class="font-title-sm text-title-sm text-on-surface">Khoảng giá (VND)</span>
                        <span class="font-label-md text-label-md text-primary font-semibold" id="price-range-display">500.000đ - 3.200.000đ</span>
                    </div>
                    <!-- Price Inputs (Min - Max) -->
                    <div class="grid grid-cols-2 gap-space-xs items-center">
                        <div class="relative">
                            <input class="w-full px-2.5 py-1.5 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-lg focus:outline-none text-center shadow-inner" id="min-price-val" type="text" value="500.000">
                            <span class="font-label-md text-[10px] text-outline block text-center mt-0.5">Tối thiểu</span>
                        </div>
                        <div class="relative">
                            <input class="w-full px-2.5 py-1.5 bg-surface-container-low text-on-surface font-body-sm text-body-sm rounded-lg focus:outline-none text-center shadow-inner" id="max-price-val" type="text" value="3.200.000">
                            <span class="font-label-md text-[10px] text-outline block text-center mt-0.5">Tối đa</span>
                        </div>
                    </div>
                    <!-- Dual Slider Simulation -->
                    <div class="relative pt-2 pb-1">
                        <div class="h-1.5 w-full bg-surface-container rounded-full relative">
                            <div class="absolute h-1.5 bg-primary rounded-full left-[10%] right-[30%]"></div>
                            <div class="absolute w-4 h-4 bg-primary shadow-sm rounded-full top-1/2 -translate-y-1/2 left-[10%] cursor-pointer hover:scale-110 transition-transform"></div>
                            <div class="absolute w-4 h-4 bg-primary shadow-sm rounded-full top-1/2 -translate-y-1/2 right-[30%] cursor-pointer hover:scale-110 transition-transform"></div>
                        </div>
                    </div>
                    <!-- Quick price chips -->
                    <div class="flex flex-wrap gap-1.5 pt-1">
                        <button class="px-2 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md hover:bg-secondary-container transition-colors" type="button">&lt; 500k</button>
                        <button class="px-2 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md font-semibold" type="button">500k - 1tr</button>
                        <button class="px-2 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md font-semibold" type="button">1tr - 2tr</button>
                        <button class="px-2 py-1 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md hover:bg-secondary-container transition-colors" type="button">&gt; 2tr</button>
                    </div>
                </div>

                <!-- Tông màu chủ đạo (Color Swatches) -->
                <div class="space-y-space-sm">
                    <div class="flex items-center justify-between">
                        <span class="font-title-sm text-title-sm text-on-surface">Tông màu hoa</span>
                        <span class="font-label-md text-label-md text-outline">Đã chọn: Hồng</span>
                    </div>
                    <div class="flex items-center justify-between gap-1">
                        <button class="w-7 h-7 rounded-full bg-[#8a4853] shadow-sm flex items-center justify-center hover:scale-110 transition-transform" title="Đỏ nhung" type="button"></button>
                        <button class="w-7 h-7 rounded-full bg-[#ffd9dd] shadow-sm flex items-center justify-center scale-110 shadow-md" title="Hồng phấn" type="button">
                            <span class="material-symbols-outlined text-[16px] text-primary">check</span>
                        </button>
                        <button class="w-7 h-7 rounded-full bg-[#ffffff] shadow-sm flex items-center justify-center hover:scale-110 transition-transform" title="Trắng tinh khôi" type="button"></button>
                        <button class="w-7 h-7 rounded-full bg-[#fde047] shadow-sm flex items-center justify-center hover:scale-110 transition-transform" title="Vàng ấm" type="button"></button>
                        <button class="w-7 h-7 rounded-full bg-[#c084fc] shadow-sm flex items-center justify-center hover:scale-110 transition-transform" title="Tím mộng mơ" type="button"></button>
                        <button class="w-7 h-7 rounded-full bg-[#fb923c] shadow-sm flex items-center justify-center hover:scale-110 transition-transform" title="Cam hoàng hôn" type="button"></button>
                        <button class="w-7 h-7 rounded-full bg-[#abd197] shadow-sm flex items-center justify-center hover:scale-110 transition-transform" title="Xanh pastel" type="button"></button>
                    </div>
                </div>

                <!-- Loại hoa (Checkboxes) -->
                <div class="space-y-space-sm">
                    <div class="flex items-center justify-between">
                        <span class="font-title-sm text-title-sm text-on-surface">Loại hoa nghệ thuật</span>
                        <span class="material-symbols-outlined text-[16px] text-outline">expand_less</span>
                    </div>
                    <div class="max-h-48 overflow-y-auto space-y-space-xs pr-1">
                        <label class="flex items-center gap-space-xs text-on-surface hover:text-primary transition-colors cursor-pointer select-none">
                            <input checked="" class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm flex-1">Hoa hồng (Ohara, Ecuador)</span>
                            <span class="text-outline font-label-md text-[11px]">(24)</span>
                        </label>
                        <label class="flex items-center gap-space-xs text-on-surface hover:text-primary transition-colors cursor-pointer select-none">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm flex-1">Hoa Tulip Hà Lan</span>
                            <span class="text-outline font-label-md text-[11px]">(8)</span>
                        </label>
                        <label class="flex items-center gap-space-xs text-on-surface hover:text-primary transition-colors cursor-pointer select-none">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm flex-1">Hoa Hướng dương</span>
                            <span class="text-outline font-label-md text-[11px]">(7)</span>
                        </label>
                        <label class="flex items-center gap-space-xs text-on-surface hover:text-primary transition-colors cursor-pointer select-none">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm flex-1">Mẫu đơn nhập khẩu</span>
                            <span class="text-outline font-label-md text-[11px]">(5)</span>
                        </label>
                        <label class="flex items-center gap-space-xs text-on-surface hover:text-primary transition-colors cursor-pointer select-none">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm flex-1">Hoa Ly kép thơm</span>
                            <span class="text-outline font-label-md text-[11px]">(6)</span>
                        </label>
                        <label class="flex items-center gap-space-xs text-on-surface hover:text-primary transition-colors cursor-pointer select-none">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm flex-1">Hoa Cẩm chướng</span>
                            <span class="text-outline font-label-md text-[11px]">(11)</span>
                        </label>
                        <label class="flex items-center gap-space-xs text-on-surface hover:text-primary transition-colors cursor-pointer select-none">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm flex-1">Hoa Baby trắng</span>
                            <span class="text-outline font-label-md text-[11px]">(9)</span>
                        </label>
                        <label class="flex items-center gap-space-xs text-on-surface hover:text-primary transition-colors cursor-pointer select-none">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm flex-1">Cúc Tana &amp; Họa mi</span>
                            <span class="text-outline font-label-md text-[11px]">(4)</span>
                        </label>
                    </div>
                </div>

                <!-- Dịp sử dụng (Checkboxes) -->
                <div class="space-y-space-sm">
                    <div class="flex items-center justify-between">
                        <span class="font-title-sm text-title-sm text-on-surface">Dịp trao gửi</span>
                        <span class="material-symbols-outlined text-[16px] text-outline">expand_less</span>
                    </div>
                    <div class="space-y-space-xs">
                        <label class="flex items-center gap-space-xs text-on-surface hover:text-primary transition-colors cursor-pointer select-none">
                            <input checked="" class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm flex-1">Sinh nhật lãng mạn</span>
                            <span class="text-outline font-label-md text-[11px]">(19)</span>
                        </label>
                        <label class="flex items-center gap-space-xs text-on-surface hover:text-primary transition-colors cursor-pointer select-none">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm flex-1">Kỷ niệm ngày cưới &amp; Yêu</span>
                            <span class="text-outline font-label-md text-[11px]">(12)</span>
                        </label>
                        <label class="flex items-center gap-space-xs text-on-surface hover:text-primary transition-colors cursor-pointer select-none">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm flex-1">Khai trương &amp; Hồng phát</span>
                            <span class="text-outline font-label-md text-[11px]">(7)</span>
                        </label>
                        <label class="flex items-center gap-space-xs text-on-surface hover:text-primary transition-colors cursor-pointer select-none">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm flex-1">Chúc mừng &amp; Tốt nghiệp</span>
                            <span class="text-outline font-label-md text-[11px]">(8)</span>
                        </label>
                        <label class="flex items-center gap-space-xs text-on-surface hover:text-primary transition-colors cursor-pointer select-none">
                            <input class="w-4 h-4 rounded text-primary focus:ring-0 accent-primary cursor-pointer" type="checkbox">
                            <span class="font-body-sm text-body-sm flex-1">Chia buồn &amp; Tưởng nhớ</span>
                            <span class="text-outline font-label-md text-[11px]">(3)</span>
                        </label>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="pt-space-xs flex flex-col gap-space-md">
                    <button class="w-full py-2.5 rounded-full bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-all shadow-sm flex items-center justify-center gap-space-xs" type="button">
                        <span class="material-symbols-outlined text-[18px]">filter_alt</span>
                        Áp dụng bộ lọc
                    </button>
                    <button class="w-full py-2 rounded-full bg-secondary-container text-on-secondary-container font-label-lg text-label-lg hover:bg-surface-container transition-colors text-center" id="default-reset-btn" type="button">
                        Đặt lại mặc định
                    </button>
                </div>
            </div>
        </aside>

        <!-- RIGHT PRODUCT SHOWCASE & SORTING AREA -->
        <main class="lg:col-span-8 xl:col-span-9 flex flex-col gap-space-lg">
            <!-- Top Controls: Active Filter Badges & Sort Dropdown -->
            <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-space-md">
                <!-- Active Tags -->
                <div class="flex flex-wrap items-center gap-space-xs">
                    <span class="font-label-md text-label-md text-secondary uppercase tracking-wider mr-1">Bộ lọc đang bật:</span>
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-body-sm text-body-sm">
                        Hoa hồng Ohara
                        <button class="hover:text-primary" type="button"><span class="material-symbols-outlined text-[14px]">close</span></button>
                    </span>
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-body-sm text-body-sm">
                        Kiểu: Bó hoa &amp; Giỏ hoa
                        <button class="hover:text-primary" type="button"><span class="material-symbols-outlined text-[14px]">close</span></button>
                    </span>
                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-body-sm text-body-sm">
                        Tông màu: Hồng
                        <button class="hover:text-primary" type="button"><span class="material-symbols-outlined text-[14px]">close</span></button>
                    </span>
                    <button class="font-label-md text-label-md text-primary hover:underline ml-1" type="button">Xóa hết (3)</button>
                </div>
                <!-- Sort Select -->
                <div class="flex items-center gap-space-xs flex-shrink-0">
                    <span class="font-body-sm text-body-sm text-secondary whitespace-nowrap">Sắp xếp:</span>
                    <div class="relative">
                        <select class="appearance-none bg-surface-container-low text-on-surface font-title-sm text-title-sm pl-space-md pr-9 py-2 rounded-lg focus:outline-none cursor-pointer">
                            <option selected="" value="featured">Mẫu hoa mới nhất</option>
                            <option value="price-asc">Giá: Thấp đến cao</option>
                            <option value="price-desc">Giá: Cao đến thấp</option>
                            <option value="rating">Đánh giá cao nhất</option>
                            <option value="alpha-asc">Tên mẫu: A - Z</option>
                            <option value="alpha-desc">Tên mẫu: Z - A</option>
                        </select>
                        <span class="material-symbols-outlined pointer-events-none absolute right-2.5 top-2.5 text-[18px] text-outline">expand_more</span>
                    </div>
                </div>
            </div>

            <!-- 12-Product Visual Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-gutter">
                <!-- Product Card 1 -->
                <div class="group bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 flex flex-col">
                    <div class="relative w-full aspect-[4/5] overflow-hidden bg-surface-container">
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Rosée Éternelle • Bó Hồng Ohara Pháp" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD1GKKM3aqw3OEtcXe6XNg5MhfglJPjxM-DpK14RLcH5pQg_y0AoVcm1jJbdSH19xoXZzDCy5i8cTHCGhfNm07EcBNZYxGbCcxhYY3J1nG0509DQcMLrCD1fkIie6wQPkB2HhOYSVTcGGrV4okKZHwQb9Ex1lwre7S6-_Dr1wOzuJm00mBS8LpYEFuJGTGOSWC0b28PLGokNl0_-JyBnE0Npqzyz1l_BxfbAcTe6HP9HS0p-VSy09tdSA">
                        <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md uppercase tracking-wider font-semibold">Bó hoa</span>
                        <span class="absolute top-3 right-3 px-2 py-0.5 rounded-full bg-primary text-on-primary font-label-md text-[11px] tracking-wide font-medium">Bán chạy</span>
                        <button aria-label="Lưu vào yêu thích" class="absolute bottom-3 right-3 w-9 h-9 rounded-full bg-surface-container-lowest/90 text-on-surface-variant hover:text-primary flex items-center justify-center transition-colors shadow-sm" type="button">
                            <span class="material-symbols-outlined text-[20px]">favorite</span>
                        </button>
                    </div>
                    <div class="p-space-md flex flex-col flex-1 justify-between gap-space-sm">
                        <div class="space-y-1">
                            <div class="flex items-center gap-1 text-[#d99a4e]">
                                <span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">star</span>
                                <span class="font-label-md text-label-md font-bold text-on-surface">4.9</span>
                                <span class="font-body-sm text-body-sm text-outline">(84 đánh giá)</span>
                            </div>
                            <h3 class="font-title-md text-title-md text-on-surface group-hover:text-primary transition-colors line-clamp-1">Rosée Éternelle • Bó Hồng Ohara Pháp</h3>
                            <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2">Hồng Ohara nhập khẩu hương thơm dịu ngọt, phối cùng thạch thảo và lá bạc cao cấp.</p>
                        </div>
                        <div class="pt-space-xs flex items-center justify-between border-t-0">
                            <div>
                                <span class="font-label-md text-[11px] text-outline block uppercase">Giá chính thức</span>
                                <span class="font-headline-sm text-headline-sm text-primary font-bold">1.450.000₫</span>
