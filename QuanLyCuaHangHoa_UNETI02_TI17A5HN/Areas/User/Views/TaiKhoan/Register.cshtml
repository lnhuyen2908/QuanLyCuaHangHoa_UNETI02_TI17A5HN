</div>

@section Scripts {
    <script>
        function togglePasswordVisibility(fieldId, btn) {
            const field = document.getElementById(fieldId);
            const icon = btn.querySelector('.material-symbols-outlined');
            if (field.type === 'password') {
                field.type = 'text';
                icon.textContent = 'visibility_off';
            } else {
                field.type = 'password';
                icon.textContent = 'visibility';
            }
        }

        function evaluatePasswordStrength(val) {
            const b1 = document.getElementById('bar1');
            const b2 = document.getElementById('bar2');
            const b3 = document.getElementById('bar3');
            const b4 = document.getElementById('bar4');
            const text = document.getElementById('strengthText');
            const feedback = document.getElementById('passwordFeedback');

            [b1, b2, b3, b4].forEach(b => {
                b.className = 'h-full rounded-full bg-outline-variant transition-colors';
            });

            if (!val) {
                text.textContent = 'Chưa nhập';
                text.className = 'font-title-sm text-outline';
                feedback.textContent = 'Gợi ý: Kết hợp chữ hoa, chữ thường, số và ký tự đặc biệt.';
                return;
            }

            let score = 0;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            if (score === 1) {
                b1.className = 'h-full rounded-full bg-error transition-colors';
                text.textContent = 'Yếu';
                text.className = 'font-title-sm text-error';
                feedback.textContent = 'Mật khẩu còn đơn giản. Hãy thêm chữ cái viết hoa và con số.';
            } else if (score === 2) {
                b1.className = 'h-full rounded-full bg-amber-500 transition-colors';
                b2.className = 'h-full rounded-full bg-amber-500 transition-colors';
                text.textContent = 'Trung bình';
                text.className = 'font-title-sm text-amber-600';
                feedback.textContent = 'Khá tốt. Thêm ký tự đặc biệt như (!, @@, #, $) để an toàn tối đa.';
            } else if (score === 3) {
                b1.className = 'h-full rounded-full bg-tertiary transition-colors';
                b2.className = 'h-full rounded-full bg-tertiary transition-colors';
                b3.className = 'h-full rounded-full bg-tertiary transition-colors';
                text.textContent = 'Mạnh';
                text.className = 'font-title-sm text-tertiary';
                feedback.textContent = 'Mật khẩu mạnh mẽ và an toàn.';
            } else if (score === 4) {
                b1.className = 'h-full rounded-full bg-tertiary transition-colors';
                b2.className = 'h-full rounded-full bg-tertiary transition-colors';
                b3.className = 'h-full rounded-full bg-tertiary transition-colors';
                b4.className = 'h-full rounded-full bg-tertiary transition-colors';
                text.textContent = 'Rất bảo mật';
                text.className = 'font-title-sm text-tertiary font-bold';
                feedback.textContent = 'Mật khẩu đạt độ bảo mật tối ưu tiêu chuẩn hội viên!';
            }
        }

        function checkPasswordMatch() {
            const pwd = document.getElementById('password').value;
            const confirmPwd = document.getElementById('confirmPassword').value;
            const confirmInput = document.getElementById('confirmPassword');
            if (confirmPwd && pwd !== confirmPwd) {
                confirmInput.classList.add('ring-2', 'ring-error');
            } else {
                confirmInput.classList.remove('ring-2', 'ring-error');
            }
        }

        function handleRegistration() {
            const pwd = document.getElementById('password').value;
            const confirmPwd = document.getElementById('confirmPassword').value;
            const name = document.getElementById('fullName').value;

            if (pwd !== confirmPwd) {
                alert('Mật khẩu xác nhận không trùng khớp. Vui lòng kiểm tra lại!');
                return;
            }

            alert('Chào mừng ' + name + ' gia nhập Web quản lý hoa tươi! Mã voucher 100.000₫ chào mừng đã được gửi tới số điện thoại và email của bạn.');
        }
    </script>
}
