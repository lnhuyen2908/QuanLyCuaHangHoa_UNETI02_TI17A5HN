            </div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-surface-container-lowest flex items-center justify-center text-primary flex-shrink-0 shadow-sm">
                    <span class="material-symbols-outlined text-[20px]">local_shipping</span>
                </div>
                <div>
                    <h3 class="font-title-sm text-title-sm text-on-surface">Giao hỏa tốc 2H</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">Bảo quản xe lạnh chuyên dụng</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-surface-container-lowest flex items-center justify-center text-secondary flex-shrink-0 shadow-sm">
                    <span class="material-symbols-outlined text-[20px]">support_agent</span>
                </div>
                <div>
                    <h3 class="font-title-sm text-title-sm text-on-surface">Tư vấn viên 24/7</h3>
