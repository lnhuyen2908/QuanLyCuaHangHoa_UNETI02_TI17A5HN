                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-12 text-secondary space-y-2">
                                <span class="material-symbols-outlined text-[48px] text-outline">palette</span>
                                <p class="font-body-md">Quý khách chưa có yêu cầu thiết kế hoa riêng nào.</p>
                                <a href="/User/CustomDesign"
                                   class="inline-block mt-2 px-6 py-2 rounded-full bg-primary text-on-primary font-title-sm text-sm">
                                    Gửi yêu cầu thiết kế riêng
                                </a>
                            </div>
                        }
                    </section>
                </div>

                <!-- TAB 4: SỔ ĐỊA CHỈ NHẬN HOA -->
                <div id="tab-addresses" class="profile-tab-content space-y-space-xl hidden">
                    <section class="bg-surface-container-lowest rounded-xl p-space-lg md:p-space-xl shadow-sm space-y-space-lg">

                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-xs">
                            <div>
                                <h2 class="font-headline-md text-headline-md text-on-surface">Sổ Địa Chỉ Nhận Hoa Thân Thiết</h2>
                                <p class="font-body-sm text-body-sm text-secondary">Các địa chỉ đã được lưu trong hồ sơ và trong lịch sử các đơn hoa của bạn.</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">

                            <!-- Address Card 1: Default -->
                            <div class="p-space-lg rounded-xl bg-surface-container-low relative space-y-space-sm flex flex-col justify-between border border-primary/20">
                                <div>
                                    <div class="flex items-center justify-between mb-space-xs">
                                        <span class="px-2.5 py-0.5 rounded-full bg-primary text-on-primary font-label-md text-label-md font-semibold uppercase tracking-wider">
                                            Địa chỉ chính trong hồ sơ
                                        </span>
                                    </div>
                                    <h3 class="font-title-md text-title-md text-on-surface font-semibold">@Model.HoTen</h3>
                                    <p class="font-body-sm text-body-sm text-secondary font-medium">@Model.SoDienThoai</p>
                                    <p class="font-body-md text-body-md text-on-surface-variant pt-2 leading-relaxed">
                                        @(string.IsNullOrEmpty(Model.DiaChi) ? "Chưa cập nhật địa chỉ mặc định trong thông tin cá nhân." : Model.DiaChi)
                                    </p>
                                </div>
                                <div class="pt-space-sm mt-space-sm bg-surface-container rounded-lg p-space-xs text-secondary font-body-sm text-body-sm flex items-start gap-1.5">
                                    <span class="material-symbols-outlined text-[16px] text-primary flex-shrink-0 mt-0.5">home</span>
                                    <span>Địa chỉ mặc định dùng khi đặt hàng nhanh.</span>
                                </div>
                            </div>

                            @{
                                var diaChiKhac = Model.DanhSachDonHang
                                    .Where(d => !string.IsNullOrEmpty(d.DiaChiGiao) && d.DiaChiGiao != Model.DiaChi)
                                    .GroupBy(d => d.DiaChiGiao)
                                    .Select(g => g.First())
                                    .Take(3)
                                    .ToList();
                            }

                            @foreach (var donDiaChi in diaChiKhac)
                            {
                                <div class="p-space-lg rounded-xl bg-surface-container-low relative space-y-space-sm flex flex-col justify-between">
                                    <div>
                                        <div class="flex items-center justify-between mb-space-xs">
                                            <span class="px-2.5 py-0.5 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-md text-label-md font-semibold uppercase tracking-wider">
                                                Đã giao trong đơn #ORD-@donDiaChi.MaDon.ToString("D4")
                                            </span>
                                        </div>
                                        <h3 class="font-title-md text-title-md text-on-surface font-semibold">@donDiaChi.NguoiNhan</h3>
                                        <p class="font-body-sm text-body-sm text-secondary font-medium">@donDiaChi.SoDienThoaiNguoiNhan</p>
                                        <p class="font-body-md text-body-md text-on-surface-variant pt-2 leading-relaxed">
                                            @donDiaChi.DiaChiGiao
                                        </p>
                                    </div>
                                    <div class="pt-space-sm mt-space-sm bg-surface-container rounded-lg p-space-xs text-secondary font-body-sm text-body-sm flex items-start gap-1.5">
                                        <span class="material-symbols-outlined text-[16px] text-tertiary flex-shrink-0 mt-0.5">local_shipping</span>
