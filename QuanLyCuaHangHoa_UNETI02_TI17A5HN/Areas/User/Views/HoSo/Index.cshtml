@* Họ và tên: Đặng Thị Mai Hương
 Mã sinh viên: 23103100293
 Nội dung thực hiện: Kết nối giao diện gốc với dữ liệu DB và hành động POST hợp lệ. *@
@model QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels.HoSoViewModel
@* Một View hiển thị hồ sơ, đơn hàng, yêu cầu thiết kế riêng và đổi mật khẩu. *@

@using QuanLyCuaHangHoa_UNETI02_TI17A5HN.Helpers
@using QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models
@{
    ViewData["Title"] = "Hồ sơ cá nhân & Cài đặt bảo mật - Web quản lý hoa tươi";
}

<!-- Decorative Ambient Underlay -->
<div class="relative w-full overflow-hidden">

    <div class="absolute -top-32 right-1/4 w-96 h-96 bg-primary-fixed/30 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-96 -left-20 w-80 h-80 bg-tertiary-fixed/20 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <!-- Container Wrap -->
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-space-lg md:py-space-xl">

        <!-- Breadcrumb & Page Introduction Header -->
        <section class="mb-space-lg md:mb-space-xl">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
                <div class="space-y-space-xs">
                    <span class="font-label-lg text-label-lg text-tertiary uppercase tracking-widest block font-medium">Boutique Privileges &amp; Profile</span>
                    <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Không Gian Thành Viên</h1>
                    <p class="font-body-lg text-body-lg text-secondary max-w-2xl">
                        Kính chào <span class="text-on-surface font-semibold">@Model.HoTen</span>, chào mừng bạn trở lại với không gian hoa nghệ thuật và dịch vụ chăm sóc hoa độc bản của Web quản lý hoa tươi.
                    </p>
                </div>
                <div class="flex items-center gap-space-sm">
                    <div class="px-space-md py-2 bg-surface-container rounded-full flex items-center gap-space-xs shadow-sm">
                        <span class="w-2.5 h-2.5 rounded-full @(Model.TrangThai ? "bg-tertiary animate-pulse" : "bg-error")"></span>
                        <span class="font-label-md text-label-md text-on-surface uppercase tracking-wider">
                            Trạng thái: @(Model.TrangThai ? "Hoạt động thường nhật" : "Tài khoản bị khóa")
                        </span>
                    </div>
                </div>
            </div>
        </section>

        @if (TempData["ThongBao"] != null)
        {
            <div class="mb-space-md p-space-md rounded-xl bg-primary-fixed/30 border border-primary/20 text-primary flex items-center gap-space-xs font-title-sm text-sm shadow-sm animate-fade-in">
                <span class="material-symbols-outlined text-[20px]">check_circle</span>
                <span>@TempData["ThongBao"]</span>
            </div>
        }
        @if (TempData["Loi"] != null)
        {
            <div class="mb-space-md p-space-md rounded-xl bg-error-container/40 border border-error/30 text-error flex items-center gap-space-xs font-title-sm text-sm shadow-sm animate-fade-in">
                <span class="material-symbols-outlined text-[20px]">error</span>
                <span>@TempData["Loi"]</span>
            </div>
        }

        <!-- Main Layout: 2 Columns -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-start">

            <!-- A. LEFT COLUMN: Sidebar Navigation -->
            <aside class="lg:col-span-4 space-y-space-lg">

                <!-- Mini Profile Card -->
                <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm space-y-space-md relative overflow-hidden">
                    <div class="absolute -right-8 -top-8 w-28 h-28 bg-secondary-fixed/40 rounded-full blur-xl pointer-events-none"></div>

                    <div class="flex flex-col items-center text-center space-y-space-sm relative">

                        <!-- Avatar Frame -->
                        <div class="relative group cursor-pointer">
                            <div class="w-24 h-24 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold text-3xl shadow-sm ring-4 ring-surface-container transition-transform duration-300 group-hover:scale-105">
                                <span class="material-symbols-outlined text-[48px]">person</span>
                            </div>
                        </div>

                        <!-- Name & Contact -->
                        <div class="space-y-0.5">
                            <h2 class="font-headline-sm text-headline-sm text-on-surface font-semibold">@Model.HoTen</h2>
                            <p class="font-body-sm text-body-sm text-secondary">@Model.Email</p>
                            @if (!string.IsNullOrEmpty(Model.SoDienThoai))
                            {
                                <p class="font-label-md text-label-md text-on-surface-variant">@Model.SoDienThoai</p>
                            }
                            <p class="font-label-md text-[11px] text-outline">Tài khoản: @@ @Model.TenDangNhap</p>
                        </div>

                        <!-- Tier Badge -->
                        <div class="inline-flex items-center gap-space-xs px-3 py-1 bg-secondary-fixed text-on-secondary-fixed rounded-full shadow-sm">
                            <span class="material-symbols-outlined text-[15px] text-primary" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
                            <span class="font-label-md text-label-md uppercase tracking-wider font-semibold">@Model.HangThanhVien</span>
                        </div>
                    </div>
                </div>

                <!-- Account Navigation Menu -->
                <nav aria-label="Menu tài khoản" class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm space-y-1">

                    <!-- 1. Thông tin cá nhân -->
                    <button type="button"
                            data-tab="personal"
                            class="tab-btn active-tab w-full flex items-center justify-between px-space-md py-3 rounded-lg bg-surface-container text-primary font-title-sm text-title-sm shadow-sm transition-all text-left cursor-pointer">
                        <div class="flex items-center gap-space-sm">
                            <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">person</span>
                            <span>Thông tin cá nhân</span>
                        </div>
                        <span class="material-symbols-outlined text-[18px] text-primary tab-chevron">chevron_right</span>
                    </button>

                    <!-- 2. Lịch sử đơn hoa -->
                    <button type="button"
                            data-tab="orders"
                            class="tab-btn w-full flex items-center justify-between px-space-md py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface transition-all font-title-sm text-title-sm text-left cursor-pointer">
                        <div class="flex items-center gap-space-sm">
                            <span class="material-symbols-outlined text-[20px]">local_florist</span>
                            <span>Lịch sử đơn hoa</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md">@Model.TongSoDonHang đơn</span>
                            <span class="material-symbols-outlined text-[18px] text-outline tab-chevron">chevron_right</span>
                        </div>
                    </button>

                    <!-- 3. Hoa thiết kế riêng -->
                    <button type="button"
                            data-tab="custom-design"
                            class="tab-btn w-full flex items-center justify-between px-space-md py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface transition-all font-title-sm text-title-sm text-left cursor-pointer">
                        <div class="flex items-center gap-space-sm">
                            <span class="material-symbols-outlined text-[20px]">palette</span>
                            <span>Hoa thiết kế riêng</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-md text-label-md">@Model.DonHangThietKeRieng.Count yêu cầu</span>
                            <span class="material-symbols-outlined text-[18px] text-outline tab-chevron">chevron_right</span>
                        </div>
                    </button>

                    <!-- 4. Sổ địa chỉ nhận hoa -->
                    <button type="button"
                            data-tab="addresses"
                            class="tab-btn w-full flex items-center justify-between px-space-md py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface transition-all font-title-sm text-title-sm text-left cursor-pointer">
                        <div class="flex items-center gap-space-sm">
                            <span class="material-symbols-outlined text-[20px]">pin_drop</span>
                            <span>Sổ địa chỉ nhận hoa</span>
                        </div>
                        <span class="material-symbols-outlined text-[18px] text-outline tab-chevron">chevron_right</span>
                    </button>

                    <!-- 5. Cài đặt & Bảo mật -->
                    <button type="button"
                            data-tab="security"
                            class="tab-btn w-full flex items-center justify-between px-space-md py-3 rounded-lg text-on-surface-variant hover:bg-surface-container-low hover:text-on-surface transition-all font-title-sm text-title-sm text-left cursor-pointer">
                        <div class="flex items-center gap-space-sm">
                            <span class="material-symbols-outlined text-[20px]">shield</span>
                            <span>Cài đặt &amp; Bảo mật</span>
                        </div>
                        <span class="material-symbols-outlined text-[18px] text-outline tab-chevron">chevron_right</span>
                    </button>

                    <!-- Logout Link -->
                    <form asp-area="User"
                          asp-controller="TaiKhoan"
                          asp-action="Logout"
                          method="post"
                          class="m-0 pt-space-xs">
                        @Html.AntiForgeryToken()
                        <button type="submit"
                                class="w-full flex items-center gap-space-sm px-space-md py-2.5 rounded-lg text-secondary hover:text-error hover:bg-error-container/30 transition-colors font-title-sm text-title-sm text-left cursor-pointer">
                            <span class="material-symbols-outlined text-[20px]">logout</span>
                            <span>Đăng xuất tài khoản</span>
                        </button>
                    </form>
                </nav>

                <!-- Artisanal Florist Advice Widget -->
                <div class="bg-surface-container-low rounded-xl p-space-lg relative space-y-space-sm">
                    <span class="font-label-md text-label-md text-secondary uppercase tracking-widest block">Web quản lý hoa tươi Concierge</span>
                    <h3 class="font-headline-sm text-headline-sm text-primary">Chuyên viên cắm hoa riêng</h3>
                    <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
                        Bạn có yêu cầu đặc biệt về loài hoa nhập khẩu hiếm hoặc sự kiện tư gia? Chuyên viên hoa của chúng tôi luôn sẵn sàng hỗ trợ.
                    </p>
                    <a class="inline-flex items-center gap-2 text-primary font-title-sm text-title-sm hover:underline pt-space-xs"
                       href="tel:19008866">
                        <span class="material-symbols-outlined text-[18px]">call</span>
                        <span>Hotline VIP: 1900 8866</span>
                    </a>
                </div>
            </aside>

            <!-- B. RIGHT COLUMN: Main Content Tabs -->
            <main class="lg:col-span-8 space-y-space-xl">

                <!-- TAB 1: THÔNG TIN CÁ NHÂN -->
                <div id="tab-personal" class="profile-tab-content space-y-space-xl">
                    <section class="bg-surface-container-lowest rounded-xl p-space-lg md:p-space-xl shadow-sm space-y-space-lg">

                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-xs">
                            <div>
                                <h2 class="font-headline-md text-headline-md text-on-surface">Thông Tin Cá Nhân &amp; Tài Khoản</h2>
                                <p class="font-body-sm text-body-sm text-secondary">Cập nhật thông tin thực tế được lưu trữ an toàn trong cơ sở dữ liệu.</p>
                            </div>
                            <span class="px-3 py-1 bg-surface-container text-secondary rounded-full font-label-md text-label-md uppercase tracking-wider self-start sm:self-auto">
                                Mã KH: #@(Model.MaKhachHang?.ToString("D4") ?? "N/A")
                            </span>
                        </div>

                        @* POST cập nhật hồ sơ: Controller đồng bộ thông tin TaiKhoan và KhachHang. *@
                        <form asp-area="User"
                              asp-controller="HoSo"
                              asp-action="CapNhatThongTin"
                              method="post"
                              class="space-y-space-md">
                            @Html.AntiForgeryToken()

                            <!-- Row 1: Name & Username -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
                                <div class="space-y-space-xs">
                                    <label class="font-title-sm text-title-sm text-on-surface block" for="fullname">Họ và tên quý khách</label>
                                    <input asp-for="HoTen"
                                           class="w-full px-space-md py-3 rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest shadow-sm transition-all"
                                           id="fullname"
                                           type="text"
                                           required>
                                </div>
                                <div class="space-y-space-xs">
                                    <label class="font-title-sm text-title-sm text-on-surface block">Tên đăng nhập hệ thống</label>
                                    <input value="@Model.TenDangNhap"
                                           readonly
                                           class="w-full px-space-md py-3 rounded-lg bg-surface-container-high/60 font-body-md text-body-md text-on-surface-variant cursor-not-allowed shadow-sm"
                                           type="text">
                                </div>
                            </div>

                            <!-- Row 2: Phone & Email -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
                                <div class="space-y-space-xs">
                                    <label class="font-title-sm text-title-sm text-on-surface block" for="phone">Số điện thoại liên hệ</label>
                                    <input asp-for="SoDienThoai"
                                           class="w-full px-space-md py-3 rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest shadow-sm transition-all"
                                           id="phone"
                                           type="tel"
                                           required>
                                </div>
                                <div class="space-y-space-xs">
                                    <label class="font-title-sm text-title-sm text-on-surface block" for="email">Địa chỉ Email</label>
                                    <input asp-for="Email"
                                           class="w-full px-space-md py-3 rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest shadow-sm transition-all"
                                           id="email"
                                           type="email"
                                           required>
                                </div>
                            </div>

                            <!-- Row 3: Address -->
                            <div class="space-y-space-xs">
                                <label class="font-title-sm text-title-sm text-on-surface block" for="address">Địa chỉ giao nhận mặc định</label>
                                <input asp-for="DiaChi"
                                       class="w-full px-space-md py-3 rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest shadow-sm transition-all"
                                       id="address"
                                       placeholder="Nhập địa chỉ nhà riêng hoặc văn phòng..."
                                       type="text">
                            </div>

                            <!-- Row 4: Member stats overview -->
                            <div class="grid grid-cols-3 gap-space-sm pt-space-xs">
                                <div class="p-space-sm bg-surface-container-low rounded-lg text-center">
                                    <span class="text-xs text-secondary block font-label-md uppercase">Tổng đơn</span>
                                    <span class="font-headline-sm text-primary font-bold">@Model.TongSoDonHang</span>
                                </div>
                                <div class="p-space-sm bg-surface-container-low rounded-lg text-center">
                                    <span class="text-xs text-secondary block font-label-md uppercase">Đã hoàn thành</span>
                                    <span class="font-headline-sm text-tertiary font-bold">@Model.SoDonHoanThanh</span>
                                </div>
                                <div class="p-space-sm bg-surface-container-low rounded-lg text-center">
                                    <span class="text-xs text-secondary block font-label-md uppercase">Tổng chi tiêu</span>
                                    <span class="font-headline-sm text-primary font-bold">@Model.TongChiTieu.ToString("N0")₫</span>
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="flex flex-wrap items-center justify-end gap-space-sm pt-space-md">
                                <button class="px-space-xl py-2.5 rounded-full bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container shadow-md transition-all flex items-center gap-2 cursor-pointer"
                                        type="submit">
                                    <span class="material-symbols-outlined text-[18px]">save</span>
                                    <span>Lưu thay đổi thông tin</span>
                                </button>
                            </div>
                        </form>
                    </section>
                </div>

                <!-- TAB 2: LỊCH SỬ ĐƠN HOA -->
                <div id="tab-orders" class="profile-tab-content space-y-space-xl hidden">

                    <!-- Current Active Order Card -->
                    @* Khối đơn mới nhất lấy từ danh sách đơn trong DB của chính khách đăng nhập. *@
                    @if (Model.DonHangGanNhat != null)
                    {
                        var donGannhat = Model.DonHangGanNhat;
                        var ctFirst = donGannhat.ChiTietDonHoas.FirstOrDefault();
                        var tenSp = ctFirst?.MauSanPham?.TenMau ?? "Đơn hoa thiết kế riêng";
                        var anhSp = ctFirst?.MauSanPham?.HinhAnh ?? "/images/mau/mau01.jpg";
                        var moTa = ctFirst?.MauSanPham?.MoTa ?? ctFirst?.YeuCauRieng ?? "Mẫu hoa tươi thiết kế độc bản";

                        <section class="bg-surface-container-lowest rounded-xl p-space-lg md:p-space-xl shadow-sm space-y-space-md">

                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-xs">
                                <div class="space-y-0.5">
                                    <span class="font-label-lg text-label-lg text-tertiary uppercase tracking-widest font-semibold block">Cập nhật thời gian thực</span>
                                    <h2 class="font-headline-md text-headline-md text-on-surface">Đơn Hoa Gần Nhất</h2>
                                </div>
                                <span class="px-3 py-1 bg-secondary-fixed text-primary font-label-md text-label-md font-semibold uppercase tracking-wider rounded-full self-start sm:self-auto">
                                    @donGannhat.TrangThai
                                </span>
                            </div>

                            <!-- Order Card with Progress -->
                            <div class="p-space-lg rounded-xl bg-surface-container-low space-y-space-md">

                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm pb-space-xs border-b border-outline-variant/30">
                                    <div>
                                        <span class="font-label-md text-label-md text-secondary uppercase tracking-widest block">Mã đơn hàng</span>
                                        <span class="font-title-md text-title-md text-on-surface font-bold">#ORD-@donGannhat.MaDon.ToString("D4")</span>
                                    </div>
                                    <div class="flex items-center gap-space-xs">
                                        <span class="w-2.5 h-2.5 rounded-full bg-secondary animate-pulse"></span>
                                        <span class="font-label-md text-label-md uppercase tracking-wider text-primary font-semibold">
                                            @donGannhat.TrangThai
                                        </span>
                                    </div>
                                </div>

                                <!-- Product Item Details -->
                                <div class="flex flex-col sm:flex-row items-center gap-space-md pt-space-xs">
                                    <img class="w-24 h-24 sm:w-28 sm:h-28 rounded-xl object-cover shadow-sm flex-shrink-0"
                                         alt="@tenSp"
                                         src="@anhSp"
                                         onerror="this.src='/images/mau/mau01.jpg';">
                                    <div class="flex-1 space-y-1 text-center sm:text-left">
                                        <h3 class="font-headline-sm text-headline-sm text-on-surface">@tenSp</h3>
                                        <p class="font-body-sm text-body-sm text-secondary">
                                            @moTa
                                        </p>
                                        <p class="font-body-sm text-body-sm text-on-surface-variant">
                                            Giao tới: <strong class="text-on-surface">@(donGannhat.DiaChiGiao ?? "Nhận tại cửa hàng")</strong>
                                            • Dự kiến: <strong class="text-tertiary">@donGannhat.ThoiGianNhanGiao.ToString("HH:mm - dd/MM/yyyy")</strong>
                                        </p>
                                        <div class="font-headline-sm text-headline-sm text-primary font-semibold pt-1">
                                            @donGannhat.TongTien.ToString("N0")₫
                                        </div>
                                    </div>
                                </div>

                                <!-- Progress Flow -->
                                <div class="pt-space-md space-y-space-sm border-t border-outline-variant/30">
                                    <span class="font-label-md text-label-md text-secondary uppercase tracking-widest block">Hành trình xử lý đơn</span>
                                    <div class="grid grid-cols-4 gap-2 text-center text-xs">
                                        <div class="space-y-1">
                                            <div class="h-2 rounded-full @(donGannhat.TrangThai != TrangThaiDon.DaHuy ? "bg-tertiary" : "bg-error")"></div>
                                            <span class="font-semibold block">1. Đã đặt</span>
                                            <span class="text-secondary text-[11px]">@donGannhat.NgayDat.ToString("dd/MM")</span>
                                        </div>
                                        <div class="space-y-1">
                                            <div class="h-2 rounded-full @(donGannhat.TrangThai is TrangThaiDon.DaXacNhan or TrangThaiDon.DangChuanBi or TrangThaiDon.SanSang or TrangThaiDon.DangGiao or TrangThaiDon.HoanThanh ? "bg-primary" : "bg-surface-container-highest")"></div>
                                            <span class="font-semibold block">2. Chuẩn bị</span>
                                        </div>
                                        <div class="space-y-1">
                                            <div class="h-2 rounded-full @(donGannhat.TrangThai is TrangThaiDon.DangGiao or TrangThaiDon.HoanThanh ? "bg-primary" : "bg-surface-container-highest")"></div>
                                            <span class="font-semibold block">3. Vận chuyển</span>
                                        </div>
                                        <div class="space-y-1">
                                            <div class="h-2 rounded-full @(donGannhat.TrangThai == TrangThaiDon.HoanThanh ? "bg-tertiary" : "bg-surface-container-highest")"></div>
                                            <span class="font-semibold block">4. Hoàn thành</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    }

                    <!-- Order History List -->
                    <section class="bg-surface-container-lowest rounded-xl p-space-lg md:p-space-xl shadow-sm space-y-space-lg">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-xs">
                            <h2 class="font-headline-md text-headline-md text-on-surface">Toàn Bộ Lịch Sử Đặt Hoa (@Model.TongSoDonHang đơn)</h2>
                        </div>

                        @* Danh sách lịch sử đơn hàng: trạng thái/giá/chi tiết đi kèm từ Controller. *@
                        @if (Model.DanhSachDonHang.Any())
                        {
                            <div class="space-y-space-md">
                                @foreach (var don in Model.DanhSachDonHang)
                                {
                                    var ct = don.ChiTietDonHoas.FirstOrDefault();
                                    var tenSp = ct?.MauSanPham?.TenMau ?? "Hoa thiết kế riêng";
                                    var anhSp = ct?.MauSanPham?.HinhAnh ?? "/images/mau/mau01.jpg";

                                    <div class="p-space-md rounded-xl bg-surface-container-low flex flex-col md:flex-row md:items-center justify-between gap-space-md hover:bg-surface-container transition-all">
                                        <div class="flex items-center gap-space-md">
                                            <img class="w-16 h-16 rounded-lg object-cover shadow-sm flex-shrink-0"
                                                 alt="@tenSp"
                                                 src="@anhSp"
                                                 onerror="this.src='/images/mau/mau01.jpg';">
                                            <div>
                                                <div class="flex items-center gap-2">
                                                    <span class="font-title-sm text-title-sm text-on-surface font-bold">#ORD-@don.MaDon.ToString("D4")</span>
                                                    <span class="px-2 py-0.5 rounded-full font-label-md text-[10px] font-semibold @(don.TrangThai == TrangThaiDon.HoanThanh ? "bg-tertiary-fixed text-on-tertiary-fixed" : (don.TrangThai == TrangThaiDon.DaHuy ? "bg-error-container text-on-error-container" : "bg-secondary-container text-on-secondary-container"))">
                                                        @don.TrangThai
                                                    </span>
                                                </div>
                                                <h3 class="font-body-md text-body-md text-on-surface font-medium">@tenSp</h3>
                                                <p class="font-body-sm text-body-sm text-secondary">
                                                    Ngày đặt: @don.NgayDat.ToString("dd/MM/yyyy HH:mm")
                                                    • Người nhận: @don.NguoiNhan
                                                </p>
                                            </div>
                                        </div>
                                        <div class="flex md:flex-col items-center md:items-end justify-between gap-1 border-t md:border-t-0 border-outline-variant/30 pt-2 md:pt-0">
                                            <span class="font-title-md text-title-md text-primary font-bold">@don.TongTien.ToString("N0")₫</span>
                                            <span class="text-xs text-secondary font-label-md">
                                                @(don.ChiTietDonHoas.Count) sản phẩm
                                            </span>
                                            <a class="text-primary text-xs underline" href="/User/HoSo/ChiTietDon?maDon=@don.MaDon">Xem chi tiết đơn</a>

                                            @* Khách chỉ thấy nút Hủy cho đơn chờ xác nhận và chưa có thanh toán; POST còn kiểm tra server. *@
                                            @if (don.TrangThai == TrangThaiDon.ChoXacNhan && !don.ThanhToans.Any())
                                            {
                                                <form method="post"
                                                      action="/User/HoSo/HuyDon"
                                                      onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn này?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="maDon" value="@don.MaDon" />
                                                    <button type="submit" class="text-error text-xs underline">Hủy đơn</button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-12 text-secondary space-y-2">
                                <span class="material-symbols-outlined text-[48px] text-outline">receipt_long</span>
                                <p class="font-body-md">Quý khách chưa có đơn đặt hoa nào trong hệ thống.</p>
                                <a href="/User/Products"
                                   class="inline-block mt-2 px-6 py-2 rounded-full bg-primary text-on-primary font-title-sm text-sm">
                                    Khám phá bộ sưu tập hoa
                                </a>
                            </div>
                        }
                    </section>
                </div>

                <!-- TAB 3: HOA THIẾT KẾ RIÊNG -->
                <div id="tab-custom-design" class="profile-tab-content space-y-space-xl hidden">
                    <section class="bg-surface-container-lowest rounded-xl p-space-lg md:p-space-xl shadow-sm space-y-space-lg">

                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-xs">
                            <div>
                                <h2 class="font-headline-md text-headline-md text-on-surface">Hoa Thiết Kế Riêng Của Tôi (Bespoke)</h2>
                                <p class="font-body-sm text-body-sm text-secondary">Quản lý các bản thảo cắm hoa độc bản được thiết kế riêng theo yêu cầu cá nhân.</p>
                            </div>
                            <a class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-colors shadow-sm self-start sm:self-auto"
                               href="/User/CustomDesign">
                                <span class="material-symbols-outlined text-[18px]">add</span>
                                <span>Tạo thiết kế hoa mới</span>
                            </a>
                        </div>

                        @* Tab thiết kế riêng lọc từ đơn có ChiTietDonHoa.YeuCauRieng hoặc MaMau == null. *@
                        @if (Model.DonHangThietKeRieng.Any())
                        {
                            <div class="space-y-space-md">
                                @foreach (var don in Model.DonHangThietKeRieng)
                                {
                                    var ctRieng = don.ChiTietDonHoas.FirstOrDefault(c => !string.IsNullOrEmpty(c.YeuCauRieng) || c.MaMau == null) ?? don.ChiTietDonHoas.FirstOrDefault();
                                    var yeuCau = ctRieng?.YeuCauRieng ?? "Yêu cầu thiết kế đặc biệt";

                                    <div class="p-space-lg rounded-xl bg-surface-container-low border border-primary/20 space-y-space-md relative overflow-hidden">

                                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm pb-space-xs border-b border-outline-variant/30">
                                            <div>
                                                <span class="font-label-md text-label-md text-secondary uppercase tracking-widest block">Mã đơn thiết kế</span>
                                                <span class="font-title-md text-title-md text-on-surface font-bold">#CTM-@don.MaDon.ToString("D4")</span>
                                            </div>
                                            <span class="px-3 py-1 bg-primary-fixed text-on-primary-fixed font-label-md text-label-md font-semibold uppercase tracking-wider rounded-full self-start sm:self-auto">
                                                @don.TrangThai
                                            </span>
                                        </div>

                                        <div class="space-y-2">
                                            <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
                                                <strong class="text-on-surface">Yêu cầu đặc biệt:</strong> @yeuCau
                                            </p>
                                            <div class="flex flex-wrap gap-2 pt-1 text-xs">
                                                <span class="px-2.5 py-1 rounded-full bg-surface-container font-label-md text-secondary">
                                                    Ngân sách: @don.TongTien.ToString("N0")₫
                                                </span>
                                                <span class="px-2.5 py-1 rounded-full bg-surface-container font-label-md text-secondary">
                                                    Ngày gửi: @don.NgayDat.ToString("dd/MM/yyyy")
                                                </span>
                                                <span class="px-2.5 py-1 rounded-full bg-surface-container font-label-md text-secondary">
                                                    Người nhận: @don.NguoiNhan (@(don.DiaChiGiao ?? "Tại quầy"))
