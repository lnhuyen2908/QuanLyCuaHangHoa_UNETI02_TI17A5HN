<!-- JavaScript for Tab Switching & Hash Navigation -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabContents = document.querySelectorAll('.profile-tab-content');
        const breadcrumbCurrent = document.getElementById('breadcrumb-current');

        const tabNames = {
            'personal': 'Thông tin cá nhân',
            'orders': 'Lịch sử đơn hoa',
            'custom-design': 'Hoa thiết kế riêng',
            'addresses': 'Sổ địa chỉ nhận hoa',
            'reminders': 'Lịch nhắc ngày kỷ niệm',
            'security': 'Cài đặt & Bảo mật'
        };

        function switchTab(tabId) {
            if (!document.getElementById('tab-' + tabId)) {
                tabId = 'personal';
            }

            // Hide all tab contents
            tabContents.forEach(content => {
                content.classList.add('hidden');
            });

            // Deactivate all tab buttons
            tabBtns.forEach(btn => {
                btn.classList.remove('bg-surface-container', 'text-primary', 'shadow-sm', 'active-tab');
                btn.classList.add('text-on-surface-variant', 'hover:bg-surface-container-low', 'hover:text-on-surface');

                const mainIcon = btn.querySelector('.flex .material-symbols-outlined');
                if (mainIcon) {
                    mainIcon.style.fontVariationSettings = "'FILL' 0";
                }

                const chevron = btn.querySelector('.tab-chevron');
                if (chevron) {
                    chevron.classList.remove('text-primary');
                    chevron.classList.add('text-outline');
                }
            });

            // Show selected tab content
            const targetContent = document.getElementById('tab-' + tabId);
            if (targetContent) {
                targetContent.classList.remove('hidden');
            }

            // Activate selected tab button
            const targetBtn = document.querySelector(`.tab-btn[data-tab="${tabId}"]`);
            if (targetBtn) {
                targetBtn.classList.remove('text-on-surface-variant', 'hover:bg-surface-container-low', 'hover:text-on-surface');
                targetBtn.classList.add('bg-surface-container', 'text-primary', 'shadow-sm', 'active-tab');

                const mainIcon = targetBtn.querySelector('.flex .material-symbols-outlined');
                if (mainIcon) {
                    mainIcon.style.fontVariationSettings = "'FILL' 1";
                }

                const chevron = targetBtn.querySelector('.tab-chevron');
                if (chevron) {
                    chevron.classList.remove('text-outline');
                    chevron.classList.add('text-primary');
                }
            }

            // Update breadcrumb text
            if (breadcrumbCurrent && tabNames[tabId]) {
                breadcrumbCurrent.textContent = tabNames[tabId];
            }
        }

        // Attach click listeners to all tab buttons
        tabBtns.forEach(btn => {
            btn.addEventListener('click', function () {
                const tabId = this.getAttribute('data-tab');
                if (tabId) {
                    switchTab(tabId);
                    history.pushState(null, null, '#' + tabId);
                }
            });
        });

        // Handle browser Back / Forward buttons & initial URL hash
        window.addEventListener('hashchange', function () {
            const hash = window.location.hash.replace('#', '');
            if (hash) {
                switchTab(hash);
            }
        });

        const initialHash = window.location.hash.replace('#', '');
        if (initialHash) {
            switchTab(initialHash);
        } else {
            switchTab('personal');
        }
    });
</script>
