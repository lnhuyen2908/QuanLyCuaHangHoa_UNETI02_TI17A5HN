                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                </div>

                <!-- TAB 5: CÀI ĐẶT & BẢO MẬT -->
                <div id="tab-security" class="profile-tab-content space-y-space-xl hidden">

                    <div class="flex items-center gap-space-sm border-b border-outline-variant/40 pb-space-md">
                        <span class="material-symbols-outlined text-primary text-[28px]">shield</span>
                        <div>
                            <h2 class="font-headline-md text-headline-md text-on-surface">Cài Đặt &amp; Bảo Mật Tài Khoản</h2>
                            <p class="font-body-sm text-body-sm text-secondary">Quản lý mật khẩu đăng nhập của tài khoản @@ @Model.TenDangNhap.</p>
                        </div>
                    </div>

                    <section class="bg-surface-container-lowest rounded-xl p-space-lg md:p-space-xl shadow-sm space-y-space-lg">

                        <div class="flex items-center justify-between border-b border-outline-variant/40 pb-space-sm">
                            <div>
                                <h3 class="font-headline-sm text-headline-sm text-on-surface">Đổi Mật Khẩu Đăng Nhập</h3>
                                <p class="font-body-sm text-body-sm text-secondary">Nên sử dụng mật khẩu mạnh kết hợp chữ hoa, chữ thường và số để đảm bảo an toàn.</p>
                            </div>
                            <span class="material-symbols-outlined text-primary text-[24px]">lock_reset</span>
                        </div>

                        @* POST bảo vệ bằng AntiForgeryToken; mật khẩu hiện tại được kiểm tra ở Controller. *@
                        <form asp-area="User"
                              asp-controller="HoSo"
                              asp-action="DoiMatKhau"
                              method="post"
                              class="space-y-space-md">
                            @Html.AntiForgeryToken()

                            <div class="space-y-space-xs">
                                <label class="font-title-sm text-title-sm text-on-surface block" for="current_pwd">Mật khẩu hiện tại</label>
                                <div class="relative">
                                    <input name="MatKhauHienTai"
                                           required
                                           class="w-full px-space-md py-3 rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest shadow-sm pr-10"
                                           id="current_pwd"
                                           placeholder="Nhập mật khẩu hiện tại"
                                           type="password">
                                    <span class="material-symbols-outlined text-[20px] text-outline absolute right-3 top-3.5 cursor-pointer hover:text-on-surface transition-colors"
                                          onclick="togglePasswordVisibility('current_pwd')">visibility</span>
                                </div>
                            </div>

                            <div class="space-y-space-xs">
                                <label class="font-title-sm text-title-sm text-on-surface block" for="new_pwd">Mật khẩu mới</label>
                                <div class="relative">
                                    <input name="MatKhauMoi"
                                           required
                                           minlength="6"
                                           class="w-full px-space-md py-3 rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest shadow-sm pr-10"
                                           id="new_pwd"
                                           placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)"
                                           type="password">
                                    <span class="material-symbols-outlined text-[20px] text-outline absolute right-3 top-3.5 cursor-pointer hover:text-on-surface transition-colors"
                                          onclick="togglePasswordVisibility('new_pwd')">visibility</span>
                                </div>
                            </div>

                            <div class="space-y-space-xs">
                                <label class="font-title-sm text-title-sm text-on-surface block" for="confirm_pwd">Xác nhận mật khẩu mới</label>
                                <div class="relative">
                                    <input name="XacNhanMatKhauMoi"
                                           required
                                           class="w-full px-space-md py-3 rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest shadow-sm pr-10"
                                           id="confirm_pwd"
                                           placeholder="Nhập lại mật khẩu mới"
                                           type="password">
                                    <span class="material-symbols-outlined text-[20px] text-outline absolute right-3 top-3.5 cursor-pointer hover:text-on-surface transition-colors"
                                          onclick="togglePasswordVisibility('confirm_pwd')">visibility</span>
                                </div>
                            </div>

                            <div class="flex items-center justify-end gap-space-sm pt-space-sm">
                                <button class="px-space-xl py-2.5 rounded-full bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container shadow-md transition-all flex items-center gap-2 cursor-pointer"
                                        type="submit">
                                    <span class="material-symbols-outlined text-[18px]">verified_user</span>
                                    <span>Cập nhật mật khẩu mới</span>
                                </button>
                            </div>
                        </form>
                    </section>
                </div>

            </main>
        </div>
    </div>
</div>

<!-- JavaScript for Tab Switching & Hash Navigation -->
<script>
    // Ẩn/hiện mật khẩu trên giao diện, không thay đổi nội dung gửi lên server.
    function togglePasswordVisibility(fieldId) {
        const input = document.getElementById(fieldId);
        if (!input) return;
        input.type = input.type === 'password' ? 'text' : 'password';
    }

    // Chuyển tab hồ sơ/lịch sử đơn/thiết kế/bảo mật mà không tải lại trang.
    document.addEventListener('DOMContentLoaded', function() {
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabContents = document.querySelectorAll('.profile-tab-content');

        function switchTab(tabId) {
            if (!document.getElementById('tab-' + tabId)) {
                tabId = 'personal';
            }

            // Hide all tab contents
            tabContents.forEach(content => {
                content.classList.add('hidden');
            });

            // Deactivate all tab buttons
            tabBtns.forEach(btn => {
                btn.classList.remove('bg-surface-container', 'text-primary', 'shadow-sm', 'active-tab');
                btn.classList.add('text-on-surface-variant', 'hover:bg-surface-container-low', 'hover:text-on-surface');

                const mainIcon = btn.querySelector('.flex .material-symbols-outlined');
                if (mainIcon) {
                    mainIcon.style.fontVariationSettings = "'FILL' 0";
                }

                const chevron = btn.querySelector('.tab-chevron');
                if (chevron) {
                    chevron.classList.remove('text-primary');
                    chevron.classList.add('text-outline');
                }
            });

            // Show selected tab content
            const targetContent = document.getElementById('tab-' + tabId);
            if (targetContent) {
                targetContent.classList.remove('hidden');
            }

            // Activate selected tab button
            const targetBtn = document.querySelector(`.tab-btn[data-tab="${tabId}"]`);
            if (targetBtn) {
                targetBtn.classList.remove('text-on-surface-variant', 'hover:bg-surface-container-low', 'hover:text-on-surface');
                targetBtn.classList.add('bg-surface-container', 'text-primary', 'shadow-sm', 'active-tab');

                const mainIcon = targetBtn.querySelector('.flex .material-symbols-outlined');
                if (mainIcon) {
                    mainIcon.style.fontVariationSettings = "'FILL' 1";
                }

                const chevron = targetBtn.querySelector('.tab-chevron');
                if (chevron) {
                    chevron.classList.remove('text-outline');
                    chevron.classList.add('text-primary');
                }
            }
        }

        // Attach click listeners to all tab buttons
        tabBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const tabId = this.getAttribute('data-tab');
                if (tabId) {
                    switchTab(tabId);
                    history.pushState(null, null, '#' + tabId);
                }
            });
        });

        // Handle browser Back / Forward buttons & initial URL hash
        window.addEventListener('hashchange', function() {
            const hash = window.location.hash.replace('#', '');
            if (hash) {
                switchTab(hash);
            }
        });

        const initialHash = window.location.hash.replace('#', '');
        if (initialHash) {
            switchTab(initialHash);
        } else {
            switchTab('personal');
        }
    });
</script>
