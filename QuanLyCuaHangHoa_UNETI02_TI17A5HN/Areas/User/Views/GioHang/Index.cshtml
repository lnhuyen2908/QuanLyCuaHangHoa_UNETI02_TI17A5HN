@model List<QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels.CartItem>

@{
    ViewData["Title"] = "Giỏ hoa của bạn - Web quản lý hoa tươi";
}

<div class="relative w-full max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-space-lg lg:py-space-xl">
    <!-- Hiệu ứng nền giữ theo thiết kế -->
    <div class="absolute top-10 left-1/4 w-96 h-96 bg-primary-fixed-dim/20 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-1/2 right-10 w-80 h-80 bg-secondary-fixed/40 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <!-- Tiêu đề -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md pb-space-lg">
        <div class="space-y-space-xs">
            <div class="flex items-center gap-space-xs text-primary font-label-md uppercase tracking-widest">
                <span class="material-symbols-outlined text-[16px]">local_florist</span>
                <span>Boutique Floral Cart</span>
            </div>

            <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">
                Giỏ Hoa Tuyển Chọn
            </h1>

            <p class="font-body-md text-body-md text-on-surface-variant">
                Kiểm tra các mẫu hoa đã chọn trước khi đặt hàng.
            </p>
        </div>

        <!-- Các bước đặt hàng -->
        <div class="flex items-center gap-space-sm font-label-md uppercase tracking-wider text-on-surface-variant bg-surface-container-low px-space-md py-2 rounded-full shadow-sm">
            <span class="text-primary">1. Giỏ hàng</span>
            <span>/</span>
            <span class="opacity-60">2. Địa chỉ &amp; lời chúc</span>
            <span>/</span>
            <span class="opacity-60">3. Hoàn tất</span>
        </div>
    </div>

    <!-- Thông báo -->
    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded-xl p-4 bg-surface-container-low text-primary">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="mb-4 rounded-xl p-4 bg-surface-container-low text-error">
            @TempData["Error"]
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-start">

        <!-- Danh sách sản phẩm -->
        <div class="lg:col-span-8 flex flex-col space-y-space-lg">

            <div class="bg-surface-container-lowest rounded-xl p-space-md sm:p-space-lg shadow-sm space-y-space-lg">

                <div class="flex items-center justify-between pb-space-sm border-b border-surface-container">
                    <span class="font-title-md text-title-md text-on-surface">
                        Tác phẩm hoa đã chọn (@Model.Count)
                    </span>
                </div>

                @* Form kiểm thử độc lập. Xóa khi module sản phẩm đã có nút Thêm vào giỏ. *@
                <div class="rounded-xl border border-outline-variant bg-surface-container-low p-space-md space-y-space-sm">
                    <p class="font-title-sm text-on-surface">Kiểm thử thêm mẫu hoa vào giỏ</p>
                    <p class="font-body-sm text-on-surface-variant">
                        Nhập mã mẫu hoa đang hoạt động đã tồn tại trong CSDL.
                    </p>
                    <form action="/User/Cart/Add" method="post" class="flex flex-wrap items-end gap-3">
                        @Html.AntiForgeryToken()
                        <div class="flex flex-col gap-1">
                            <label for="testMaMau" class="font-body-sm text-on-surface">Mã mẫu hoa</label>
                            <input id="testMaMau" name="maMau" type="number" min="1" required
                                   class="w-36 rounded-lg p-2 bg-surface-container-lowest text-on-surface border border-outline-variant" />
                        </div>
                        <div class="flex flex-col gap-1">
                            <label for="testSoLuong" class="font-body-sm text-on-surface">Số lượng</label>
                            <input id="testSoLuong" name="soLuong" type="number" value="1" min="1" required
                                   class="w-24 rounded-lg p-2 bg-surface-container-lowest text-on-surface border border-outline-variant" />
                        </div>
                        <button type="submit" class="px-4 py-2 rounded-full bg-primary text-on-primary font-label-md hover:bg-primary-container transition-colors">
                            Thử thêm vào giỏ
                        </button>
                    </form>
                </div>

                @if (Model.Count == 0)
                {
                    <div class="py-12 text-center space-y-4">
                        <span class="material-symbols-outlined text-primary text-[64px]">
                            shopping_basket
                        </span>

                        <h2 class="font-headline-sm text-headline-sm text-on-surface">
                            Giỏ hàng của bạn đang trống
                        </h2>

                        <p class="font-body-md text-body-md text-on-surface-variant">
                            Hãy lựa chọn những mẫu hoa yêu thích.
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <div class="cart-item group relative flex flex-col md:flex-row gap-space-md p-space-md bg-surface-container-low rounded-xl transition-all duration-300 hover:shadow-md">

                            <!-- Thông tin mẫu hoa (tên, ảnh, giá sẽ tích hợp từ CSDL sau) -->
                            <div class="flex-1 flex flex-col justify-between space-y-space-sm min-w-0">

                                <div class="space-y-space-xs">
                                    <span class="font-label-md text-label-md text-secondary uppercase tracking-wider">
                                        Mẫu hoa đã chọn
                                    </span>

                                    <h3 class="font-headline-sm text-headline-sm text-on-surface">
                                        Mã mẫu: @item.MaMau
                                    </h3>

                                    <p class="font-body-sm text-body-sm text-on-surface-variant">
                                        Tên, hình ảnh và giá bán sẽ được lấy từ CSDL.
                                    </p>
                                </div>

                                <!-- Cập nhật số lượng và xóa -->
                                <div class="flex flex-wrap items-center justify-between gap-space-sm pt-space-md">

                                    <form asp-area="User"
                                          asp-controller="GioHang"
                                          asp-action="Update"
                                          method="post"
                                          class="flex items-center gap-3">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="maMau"
                                               value="@item.MaMau" />

                                        <label class="font-body-sm text-body-sm text-secondary">
                                            Số lượng
                                        </label>

                                        <input type="number" name="soLuong" value="@item.SoLuong" min="1" required
                                               class="w-20 text-center rounded-lg p-2 bg-surface-container-lowest text-on-surface border border-outline-variant" />

                                        <button type="submit" class="px-4 py-2 rounded-full bg-primary text-on-primary font-label-md hover:bg-primary-container transition-colors">
                                            Cập nhật
                                        </button>
                                    </form>

                                    <form action="/User/Cart/Remove" method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="maMau" value="@item.MaMau" />

                                        <button type="submit" onclick="return confirm('Bạn có muốn xóa mẫu hoa này khỏi giỏ hàng?')"
                                                class="hover:text-error flex items-center gap-1 text-secondary transition-colors">

                                            <span class="material-symbols-outlined text-[16px]">
                                                delete_outline
                                            </span>

                                            <span>Xóa</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Xóa toàn bộ giỏ -->
                    <div class="flex justify-end pt-space-md">
                        <form asp-area="User"
                              asp-controller="GioHang"
                              asp-action="Clear"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    onclick="return confirm('Bạn có chắc chắn muốn xóa toàn bộ giỏ hàng?')"
                                    class="text-on-surface-variant hover:text-error font-body-sm flex items-center gap-2">

                                <span class="material-symbols-outlined text-[18px]">
                                    remove_shopping_cart
                                </span>

                                Xóa toàn bộ giỏ hàng
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- Tóm tắt giỏ hàng -->
        <div class="lg:col-span-4 flex flex-col space-y-space-md sticky top-28">

            <div class="bg-surface-container-lowest rounded-xl p-space-md sm:p-space-lg shadow-sm space-y-space-md">

                <h2 class="font-headline-sm text-headline-sm text-on-surface">
                    Tóm Tắt Đơn Hoa
                </h2>

                <div class="h-px bg-surface-container"></div>

                <div class="flex justify-between font-body-sm text-body-sm text-on-surface-variant">
                    <span>Số mẫu hoa</span>
                    <span class="font-title-sm text-on-surface">
                        @Model.Count
                    </span>
                </div>

                <div class="flex justify-between font-body-sm text-body-sm text-on-surface-variant">
                    <span>Tổng số lượng</span>
                    <span class="font-title-sm text-on-surface">
                        @Model.Sum(x => x.SoLuong)
                    </span>
                </div>

                <div class="h-px bg-surface-container"></div>

                <p class="font-body-sm text-body-sm text-on-surface-variant">
                    Giá bán và tổng tiền sẽ được tính từ dữ liệu sản phẩm trong hệ thống.
                </p>

                @if (Model.Count > 0)
                {
                    <button type="button" disabled class="w-full py-3.5 px-space-lg rounded-full bg-surface-container text-on-surface-variant font-label-lg text-label-lg cursor-not-allowed">
                        Tiến Hành Đặt Hoa &amp; Chọn Giờ Giao
                    </button>

                    <p class="font-body-sm text-body-sm text-secondary text-center">
                        Chức năng Checkout sẽ được kết nối sau.
                    </p>
                }
            </div>
        </div>
    </div>
</div>
