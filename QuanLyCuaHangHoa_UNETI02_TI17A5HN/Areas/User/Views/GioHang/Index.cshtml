@* Họ và tên: Đặng Thị Mai Hương
Mã sinh viên: 23103100293
Nội dung thực hiện: Kết nối giao diện gốc với dữ liệu DB và hành động POST hợp lệ. *@
@model List<QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels.CartDisplayItem>
@* Giỏ lấy số lượng từ Session nhưng tên/ảnh/giá từ DB thông qua GioHangService. *@


@{
    ViewData["Title"] = "Giỏ hoa của bạn - Web quản lý hoa tươi";
}

<div class="relative w-full max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-space-lg lg:py-space-xl">

    <!-- Hiệu ứng nền giữ theo thiết kế -->
    <div class="absolute top-10 left-1/4 w-96 h-96 bg-primary-fixed-dim/20 rounded-full blur-3xl pointer-events-none -z-10"></div>
    <div class="absolute top-1/2 right-10 w-80 h-80 bg-secondary-fixed/40 rounded-full blur-3xl pointer-events-none -z-10"></div>

    <!-- Tiêu đề -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md pb-space-lg">
        <div class="space-y-space-xs">
            <div class="flex items-center gap-space-xs text-primary font-label-md uppercase tracking-widest">
                <span class="material-symbols-outlined text-[16px]">local_florist</span>
                <span>Boutique Floral Cart</span>
            </div>

            <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">
                Giỏ Hoa Tuyển Chọn
            </h1>

            <p class="font-body-md text-body-md text-on-surface-variant">
                Kiểm tra các mẫu hoa đã chọn trước khi đặt hàng.
            </p>
        </div>

        <!-- Các bước đặt hàng -->
        <div class="flex items-center gap-space-sm font-label-md uppercase tracking-wider text-on-surface-variant bg-surface-container-low px-space-md py-2 rounded-full shadow-sm">
            <span class="text-primary">1. Giỏ hàng</span>
            <span>/</span>
            <span class="opacity-60">2. Địa chỉ &amp; lời chúc</span>
            <span>/</span>
            <span class="opacity-60">3. Hoàn tất</span>
        </div>
    </div>

    <!-- Thông báo -->
    @if (TempData["Success"] != null)
    {
        <div class="mb-4 rounded-xl p-4 bg-surface-container-low text-primary">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="mb-4 rounded-xl p-4 bg-surface-container-low text-error">
            @TempData["Error"]
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-start">

        <!-- Danh sách sản phẩm -->
        <div class="lg:col-span-8 flex flex-col space-y-space-lg">

            <div class="bg-surface-container-lowest rounded-xl p-space-md sm:p-space-lg shadow-sm space-y-space-lg">

                <div class="flex items-center justify-between pb-space-sm border-b border-surface-container">
                    <span class="font-title-md text-title-md text-on-surface">
                        Tác phẩm hoa đã chọn (@Model.Count)
                    </span>
                </div>

                <a href="/User/Products" class="inline-flex items-center gap-2 text-primary font-title-sm underline">
                    Tiếp tục chọn mẫu hoa
                </a>

                @* Nhánh hiển thị giỏ trống: không cho người dùng đi tiếp tới Checkout. *@
                @if (Model.Count == 0)
                {
                    <div class="py-12 text-center space-y-4">
                        <span class="material-symbols-outlined text-primary text-[64px]">
                            shopping_basket
                        </span>

                        <h2 class="font-headline-sm text-headline-sm text-on-surface">
                            Giỏ hàng của bạn đang trống
                        </h2>

                        <p class="font-body-md text-body-md text-on-surface-variant">
                            Hãy lựa chọn những mẫu hoa yêu thích.
                        </p>
                    </div>
                }
                else
                {
                    @* Lặp mỗi mẫu hoa; các nút sửa/xóa đều gọi POST thực tế. *@
                    @foreach (var item in Model)
                    {
                        <div class="grid grid-cols-[64px_1fr_auto] gap-3 items-start
                            rounded-xl border border-outline-variant/40 p-3">

                            <img src="@(string.IsNullOrWhiteSpace(item.HinhAnh)
                                                                            ? "/images/mau/mau01.jpg"
                                                                            : item.HinhAnh)"
                                 alt="@item.TenMau"
                                 class="w-16 h-16 rounded-lg object-cover"
                                 onerror="this.src='/images/mau/mau01.jpg'" />

                            <div class="min-w-0">
                                <h3 class="font-semibold text-on-surface">@item.TenMau</h3>
                                <p class="mt-1 text-sm text-primary">
                                    @item.DonGia.ToString("N0")₫ × @item.SoLuong
                                    = @item.ThanhTien.ToString("N0")₫
                                </p>

                                @if (!item.ConBan)
                                {
                                    <p class="mt-1 text-sm text-error">Mẫu đã ngừng bán.</p>
                                }
                            </div>

                            <form action="/User/Cart/Remove" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maMau" value="@item.MaMau" />
                                <button type="submit"
                                        class="text-sm text-secondary hover:text-error"
                                        onclick="return confirm('Xóa mẫu hoa này khỏi giỏ?')">
                                    Xóa
                                </button>
                            </form>

                            <form asp-area="User" asp-controller="GioHang" asp-action="Update" method="post"
                                  class="col-span-3 grid grid-cols-1 sm:grid-cols-2 gap-3">

                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maMau" value="@item.MaMau" />

                                <label class="text-sm text-secondary">
                                    Số lượng
                                    <input type="number" name="soLuong" value="@item.SoLuong" min="1" max="100" required
                                           onchange="this.form.requestSubmit()"
                                           class="mt-1 w-full rounded-lg p-2 border border-outline-variant" />
                                </label>

                                <label class="text-sm text-secondary">
                                    Giấy gói &amp; ruy-băng
                                    <select name="giayGoiRuyBang"
                                            onchange="this.form.requestSubmit()"
                                            class="mt-1 w-full rounded-lg p-2 border border-outline-variant">
                                        @foreach (var wrap in new[]
                                        {
                                            "Kraft xám ấm & nơ dusty rose",
                                            "Trắng kem hoàng gia & nơ ngọc trai",
                                            "Đen mờ huyền bí & nơ đỏ Bordeaux"
                                        })
                                        {
                                            <option value="@wrap" selected="@(item.GiayGoiRuyBang == wrap)">
                                                @wrap
                                            </option>
                                        }
                                    </select>
                                </label>

                                <label class="text-sm text-secondary sm:col-span-2">
                                    Lời chúc
                                    <textarea name="loiChuc" maxlength="180" rows="2" onchange="this.form.requestSubmit()"
                                              class="mt-1 w-full rounded-lg p-2 border border-outline-variant">@item.LoiChuc</textarea>
                                </label>
                            </form>
                        </div>
                    }

                    <!-- Xóa toàn bộ giỏ -->
                    <div class="flex justify-end pt-space-md">
                        <form asp-area="User"
                              asp-controller="GioHang"
                              asp-action="Clear"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit" onclick="return confirm('Bạn có chắc chắn muốn xóa toàn bộ giỏ hàng?')"
                                    class="text-on-surface-variant hover:text-error font-body-sm flex items-center gap-2">

                                <span class="material-symbols-outlined text-[18px]">
                                    remove_shopping_cart
                                </span>

                                Xóa toàn bộ giỏ hàng
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- Tóm tắt giỏ hàng -->
        <div class="lg:col-span-4 flex flex-col space-y-space-md sticky top-28">

            <div class="bg-surface-container-lowest rounded-xl p-space-md sm:p-space-lg shadow-sm space-y-space-md">

                <h2 class="font-headline-sm text-headline-sm text-on-surface">
                    Tóm Tắt Đơn Hoa
                </h2>

                <div class="h-px bg-surface-container"></div>

                <div class="flex justify-between font-body-sm text-body-sm text-on-surface-variant">
                    <span>Số mẫu hoa</span>
                    <span class="font-title-sm text-on-surface">
                        @Model.Count
                    </span>
                </div>

                <div class="flex justify-between font-body-sm text-body-sm text-on-surface-variant">
                    <span>Tổng số lượng</span>
                    <span class="font-title-sm text-on-surface">
                        @Model.Sum(x => x.SoLuong)
                    </span>
                </div>

                <div class="h-px bg-surface-container"></div>

                <p class="font-body-sm text-body-sm text-on-surface-variant">
                    Tạm tính: @Model.Sum(x => x.ThanhTien).ToString("N0")₫ (phí vận chuyển xác định khi xác nhận đơn).
                </p>

                @if (Model.Count > 0)
                {
                    @* Chỉ mở đường sang Checkout khi tất cả mẫu trong giỏ vẫn được kinh doanh. *@
                    @if (Model.All(x => x.ConBan))
                    {
                        <a href="/User/Checkout"
                           class="block text-center w-full py-3.5 px-space-lg rounded-full bg-primary text-on-primary font-label-lg text-label-lg">
                            Tiến Hành Đặt Hoa &amp; Chọn Giờ Giao
                        </a>
                    }
                    else
                    {
                        <p class="text-error text-sm">Xóa mẫu đã ngừng bán để tiếp tục.</p>
                    }
                }
            </div>
        </div>
    </div>
</div>
