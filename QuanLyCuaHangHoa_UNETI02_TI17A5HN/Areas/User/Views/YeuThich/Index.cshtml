<!-- JAVASCRIPT LOGIC FOR WISHLIST -->
<script>
    let wishlistCount = 6;

    function filterWishlist(cat, btnEl) {
        const tabs = document.querySelectorAll('.filter-tab');
        tabs.forEach(t => {
            t.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm', 'active');
            t.classList.add('bg-surface-container-low', 'text-secondary', 'hover:bg-surface-container');
        });

        btnEl.classList.remove('bg-surface-container-low', 'text-secondary', 'hover:bg-surface-container');
        btnEl.classList.add('bg-primary', 'text-on-primary', 'shadow-sm', 'active');

        const items = document.querySelectorAll('.wishlist-item');
        items.forEach(item => {
            if (cat === 'all' || item.getAttribute('data-category') === cat) {
                item.classList.remove('hidden');
            } else {
                item.classList.add('hidden');
            }
        });
    }

    function removeItem(btnEl, itemName) {
        const itemCard = btnEl.closest('.wishlist-item');
        if (itemCard) {
            itemCard.style.opacity = '0';
            itemCard.style.transform = 'scale(0.9)';
            itemCard.style.transition = 'all 0.3s ease';

            setTimeout(() => {
                itemCard.remove();
                wishlistCount--;
                if (wishlistCount < 0) wishlistCount = 0;
                
                const label = document.getElementById('itemCountLabel');
                if (label) {
                    label.textContent = wishlistCount + ' tác phẩm';
                }
            }, 300);
        }
    }

    function shareWishlist() {
        if (navigator.clipboard) {
            navigator.clipboard.writeText(window.location.href);
            alert('Đã sao chép đường dẫn bộ sưu tập yêu thích vào bộ nhớ tạm!');
        } else {
            alert('Đã tạo liên kết chia sẻ bộ sưu tập yêu thích của bạn!');
        }
    }
</script>
