    <div class="max-w-7xl mx-auto flex items-center flex-wrap gap-space-xs font-label-md text-label-md text-on-surface-variant">
        <a class="hover:text-primary transition-colors flex items-center gap-1" asp-controller="Home" asp-action="Index">
            <span class="material-symbols-outlined text-[16px]">home</span>
