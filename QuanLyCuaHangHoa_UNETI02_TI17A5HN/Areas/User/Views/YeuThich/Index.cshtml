<!-- MAIN CONTAINER WRAP -->
<div class="w-full max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-space-lg md:py-space-xl space-y-space-xl">
    
    <!-- 1. HERO HEADER SUMMARY CARD -->
    <section class="p-space-lg md:p-space-xl rounded-3xl bg-surface-container-lowest shadow-sm border border-outline-variant/30 relative overflow-hidden space-y-space-lg">
        <div class="absolute -right-12 -top-12 w-64 h-64 bg-primary-fixed/25 rounded-full blur-3xl pointer-events-none -z-10"></div>
        <div class="absolute top-1/2 -left-16 w-56 h-56 bg-tertiary-fixed/20 rounded-full blur-2xl pointer-events-none -z-10"></div>

        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
            <div class="space-y-space-xs max-w-2xl">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-md text-label-md font-semibold uppercase tracking-wider">
                    <span class="material-symbols-outlined text-[15px] text-primary" style="font-variation-settings: 'FILL' 1;">favorite</span>
                    <span>PRIVATE WISHLIST</span>
                </div>
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">Bộ Sưu Tập Hoa Yêu Thích</h1>
                <p class="font-body-lg text-body-lg text-secondary leading-relaxed">
                    Lưu giữ những tác phẩm hoa nghệ thuật bạn yêu thích để dễ dàng đặt trước cho các dịp kỷ niệm đặc biệt hoặc gửi trọn vẹn xúc cảm đến người thương.
                </p>
            </div>

            <!-- Top Header Actions -->
            <div class="flex flex-wrap items-center gap-space-sm self-start lg:self-auto">
                <button type="button" onclick="shareWishlist()" class="px-space-md py-3 rounded-full bg-surface-container-low text-on-surface font-title-sm text-title-sm hover:bg-surface-container transition-all flex items-center gap-2 shadow-sm">
                    <span class="material-symbols-outlined text-[18px]">share</span>
                    <span>Chia sẻ danh sách</span>
                </button>
                <a asp-controller="Home" asp-action="Cart" class="px-space-lg py-3 rounded-full bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container shadow-md transition-all flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
                    <span>Thêm tất cả vào giỏ (6)</span>
                </a>
            </div>
        </div>

        <!-- Stat Counters Row -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-space-sm pt-space-xs border-t border-outline-variant/30">
            <div class="p-3 rounded-xl bg-surface-container-low flex items-center gap-space-xs">
                <div class="w-9 h-9 rounded-full bg-primary-fixed text-primary flex items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-[20px]">local_florist</span>
                </div>
                <div>
                    <span class="font-title-md text-title-md text-on-surface font-bold block leading-none" id="itemCountLabel">6 tác phẩm</span>
                    <span class="font-body-sm text-[11px] text-secondary">Đã lưu trong bộ sưu tập</span>
                </div>
            </div>

            <div class="p-3 rounded-xl bg-surface-container-low flex items-center gap-space-xs">
                <div class="w-9 h-9 rounded-full bg-tertiary-fixed text-tertiary flex items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-[20px]">electric_bolt</span>
                </div>
                <div>
                    <span class="font-title-md text-title-md text-on-surface font-bold block leading-none">Giao hỏa tốc 2h</span>
                    <span class="font-body-sm text-[11px] text-secondary">Khu vực nội thành</span>
                </div>
            </div>

            <div class="p-3 rounded-xl bg-surface-container-low flex items-center gap-space-xs">
                <div class="w-9 h-9 rounded-full bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-[20px]">workspace_premium</span>
                </div>
                <div>
                    <span class="font-title-md text-title-md text-on-surface font-bold block leading-none">+485 Điểm Atelier</span>
                    <span class="font-body-sm text-[11px] text-secondary">Tích lũy khi hoàn tất</span>
                </div>
            </div>

            <div class="p-3 rounded-xl bg-surface-container-low flex items-center gap-space-xs">
                <div class="w-9 h-9 rounded-full bg-surface-container-highest text-primary flex items-center justify-center flex-shrink-0">
                    <span class="material-symbols-outlined text-[20px]">photo_camera</span>
                </div>
                <div>
                    <span class="font-title-md text-title-md text-on-surface font-bold block leading-none">Duyệt Ảnh Thật</span>
                    <span class="font-body-sm text-[11px] text-secondary">Trước khi đóng gói</span>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. FILTER & SORT BAR -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-md">
        <!-- Filter Category Tabs -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
            <button type="button" onclick="filterWishlist('all', this)" class="filter-tab active px-4 py-2 rounded-full bg-primary text-on-primary font-title-sm text-title-sm shadow-sm transition-all whitespace-nowrap">
                Tất cả (6)
            </button>
            <button type="button" onclick="filterWishlist('bouquet', this)" class="filter-tab px-4 py-2 rounded-full bg-surface-container-low text-secondary hover:bg-surface-container font-title-sm text-title-sm transition-all whitespace-nowrap">
                Bó hoa tươi (2)
            </button>
            <button type="button" onclick="filterWishlist('box', this)" class="filter-tab px-4 py-2 rounded-full bg-surface-container-low text-secondary hover:bg-surface-container font-title-sm text-title-sm transition-all whitespace-nowrap">
                Giỏ &amp; Hộp hoa (2)
            </button>
            <button type="button" onclick="filterWishlist('bespoke', this)" class="filter-tab px-4 py-2 rounded-full bg-surface-container-low text-secondary hover:bg-surface-container font-title-sm text-title-sm transition-all whitespace-nowrap">
                Thiết kế cao cấp (2)
            </button>
        </div>

        <!-- Sort Select -->
        <div class="flex items-center gap-2 flex-shrink-0">
            <span class="font-body-sm text-body-sm text-secondary">Sắp xếp:</span>
            <div class="relative">
                <select class="px-space-md py-2 rounded-full bg-surface-container-lowest border border-outline-variant/40 font-title-sm text-title-sm text-on-surface focus:outline-none focus:ring-1 focus:ring-primary shadow-sm appearance-none pr-8 cursor-pointer">
                    <option selected>Mới lưu gần đây</option>
                    <option>Giá: Thấp đến Cao</option>
                    <option>Giá: Cao đến Thấp</option>
                    <option>Đánh giá cao nhất</option>
                </select>
                <span class="material-symbols-outlined text-[18px] text-outline absolute right-2.5 top-2.5 pointer-events-none">expand_more</span>
            </div>
        </div>
    </div>

