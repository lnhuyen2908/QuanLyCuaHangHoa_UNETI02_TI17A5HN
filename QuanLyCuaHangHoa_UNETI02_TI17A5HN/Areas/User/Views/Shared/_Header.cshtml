    var gioHang = maTaiKhoan.HasValue
        ? Context.Session.GetJson<List<CartItem>>(
            GioHangService.Key(maTaiKhoan.Value)) ?? new List<CartItem>()
        : new List<CartItem>();

    var soLuongGioHang = gioHang.Count(x => x.MaMau > 0 && x.SoLuong > 0);
