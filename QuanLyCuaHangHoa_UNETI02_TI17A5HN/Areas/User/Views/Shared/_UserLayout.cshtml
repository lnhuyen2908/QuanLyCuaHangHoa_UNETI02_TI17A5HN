      theme: {
        extend: {
          "colors": {
            "surface-bright": "#fff8f6",
            "surface-container-low": "#fbf2f0",
            "error-container": "#ffdad6",
            "on-secondary": "#ffffff",
            "outline": "#857374",
            "on-primary-container": "#fffbff",
            "on-primary": "#ffffff",
            "on-error-container": "#93000a",
            "on-secondary-fixed-variant": "#4e4446",
            "on-primary-fixed": "#3a0915",
            "surface-container": "#f5ecea",
            "on-tertiary-fixed": "#052100",
            "tertiary-container": "#5b7e4b",
            "surface-container-high": "#efe6e4",
            "on-background": "#1e1b1a",
            "on-tertiary-container": "#f8ffee",
            "primary": "#8a4853",
            "secondary": "#675c5d",
            "on-primary-fixed-variant": "#70343e",
            "surface-variant": "#e9e1df",
            "tertiary-fixed-dim": "#abd197",
            "tertiary-fixed": "#c7eeb1",
            "on-secondary-fixed": "#21191b",
            "on-surface-variant": "#524345",
            "surface-container-lowest": "#ffffff",
            "inverse-on-surface": "#f8efed",
            "outline-variant": "#d7c1c3",
            "primary-fixed-dim": "#ffb2bc",
            "secondary-fixed-dim": "#d2c3c5",
            "on-error": "#ffffff",
            "on-tertiary": "#ffffff",
            "on-secondary-container": "#6b6062",
            "inverse-primary": "#ffb2bc",
            "error": "#ba1a1a",
            "surface-container-highest": "#e9e1df",
            "tertiary": "#446435",
            "primary-fixed": "#ffd9dd",
            "surface-dim": "#e1d8d6",
            "surface": "#fff8f6",
            "surface-tint": "#8c4b55",
            "background": "#fff8f6",
            "secondary-container": "#ecdcde",
            "secondary-fixed": "#eedfe1",
            "on-surface": "#1e1b1a",
            "primary-container": "#a6606b",
            "on-tertiary-fixed-variant": "#2f4f22",
            "inverse-surface": "#342f2e"
          },
          "borderRadius": {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          "spacing": {
            "space-lg": "1.5rem",
            "margin-desktop": "3rem",
            "margin-mobile": "1rem",
            "space-md": "1rem",
            "gutter-sm": "1rem",
            "margin": "2rem",
            "gutter-lg": "2rem",
            "space-sm": "0.5rem",
            "space-xs": "0.25rem",
            "gutter": "1.5rem",
            "space-xl": "2.5rem"
          },
          "fontFamily": {
            "display-lg": ["Playfair Display"],
            "headline-lg-mobile": ["Playfair Display"],
            "headline-sm": ["Playfair Display"],
            "title-md": ["Plus Jakarta Sans"],
            "headline-md": ["Playfair Display"],
            "title-sm": ["Plus Jakarta Sans"],
            "body-md": ["Plus Jakarta Sans"],
            "body-lg": ["Plus Jakarta Sans"],
            "label-lg": ["Plus Jakarta Sans"],
            "label-md": ["Plus Jakarta Sans"],
            "display-lg-mobile": ["Playfair Display"],
            "headline-lg": ["Playfair Display"],
            "body-sm": ["Plus Jakarta Sans"]
          },
          "fontSize": {
            "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "600"}],
            "headline-lg-mobile": ["26px", {"lineHeight": "34px", "fontWeight": "600"}],
            "headline-sm": ["20px", {"lineHeight": "28px", "fontWeight": "500"}],
            "title-md": ["16px", {"lineHeight": "24px", "fontWeight": "600"}],
            "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "500"}],
            "title-sm": ["14px", {"lineHeight": "20px", "fontWeight": "600"}],
            "body-md": ["14px", {"lineHeight": "22px", "fontWeight": "400"}],
            "body-lg": ["16px", {"lineHeight": "26px", "fontWeight": "400"}],
            "label-lg": ["13px", {"lineHeight": "18px", "letterSpacing": "0.03em", "fontWeight": "600"}],
            "label-md": ["11px", {"lineHeight": "16px", "letterSpacing": "0.04em", "fontWeight": "600"}],
            "display-lg-mobile": ["34px", {"lineHeight": "42px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
            "headline-lg": ["32px", {"lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600"}],
