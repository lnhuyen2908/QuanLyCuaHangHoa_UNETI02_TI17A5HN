@{
    ViewData["Title"] = "Thanh toán chuyển khoản";

    var noiDung = (string)ViewBag.NoiDungChuyenKhoan;
    var maDon = (string)ViewBag.MaDon;
    decimal tongTien = (decimal)ViewBag.TongTien;
}

<div class="max-w-3xl mx-auto p-6 my-8 bg-white rounded-2xl shadow">

    <h1 class="text-2xl font-bold text-center mb-3">
        Thanh toán chuyển khoản ngân hàng
    </h1>

    <p class="text-center text-secondary mb-6">
        Đơn hàng: <strong>@maDon</strong>
    </p>

    <div class="text-center mt-6">
    <h2 class="text-lg font-bold mb-2">
        Quét mã QR để thanh toán
    </h2>

    <p class="text-sm text-gray-500 mb-5">
        Mở ứng dụng ngân hàng và quét mã bên dưới
    </p>

    <div class="inline-block bg-white p-5 rounded-3xl
                border border-gray-200 shadow-lg">

        <img src="/images/qr-ngan-hang.png"
             alt="Mã QR ngân hàng"
             class="w-64 h-64 object-contain mx-auto" />

        <div class="border-t border-gray-100 mt-4 pt-3">
            <p class="text-xs text-gray-500">
                THANH TOÁN ĐƠN HÀNG
            </p>

            <p class="font-bold text-gray-800 mt-1">
                @maDon
            </p>
        </div>
    </div>
</div>

    <div class="mt-6 space-y-4">

        <div class="p-4 bg-gray-100 rounded-xl">
            <p class="text-sm text-gray-600">Số tiền cần chuyển</p>
            <p class="text-2xl font-bold text-red-600">
                @tongTien.ToString("N0") VNĐ
            </p>
        </div>

        <div class="p-4 bg-gray-100 rounded-xl">
            <p class="text-sm text-gray-600 mb-2">
                Nội dung chuyển khoản
            </p>

            <div class="flex flex-col sm:flex-row gap-2">
                <input id="noiDungChuyenKhoan"
                       value="@noiDung"
                       readonly
                       class="flex-1 p-3 border rounded-lg bg-white" />

                <button type="button"
                        onclick="saoChepNoiDung()"
                        class="px-5 py-3 bg-blue-600 text-white rounded-lg">
                    Sao chép
                </button>
            </div>
        </div>

        <div class="p-4 bg-yellow-50 border border-yellow-300 rounded-xl">
            <p class="font-semibold">Lưu ý:</p>
            <p class="text-sm mt-1">
                Vui lòng chuyển đúng số tiền và nội dung ở trên.
                Nhân viên sẽ kiểm tra giao dịch ngân hàng và xác nhận
                thanh toán trên hệ thống.
            </p>
        </div>

        <a href="/User/Profile#orders"
           class="block text-center p-3 bg-gray-200 rounded-lg">
            Quay lại đơn hàng
        </a>

    </div>
</div>

<script>
    function saoChepNoiDung() {
        const input = document.getElementById("noiDungChuyenKhoan");

        input.select();
        input.setSelectionRange(0, 99999);

        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(input.value)
                .then(() => alert("Đã sao chép nội dung chuyển khoản!"))
                .catch(() => {
                    document.execCommand("copy");
                    alert("Đã sao chép nội dung chuyển khoản!");
                });
        } else {
            document.execCommand("copy");
            alert("Đã sao chép nội dung chuyển khoản!");
        }
    }
</script>