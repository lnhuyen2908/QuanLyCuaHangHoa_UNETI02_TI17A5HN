@section Scripts {
    <script>
        const cardTextArea = document.getElementById('card_content');
        const charCountEl = document.getElementById('cardCharCount');

        if (cardTextArea && charCountEl) {
            cardTextArea.addEventListener('input', function () {
                charCountEl.innerText = `${cardTextArea.value.length}/300 ký tự`;
            });
        }

        function setCardPreset(type) {
            if (!cardTextArea) return;
            if (type === 'Sinh nhật') {
                cardTextArea.value = 'Chúc mừng sinh nhật Phương Thảo! Chúc em luôn rực rỡ, kiêu hãnh và ngập tràn hạnh phúc như những bông hoa xinh đẹp nhất hôm nay. Yêu em thật nhiều!';
            } else if (type === 'Tình yêu') {
                cardTextArea.value = 'Gửi em người con gái anh yêu nhất. Cảm ơn em đã đến và làm cho mỗi ngày của anh trở nên ngập tràn hương sắc tình yêu.';
            } else if (type === 'Khai trương') {
                cardTextArea.value = 'Kính chúc Quý công ty Khai trương Hồng Phát, Mã Đáo Thành Công, Vạn Sự Hanh Thông và Kinh Doanh Phát Đạt!';
            }
            if (charCountEl) {
                charCountEl.innerText = `${cardTextArea.value.length}/300 ký tự`;
            }
        }

        function applyCheckoutVoucher() {
            const input = document.getElementById('voucher_input');
            const badge = document.getElementById('checkoutVoucherBadge');
            const discountRow = document.getElementById('discountRow');
            const totalText = document.getElementById('checkoutTotalText');

            if (input && input.value.trim().toUpperCase() === 'ATELIERSPRING') {
                if (badge) badge.classList.remove('hidden');
                if (discountRow) discountRow.classList.remove('hidden');
                if (totalText) totalText.innerText = '2.300.000đ';
                alert('Áp dụng voucher ATELIERSPRING thành công! Giảm 100.000đ.');
            } else {
                alert('Mã ưu đãi không hợp lệ.');
            }
        }

        function removeCheckoutVoucher() {
            const badge = document.getElementById('checkoutVoucherBadge');
            const discountRow = document.getElementById('discountRow');
            const totalText = document.getElementById('checkoutTotalText');

            if (badge) badge.classList.add('hidden');
            if (discountRow) discountRow.classList.add('hidden');
            if (totalText) totalText.innerText = '2.400.000đ';
        }

        function submitOrder() {
            const termsCheck = document.getElementById('termsCheck');
            if (termsCheck && !termsCheck.checked) {
                alert('Vui lòng đồng ý với Điều khoản dịch vụ và Chính sách bảo đảm hoa tươi trước khi đặt hàng.');
                return;
            }
            alert('Đặt hàng thành công! Đơn hàng của bạn đã được chuyển đến Bàn cắm hoa. Nhân viên sẽ liên hệ gửi ảnh hoa thực tế qua Zalo trước khi giao.');
            window.location.href = '@Url.Action("Index", "Home")';
        }
    </script>
}
