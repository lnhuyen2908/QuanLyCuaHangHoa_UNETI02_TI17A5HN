@{
    ViewData["Title"] = "Thanh toán & Đặt hoa - Web quản lý hoa tươi";
}

<!-- BREADCRUMB & PROGRESS STEPPER -->
<section class="border-b border-outline-variant/40 bg-surface-container-lowest/60">
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-6">
        <!-- Stepper 3 Bước -->
        <div class="max-w-3xl mx-auto py-2">
            <div class="grid grid-cols-3 relative">
                <!-- Connector Lines -->
                <div class="absolute top-4 left-[16.66%] right-[16.66%] h-[2px] -z-0 bg-outline-variant/40">
                    <div class="h-full bg-primary" style="width: 50%;"></div>
                </div>
                <!-- Step 1: Hoàn thành -->
                <div class="flex flex-col items-center relative z-10">
                    <a class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-sm" asp-controller="Home" asp-action="Cart">
                        <span class="material-symbols-outlined text-[18px]">check</span>
                    </a>
                    <span class="mt-2 text-title-sm text-primary font-medium">1. Giỏ hàng</span>
                    <span class="text-[12px] text-secondary font-label-md">Đã chọn 2 tác phẩm</span>
                </div>
                <!-- Step 2: Đang thực hiện -->
                <div class="flex flex-col items-center relative z-10">
                    <div class="w-8 h-8 rounded-full bg-primary text-on-primary ring-4 ring-primary-fixed flex items-center justify-center font-bold text-sm shadow-md">
                        2
                    </div>
                    <span class="mt-2 text-title-sm text-primary font-semibold">2. Giao nhận &amp; Lời chúc</span>
                    <span class="text-[12px] text-primary/80 font-label-md font-medium">Đang tiến hành</span>
                </div>
                <!-- Step 3: Chờ hoàn tất -->
                <div class="flex flex-col items-center relative z-10">
                    <div class="w-8 h-8 rounded-full bg-surface-container border border-outline-variant text-secondary flex items-center justify-center font-medium text-sm">
                        3
                    </div>
                    <span class="mt-2 text-title-sm text-secondary">3. Xác nhận &amp; Đơn hoa</span>
                    <span class="text-[12px] text-outline font-label-md">Chờ xử lý</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MAIN CHECKOUT 2-COLUMN SECTION -->
<section class="max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-8 md:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- CỘT TRÁI (LEFT COLUMN - 7 COLS): Giao nhận & Dịch vụ cá nhân hóa -->
        <div class="lg:col-span-7 space-y-8">
            <!-- KHỐI 1: Thông tin người đặt hoa -->
            <div class="bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-6 md:p-8 shadow-sm">
                <div class="flex items-center justify-between pb-4 border-b border-outline-variant/30 mb-6">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-full border border-primary/30 bg-primary/10 text-primary flex items-center justify-center font-semibold text-sm">1</span>
                        <div>
                            <h2 class="font-headline-sm text-headline-sm text-on-surface">Thông tin người đặt hoa</h2>
                            <p class="font-body-sm text-secondary">Thông báo tình trạng xử lý đơn sẽ gửi về đây</p>
                        </div>
                    </div>
                    <span class="font-label-md text-xs px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant">Bắt buộc</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5" for="sender_name">Họ và tên người đặt *</label>
                        <input class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md" id="sender_name" placeholder="Ví dụ: Trần Minh Tâm" type="text" value="Lê Nguyễn Hoàng Anh">
                    </div>
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5" for="sender_phone">Số điện thoại *</label>
                        <input class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md" id="sender_phone" placeholder="Số điện thoại nhận SMS cập nhật" type="tel" value="0918 345 678">
                    </div>
                    <div class="md:col-span-2">
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5" for="sender_email">Email nhận hóa đơn VAT điện tử</label>
                        <input class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md" id="sender_email" placeholder="name@company.com" type="email" value="hoanganh.lenguyen@gmail.com">
                    </div>
                </div>
                <!-- Toggle Người gửi bí mật -->
                <div class="mt-5 p-4 rounded-xl bg-surface-container-low border border-outline-variant/40 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-full border border-primary/30 bg-primary/10 text-primary flex items-center justify-center font-semibold text-sm">1</span>
                        <div>
                            <span class="font-title-sm text-title-sm text-on-surface block">Giao ẩn danh / Người gửi bí mật</span>
                            <span class="font-body-sm text-secondary text-xs">Web quản lý hoa tươi sẽ không ghi thông tin người gửi trên thiệp và đơn vận chuyển</span>
                        </div>
                    </div>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input class="sr-only peer" type="checkbox" value="">
                        <div class="w-11 h-6 bg-surface-container-highest peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-primary"></div>
                    </label>
                </div>
            </div>

            <!-- KHỐI 2: Thông tin người nhận hoa & Địa chỉ giao -->
            <div class="bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-6 md:p-8 shadow-sm">
                <div class="flex items-center justify-between pb-4 border-b border-outline-variant/30 mb-6">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-full border border-primary/30 bg-primary/10 text-primary flex items-center justify-center font-semibold text-sm">2</span>
                        <div>
                            <h2 class="font-headline-sm text-headline-sm text-on-surface">Thông tin người nhận hoa</h2>
                            <p class="font-body-sm text-secondary">Địa chỉ trao gửi tác phẩm nghệ thuật tận tay</p>
                        </div>
                    </div>
                    <!-- Checkbox: Người nhận chính là tôi -->
                    <label class="inline-flex items-center gap-2 cursor-pointer font-title-sm text-xs text-primary hover:text-primary-container">
                        <input class="w-4 h-4 rounded border-outline-variant text-primary focus:ring-primary/40" type="checkbox">
                        <span class="">Người nhận chính là tôi</span>
                    </label>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5" for="recipient_name">Họ và tên người nhận *</label>
                        <input class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md" id="recipient_name" placeholder="Tên người nhận hoa" type="text" value="Vũ Phương Thảo">
                    </div>
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5" for="recipient_phone">Số điện thoại người nhận *</label>
                        <input class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md" id="recipient_phone" placeholder="Shipper sẽ gọi trước khi giao 15p" type="tel" value="0934 892 115">
                    </div>
                    <div class="md:col-span-2">
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5" for="recipient_address">Địa chỉ chi tiết (Số nhà, tòa nhà, tên đường) *</label>
                        <input class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md" id="recipient_address" placeholder="Ví dụ: Tầng 8, Tòa nhà Vincom, 72 Lê Thánh Tôn" type="text" value="Căn hộ 14.02, Tháp B, Saigon Centre, 65 Lê Lợi">
                    </div>
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5">Tỉnh / Thành phố *</label>
                        <select class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md">
                            <option selected="">TP. Hồ Chí Minh</option>
                            <option>Hà Nội</option>
                            <option>Đà Nẵng</option>
                            <option>Hải Phòng</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5">Quận / Huyện *</label>
                        <select class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md">
                            <option selected="">Quận 1</option>
                            <option>Quận 3</option>
                            <option>Quận 2 (TP. Thủ Đức)</option>
                            <option>Quận Bình Thạnh</option>
                            <option>Quận Phú Nhuận</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- KHỐI 3: Thời gian giao hoa mong muốn -->
            <div class="bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-6 md:p-8 shadow-sm">
                <div class="flex items-center gap-3 pb-4 border-b border-outline-variant/30 mb-6">
                    <span class="w-8 h-8 rounded-full border border-primary/30 bg-primary/10 text-primary flex items-center justify-center font-semibold text-sm">3</span>
                    <div>
                        <h2 class="font-headline-sm text-headline-sm text-on-surface">Thời gian giao hoa mong muốn</h2>
                        <p class="font-body-sm text-secondary">Đảm bảo hoa luôn nở rộ tươi mới đúng thời khắc ý nghĩa</p>
                    </div>
                </div>
                <!-- Chọn ngày -->
                <div class="mb-5">
                    <label class="block font-title-sm text-title-sm text-on-surface mb-2.5">Ngày nhận hoa *</label>
                    <div class="grid grid-cols-3 gap-3">
                        <label class="border-2 border-primary bg-primary/5 rounded-xl p-3.5 text-center cursor-pointer block transition-all shadow-sm">
                            <input checked="" class="sr-only" name="delivery_date" type="radio">
                            <span class="font-label-md text-xs text-primary font-semibold uppercase block">Hôm nay</span>
                            <span class="font-title-sm text-on-surface block mt-0.5">24 Tháng 03</span>
                        </label>
                        <label class="border border-outline-variant/80 hover:border-primary/60 bg-surface-bright rounded-xl p-3.5 text-center cursor-pointer block transition-all">
                            <input class="sr-only" name="delivery_date" type="radio">
                            <span class="font-label-md text-xs text-secondary block uppercase">Ngày mai</span>
                            <span class="font-title-sm text-on-surface block mt-0.5">25 Tháng 03</span>
                        </label>
                        <label class="border border-outline-variant/80 hover:border-primary/60 bg-surface-bright rounded-xl p-3.5 text-center cursor-pointer block transition-all flex flex-col justify-center items-center">
                            <input class="sr-only" name="delivery_date" type="radio">
                            <div class="flex items-center gap-1 text-secondary">
                                <span class="material-symbols-outlined text-[16px]">calendar_today</span>
                                <span class="font-label-md text-xs uppercase">Chọn ngày khác</span>
                            </div>
                            <span class="font-body-sm text-xs text-secondary mt-0.5">Theo lịch hẹn</span>
                        </label>
                    </div>
                </div>
                <!-- Chọn khung giờ -->
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-2.5">Khung giờ giao hoa chính xác *</label>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <label class="border border-outline-variant/80 rounded-xl p-3.5 flex items-center justify-between cursor-pointer hover:border-primary/60 bg-surface-bright transition-all">
                            <div class="flex items-center gap-2.5">
                                <input class="text-primary focus:ring-primary/40" name="delivery_time" type="radio">
                                <div>
                                    <span class="font-title-sm text-sm text-on-surface block">Giao hỏa tốc 2H</span>
                                    <span class="font-body-sm text-xs text-tertiary">Ưu tiên nghệ nhân cắm ngay</span>
                                </div>
                            </div>
                            <span class="material-symbols-outlined text-primary text-[20px]">bolt</span>
                        </label>
                        <label class="border-2 border-primary bg-primary/5 rounded-xl p-3.5 flex items-center justify-between cursor-pointer transition-all shadow-sm">
                            <div class="flex items-center gap-2.5">
                                <input checked="" class="text-primary focus:ring-primary/40" name="delivery_time" type="radio">
                                <div>
                                    <span class="font-title-sm text-sm text-on-surface block">Sáng (08:00 - 10:00)</span>
                                    <span class="font-body-sm text-xs text-secondary">Thích hợp hoa sinh nhật sáng</span>
                                </div>
                            </div>
                            <span class="material-symbols-outlined text-primary text-[20px]">wb_sunny</span>
                        </label>
                        <label class="border border-outline-variant/80 rounded-xl p-3.5 flex items-center justify-between cursor-pointer hover:border-primary/60 bg-surface-bright transition-all">
                            <div class="flex items-center gap-2.5">
                                <input class="text-primary focus:ring-primary/40" name="delivery_time" type="radio">
                                <div>
                                    <span class="font-title-sm text-sm text-on-surface block">Chiều (14:00 - 16:00)</span>
                                    <span class="font-body-sm text-xs text-secondary">Giao văn phòng &amp; đối tác</span>
                                </div>
                            </div>
                            <span class="material-symbols-outlined text-secondary text-[20px]">schedule</span>
                        </label>
                        <label class="border border-outline-variant/80 rounded-xl p-3.5 flex items-center justify-between cursor-pointer hover:border-primary/60 bg-surface-bright transition-all">
                            <div class="flex items-center gap-2.5">
                                <input class="text-primary focus:ring-primary/40" name="delivery_time" type="radio">
                                <div>
                                    <span class="font-title-sm text-sm text-on-surface block">Tối (18:00 - 20:00)</span>
                                    <span class="font-body-sm text-xs text-secondary">Tiệc tối lãng mạn &amp; gia đình</span>
                                </div>
                            </div>
                            <span class="material-symbols-outlined text-secondary text-[20px]">bedtime</span>
                        </label>
                    </div>
                </div>
                <!-- Cam kết bảo quản đặc thù -->
                <div class="mt-5 p-4 rounded-xl bg-tertiary/10 border border-tertiary/20 flex items-start gap-3">
                    <span class="material-symbols-outlined text-tertiary text-[22px] flex-shrink-0 mt-0.5">ac_unit</span>
                    <div class="text-xs text-on-surface">
                        <strong class="font-semibold text-tertiary block mb-0.5">Quy chuẩn vận chuyển độc quyền Web quản lý hoa tươi:</strong>
                        Hoa được chở bằng thùng xe điều hòa chuyên dụng nhiệt độ 18°C-22°C. Cam kết không dập cánh hoa, kèm túi giữ ẩm và gói nước dưỡng hoa chưng bền.
                    </div>
                </div>
            </div>

            <!-- KHỐI 4: Thiệp chúc mừng & Dịch vụ đi kèm -->
            <div class="bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-6 md:p-8 shadow-sm">
                <div class="flex items-center gap-3 pb-4 border-b border-outline-variant/30 mb-6">
                    <span class="w-8 h-8 rounded-full border border-primary/30 bg-primary/10 text-primary flex items-center justify-center font-semibold text-sm">4</span>
                    <div>
                        <h2 class="font-headline-sm text-headline-sm text-on-surface">Thiệp chúc mừng &amp; Lời nhắn nghệ thuật</h2>
                        <p class="font-body-sm text-secondary">Trao gửi tâm tư qua từng con chữ thư pháp trau chuốt</p>
                    </div>
                </div>
                <!-- Mẫu thiệp -->
                <div class="mb-5">
                    <label class="block font-title-sm text-title-sm text-on-surface mb-2.5">Chọn mẫu thiệp nghệ thuật *</label>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <label class="border-2 border-primary bg-primary/5 rounded-xl p-3 cursor-pointer block transition-all shadow-sm">
                            <input checked="" class="sr-only" name="card_style" type="radio">
                            <div class="flex items-center justify-between mb-1">
                                <span class="material-symbols-outlined text-primary text-[20px]">mail</span>
                                <span class="bg-tertiary-fixed text-on-tertiary-fixed text-[10px] font-bold px-1.5 py-0.5 rounded-full uppercase">Miễn phí</span>
                            </div>
                            <span class="font-title-sm text-sm text-on-surface block">Thiệp Ép Kim Luxe</span>
                            <span class="font-body-sm text-xs text-secondary">Giấy mỹ thuật dập nổi</span>
                        </label>
                        <label class="border border-outline-variant/80 hover:border-primary/60 bg-surface-bright rounded-xl p-3 cursor-pointer block transition-all">
                            <input class="sr-only" name="card_style" type="radio">
                            <div class="flex items-center justify-between mb-1">
                                <span class="material-symbols-outlined text-secondary text-[20px]">history_edu</span>
                                <span class="bg-secondary-container text-on-secondary-container text-[10px] font-medium px-1.5 py-0.5 rounded-full uppercase">Tùy chọn</span>
                            </div>
                            <span class="font-title-sm text-sm text-on-surface block">Thiệp Giấy Dó Thủ Công</span>
                            <span class="font-body-sm text-xs text-secondary">Sợi vỏ cây tự nhiên</span>
                        </label>
                        <label class="border border-outline-variant/80 hover:border-primary/60 bg-surface-bright rounded-xl p-3 cursor-pointer block transition-all">
                            <input class="sr-only" name="card_style" type="radio">
                            <div class="flex items-center justify-between mb-1">
                                <span class="material-symbols-outlined text-secondary text-[20px]">mark_email_read</span>
                                <span class="bg-primary-fixed text-primary text-[10px] font-bold px-1.5 py-0.5 rounded-full">+50.000đ</span>
                            </div>
                            <span class="font-title-sm text-sm text-on-surface block">Thư Tay Niêm Phong Sáp</span>
                            <span class="font-body-sm text-xs text-secondary">Đóng dấu sáp hoàng gia</span>
                        </label>
                    </div>
                </div>
                <!-- Lời chúc -->
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <label class="font-title-sm text-title-sm text-on-surface" for="card_content">Nội dung thiệp chúc mừng *</label>
                        <div class="flex items-center gap-1.5 text-xs text-primary font-medium">
                            <span class="material-symbols-outlined text-[15px]">auto_awesome</span>
                            <span class="">Gợi ý lời chúc:</span>
                            <button class="underline hover:text-primary-container" onclick="setCardPreset('Sinh nhật')" type="button">Sinh nhật</button>
                            <button class="underline hover:text-primary-container" onclick="setCardPreset('Tình yêu')" type="button">Tình yêu</button>
                            <button class="underline hover:text-primary-container" onclick="setCardPreset('Khai trương')" type="button">Khai trương</button>
                        </div>
                    </div>
                    <textarea class="w-full px-4 py-3 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface font-body-md transition-all resize-none" id="card_content" placeholder="Nhập lời chúc bạn muốn nghệ nhân viết tay gửi tặng người nhận..." rows="3">Chúc mừng sinh nhật Phương Thảo! Chúc em luôn rực rỡ, kiêu hãnh và ngập tràn hạnh phúc như những bông hoa xinh đẹp nhất hôm nay. Yêu em thật nhiều!</textarea>
                    <div class="flex justify-between items-center mt-1 text-xs text-secondary">
                        <span class="">Nghệ nhân Web quản lý hoa tươi sẽ nắn nót viết tay bằng bút máy mực sepia</span>
                        <span id="cardCharCount" class="">138/300 ký tự</span>
                    </div>
                </div>
                <!-- Duyệt ảnh hoa trước khi giao -->
                <div class="mt-5 p-4 rounded-xl bg-surface-container-low border border-primary/20 flex items-center gap-3">

                    <div class="flex-1">
                        <span class="font-title-sm text-sm text-primary font-semibold block">Duyệt ảnh tác phẩm thực tế trước khi xuất xưởng</span>
                        <p class="font-body-sm text-xs text-on-surface-variant mt-0.5">Web quản lý hoa tươi sẽ chụp ảnh 360° tác phẩm hoàn thiện gửi qua Zalo/SMS cho bạn duyệt trước khi shipper nhận hoa 30 phút.</p>
                    </div>
                    <span class="material-symbols-outlined text-tertiary text-[20px]">check_circle</span>
                </div>
            </div>

            <!-- KHỐI 5: Phương thức thanh toán linh hoạt -->
