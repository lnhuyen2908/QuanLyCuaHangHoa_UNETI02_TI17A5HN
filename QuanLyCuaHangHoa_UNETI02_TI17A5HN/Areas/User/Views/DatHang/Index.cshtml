@* Họ và tên: Đặng Thị Mai Hương
Mã sinh viên: 23103100293
Nội dung thực hiện: Kết nối giao diện gốc với dữ liệu DB và hành động POST hợp lệ. *@
@model QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels.DatHangViewModel
@* DatHangViewModel chỉ chứa thông tin nhận hàng; tổng tiền được tính từ giỏ + giá DB. *@
@using QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels
@using QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models
@using QuanLyCuaHangHoa_UNETI02_TI17A5HN.Services

@{
    var cartItems = (List<CartDisplayItem>?)ViewBag.Items ?? new();
    var tamTinh = cartItems.Sum(x => x.ThanhTien);
    var phiGiao = DonHangService.TinhPhiGiaoHang(Model.HinhThucNhan);

    var chonTuGio = ViewBag.ChonTuGio is bool b && b;
    var maMauChon = (List<int>?)ViewBag.MaMauChon ?? new();
    var muaNgay = ViewBag.MuaNgay is bool bMuaNgay && bMuaNgay;
}

@{
    ViewData["Title"] = "Thanh toán & Đặt hoa - Web quản lý hoa tươi";
}

<!-- BREADCRUMB & PROGRESS STEPPER -->
<section class="border-b border-outline-variant/40 bg-surface-container-lowest/60">
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-6">

        <!-- Stepper 3 Bước -->
        <div class="max-w-3xl mx-auto py-2">
            <div class="grid grid-cols-3 relative">

                <!-- Connector Lines -->
                <div class="absolute top-4 left-[16.66%] right-[16.66%] h-[2px] -z-0 bg-outline-variant/40">
                    <div class="h-full bg-primary" style="width: 50%;"></div>
                </div>

                <!-- Step 1: Hoàn thành -->
                <div class="flex flex-col items-center relative z-10">
                    <a class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-sm"
                       href="/User/Cart">
                        <span class="material-symbols-outlined text-[18px]">check</span>
                    </a>
                    <span class="mt-2 text-title-sm text-primary font-medium">1. Giỏ hàng</span>
                    <span class="text-[12px] text-secondary font-label-md">Đã chọn @cartItems.Count tác phẩm</span>
                </div>

                <!-- Step 2: Đang thực hiện -->
                <div class="flex flex-col items-center relative z-10">
                    <div class="w-8 h-8 rounded-full bg-primary text-on-primary ring-4 ring-primary-fixed flex items-center justify-center font-bold text-sm shadow-md">
                        2
                    </div>
                    <span class="mt-2 text-title-sm text-primary font-semibold">2. Giao nhận &amp; Lời chúc</span>
                    <span class="text-[12px] text-primary/80 font-label-md font-medium">Đang tiến hành</span>
                </div>

                <!-- Step 3: Chờ hoàn tất -->
                <div class="flex flex-col items-center relative z-10">
                    <div class="w-8 h-8 rounded-full bg-surface-container border border-outline-variant text-secondary flex items-center justify-center font-medium text-sm">
                        3
                    </div>
                    <span class="mt-2 text-title-sm text-secondary">3. Xác nhận &amp; Đơn hoa</span>
                    <span class="text-[12px] text-outline font-label-md">Chờ xử lý</span>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="max-w-7xl mx-auto px-6 mt-3 text-error" asp-validation-summary="All"></div>

<!-- MAIN CHECKOUT 2-COLUMN SECTION -->
<section class="max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-8 md:py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

        @* Form thật gửi POST tạo đơn. AntiForgeryToken ngăn yêu cầu giả mạo từ website khác. *@
        <form id="checkoutSubmitForm"
              action="/User/Checkout"
              method="post"
              class="hidden">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="muaNgay"
                   value="@(muaNgay ? "true" : "false")" />

            <input type="hidden"
                   name="chonTuGio"
                   value="@(chonTuGio ? "true" : "false")" />

            @if (chonTuGio)
            {
                foreach (var id in maMauChon)
                {
                    <input type="hidden"
                           name="maMauChon"
                           value="@id" />
                }
            }
        </form>

        <!-- CỘT TRÁI (LEFT COLUMN - 7 COLS): Giao nhận & Dịch vụ cá nhân hóa -->
        <div class="lg:col-span-7 space-y-8">

            <!-- KHỐI 1: Thông tin người đặt hoa -->
            <div class="bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-6 md:p-8 shadow-sm">
                <div class="flex items-center justify-between pb-4 border-b border-outline-variant/30 mb-6">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-full border border-primary/30 bg-primary/10 text-primary flex items-center justify-center font-semibold text-sm">1</span>
                        <div>
                            <h2 class="font-headline-sm text-headline-sm text-on-surface">Thông tin người đặt hoa</h2>
                            <p class="font-body-sm text-secondary">Thông báo tình trạng xử lý đơn sẽ gửi về đây</p>
                        </div>
                    </div>
                    <span class="font-label-md text-xs px-2.5 py-1 rounded-full bg-surface-container text-on-surface-variant">Bắt buộc</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5" for="sender_name">Họ và tên người đặt *</label>
                        <input class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md"
                               id="sender_name"
                               placeholder="Ví dụ: Trần Minh Tâm"
                               type="text"
                               value="@(ViewBag.TenNguoiDat)"
                               readonly>
                    </div>
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5" for="sender_phone">Số điện thoại *</label>
                        <input class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md"
                               id="sender_phone"
                               placeholder="Số điện thoại nhận SMS cập nhật"
                               type="tel"
                               value="@(ViewBag.SdtNguoiDat)"
                               readonly>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5" for="sender_email">Email liên hệ (theo tài khoản)</label>
                        <input class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md"
                               id="sender_email"
                               placeholder="name@company.com"
                               type="email"
                               value="@(ViewBag.EmailNguoiDat)"
                               readonly>
                    </div>
                </div>
                <p class="mt-5 text-secondary text-xs">Tên người đặt được lấy từ tài khoản; thông tin người nhận nhập ở bước bên dưới.</p>
            </div>

            <!-- Ngày giờ nhận/giao dự kiến -->
            <div class="p-4 border border-primary/30 rounded-xl bg-surface-container-lowest mb-4">
                <label class="font-title-sm text-on-surface block mb-2" for="ThoiGianNhanGiao">Ngày giờ nhận/giao dự kiến *</label>
                <input id="ThoiGianNhanGiao"
                       type="datetime-local"
                       name="ThoiGianNhanGiao"
                       form="checkoutSubmitForm"
                       required
                       min="@DateTime.Now.AddMinutes(30).ToString("yyyy-MM-ddTHH:mm")"
                       value="@(Model.ThoiGianNhanGiao?.ToString("yyyy-MM-ddTHH:mm"))"
                       class="w-full p-3 rounded-lg border border-outline-variant" />
                <span class="text-error text-xs" asp-validation-for="ThoiGianNhanGiao"></span>
            </div>

            <!-- Hình thức nhận hàng -->
            <div class="p-4 bg-surface-container-lowest rounded-xl border border-outline-variant/40 mb-4">
                <p class="font-title-sm mb-2">Hình thức nhận hàng *</p>
                <label class="inline-flex items-center gap-2 mr-5">
                    <input type="radio"
                           form="checkoutSubmitForm"
                           name="HinhThucNhan"
                           value="Giao tận nơi"
                    @(Model.HinhThucNhan != HinhThucNhanConst.KhachDenNhan ? "checked" : "") />
                    Giao tận nơi
                </label>
                <label class="inline-flex items-center gap-2">
                    <input type="radio"
                           form="checkoutSubmitForm"
                           name="HinhThucNhan"
                           value="Khách đến nhận"
                    @(Model.HinhThucNhan == HinhThucNhanConst.KhachDenNhan ? "checked" : "") />
                    Khách đến nhận
                </label>
            </div>

            <!-- KHỐI 2: Thông tin người nhận hoa & Địa chỉ giao -->
            <div class="bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-6 md:p-8 shadow-sm">
                <div class="flex items-center justify-between pb-4 border-b border-outline-variant/30 mb-6">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-full border border-primary/30 bg-primary/10 text-primary flex items-center justify-center font-semibold text-sm">2</span>
                        <div>
                            <h2 class="font-headline-sm text-headline-sm text-on-surface">Thông tin người nhận hoa</h2>
                            <p class="font-body-sm text-secondary">Địa chỉ trao gửi tác phẩm nghệ thuật tận tay</p>
                        </div>
                    </div>
                    <!-- Checkbox đồng bộ người nhận với hồ sơ người đặt. -->
                    <label class="inline-flex items-center gap-2 cursor-pointer font-title-sm text-xs text-primary hover:text-primary-container">
                        <input type="checkbox"
                               name="NguoiNhanLaNguoiDat"
                               value="true"
                               form="checkoutSubmitForm"
                               id="NguoiNhanLaNguoiDat"
                               class="w-4 h-4 rounded border-outline-variant text-primary focus:ring-primary/40"
                               checked="@(Model.NguoiNhanLaNguoiDat ? "checked" : null)" />
                        <input type="hidden" name="NguoiNhanLaNguoiDat" value="false" form="checkoutSubmitForm" />
                        <span class="">Người nhận chính là tôi</span>
                    </label>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5" for="recipient_name">Họ và tên người nhận *</label>
                        <input class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md"
                               id="recipient_name"
                               maxlength="100"
                               required
                               placeholder="Tên người nhận hoa"
                               type="text"
                               name="NguoiNhan"
                               value="@(Model.NguoiNhan)"
                               form="checkoutSubmitForm"
                               readonly="@(Model.NguoiNhanLaNguoiDat ? "readonly" : null)">
                        <span class="text-error text-xs" asp-validation-for="NguoiNhan"></span>
                    </div>
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5" for="recipient_phone">Số điện thoại người nhận *</label>
                        <input class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md"
                               id="recipient_phone"
                               maxlength="15"
                               required
                               placeholder="Shipper sẽ gọi trước khi giao 15p"
                               type="tel"
                               name="SoDienThoaiNguoiNhan"
                               value="@(Model.SoDienThoaiNguoiNhan)"
                               form="checkoutSubmitForm"
                               readonly="@(Model.NguoiNhanLaNguoiDat ? "readonly" : null)">
                        <span class="text-error text-xs" asp-validation-for="SoDienThoaiNguoiNhan"></span>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1.5" for="recipient_address">Địa chỉ chi tiết (Số nhà, tòa nhà, tên đường) *</label>
                        <input class="w-full px-4 py-2.5 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface transition-all font-body-md"
                               id="recipient_address"
                               maxlength="250"
                               placeholder="Ví dụ: Tầng 8, Tòa nhà Vincom, 72 Lê Thánh Tôn"
                               type="text"
                               name="DiaChiGiao"
                               value="@(Model.DiaChiGiao)"
                               form="checkoutSubmitForm"
                               >
                        <span class="text-error text-xs" asp-validation-for="DiaChiGiao"></span>
                    </div>
                    <p class="md:col-span-2 text-secondary text-xs">
                        Nhập đầy đủ số nhà, phường/xã, quận/huyện và tỉnh/thành phố trong ô địa chỉ ở trên để tránh thất lạc.
                    </p>
                </div>
            </div>

            <!-- KHỐI 4: Thiệp chúc mừng & Dịch vụ đi kèm -->
            <div class="bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-6 md:p-8 shadow-sm">
                <div class="flex items-center gap-3 pb-4 border-b border-outline-variant/30 mb-6">
                    <span class="w-8 h-8 rounded-full border border-primary/30 bg-primary/10 text-primary flex items-center justify-center font-semibold text-sm">3</span>
                    <div>
                        <h2 class="font-headline-sm text-headline-sm text-on-surface">Lời nhắn chung cho toàn đơn (tùy chọn)</h2>
                        <p class="font-body-sm text-secondary">Trao gửi tâm tư qua từng con chữ thư pháp trau chuốt</p>
                    </div>
                </div>
                <p class="mb-3 text-secondary text-sm">Lời nhắn dưới đây áp dụng chung cho toàn đơn. Lời chúc riêng và giấy gói của từng mẫu được giữ riêng theo từng chi tiết sản phẩm.</p>

                <!-- Lời chúc -->
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <label class="font-title-sm text-title-sm text-on-surface" for="card_content">Lời nhắn áp dụng chung (nếu có)</label>
                        <div class="flex items-center gap-1.5 text-xs text-primary font-medium">
                            <span class="material-symbols-outlined text-[15px]">auto_awesome</span>
                            <span class="">Gợi ý lời chúc:</span>
                            <button class="underline hover:text-primary-container" onclick="setCardPreset('Sinh nhật')" type="button">Sinh nhật</button>
                            <button class="underline hover:text-primary-container" onclick="setCardPreset('Tình yêu')" type="button">Tình yêu</button>
                            <button class="underline hover:text-primary-container" onclick="setCardPreset('Khai trương')" type="button">Khai trương</button>
                        </div>
                    </div>
                    <textarea class="w-full px-4 py-3 rounded-xl border border-outline-variant/80 bg-surface-bright focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary text-on-surface font-body-md transition-all resize-none"
                              id="card_content"
                              name="LoiNhan"
                              form="checkoutSubmitForm"
                              maxlength="500"
                              placeholder="Ghi chú chung cho cả đơn. Lời chúc riêng từng mẫu đã nằm trong phần chi tiết sản phẩm..."
                              rows="3">@Model.LoiNhan</textarea>
                    <div class="flex justify-between items-center mt-1 text-xs text-secondary">
                        <span class="">Nghệ nhân Web quản lý hoa tươi sẽ nắn nót viết tay bằng bút máy mực sepia</span>
                        <span id="cardCharCount" class="">0/500 ký tự</span>
                    </div>
                </div>

                <!-- Duyệt ảnh hoa trước khi giao -->
                <div class="mt-5 p-4 rounded-xl bg-surface-container-low border border-primary/20 flex items-center gap-3">
                    <div class="flex-1">
                        <span class="font-title-sm text-sm text-primary font-semibold block">Duyệt ảnh tác phẩm thực tế trước khi xuất xưởng</span>
                        <p class="font-body-sm text-xs text-on-surface-variant mt-0.5">
                            Web quản lý hoa tươi sẽ chụp ảnh 360° tác phẩm hoàn thiện gửi qua Zalo/SMS cho bạn duyệt trước khi shipper nhận hoa 30 phút.
                        </p>
                    </div>
                    <span class="material-symbols-outlined text-tertiary text-[20px]">check_circle</span>
                </div>
            </div>

            @* Nguyễn Thị Đào - 23103100245
               Lựa chọn phương thức thanh toán
               Chỉ COD hoạt động, các hình thức khác sắp hỗ trợ *@

            <div class="bg-surface-container-lowest border border-outline-variant/60 rounded-2xl p-6 md:p-8 shadow-sm">

                <h2 class="font-headline-sm text-headline-sm text-on-surface mb-5">
                    Lựa chọn phương thức thanh toán
                </h2>

                <div class="space-y-4">

                    @* 1. Tiền mặt - Được sử dụng *@
                    <label class="flex items-start gap-3 p-5 border-2 border-emerald-700 bg-emerald-50/60 rounded-2xl cursor-pointer">

                        <input type="radio"
                               name="PhuongThucThanhToan"
                               value="@PhuongThucThanhToanConst.TienMat"
                               form="checkoutSubmitForm"
                               checked
                               required
                               class="mt-1 w-5 h-5 accent-emerald-700" />

                        <div class="flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                                <strong class="text-on-surface">
                                    Tiền mặt khi nhận hoa (COD)
                                </strong>

                                <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-2 py-1 rounded-full">
                                    ĐANG HỖ TRỢ
                                </span>
                            </div>

                            <p class="text-sm text-secondary mt-2">
                                Thanh toán tiền mặt khi nhận hoa tại nhà hoặc cửa hàng.
                            </p>

                            <p class="text-sm text-emerald-800 mt-3">
                                Đặt hàng ngay, chưa cần thanh toán trước.
                            </p>
                        </div>

                        <span class="material-symbols-outlined text-emerald-700">
                            payments
                        </span>
                    </label>

                    @* 2. Chuyển khoản - Chưa hỗ trợ *@
                    <div class="flex items-start gap-3 p-5 border border-outline-variant rounded-2xl bg-surface-container-low opacity-70">

                        <input type="radio" disabled class="mt-1 w-5 h-5" />

                        <div class="flex-1">
                            <strong>Chuyển khoản ngân hàng / VietQR</strong>
                            <p class="text-sm text-secondary mt-1">
                                Chưa hỗ trợ thanh toán qua mã QR.
                            </p>
                        </div>

                        <span class="material-symbols-outlined">
                            qr_code_2
                        </span>
                    </div>

                    @* 3. Ví điện tử - Chưa hỗ trợ *@
                    <div class="flex items-start gap-3 p-5 border border-outline-variant rounded-2xl bg-surface-container-low opacity-70">

                        <input type="radio" disabled class="mt-1 w-5 h-5" />

                        <div class="flex-1">
                            <strong>Ví điện tử</strong>
                            <p class="text-sm text-secondary mt-1">
                                Chưa hỗ trợ thanh toán bằng ví điện tử.
                            </p>
                        </div>

                        <span class="material-symbols-outlined">
                            account_balance_wallet
                        </span>
                    </div>

                    @* 4. Thẻ ngân hàng - Chưa hỗ trợ *@
                    <div class="flex items-start gap-3 p-5 border border-outline-variant rounded-2xl bg-surface-container-low opacity-70">

                        <input type="radio" disabled class="mt-1 w-5 h-5" />

                        <div class="flex-1">
                            <strong>Thẻ ngân hàng / Thẻ tín dụng</strong>
                            <p class="text-sm text-secondary mt-1">
                                Chưa hỗ trợ thanh toán bằng thẻ.
                            </p>
                        </div>

                        <span class="material-symbols-outlined">
                            credit_card
                        </span>
                    </div>

                </div>

                <span asp-validation-for="PhuongThucThanhToan"
                      class="text-error text-sm mt-3 block"></span>

            </div>
            @* KẾT THÚC BỔ SUNG - NGUYỄN THỊ ĐÀO *@

        </div>

        <!-- CỘT PHẢI (RIGHT COLUMN - 5 COLS): Sticky Order Summary & Tính tiền -->
        <div class="lg:col-span-5">
            <div class="sticky top-28 space-y-5">

                <!-- Tóm tắt đơn hàng -->
                <div class="bg-surface-container-lowest border border-outline-variant/60 rounded-3xl p-6 md:p-7 shadow-lg">
                    <div class="flex items-center justify-between pb-4 border-b border-outline-variant/30">
                        <div class="flex items-center gap-2">
                            <span class="material-symbols-outlined text-primary text-[22px]">shopping_bag</span>
                            <h3 class="font-headline-sm text-lg font-semibold text-on-surface">Tóm tắt đơn hàng</h3>
                        </div>
                        <span class="text-xs font-semibold text-primary px-2.5 py-0.5 rounded-full bg-primary-fixed">@cartItems.Count Tác phẩm</span>
                    </div>

                    <div class="py-4 space-y-3 border-b border-outline-variant/30">
                        @* Tóm tắt từng dòng giỏ (giá được nạp lại từ DB trước khi hiển thị). *@
                        @foreach (var item in cartItems)
                        {
                            <div class="flex gap-3 items-center">
                                <img src="@(item.HinhAnh ?? "/images/mau/mau01.jpg")"
                                     class="w-16 h-16 rounded-lg object-cover"
                                     alt="@item.TenMau" />
                                <div class="flex-1">
                                    <p class="font-title-sm text-on-surface">@item.TenMau</p>
                                    <p class="text-secondary text-xs">@item.SoLuong × @item.DonGia.ToString("N0")₫</p>
                                    @if (!string.IsNullOrWhiteSpace(item.GiayGoiRuyBang))
                                    {
                                        <p class="text-secondary text-xs">Giấy gói &amp; ruy-băng: @item.GiayGoiRuyBang</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.LoiChuc))
                                    {
                                        <p class="text-secondary text-xs">Lời chúc riêng: @item.LoiChuc</p>
                                    }
                                </div>
                                <p class="text-primary font-semibold">@item.ThanhTien.ToString("N0")₫</p>
                            </div>
                        }
                    </div>

                    <div class="py-4 space-y-2 border-b border-outline-variant/30 text-sm">
                        <div class="flex justify-between">
                            <span>Phí giao hàng</span>
                            <strong id="shippingFee">@phiGiao.ToString("N0")₫</strong>
                        </div>
                        <p class="text-xs text-secondary">
                            Chưa áp dụng voucher. Phí/phụ phí phát sinh chỉ được cập nhật theo quy trình của cửa hàng trước thanh toán.
                        </p>
                    </div>

                    <div class="flex items-center justify-between py-4">
                        <strong>TỔNG TIỀN DỰ KIẾN</strong>
                        <strong id="orderTotal" class="text-primary text-xl">
                            @((tamTinh + phiGiao).ToString("N0"))₫
                        </strong>
                    </div>

                    <!-- Checkbox Điều khoản -->
                    <div class="mt-4 pt-3 border-t border-outline-variant/20">
                        <label class="flex items-start gap-2.5 cursor-pointer text-xs text-on-surface-variant">
                            <input checked=""
                                   class="w-4 h-4 mt-0.5 rounded border-outline-variant text-primary focus:ring-primary/40"
                                   id="termsCheck"
                                   type="checkbox"
                                   required
                                   form="checkoutSubmitForm">
                            <span class="">Tôi xác nhận thông tin đặt hoa chính xác và đồng ý gửi yêu cầu đặt hàng đến cửa hàng.</span>
                        </label>
                    </div>

                    <!-- Nút CTA Thanh Toán -->
                    <div class="mt-5">
                        <button class="w-full py-4 px-6 rounded-2xl bg-primary hover:bg-primary-container text-on-primary font-semibold"
                                form="checkoutSubmitForm"
                                type="submit">
                            <span class="material-symbols-outlined text-[20px]">lock</span>
                            <span id="checkoutButtonTotal">
                                Xác nhận đặt hàng
                                (@((tamTinh + phiGiao).ToString("N0"))₫)
                                <br />
                                Chưa thu tiền
                            </span>
                            <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
                        </button>
                    </div>

                    <div class="mt-3 text-center">
                        <span class="inline-flex items-center gap-1.5 text-[11px] text-secondary font-label-md">
                            <span class="material-symbols-outlined text-[14px] text-tertiary">verified_user</span>
                            Đơn chỉ được ghi nhận sau khi gửi biểu mẫu thành công
                        </span>
                    </div>
                </div>

                <!-- Huy hiệu cam kết bảo chứng chất lượng -->
                <div class="bg-surface-container-low border border-outline-variant/40 rounded-2xl p-7 space-y-4">
                    <span class="font-label-md text-xs text-primary font-bold uppercase tracking-wider block">
                        Cam kết độc quyền Web quản lý hoa tươi:
                    </span>
                    <div class="flex items-start gap-2.5 text-xs text-on-surface">
                        <span class="material-symbols-outlined text-primary text-[18px] flex-shrink-0">replay</span>
                        <span class="">
                            <strong>Hoàn tiền 100% hoặc đổi hoa mới trong 24h</strong> nếu hoa bị dập nát, gãy cành hoặc không đúng tông màu thiết kế đã duyệt.
                        </span>
                    </div>
                    <div class="flex items-start gap-2.5 text-xs text-on-surface">
                        <span class="material-symbols-outlined text-primary text-[18px] flex-shrink-0">local_florist</span>
                        <span class="">
                            <strong>Độ tươi nguyên bản tối thiểu 5 - 7 ngày</strong>: 100% hoa loại 1 nhập trực tiếp từ Đà Lạt &amp; Hà Lan/Ecuador.
                        </span>
                    </div>
                    <div class="flex items-start gap-2.5 text-xs text-on-surface">
                        <span class="material-symbols-outlined text-primary text-[18px] flex-shrink-0">support_agent</span>
                        <span class="">
                            <strong>Hỗ trợ riêng 24/7</strong>: Hotline &amp; Zalo Atelier VIP <strong class="text-primary font-semibold">1900 8866</strong> luôn sẵn sàng.
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const phiGiaoTanNoi = @(DonHangService.PhiGiaoTanNoi.ToString(
                    System.Globalization.CultureInfo.InvariantCulture));
        const tamTinhDon = @(tamTinh.ToString(
                    System.Globalization.CultureInfo.InvariantCulture));

        const address = document.querySelector('[name="DiaChiGiao"]');

        function capNhatHinhThucNhan() {
            const hinhThuc = document.querySelector(
                'input[name="HinhThucNhan"]:checked'
            )?.value;

            const giaoTanNoi = hinhThuc === 'Giao tận nơi';
            const phiGiao = giaoTanNoi ? phiGiaoTanNoi : 0;

            if (address) {
                address.required = giaoTanNoi;
            }

            const dinhDang = soTien =>
                soTien.toLocaleString('vi-VN') + '₫';

            document.getElementById('shippingFee').textContent =
                dinhDang(phiGiao);

            document.getElementById('orderTotal').textContent =
                dinhDang(tamTinhDon + phiGiao);

            document.getElementById('checkoutButtonTotal').innerHTML =
                `Xác nhận đặt hàng (${dinhDang(tamTinhDon + phiGiao)})<br>Chưa thu tiền`;
        }

        document.querySelectorAll('input[name="HinhThucNhan"]')
            .forEach(radio =>
                radio.addEventListener('change', capNhatHinhThucNhan));

        capNhatHinhThucNhan();
    </script>
}
