@{
    ViewData["Title"] = "Thiết kế hoa theo yêu cầu - Web quản lý hoa tươi";
}

<!-- Top Botanical Editorial Intro Banner -->
<section class="relative w-full overflow-hidden bg-surface-container-low py-space-xl">
    <div class="absolute -right-24 -top-24 w-96 h-96 rounded-full bg-secondary-container/40 blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 bottom-0 w-80 h-80 rounded-full bg-primary-fixed/20 blur-2xl pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop relative z-10">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-lg">
            <div class="max-w-3xl space-y-space-sm">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md uppercase tracking-widest shadow-sm">
                    <span class="material-symbols-outlined text-[16px] text-primary" style="font-variation-settings: 'FILL' 1;">palette</span>
                    <span>Bespoke Floral Workshop • Nghệ Thuật Cắm Hoa Độc Bản</span>
                </div>
                <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight">
                    Bạn muốn một bó hoa thật <span class="text-primary italic font-normal">đặc biệt?</span>
                </h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">
                    Hãy chia sẻ ý tưởng, sở thích và ngân sách của bạn. Nghệ nhân hoa của <span class="font-medium text-primary">Web quản lý hoa tươi</span> sẽ tư vấn tận tâm, gửi ảnh phác thảo cắm thực tế và báo giá chi tiết trong vòng <span class="font-semibold text-tertiary">15 – 30 phút</span>.
                </p>
            </div>
            <!-- Metric micro-badges -->
            <div class="flex items-center gap-space-md sm:gap-space-lg py-2">
                <div class="flex items-center gap-3 bg-surface-container-lowest px-4 py-3 rounded-xl shadow-sm">
                    <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-primary">
                        <span class="material-symbols-outlined text-[20px]">timer</span>
                    </div>
                    <div>
                        <span class="font-label-md text-label-md text-secondary block uppercase">Phản hồi hỏa tốc</span>
                        <span class="font-title-sm text-title-sm text-on-surface">15 - 30 Phút</span>
                    </div>
                </div>
                <div class="flex items-center gap-3 bg-surface-container-lowest px-4 py-3 rounded-xl shadow-sm">
                    <div class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-tertiary">
                        <span class="material-symbols-outlined text-[20px]">verified</span>
                    </div>
                    <div>
                        <span class="font-label-md text-label-md text-secondary block uppercase">Hoa tươi nhập khẩu</span>
                        <span class="font-title-sm text-title-sm text-on-surface">100% Loại A</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Interactive 2-Column Bespoke Atelier Workspace -->
<section class="max-w-7xl mx-auto w-full px-margin-mobile md:px-margin lg:px-margin-desktop py-space-xl">
    <form class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg" id="customFlowerForm" onsubmit="event.preventDefault(); submitCustomOrder();">
        <!-- LEFT COLUMN: Flower Characteristics & Palette -->
        <div class="lg:col-span-7 space-y-space-lg">
            <!-- STEP 1: Product Format Selection -->
            <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm space-y-space-md">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-space-sm">
                        <span class="w-7 h-7 rounded-full bg-primary text-on-primary font-label-lg text-label-lg flex items-center justify-center shadow-sm">1</span>
                        <h2 class="font-title-md text-title-md text-on-surface font-semibold">Chọn kiểu dáng sản phẩm mong muốn</h2>
                    </div>
                    <span class="font-label-md text-label-md text-secondary uppercase tracking-wider">Bắt buộc</span>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-space-sm" id="formatRadioGroup">
                    <!-- Format Card 1 -->
                    <label class="group relative flex flex-col items-center text-center p-3 rounded-xl bg-surface-container-low cursor-pointer transition-all hover:bg-secondary-container/30">
                        <input checked="" class="sr-only peer" name="flower_format" type="radio" value="Bó hoa cầm tay">
                        <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-primary group-hover:scale-105 transition-transform peer-checked:bg-primary peer-checked:text-on-primary">
                            <span class="material-symbols-outlined text-[24px]">local_florist</span>
                        </div>
                        <span class="mt-2 font-title-sm text-title-sm text-on-surface peer-checked:text-primary peer-checked:font-bold">Bó hoa cầm tay</span>
                        <span class="font-body-sm text-body-sm text-secondary">Thanh lịch &amp; hiện đại</span>
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></span>
                    </label>
                    <!-- Format Card 2 -->
                    <label class="group relative flex flex-col items-center text-center p-3 rounded-xl bg-surface-container-low cursor-pointer transition-all hover:bg-secondary-container/30">
                        <input class="sr-only peer" name="flower_format" type="radio" value="Giỏ hoa cao cấp">
                        <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-primary group-hover:scale-105 transition-transform peer-checked:bg-primary peer-checked:text-on-primary">
                            <span class="material-symbols-outlined text-[24px]">shopping_basket</span>
                        </div>
                        <span class="mt-2 font-title-sm text-title-sm text-on-surface peer-checked:text-primary peer-checked:font-bold">Giỏ hoa mây</span>
                        <span class="font-body-sm text-body-sm text-secondary">Ấm cúng, trưng bày</span>
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></span>
                    </label>
                    <!-- Format Card 3 -->
                    <label class="group relative flex flex-col items-center text-center p-3 rounded-xl bg-surface-container-low cursor-pointer transition-all hover:bg-secondary-container/30">
                        <input class="sr-only peer" name="flower_format" type="radio" value="Hộp hoa quà tặng">
                        <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-primary group-hover:scale-105 transition-transform peer-checked:bg-primary peer-checked:text-on-primary">
                            <span class="material-symbols-outlined text-[24px]">redeem</span>
                        </div>
                        <span class="mt-2 font-title-sm text-title-sm text-on-surface peer-checked:text-primary peer-checked:font-bold">Hộp hoa tinh tế</span>
                        <span class="font-body-sm text-body-sm text-secondary">Sang trọng, bất ngờ</span>
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></span>
                    </label>
                    <!-- Format Card 4 -->
                    <label class="group relative flex flex-col items-center text-center p-3 rounded-xl bg-surface-container-low cursor-pointer transition-all hover:bg-secondary-container/30">
                        <input class="sr-only peer" name="flower_format" type="radio" value="Kệ hoa sự kiện / khai trương">
                        <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-primary group-hover:scale-105 transition-transform peer-checked:bg-primary peer-checked:text-on-primary">
                            <span class="material-symbols-outlined text-[24px]">nest_multi_room</span>
                        </div>
                        <span class="mt-2 font-title-sm text-title-sm text-on-surface peer-checked:text-primary peer-checked:font-bold">Kệ khai trương</span>
                        <span class="font-body-sm text-body-sm text-secondary">Hoành tráng, ấn tượng</span>
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></span>
                    </label>
                </div>
            </div>

            <!-- STEP 2: Color Palette Selection -->
            <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm space-y-space-md">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-space-sm">
                        <span class="w-7 h-7 rounded-full bg-primary text-on-primary font-label-lg text-label-lg flex items-center justify-center shadow-sm">2</span>
                        <h2 class="font-title-md text-title-md text-on-surface font-semibold">Tông màu chủ đạo bạn yêu thích</h2>
                    </div>
                    <span class="font-label-lg text-label-lg text-primary font-semibold" id="selectedPaletteLabel">Tông Hồng Ngọt Ngào</span>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-space-sm">
                    <!-- Palette 1 -->
                    <label class="palette-option flex flex-col p-3 rounded-xl bg-surface-container-low cursor-pointer transition-all hover:bg-secondary-container/30 relative">
                        <input checked="" class="sr-only peer" name="color_palette" onchange="updatePaletteText('Tông Hồng Ngọt Ngào (Dusty Pink)')" type="radio" value="Tông Hồng Ngọt Ngào (Dusty Pink)">
                        <div class="flex items-center gap-1.5 h-6 w-full rounded-full overflow-hidden p-0.5 bg-surface-container-lowest shadow-inner mb-2">
                            <span class="h-full flex-1 rounded-full bg-primary-fixed"></span>
                            <span class="h-full flex-1 rounded-full bg-primary"></span>
                            <span class="h-full flex-1 rounded-full bg-surface-container"></span>
                        </div>
                        <span class="font-title-sm text-title-sm text-on-surface peer-checked:text-primary peer-checked:font-bold">Hồng Ngọt Ngào</span>
                        <span class="font-body-sm text-body-sm text-secondary">Dusty Pink &amp; Rose</span>
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></span>
                    </label>
                    <!-- Palette 2 -->
                    <label class="palette-option flex flex-col p-3 rounded-xl bg-surface-container-low cursor-pointer transition-all hover:bg-secondary-container/30 relative">
                        <input class="sr-only peer" name="color_palette" onchange="updatePaletteText('Tông Đỏ Quyến Rũ (Ruby Red)')" type="radio" value="Tông Đỏ Quyến Rũ (Ruby Red)">
                        <div class="flex items-center gap-1.5 h-6 w-full rounded-full overflow-hidden p-0.5 bg-surface-container-lowest shadow-inner mb-2">
                            <span class="h-full flex-1 rounded-full bg-primary-container"></span>
                            <span class="h-full flex-1 rounded-full bg-primary"></span>
                            <span class="h-full flex-1 rounded-full bg-on-primary-fixed"></span>
                        </div>
                        <span class="font-title-sm text-title-sm text-on-surface peer-checked:text-primary peer-checked:font-bold">Đỏ Quyến Rũ</span>
                        <span class="font-body-sm text-body-sm text-secondary">Ruby &amp; Bordeaux</span>
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></span>
                    </label>
                    <!-- Palette 3 -->
                    <label class="palette-option flex flex-col p-3 rounded-xl bg-surface-container-low cursor-pointer transition-all hover:bg-secondary-container/30 relative">
                        <input class="sr-only peer" name="color_palette" onchange="updatePaletteText('Tông Trắng Thuần Khiết (Ivory White)')" type="radio" value="Tông Trắng Thuần Khiết (Ivory White)">
                        <div class="flex items-center gap-1.5 h-6 w-full rounded-full overflow-hidden p-0.5 bg-surface-container shadow-inner mb-2">
                            <span class="h-full flex-1 rounded-full bg-surface-container-lowest"></span>
                            <span class="h-full flex-1 rounded-full bg-surface-bright"></span>
                            <span class="h-full flex-1 rounded-full bg-tertiary-fixed-dim"></span>
                        </div>
                        <span class="font-title-sm text-title-sm text-on-surface peer-checked:text-primary peer-checked:font-bold">Trắng Thuần Khiết</span>
                        <span class="font-body-sm text-body-sm text-secondary">Ivory White &amp; Cream</span>
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></span>
                    </label>
                    <!-- Palette 4 -->
                    <label class="palette-option flex flex-col p-3 rounded-xl bg-surface-container-low cursor-pointer transition-all hover:bg-secondary-container/30 relative">
                        <input class="sr-only peer" name="color_palette" onchange="updatePaletteText('Tông Vàng Ấm Áp (Sun Gold)')" type="radio" value="Tông Vàng Ấm Áp (Sun Gold)">
                        <div class="flex items-center gap-1.5 h-6 w-full rounded-full overflow-hidden p-0.5 bg-surface-container-lowest shadow-inner mb-2">
                            <span class="h-full flex-1 rounded-full bg-secondary-fixed"></span>
                            <span class="h-full flex-1 rounded-full bg-tertiary-fixed"></span>
                            <span class="h-full flex-1 rounded-full bg-surface-dim"></span>
                        </div>
                        <span class="font-title-sm text-title-sm text-on-surface peer-checked:text-primary peer-checked:font-bold">Vàng Ấm Áp</span>
                        <span class="font-body-sm text-body-sm text-secondary">Sun Gold &amp; Champagne</span>
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></span>
                    </label>
                    <!-- Palette 5 -->
                    <label class="palette-option flex flex-col p-3 rounded-xl bg-surface-container-low cursor-pointer transition-all hover:bg-secondary-container/30 relative">
                        <input class="sr-only peer" name="color_palette" onchange="updatePaletteText('Tông Tím Lãng Mạn (Pastel Lilac)')" type="radio" value="Tông Tím Lãng Mạn (Pastel Lilac)">
                        <div class="flex items-center gap-1.5 h-6 w-full rounded-full overflow-hidden p-0.5 bg-surface-container-lowest shadow-inner mb-2">
                            <span class="h-full flex-1 rounded-full bg-secondary-container"></span>
                            <span class="h-full flex-1 rounded-full bg-primary-fixed-dim"></span>
                            <span class="h-full flex-1 rounded-full bg-surface-variant"></span>
                        </div>
                        <span class="font-title-sm text-title-sm text-on-surface peer-checked:text-primary peer-checked:font-bold">Tím Lãng Mạn</span>
                        <span class="font-body-sm text-body-sm text-secondary">Pastel Lilac &amp; Lavender</span>
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></span>
                    </label>
                    <!-- Palette 6 -->
                    <label class="palette-option flex flex-col p-3 rounded-xl bg-surface-container-low cursor-pointer transition-all hover:bg-secondary-container/30 relative">
                        <input class="sr-only peer" name="color_palette" onchange="updatePaletteText('Tông Cam Tươi Sáng (Sunset Coral)')" type="radio" value="Tông Cam Tươi Sáng (Sunset Coral)">
                        <div class="flex items-center gap-1.5 h-6 w-full rounded-full overflow-hidden p-0.5 bg-surface-container-lowest shadow-inner mb-2">
                            <span class="h-full flex-1 rounded-full bg-primary-fixed"></span>
                            <span class="h-full flex-1 rounded-full bg-secondary-container"></span>
                            <span class="h-full flex-1 rounded-full bg-tertiary-fixed-dim"></span>
                        </div>
                        <span class="font-title-sm text-title-sm text-on-surface peer-checked:text-primary peer-checked:font-bold">Cam Tươi Sáng</span>
                        <span class="font-body-sm text-body-sm text-secondary">Sunset Coral &amp; Peach</span>
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></span>
                    </label>
                    <!-- Palette 7 -->
                    <label class="palette-option col-span-2 flex flex-col p-3 rounded-xl bg-surface-container-low cursor-pointer transition-all hover:bg-secondary-container/30 relative">
                        <input class="sr-only peer" name="color_palette" onchange="updatePaletteText('Tông Xanh Thiên Nhiên (Botanical Foliage)')" type="radio" value="Tông Xanh Thiên Nhiên (Botanical Foliage)">
                        <div class="flex items-center gap-1.5 h-6 w-full rounded-full overflow-hidden p-0.5 bg-surface-container-lowest shadow-inner mb-2">
                            <span class="h-full flex-1 rounded-full bg-tertiary-fixed"></span>
                            <span class="h-full flex-1 rounded-full bg-tertiary-container"></span>
                            <span class="h-full flex-1 rounded-full bg-tertiary"></span>
                        </div>
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="font-title-sm text-title-sm text-on-surface peer-checked:text-primary peer-checked:font-bold">Xanh Thiên Nhiên Cỏ Cây</span>
                                <span class="font-body-sm text-body-sm text-secondary block">Eucalyptus, Olive &amp; Botanical Greenery</span>
                            </div>
                            <span class="material-symbols-outlined text-tertiary text-[20px]">eco</span>
                        </div>
                        <span class="absolute top-2 right-2 w-2 h-2 rounded-full bg-primary opacity-0 peer-checked:opacity-100 transition-opacity"></span>
                    </label>
                </div>
            </div>

            <!-- STEP 3: Prioritized Flowers Multi-select -->
            <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm space-y-space-md">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-space-sm">
                        <span class="w-7 h-7 rounded-full bg-primary text-on-primary font-label-lg text-label-lg flex items-center justify-center shadow-sm">3</span>
                        <h2 class="font-title-md text-title-md text-on-surface font-semibold">Chọn loại hoa ưu tiên phối (chọn nhiều)</h2>
                    </div>
                    <span class="font-body-sm text-body-sm text-on-surface-variant">Tối đa 4 loại</span>
                </div>
                <div class="flex flex-wrap gap-2.5">
                    <!-- Flower Tag 1 -->
                    <label class="flower-tag flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface-container-low hover:bg-secondary-container/40 cursor-pointer transition-colors select-none text-on-surface text-body-md">
                        <input checked="" class="sr-only peer" name="flower_types" type="checkbox" value="Hoa hồng Ecuador &amp; David Austin">
                        <span class="w-4 h-4 rounded-full bg-surface-variant peer-checked:bg-primary flex items-center justify-center text-on-primary text-[10px]">
                            <span class="material-symbols-outlined text-[12px] opacity-0 peer-checked:opacity-100">check</span>
                        </span>
                        <span class="peer-checked:font-semibold peer-checked:text-primary">Hoa hồng Ecuador / David Austin</span>
                    </label>
                    <!-- Flower Tag 2 -->
                    <label class="flower-tag flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface-container-low hover:bg-secondary-container/40 cursor-pointer transition-colors select-none text-on-surface text-body-md">
                        <input class="sr-only peer" name="flower_types" type="checkbox" value="Hoa Tulip Hà Lan">
                        <span class="w-4 h-4 rounded-full bg-surface-variant peer-checked:bg-primary flex items-center justify-center text-on-primary text-[10px]">
                            <span class="material-symbols-outlined text-[12px] opacity-0 peer-checked:opacity-100">check</span>
                        </span>
                        <span class="peer-checked:font-semibold peer-checked:text-primary">Hoa Tulip Hà Lan</span>
                    </label>
                    <!-- Flower Tag 3 -->
                    <label class="flower-tag flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface-container-low hover:bg-secondary-container/40 cursor-pointer transition-colors select-none text-on-surface text-body-md">
                        <input class="sr-only peer" name="flower_types" type="checkbox" value="Hoa Lily thơm kép">
                        <span class="w-4 h-4 rounded-full bg-surface-variant peer-checked:bg-primary flex items-center justify-center text-on-primary text-[10px]">
                            <span class="material-symbols-outlined text-[12px] opacity-0 peer-checked:opacity-100">check</span>
                        </span>
                        <span class="peer-checked:font-semibold peer-checked:text-primary">Hoa Lily thơm kép</span>
                    </label>
                    <!-- Flower Tag 4 -->
                    <label class="flower-tag flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface-container-low hover:bg-secondary-container/40 cursor-pointer transition-colors select-none text-on-surface text-body-md">
                        <input checked="" class="sr-only peer" name="flower_types" type="checkbox" value="Hoa Baby trắng Hà Lan">
                        <span class="w-4 h-4 rounded-full bg-surface-variant peer-checked:bg-primary flex items-center justify-center text-on-primary text-[10px]">
                            <span class="material-symbols-outlined text-[12px] opacity-0 peer-checked:opacity-100">check</span>
                        </span>
                        <span class="peer-checked:font-semibold peer-checked:text-primary">Hoa Baby trắng Hà Lan</span>
                    </label>
                    <!-- Flower Tag 5 -->
                    <label class="flower-tag flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface-container-low hover:bg-secondary-container/40 cursor-pointer transition-colors select-none text-on-surface text-body-md">
                        <input class="sr-only peer" name="flower_types" type="checkbox" value="Hoa Mẫu đơn (Peony)">
                        <span class="w-4 h-4 rounded-full bg-surface-variant peer-checked:bg-primary flex items-center justify-center text-on-primary text-[10px]">
                            <span class="material-symbols-outlined text-[12px] opacity-0 peer-checked:opacity-100">check</span>
                        </span>
                        <span class="peer-checked:font-semibold peer-checked:text-primary">Hoa Mẫu đơn (Peony)</span>
                    </label>
                    <!-- Flower Tag 6 -->
                    <label class="flower-tag flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface-container-low hover:bg-secondary-container/40 cursor-pointer transition-colors select-none text-on-surface text-body-md">
                        <input class="sr-only peer" name="flower_types" type="checkbox" value="Hoa Cẩm chướng xoăn">
                        <span class="w-4 h-4 rounded-full bg-surface-variant peer-checked:bg-primary flex items-center justify-center text-on-primary text-[10px]">
                            <span class="material-symbols-outlined text-[12px] opacity-0 peer-checked:opacity-100">check</span>
                        </span>
                        <span class="peer-checked:font-semibold peer-checked:text-primary">Hoa Cẩm chướng xoăn</span>
                    </label>
                    <!-- Flower Tag 7 -->
                    <label class="flower-tag flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface-container-low hover:bg-secondary-container/40 cursor-pointer transition-colors select-none text-on-surface text-body-md">
                        <input class="sr-only peer" name="flower_types" type="checkbox" value="Hoa Hướng dương Đà Lạt">
                        <span class="w-4 h-4 rounded-full bg-surface-variant peer-checked:bg-primary flex items-center justify-center text-on-primary text-[10px]">
                            <span class="material-symbols-outlined text-[12px] opacity-0 peer-checked:opacity-100">check</span>
                        </span>
                        <span class="peer-checked:font-semibold peer-checked:text-primary">Hoa Hướng dương</span>
                    </label>
                    <!-- Flower Tag 8 -->
                    <label class="flower-tag flex items-center gap-2 px-3.5 py-2 rounded-full bg-surface-container-low hover:bg-secondary-container/40 cursor-pointer transition-colors select-none text-on-surface text-body-md">
                        <input class="sr-only peer" name="flower_types" type="checkbox" value="Lan hồ điệp cánh lớn">
                        <span class="w-4 h-4 rounded-full bg-surface-variant peer-checked:bg-primary flex items-center justify-center text-on-primary text-[10px]">
                            <span class="material-symbols-outlined text-[12px] opacity-0 peer-checked:opacity-100">check</span>
                        </span>
                        <span class="peer-checked:font-semibold peer-checked:text-primary">Lan hồ điệp</span>
                    </label>
                </div>
            </div>

            <!-- STEP 4: Budget Range Selector -->
            <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm space-y-space-md">
