<!-- Interactive Submission Success Modal -->
<div class="fixed inset-0 z-50 flex items-center justify-center bg-inverse-surface/40 backdrop-blur-sm p-4 hidden" id="successModal">
    <div class="bg-surface-container-lowest max-w-lg w-full rounded-2xl p-space-lg shadow-xl text-center space-y-space-md animate-fade-in">
        <div class="w-16 h-16 rounded-full bg-secondary-container text-primary mx-auto flex items-center justify-center">
            <span class="material-symbols-outlined text-[36px]" style="font-variation-settings: 'FILL' 1;">favorite</span>
        </div>
        <div>
            <span class="font-label-md text-label-md text-secondary uppercase tracking-widest">Đã Gửi Đến Bàn Thợ Cắm Hoa</span>
            <h3 class="font-headline-md text-headline-md text-on-surface mt-1">Yêu cầu thiết kế đã tiếp nhận!</h3>
            <p class="font-body-md text-body-md text-on-surface-variant mt-2">
                Cảm ơn <span class="font-semibold text-primary" id="modalSenderName">bạn</span>. Florist của Web quản lý hoa tươi đang xem xét ý tưởng và sẽ nhắn tin Zalo tới số <span class="font-semibold text-on-surface" id="modalSenderPhone">...</span> trong <span class="text-tertiary font-bold">15 phút tới</span> kèm hình ảnh hoa thực tế để bạn duyệt.
            </p>
        </div>
        <div class="p-4 rounded-xl bg-surface-container-low text-left space-y-2">
            <div class="flex justify-between text-body-sm">
                <span class="text-secondary">Kiểu cắm:</span>
                <span class="font-medium text-on-surface" id="modalFormat">Bó hoa cầm tay</span>
            </div>
            <div class="flex justify-between text-body-sm">
                <span class="text-secondary">Tông màu:</span>
                <span class="font-medium text-on-surface" id="modalPalette">Tông Hồng Ngọt Ngào</span>
            </div>
            <div class="flex justify-between text-body-sm">
                <span class="text-secondary">Ngân sách dự kiến:</span>
                <span class="font-medium text-primary" id="modalBudget">1.500.000đ</span>
            </div>
        </div>
        <div class="flex gap-3">
            <a class="flex-1 py-3 rounded-full bg-primary text-on-primary font-title-sm text-title-sm text-center hover:bg-primary-container transition-colors" asp-controller="Home" asp-action="Index">
                Hoàn tất &amp; Về trang chủ
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updatePaletteText(name) {
            const el = document.getElementById('selectedPaletteLabel');
            if (el) el.innerText = name;
        }

        function setBudget(label) {
            const input = document.getElementById('budgetInput');
            if (input) {
                input.value = label;
            }
        }

        function insertCardText(text) {
            const textarea = document.getElementById('cardMessage');
            if (textarea) {
                textarea.value = text;
                updateCharCount();
            }
        }

        const cardMessageInput = document.getElementById('cardMessage');
        if (cardMessageInput) {
            cardMessageInput.addEventListener('input', updateCharCount);
        }

        function updateCharCount() {
            const countEl = document.getElementById('charCount');
            const val = cardMessageInput ? cardMessageInput.value : '';
            if (countEl) {
                countEl.innerText = `${val.length}/200`;
            }
        }

        function triggerFileInput() {
            document.getElementById('sampleFileInput').click();
        }

        function handleFileSelect(e) {
            const file = e.target.files[0];
            if (file) {
                const dropzone = document.getElementById('dropzone');
                const previewCard = document.getElementById('previewCard');
                const previewFileName = document.getElementById('previewFileName');
                const imagePreview = document.getElementById('imagePreview');

                dropzone.classList.add('hidden');
                previewCard.classList.remove('hidden');
                previewCard.classList.add('flex');
                previewFileName.innerText = file.name;

                const reader = new FileReader();
                reader.onload = function(evt) {
                    imagePreview.src = evt.target.result;
                };
                reader.readAsDataURL(file);
            }
        }

        function removeUploadedFile(e) {
            e.stopPropagation();
            const dropzone = document.getElementById('dropzone');
            const previewCard = document.getElementById('previewCard');
            const fileInput = document.getElementById('sampleFileInput');

            fileInput.value = '';
            dropzone.classList.remove('hidden');
            previewCard.classList.add('hidden');
            previewCard.classList.remove('flex');
        }

        function submitCustomOrder() {
            const name = document.getElementById('senderName').value;
            const phone = document.getElementById('senderPhone').value;
            const budget = document.getElementById('budgetInput').value;

            const formatEl = document.querySelector('input[name="flower_format"]:checked');
            const paletteEl = document.querySelector('input[name="color_palette"]:checked');

            document.getElementById('modalSenderName').innerText = name || 'Quý khách';
            document.getElementById('modalSenderPhone').innerText = phone || 'liên hệ';
            document.getElementById('modalBudget').innerText = budget || 'Thỏa thuận';
            if (formatEl) document.getElementById('modalFormat').innerText = formatEl.value;
            if (paletteEl) document.getElementById('modalPalette').innerText = paletteEl.value;

            document.getElementById('successModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('successModal').classList.add('hidden');
            document.getElementById('customFlowerForm').reset();
        }
    </script>
}
