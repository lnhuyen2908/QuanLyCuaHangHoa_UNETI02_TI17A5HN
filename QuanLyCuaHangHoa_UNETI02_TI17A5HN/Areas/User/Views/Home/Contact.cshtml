            <div class="space-y-space-xs">
                <span class="font-label-md text-label-md uppercase tracking-widest text-secondary">HỆ THỐNG SHOWROOM</span>
                <h2 class="font-headline-lg text-headline-lg text-on-surface">Không Gian Trải Nghiệm Hoa Thủ Công</h2>
            </div>
            <!-- Showroom 1: Flagship Saigon -->
            <article class="bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
                <div class="relative w-full h-80 sm:h-96 overflow-hidden">
                    <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" alt="Web quản lý hoa tươi luxury flower boutique storefront exterior in Saigon at twilight" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAdorBi5fBnZ7UoiD0fVgaZwbfNpilvPfIQNrxHr6HFxSpFELfmAiHeSSdgNquCowsMnGi-SVba_r6EUY9kzJBjwM6I_T6bxx6taJvCDE4_MmQH1kwPN5l-9BUFbWgowyhYuQCv9dszIOxE4eubfc57-StaalBgqKxNZmXKS4hMbhQbRtDf2UpgVP44ObwwyucJERsVd9LQFa2sbbDaEMPDgUtl99IIR92g_Y6ZT7P7VovYnV5S7jkoIg">
