@{
    ViewData["Title"] = "Liên hệ & Showroom - Web quản lý hoa tươi";
}

<!-- Hero & Breadcrumb Section -->
<section class="relative w-full bg-surface-container-low/70 py-space-xl overflow-hidden">
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-primary-fixed/30 blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -left-20 w-80 h-80 rounded-full bg-tertiary-fixed/20 blur-3xl pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop relative">
        <!-- Section Title & Narrative -->
        <div class="max-w-3xl space-y-space-sm">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md uppercase tracking-widest">
                <span class="material-symbols-outlined text-[14px] text-primary">spa</span>
                KẾT NỐI VỚI CHÚNG TÔI
            </span>
            <h1 class="font-display-lg text-display-lg text-on-surface tracking-tight leading-tight">
                Ghé Thăm Showroom &amp; Lắng Nghe Tư Vấn
            </h1>
            <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
                Dù là một bó hoa sinh nhật ngọt ngào, một giỏ hoa khai trương trang trọng hay không gian tiệc cưới xa hoa, đội ngũ Florist Master của Web quản lý hoa tươi luôn sẵn sàng lắng nghe và hiện thực hóa mọi xúc cảm của bạn.
            </p>
        </div>
    </div>
</section>

<!-- 4 Fast Contact Channels Grid -->
