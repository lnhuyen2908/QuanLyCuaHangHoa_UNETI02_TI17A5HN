@section Scripts {
    <script>
        function switchMap(city) {
            const mapSg = document.getElementById('map-sg');
            const mapHn = document.getElementById('map-hn');
            const btnSg = document.getElementById('btn-map-sg');
            const btnHn = document.getElementById('btn-map-hn');

            if (city === 'sg') {
                mapSg.classList.remove('hidden');
                mapHn.classList.add('hidden');
                btnSg.className = 'px-3 py-1 rounded-full bg-primary text-on-primary font-medium transition-colors';
                btnHn.className = 'px-3 py-1 rounded-full bg-surface-container text-on-surface-variant hover:text-on-surface font-medium transition-colors';
            } else {
                mapHn.classList.remove('hidden');
                mapSg.classList.add('hidden');
                btnHn.className = 'px-3 py-1 rounded-full bg-primary text-on-primary font-medium transition-colors';
                btnSg.className = 'px-3 py-1 rounded-full bg-surface-container text-on-surface-variant hover:text-on-surface font-medium transition-colors';
            }
        }

        function handleFormSubmit(event) {
            event.preventDefault();
            const successToast = document.getElementById('form-success');
            const submitBtn = event.target.querySelector('button[type="submit"]');
            
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-75');
            submitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span><span>Đang xử lý...</span>';

            setTimeout(() => {
                submitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">done</span><span>Đã gửi thông tin</span>';
                successToast.classList.remove('hidden');
                event.target.reset();
            }, 800);
        }
    </script>
}
