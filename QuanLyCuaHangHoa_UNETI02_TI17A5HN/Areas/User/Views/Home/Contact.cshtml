                Nhắn tin ngay <span class="material-symbols-outlined text-[16px]">arrow_outward</span>
            </a>
        </div>
        <!-- Card 3 -->
        <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-md hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
            <div>
                <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-primary group-hover:scale-110 transition-transform mb-space-md">
                    <span class="material-symbols-outlined text-[24px]">mail</span>
                </div>
                <span class="font-label-md text-label-md uppercase tracking-wider text-secondary block mb-1">Hợp tác &amp; Sự kiện B2B</span>
                <p class="font-title-sm text-title-sm text-on-surface font-semibold mb-1 truncate">concierge@webquanlyhoatuoi.vn</p>
                <p class="font-body-sm text-body-sm text-secondary truncate">b2b@webquanlyhoatuoi.vn</p>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-md flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[15px] text-tertiary">check_circle</span>
                Hỗ trợ xuất hóa đơn VAT
            </p>
        </div>
        <!-- Card 4 -->
        <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-md hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
            <div>
                <div class="w-12 h-12 rounded-full bg-tertiary-fixed flex items-center justify-center text-tertiary group-hover:scale-110 transition-transform mb-space-md">
                    <span class="material-symbols-outlined text-[24px]">electric_bolt</span>
                </div>
                <span class="font-label-md text-label-md uppercase tracking-wider text-secondary block mb-1">Giao hoa 24/7 hẹn trước</span>
                <p class="font-title-md text-title-md text-on-surface font-semibold mb-2">0988 123 456</p>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Dành riêng cho đơn hẹn giờ đêm, lễ cưới hoặc khẩn cấp</p>
            </div>
            <p class="font-body-sm text-body-sm text-tertiary font-medium mt-space-md flex items-center gap-1">
                <span class="material-symbols-outlined text-[15px]">local_shipping</span>
                Giao xe lạnh chuyên dụng
            </p>
        </div>
    </div>
</section>

<!-- Main Interaction: 2 Columns (Showrooms & Interactive Form) -->
