@{
    ViewData["Title"] = "Trang chủ - Web quản lý hoa tươi";
}

<div class="flex flex-col w-full">
  <!-- 1. HERO SECTION (With Interactive 3D Perspective Animated Carousel) -->
  <section class="relative w-full -mt-28 pt-36 pb-20 md:pb-28 overflow-hidden bg-surface-bright">
    <div class="absolute inset-0 bg-gradient-to-b from-surface-container-low/60 via-transparent to-surface-bright pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-center">
        <!-- Text Column -->
        <div class="lg:col-span-6 flex flex-col space-y-space-md z-10">
          <div class="inline-flex items-center gap-2 self-start px-3.5 py-1.5 rounded-full bg-secondary-container text-on-secondary-container">
            <span class="material-symbols-outlined text-[16px] text-primary" style="font-variation-settings: 'FILL' 1;">spa</span>
            <span class="font-label-md text-label-md uppercase tracking-wider">Bộ sưu tập Mùa Yêu — 2025</span>
          </div>
          <h1 class="font-display-lg text-display-lg text-on-surface leading-tight tracking-tight">
            Trao gửi yêu thương bằng những <span class="italic font-normal text-primary">đóa hoa</span>
          </h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant max-w-xl">
            Những mẫu hoa được thiết kế tinh tế cho mọi khoảnh khắc đáng nhớ. Mỗi tác phẩm là một câu chuyện cảm xúc được gói trọn bởi bàn tay nghệ nhân atelier.
          </p>
          <!-- Badges highlight -->
          <div class="flex flex-wrap items-center gap-space-sm pt-space-xs text-on-surface-variant font-label-lg text-label-lg">
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-high/80">
              <span class="material-symbols-outlined text-primary text-[18px]">verified</span>
              <span>100% Hoa tươi nhập khẩu</span>
            </div>
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-tertiary-container/20 text-tertiary font-medium">
              <span class="material-symbols-outlined text-[18px]">bolt</span>
              <span>Giao hỏa tốc 2H</span>
            </div>
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container-high/80">
              <span class="material-symbols-outlined text-primary text-[18px]">photo_camera</span>
              <span>Chụp ảnh duyệt trước</span>
            </div>
          </div>
          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-space-md pt-space-sm">
            <a class="px-7 py-3.5 rounded-full bg-primary text-on-primary font-title-sm text-title-sm shadow-md hover:bg-primary-container transition-all transform hover:-translate-y-0.5 flex items-center gap-2" asp-controller="Home" asp-action="Products">
              <span>Khám phá mẫu hoa</span>
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
            <a class="px-7 py-3.5 rounded-full bg-surface-container-lowest text-on-surface font-title-sm text-title-sm shadow-sm hover:bg-surface-container hover:text-primary transition-all flex items-center gap-2 border border-outline-variant/40" asp-controller="Home" asp-action="CustomDesign">
              <span class="material-symbols-outlined text-[18px] text-primary">edit_calendar</span>
              <span>Thiết kế hoa theo yêu cầu</span>
            </a>
          </div>
          <!-- Quick stat counter -->
          <div class="pt-space-md grid grid-cols-3 gap-space-md">
            <div>
              <p class="font-headline-md text-headline-md text-primary">15,000+</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant">Bó hoa trao tận tay</p>
            </div>
            <div>
              <p class="font-headline-md text-headline-md text-on-surface">99.4%</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant">Hài lòng tuyệt đối</p>
            </div>
            <div>
