            <div class="absolute -bottom-8 -left-8 w-64 h-64 rounded-full bg-tertiary-fixed/30 blur-2xl pointer-events-none"></div>

            <!-- Carousel Stage Container -->
            <div class="relative w-full h-[410px] sm:h-[470px] flex items-center justify-center">

              <!-- Prev Arrow Button -->
              <button id="hero-prev-btn" onclick="prevHeroSlide()" aria-label="Mẫu hoa trước" type="button" class="absolute left-0 sm:-left-3 z-40 w-11 h-11 rounded-full bg-surface-container-lowest/90 hover:bg-surface-container-lowest text-on-surface hover:text-primary shadow-xl backdrop-blur-md flex items-center justify-center transition-all duration-300 transform hover:scale-110 active:scale-95 border border-outline-variant/40">
                <span class="material-symbols-outlined text-[24px]">chevron_left</span>
              </button>

              <!-- Next Arrow Button -->
              <button id="hero-next-btn" onclick="nextHeroSlide()" aria-label="Mẫu hoa tiếp theo" type="button" class="absolute right-0 sm:-right-3 z-40 w-11 h-11 rounded-full bg-surface-container-lowest/90 hover:bg-surface-container-lowest text-on-surface hover:text-primary shadow-xl backdrop-blur-md flex items-center justify-center transition-all duration-300 transform hover:scale-110 active:scale-95 border border-outline-variant/40">
