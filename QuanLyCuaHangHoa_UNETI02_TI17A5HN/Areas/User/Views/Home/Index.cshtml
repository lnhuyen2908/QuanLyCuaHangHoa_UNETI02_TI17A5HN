                  <img class="w-full h-full object-cover" alt="Juliet Serenade" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDFIRlyWoqirsws8UQGhG6vkN3wXKunzgOLwYtT8mo4SZVxrZA5HvdQSLgbYfy__YrBBBt7xEfvJp9Vk7kaj7NRUFRS12YE6LXq1ZKTBUjiRNJbeUM2K26J6oxNaFl7N18xbzPKztTcvorb7RMvXxWspiHg9sP-0J7GBRqbTbfjORjyHBlHSOGUj37vgXgweObZuxv7dntyeEkMqAtoFrDmuVb-Hd_jdsunE6VXDlD07tPk2P-9EhnkZQ">
                  <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/30 via-transparent to-transparent"></div>
                </div>

                <!-- Slide 3 -->
                <div class="hero-slide absolute w-[260px] sm:w-[320px] h-[340px] sm:h-[400px] transition-all duration-700 ease-in-out cursor-pointer rounded-3xl overflow-hidden bg-surface-container border border-outline-variant/30" data-index="3" data-title="Pastel Serenade" data-subtitle="Giỏ hoa cẩm tú cầu &amp; Hoa baby" data-price="1.250.000₫">
                  <img class="w-full h-full object-cover" alt="Pastel Serenade" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDIZZe20-pBfNq1T6IaNaaUI-E9KxcRe1yUImrgqyy5WvAG8uHtRmjgP8IASJCAzVmG82IPiHL3ralri062T8D_guF4zZpoJPUrqLtXSzQp-I_oerDCPme7H5iTmQKaZvaIQbe5SXvZCf265J0XCudQOPEVSg4ie0WVogDGii2sJDcYgqD_d9easpzNVCjsRk_PSZljEXwtzTkT11DaWIl86kxn377W0B98GkmgUvQwlGq7WmxCGtrdBg">
