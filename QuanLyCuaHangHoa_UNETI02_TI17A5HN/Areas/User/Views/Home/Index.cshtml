                <div class="w-8 h-8 rounded-full bg-tertiary/15 text-tertiary flex items-center justify-center shrink-0">
                  <span class="material-symbols-outlined text-[18px]">verified</span>
                </div>
                <div>
                  <p class="font-label-md text-[10px] text-secondary uppercase tracking-wider font-semibold">Cam kết tươi lâu</p>
                  <p class="font-title-sm text-[12px] text-on-surface font-bold">Tối thiểu 5 - 7 ngày</p>
                </div>
              </div>

              <!-- Slides List (3D Cards) -->
              <div class="relative w-full h-full flex items-center justify-center">
                
                <!-- Slide 0 -->
                <div class="hero-slide absolute w-[260px] sm:w-[320px] h-[340px] sm:h-[400px] transition-all duration-700 ease-in-out cursor-pointer rounded-3xl overflow-hidden bg-surface-container border border-outline-variant/30" data-index="0" data-title="Amour Éternel Bouquet" data-subtitle="Hồng Ohara &amp; Mẫu đơn Hà Lan" data-price="1.450.000₫">
