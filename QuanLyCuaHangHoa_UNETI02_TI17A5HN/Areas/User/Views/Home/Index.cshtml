                </div>

              </div>

              <!-- Bottom Floating Product Info Card -->
              <div id="hero-info-card" class="absolute -bottom-6 left-1/2 -translate-x-1/2 z-40 w-[90%] sm:w-[85%] max-w-md p-3.5 sm:p-4 rounded-2xl bg-surface-container-lowest/95 shadow-xl backdrop-blur-md border border-outline-variant/30 flex items-center justify-between transition-all duration-500 transform">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-primary shrink-0 shadow-sm">
                    <span class="material-symbols-outlined text-[20px]">local_florist</span>
                  </div>
                  <div class="overflow-hidden">
                    <p id="hero-card-title" class="font-title-sm text-title-sm text-on-surface font-bold truncate">Amour Éternel Bouquet</p>
                    <p id="hero-card-subtitle" class="font-body-sm text-body-sm text-secondary truncate">Hồng Ohara &amp; Mẫu đơn Hà Lan</p>
                  </div>
                </div>
                <span id="hero-card-price" class="font-headline-sm text-headline-sm text-primary font-semibold shrink-0 pl-2">1.450.000₫</span>
              </div>

            </div>

            <!-- Pagination Dots -->
            <div class="flex items-center justify-center gap-2 pt-10" id="hero-dots-container">
              <button onclick="goToHeroSlide(0)" class="hero-dot w-8 h-2 rounded-full bg-primary transition-all duration-300" aria-label="Slide 1"></button>
              <button onclick="goToHeroSlide(1)" class="hero-dot w-2 h-2 rounded-full bg-outline-variant/60 hover:bg-primary/50 transition-all duration-300" aria-label="Slide 2"></button>
              <button onclick="goToHeroSlide(2)" class="hero-dot w-2 h-2 rounded-full bg-outline-variant/60 hover:bg-primary/50 transition-all duration-300" aria-label="Slide 3"></button>
              <button onclick="goToHeroSlide(3)" class="hero-dot w-2 h-2 rounded-full bg-outline-variant/60 hover:bg-primary/50 transition-all duration-300" aria-label="Slide 4"></button>
