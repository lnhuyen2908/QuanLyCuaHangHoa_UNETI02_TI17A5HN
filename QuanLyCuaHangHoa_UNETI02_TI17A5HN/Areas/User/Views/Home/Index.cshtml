@section Scripts {
  <script>
    let currentHeroIndex = 0;
    const heroSlides = document.querySelectorAll('.hero-slide');
    const heroDots = document.querySelectorAll('.hero-dot');
    const totalHeroSlides = heroSlides.length;
    let heroAutoPlayTimer = null;

    function updateHeroCarousel() {
      heroSlides.forEach((slide, idx) => {
        let diff = idx - currentHeroIndex;
        
        // Handle wrap-around index offset
        if (diff > totalHeroSlides / 2) diff -= totalHeroSlides;
        if (diff < -totalHeroSlides / 2) diff += totalHeroSlides;

        if (diff === 0) {
          // Active Center Slide (Popped out, sharp, high z-index)
          slide.style.zIndex = '30';
          slide.style.transform = 'translateX(0) scale(1.04)';
          slide.style.opacity = '1';
          slide.style.filter = 'none';
          slide.style.boxShadow = '0 25px 50px -12px rgba(138, 72, 83, 0.25)';

          // Update info card text
          const title = slide.getAttribute('data-title');
          const subtitle = slide.getAttribute('data-subtitle');
          const price = slide.getAttribute('data-price');

          const cardTitle = document.getElementById('hero-card-title');
          const cardSubtitle = document.getElementById('hero-card-subtitle');
          const cardPrice = document.getElementById('hero-card-price');

          if (cardTitle) cardTitle.textContent = title;
          if (cardSubtitle) cardSubtitle.textContent = subtitle;
          if (cardPrice) cardPrice.textContent = price;
        } 
        else if (diff === 1 || diff === -(totalHeroSlides - 1)) {
          // Right Side Slide (Visible, scaled down)
          slide.style.zIndex = '15';
          slide.style.transform = 'translateX(100px) scale(0.85)';
          slide.style.opacity = '0.6';
          slide.style.filter = 'blur(0.5px)';
          slide.style.boxShadow = 'none';
        } 
        else if (diff === -1 || diff === (totalHeroSlides - 1)) {
          // Left Side Slide (Visible, scaled down)
          slide.style.zIndex = '15';
          slide.style.transform = 'translateX(-100px) scale(0.85)';
          slide.style.opacity = '0.6';
          slide.style.filter = 'blur(0.5px)';
          slide.style.boxShadow = 'none';
        } 
        else {
          // Hidden background slides
          slide.style.zIndex = '0';
          slide.style.transform = 'translateX(0) scale(0.7)';
          slide.style.opacity = '0';
          slide.style.filter = 'none';
          slide.style.boxShadow = 'none';
        }
      });

      // Update Pagination Dots
      heroDots.forEach((dot, idx) => {
        if (idx === currentHeroIndex) {
          dot.className = 'hero-dot w-8 h-2 rounded-full bg-primary transition-all duration-300';
        } else {
          dot.className = 'hero-dot w-2 h-2 rounded-full bg-outline-variant/60 hover:bg-primary/50 transition-all duration-300';
        }
      });
    }

    function nextHeroSlide() {
      currentHeroIndex = (currentHeroIndex + 1) % totalHeroSlides;
      updateHeroCarousel();
    }

    function prevHeroSlide() {
      currentHeroIndex = (currentHeroIndex - 1 + totalHeroSlides) % totalHeroSlides;
      updateHeroCarousel();
    }

    function goToHeroSlide(index) {
      currentHeroIndex = index;
      updateHeroCarousel();
    }

    function startHeroAutoPlay() {
      stopHeroAutoPlay();
      heroAutoPlayTimer = setInterval(nextHeroSlide, 3500);
    }

    function stopHeroAutoPlay() {
      if (heroAutoPlayTimer) {
        clearInterval(heroAutoPlayTimer);
        heroAutoPlayTimer = null;
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      updateHeroCarousel();
      startHeroAutoPlay();

      const container = document.getElementById('hero-carousel-container');
      if (container) {
        container.addEventListener('mouseenter', stopHeroAutoPlay);
        container.addEventListener('mouseleave', startHeroAutoPlay);
      }

      // Add click handler to side slides to jump to them
      heroSlides.forEach((slide) => {
        slide.addEventListener('click', () => {
          const idx = parseInt(slide.getAttribute('data-index'));
          if (!isNaN(idx)) {
            goToHeroSlide(idx);
          }
        });
      });
    });
  </script>
}
