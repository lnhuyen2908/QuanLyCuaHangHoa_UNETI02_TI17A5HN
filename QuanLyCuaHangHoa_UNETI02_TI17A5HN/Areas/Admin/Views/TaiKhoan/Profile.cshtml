@*
    Họ và tên: Lã Ngọc Huyền
    Mã sinh viên: 23103100271
    Nội dung thực hiện: Hồ sơ Admin cá nhân: hiển thị thông tin thực tế từ Database, form POST cập nhật họ tên, email và đổi mật khẩu.
*@

@model QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.Entities.TaiKhoan
@{
    ViewBag.Title = "Hồ Sơ Quản Trị Viên";
    ViewBag.ActiveMenu = "TaiKhoan";
    ViewBag.Breadcrumb = "Cài đặt tài khoản";
}

<div class="px-space-xl py-space-lg flex flex-col w-full space-y-space-md">
    <!-- Header Section -->
    @await Html.PartialAsync("_AdminPageHeader")

    <!-- Thông báo -->
    @if (TempData["ThanhCong"] != null)
    {
        <div class="flex items-center gap-2 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 shadow-sm animate-fade-in">
            <span class="material-symbols-outlined text-[20px] text-emerald-600">check_circle</span>
            <span class="font-body-md text-body-md font-medium">@TempData["ThanhCong"]</span>
        </div>
    }

    @if (TempData["Loi"] != null)
    {
        <div class="flex items-center gap-2 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 shadow-sm animate-fade-in">
            <span class="material-symbols-outlined text-[20px] text-rose-600">error</span>
            <span class="font-body-md text-body-md font-medium">@TempData["Loi"]</span>
        </div>
    }

    <!-- Main Grid: Florist Identity & Settings -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-start">
        <!-- Left Column: Identity Summary Card -->
        <div class="lg:col-span-4 flex flex-col gap-space-lg">
            <div class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm flex flex-col items-center text-center">
                <div class="w-24 h-24 rounded-full bg-primary text-on-primary flex items-center justify-center font-headline-lg font-bold shadow-md mb-4 uppercase">
                    @(string.IsNullOrWhiteSpace(Model.HoTen) ? "AD" : Model.HoTen.Substring(0, Math.Min(2, Model.HoTen.Length)))
                </div>
                <h2 class="font-headline-sm text-headline-sm text-on-surface font-semibold">@Model.HoTen</h2>
                <p class="font-title-sm text-title-sm text-primary italic">@Model.VaiTro Atelier System</p>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-label-md text-label-md font-semibold mt-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span> Tài khoản đang hoạt động
                </span>
                
                <div class="w-full mt-6 pt-4 border-t border-surface-container flex flex-col gap-2.5 text-left font-body-sm text-body-sm">
                    <div class="flex justify-between items-center">
                        <span class="text-secondary">Mã tài khoản:</span>
                        <span class="font-mono text-on-surface font-bold">#@Model.MaTaiKhoan</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-secondary">Username:</span>
                        <span class="font-mono text-on-surface font-bold">@Model.TenDangNhap</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-secondary">Email:</span>
                        <span class="text-on-surface font-medium">@Model.Email</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-secondary">Quyền hạn:</span>
                        <span class="text-primary font-bold">@Model.VaiTro (Full Permission)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Settings Form -->
        <div class="lg:col-span-8 bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm space-y-space-md">
            <h3 class="font-headline-sm text-headline-sm text-on-surface border-b border-surface-container pb-space-xs font-semibold">Cập Nhật Thông Tin Cá Nhân</h3>

            <form asp-area="Admin" asp-controller="TaiKhoan" asp-action="Profile" method="post" class="space-y-space-md">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Tên đăng nhập (Cố định)</label>
                        <input type="text" value="@Model.TenDangNhap" readonly class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-high text-secondary font-mono font-bold border border-outline-variant/30 cursor-not-allowed" />
                    </div>
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Họ và tên *</label>
                        <input type="text" name="hoTen" value="@Model.HoTen" required class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md focus:outline-none focus:ring-1 focus:ring-primary border border-outline-variant/40" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Email liên hệ *</label>
                        <input type="email" name="email" value="@Model.Email" required class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md focus:outline-none focus:ring-1 focus:ring-primary border border-outline-variant/40" />
                    </div>
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Vai trò hệ thống</label>
                        <input type="text" value="@Model.VaiTro" readonly class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-high text-secondary font-body-md border border-outline-variant/30 cursor-not-allowed" />
                    </div>
                </div>

                <div class="pt-space-md border-t border-surface-container">
                    <h4 class="font-title-md text-title-md text-on-surface mb-space-md font-semibold">Đổi Mật Khẩu Bảo Mật</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
                        <div>
                            <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-medium">Mật khẩu hiện tại</label>
                            <input type="password" name="matKhauHienTai" placeholder="Nhập để xác nhận nếu muốn đổi" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md focus:outline-none border border-outline-variant/40" />
                        </div>
                        <div>
                            <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-medium">Mật khẩu mới</label>
                            <input type="password" name="matKhauMoi" placeholder="Tối thiểu 6 ký tự" minlength="6" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md focus:outline-none border border-outline-variant/40" />
                        </div>
                    </div>
                </div>

                <div class="pt-space-md flex justify-end">
                    <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary text-on-primary font-title-sm hover:bg-primary-container transition-all shadow-md flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[18px]">save</span>
                        <span>Lưu thông tin cài đặt</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
