@{
    ViewBag.Title = "Quản Lý Tài Khoản & Phân Quyền";
    ViewBag.ActiveMenu = "TaiKhoan";
    ViewBag.Breadcrumb = "Cấu hình hệ thống";
}

<div class="px-space-xl py-space-lg flex flex-col w-full space-y-space-md">
    <!-- Header Section -->
    @await Html.PartialAsync("_AdminPageHeader")

    <!-- Metric Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-gutter">
        <div class="relative overflow-hidden p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Tổng tài khoản</span>
                <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[20px]">groups</span>
                </div>
            </div>
            <div class="mt-4 flex flex-col">
                <span class="font-display-lg text-display-lg text-on-surface">1,296</span>
                <div class="flex items-center gap-1.5 mt-1 font-body-sm text-body-sm text-tertiary">
                    <span class="material-symbols-outlined text-[16px]">trending_up</span>
                    <span class="font-semibold">+18 người dùng</span>
                    <span class="text-outline">tuần này</span>
                </div>
            </div>
        </div>

        <div class="relative overflow-hidden p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Nhân sự Atelier</span>
                <div class="w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-on-primary-fixed-variant">
                    <span class="material-symbols-outlined text-[20px]">badge</span>
                </div>
            </div>
            <div class="mt-4 flex flex-col">
                <span class="font-display-lg text-display-lg text-primary">14</span>
                <div class="flex items-center gap-1 mt-1 font-body-sm text-body-sm text-on-surface-variant">
                    <span class="font-medium text-on-surface">4 Admin</span>
                    <span>•</span>
                    <span class="font-medium text-on-surface">6 Florist</span>
                    <span>•</span>
                    <span class="font-medium text-on-surface">4 Shipper</span>
                </div>
            </div>
        </div>

        <div class="relative overflow-hidden p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Tài khoản Khách hàng</span>
                <div class="w-10 h-10 rounded-full bg-tertiary-fixed flex items-center justify-center text-on-tertiary-fixed">
                    <span class="material-symbols-outlined text-[20px]">diamond</span>
                </div>
            </div>
            <div class="mt-4 flex flex-col">
                <span class="font-display-lg text-display-lg text-on-surface">1,282</span>
                <div class="flex items-center gap-1.5 mt-1 font-body-sm text-body-sm text-on-surface-variant">
                    <span class="px-2 py-0.5 rounded-full bg-tertiary-container text-on-tertiary-container font-label-md text-label-md font-medium">386 Club VIP</span>
                </div>
            </div>
        </div>

        <div class="relative overflow-hidden p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Bảo mật hệ thống</span>
                <div class="w-10 h-10 rounded-full bg-secondary-fixed flex items-center justify-center text-on-secondary-fixed">
                    <span class="material-symbols-outlined text-[20px]">verified_user</span>
                </div>
            </div>
            <div class="mt-4 flex flex-col">
                <span class="font-display-lg text-display-lg text-tertiary">100%</span>
                <div class="flex items-center gap-1.5 mt-1 font-body-sm text-body-sm text-on-surface-variant">
                    <span class="w-2 h-2 rounded-full bg-tertiary"></span>
                    <span>Bảo mật Session &amp; RBAC</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Component -->
    @await Html.PartialAsync("_AdminFilterBar")

    <!-- Account Data Table Container -->
    <div class="bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden">
        <!-- Table Top Action Bar -->
        <div class="p-space-md bg-surface-container-lowest flex items-center justify-between gap-space-sm border-b border-surface-container">
            <div class="flex items-center gap-space-sm">
                <span class="font-headline-sm text-headline-sm text-on-surface">Danh Sách Tài Khoản</span>
                <span class="px-2.5 py-0.5 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md">1,296 tài khoản</span>
            </div>
            <button type="button" onclick="openAddModal()" class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-all shadow-sm">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                <span>Thêm Tài Khoản Mới</span>
            </button>
        </div>

        <div class="overflow-x-auto w-full">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container text-on-surface-variant font-label-md text-label-md uppercase tracking-wider">
                        <th class="py-3.5 px-4 font-semibold">Tên đăng nhập</th>
                        <th class="py-3.5 px-4 font-semibold">Họ và tên</th>
                        <th class="py-3.5 px-4 font-semibold">Email</th>
                        <th class="py-3.5 px-4 font-semibold">Vai trò</th>
                        <th class="py-3.5 px-4 font-semibold text-center">Trạng thái</th>
                        <th class="py-3.5 px-space-lg text-right font-semibold">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container text-on-surface font-body-sm text-body-sm">
                    <tr class="hover:bg-surface-container-low/60 transition-colors">
                        <td class="py-4 px-4 font-mono text-primary font-bold">admin</td>
                        <td class="py-4 px-4 font-title-sm text-title-sm">Nguyễn Văn Quản Trị</td>
                        <td class="py-4 px-4 text-on-surface-variant">admin@nhom2atelier.vn</td>
                        <td class="py-4 px-4">
                            <span class="px-2.5 py-1 rounded-full bg-primary-fixed text-on-primary-fixed-variant font-label-md text-label-md font-bold">Quản trị viên (Admin)</span>
                        </td>
                        <td class="py-4 px-4 text-center">
                            @await Html.PartialAsync("_AdminStatusBadge", "Hoạt động")
                        </td>
                        <td class="py-4 px-space-lg text-right">
                            <button type="button" onclick="openEditModal('admin', 'Nguyễn Văn Quản Trị', 'admin@nhom2atelier.vn', 'Quản trị viên (Admin)', '1')" class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-all" title="Phân quyền &amp; Sửa">
                                <span class="material-symbols-outlined text-[18px]">manage_accounts</span>
                            </button>
                        </td>
                    </tr>
                    <tr class="hover:bg-surface-container-low/60 transition-colors">
                        <td class="py-4 px-4 font-mono text-primary font-bold">florist_mai</td>
                        <td class="py-4 px-4 font-title-sm text-title-sm">Lê Thị Mai (Master Florist)</td>
                        <td class="py-4 px-4 text-on-surface-variant">maiflorist@nhom2atelier.vn</td>
                        <td class="py-4 px-4">
                            <span class="px-2.5 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md font-semibold">Thợ cắm hoa (Florist)</span>
                        </td>
                        <td class="py-4 px-4 text-center">
                            @await Html.PartialAsync("_AdminStatusBadge", "Hoạt động")
                        </td>
                        <td class="py-4 px-space-lg text-right">
                            <button type="button" onclick="openEditModal('florist_mai', 'Lê Thị Mai (Master Florist)', 'maiflorist@nhom2atelier.vn', 'Thợ cắm hoa (Florist)', '1')" class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-all" title="Phân quyền &amp; Sửa">
                                <span class="material-symbols-outlined text-[18px]">manage_accounts</span>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_AdminPagination")
    </div>
</div>

<!-- Popup Modal: Thêm / Chỉnh Sửa Tài Khoản -->
<div id="taiKhoanModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-on-surface/50 backdrop-blur-sm p-4 overflow-y-auto transition-all">
    <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-xl overflow-hidden flex flex-col">
        <!-- Modal Header -->
        <div class="flex items-center justify-between px-space-lg py-space-md bg-surface-container-low border-b border-surface-container-high">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[22px]">person_add</span>
                <h3 id="modalTaiKhoanTitle" class="font-headline-sm text-headline-sm text-on-surface font-semibold">Thêm Tài Khoản Mới</h3>
            </div>
            <button type="button" onclick="closeTaiKhoanModal()" class="text-secondary hover:text-on-surface p-1.5 rounded-full hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <!-- Modal Body -->
        <form id="taiKhoanForm" onsubmit="handleTaiKhoanSubmit(event)" class="p-space-lg space-y-space-md font-body-md text-body-md">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Tên đăng nhập *</label>
                    <input type="text" id="inputTenDangNhap" placeholder="VD: florist_nhom2" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary border border-outline-variant/40" required />
                </div>
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Họ và tên *</label>
                    <input type="text" id="inputHoTen" placeholder="VD: Nguyễn Văn A" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary border border-outline-variant/40" required />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Email *</label>
                    <input type="email" id="inputEmail" placeholder="user@nhom2atelier.vn" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none border border-outline-variant/40" required />
                </div>
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Mật khẩu khởi tạo *</label>
                    <input type="password" id="inputMatKhau" placeholder="••••••••" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none border border-outline-variant/40" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Vai trò phân quyền</label>
                    <select id="selectVaiTro" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none border border-outline-variant/40">
                        <option value="Quản trị viên (Admin)">Quản trị viên (Admin)</option>
                        <option value="Thợ cắm hoa (Florist)">Thợ cắm hoa (Florist)</option>
                        <option value="Nhân viên giao hàng">Nhân viên giao hàng (Shipper)</option>
                        <option value="Khách hàng VIP">Khách hàng VIP</option>
                    </select>
                </div>
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Trạng thái tài khoản</label>
                    <select id="selectTrangThaiTK" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none border border-outline-variant/40">
                        <option value="1">Kích hoạt (Hoạt động)</option>
                        <option value="0">Khóa tài khoản</option>
                    </select>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-end gap-space-sm pt-space-md border-t border-surface-container-high">
                <button type="button" onclick="closeTaiKhoanModal()" class="px-5 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-title-sm text-title-sm transition-all">
                    Hủy bỏ
                </button>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-all shadow-md flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    <span>Lưu tài khoản</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openAddModal() {
        document.getElementById('modalTaiKhoanTitle').innerText = 'Thêm Tài Khoản Mới';
        document.getElementById('inputTenDangNhap').value = '';
        document.getElementById('inputHoTen').value = '';
        document.getElementById('inputEmail').value = '';
        document.getElementById('inputMatKhau').value = '';
        document.getElementById('taiKhoanModal').classList.remove('hidden');
    }

    function openEditModal(username, fullname, email, role, status) {
        document.getElementById('modalTaiKhoanTitle').innerText = 'Chỉnh Sửa Tài Khoản (' + username + ')';
        document.getElementById('inputTenDangNhap').value = username;
        document.getElementById('inputHoTen').value = fullname;
        document.getElementById('inputEmail').value = email;
        document.getElementById('selectVaiTro').value = role;
        document.getElementById('selectTrangThaiTK').value = status;
        document.getElementById('taiKhoanModal').classList.remove('hidden');
    }

    function closeTaiKhoanModal() {
        document.getElementById('taiKhoanModal').classList.add('hidden');
    }

    function handleTaiKhoanSubmit(e) {
        e.preventDefault();
        alert('Lưu thông tin tài khoản thành công!');
        closeTaiKhoanModal();
    }
</script>
