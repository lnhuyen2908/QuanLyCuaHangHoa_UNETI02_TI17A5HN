                </div>

                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Ghi chú nhân viên / Thợ cắm</label>
                    <textarea id="inputGhiChu" rows="2" placeholder="Ghi chú thành phần hoa chốt và hướng dẫn shipper..." class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none border border-outline-variant/40"></textarea>
                </div>
            </form>
        </div>

        <!-- Modal Footer -->
        <div class="flex items-center justify-end gap-space-sm px-space-lg py-space-md bg-surface-container-low border-t border-surface-container-high">
            <button type="button" onclick="closeModal()" class="px-5 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-title-sm text-title-sm transition-all">
                Hủy bỏ
            </button>
            <button type="button" onclick="document.getElementById('modalForm').requestSubmit()" class="px-6 py-2.5 rounded-xl bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-all shadow-md flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[18px]">check_circle</span>
                <span>Chốt giá &amp; Tạo đơn hàng</span>
            </button>
        </div>
    </div>
</div>

<script>
    function openModal(id, customerName, contact, note, budget, finalPrice, prodName, colors, flowers, cardText, statusText, statusClass) {
        document.getElementById('modalTitle').innerText = 'Duyệt & Chốt Giá Yêu Cầu #' + id;
        document.getElementById('modalCustomerName').innerText = customerName;
        document.getElementById('modalCustomerContact').innerText = contact;
        document.getElementById('modalCustomerNote').innerText = '"' + note + '"';
        document.getElementById('inputNganSach').value = budget;
        document.getElementById('inputGiaChot').value = finalPrice || '';
        document.getElementById('inputTenSanPham').value = prodName || '';
        document.getElementById('inputTongMau').value = colors || '';
        document.getElementById('inputLoaiHoa').value = flowers || '';
        document.getElementById('inputThiep').value = cardText || '';
        
        var badge = document.getElementById('modalStatusBadge');
        badge.innerText = statusText || 'Chờ báo giá';
        badge.className = 'font-label-md text-label-md px-2.5 py-0.5 rounded-full font-bold ' + (statusClass || 'bg-error-container text-on-error-container');

        var modal = document.getElementById('duyetChotGiaModal');
        modal.classList.remove('hidden');
    }

    function closeModal() {
        var modal = document.getElementById('duyetChotGiaModal');
        modal.classList.add('hidden');
    }

    function handleFormSubmit(e) {
        e.preventDefault();
        alert('Đã duyệt & chốt giá thành công! Đơn hàng đã được chuyển sang bộ phận cắm hoa.');
        closeModal();
    }
</script>
