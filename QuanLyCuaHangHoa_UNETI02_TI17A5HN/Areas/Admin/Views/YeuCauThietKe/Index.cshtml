@* Họ và tên: Đặng Thị Mai Hương
Mã sinh viên: 23103100293
Nội dung thực hiện: Hiển thị dữ liệu thật, form GET lọc và POST có chống CSRF*@

@model List<QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.Entities.ChiTietDonHoa>
@* Danh sách các chi tiết MaMau = null; lọc yêu cầu chưa chốt và đã chốt giá. *@
@{
    ViewBag.Title = "Xử Lý Yêu Cầu Thiết Kế Riêng";
    ViewBag.ActiveMenu = "YeuCauThietKe";
    ViewBag.Breadcrumb = "Thiết kế riêng (Bespoke)";
}

<div class="px-space-xl py-space-lg flex flex-col w-full space-y-space-md">
    <!-- Header Section -->
    @await Html.PartialAsync("_AdminPageHeader")

    @if (TempData["Error"] != null)
    {
        <div class="rounded-xl bg-error-container p-4 text-error">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="rounded-xl bg-tertiary-fixed p-4 text-tertiary">@TempData["Success"]</div>
    }

    <!-- Thẻ thống kê -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm">
            <p>Chờ báo giá</p>
            <strong class="font-headline-md text-2xl text-error">@Model.Count(x => !x.DaChotGia) đơn</strong>
        </div>
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm">
            <p>Đã chốt giá</p>
            <strong class="font-headline-md text-2xl text-tertiary">@Model.Count(x => x.DaChotGia) đơn</strong>
        </div>
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm">
            <p>Tổng yêu cầu hiển thị</p>
            <strong class="font-headline-md text-2xl text-primary">@Model.Count đơn</strong>
        </div>
    </div>

    <!-- Bộ lọc nhanh -->
    <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex gap-3">
        <a href="/Admin/YeuCauThietKe" class="text-primary underline">Tất cả</a>
        <a href="/Admin/YeuCauThietKe?trangThai=cho" class="text-primary underline">Chờ báo giá</a>
        <a href="/Admin/YeuCauThietKe?trangThai=da" class="text-primary underline">Đã chốt</a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-space-md">
        @* Một yêu cầu tương ứng một ChiTietDonHoa. Dữ liệu giá và trạng thái đọc từ DB. *@
        @foreach (var item in Model)
        {
            <article class="bg-surface-container-lowest rounded-xl shadow-sm p-space-lg space-y-3">

                <div class="flex justify-between items-center">
                    <strong class="text-primary">
                        #CTM-@item.MaDon.ToString("D4") • Chi tiết #@item.MaChiTiet
                    </strong>
                    <span class="text-sm @(item.DaChotGia ? "text-tertiary" : "text-error")">
                        @(item.DaChotGia ? "Đã báo giá" : "Chờ báo giá")
                    </span>
                </div>

                <p class="text-on-surface font-semibold">
                    @item.DonDatHoa.KhachHang.HoTen — @item.DonDatHoa.SoDienThoaiNguoiNhan
                </p>

                <p class="text-xs text-secondary">
                    Gửi: @item.DonDatHoa.NgayDat.ToString("dd/MM/yyyy HH:mm")
                    • Dự kiến: @item.DonDatHoa.ThoiGianNhanGiao.ToString("dd/MM/yyyy HH:mm")
                </p>

                <p class="text-sm break-words whitespace-pre-line">@item.YeuCauRieng</p>

                <p class="text-sm">Trạng thái đơn: @item.DonDatHoa.TrangThai</p>

                @if (item.DaChotGia)
                {
                    <strong class="text-primary">Giá đã chốt: @item.DonGia.ToString("N0")₫</strong>
                }
                else if (item.DonDatHoa.TrangThai == TrangThaiDon.ChoXacNhan)
                {
                    @* Chốt giá bắt buộc POST + AntiForgeryToken; cập nhật dòng chi tiết và tổng đơn ở Controller. *@
                    <form method="post"
                          asp-action="ChotGia"
                          class="flex flex-wrap items-end gap-3"
                          onsubmit="return confirm('Xác nhận chốt giá này?')">
                        @Html.AntiForgeryToken()
                        <input name="maChiTiet" type="hidden" value="@item.MaChiTiet" />
                        <label class="flex-1">
                            Giá chốt (VNĐ)
                            <input type="number"
                                   name="donGia"
                                   min="1"
                                   max="999999999"
                                   step="0.01"
                                   required
                                   class="block w-full rounded-lg border border-outline-variant bg-surface-container-low p-3" />
                        </label>
                        <button type="submit" class="px-5 py-3 rounded-xl bg-primary text-on-primary">
                            Chốt giá
                        </button>
                    </form>
                }

                <a asp-area="Admin"
                   asp-controller="DonDatHoa"
                   asp-action="Details"
                   asp-route-id="@item.MaDon"
                   class="inline-block text-primary underline text-sm">
                    Chi tiết đơn / Xác nhận đơn
                </a>
            </article>
        }

        @if (!Model.Any())
        {
            <div class="rounded-xl bg-surface-container-lowest p-6 text-secondary">
                Chưa có yêu cầu thiết kế riêng phù hợp.
            </div>
        }
    </div>
</div>
