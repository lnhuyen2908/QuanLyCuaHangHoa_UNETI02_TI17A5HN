                    <circle cx="10" cy="145" r="4" fill="#8a4853"></circle>
                    <circle cx="95" cy="105" r="4" fill="#8a4853"></circle>
                    <circle cx="180" cy="85" r="4" fill="#8a4853"></circle>
                    <circle cx="265" cy="95" r="4" fill="#8a4853"></circle>
                    <circle cx="350" cy="45" r="4" fill="#8a4853"></circle>
                    <circle cx="435" cy="60" r="4" fill="#8a4853"></circle>
                    <circle cx="490" cy="20" r="5" fill="#446435"></circle>
