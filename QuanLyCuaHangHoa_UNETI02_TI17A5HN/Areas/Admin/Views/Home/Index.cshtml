                            <th class="py-3 px-space-md">Hẹn giao</th>
                            <th class="py-3 px-space-md">Tổng tiền</th>
                            <th class="py-3 px-space-md">Trạng thái</th>
                            <th class="py-3 px-space-md text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-surface-container font-body-sm text-body-sm">
                        <tr class="hover:bg-surface-container-low/40 transition-colors">
                            <td class="py-3.5 px-space-md font-title-sm text-title-sm text-primary">#ORD-9021</td>
                            <td class="py-3.5 px-space-md">
                                <div class="font-title-sm text-title-sm text-on-surface">Nguyễn Thu Thảo</div>
                                <div class="text-secondary font-body-sm text-body-sm">0903 124 ***</div>
                            </td>
                            <td class="py-3.5 px-space-md">
                                <span class="font-title-sm text-title-sm text-on-surface">Bó Hoa Sunset Romance</span>
                            </td>
                            <td class="py-3.5 px-space-md">
                                <span class="text-primary font-bold">15:00 Hôm nay</span>
                            </td>
                            <td class="py-3.5 px-space-md font-title-sm text-title-sm text-on-surface">1.450.000đ</td>
                            <td class="py-3.5 px-space-md">
                                @await Html.PartialAsync("_AdminStatusBadge", "Đang cắm hoa")
                            </td>
                            <td class="py-3.5 px-space-md text-right">
                                <a href="/Admin/DonDatHoa" class="bg-primary text-on-primary px-3 py-1 rounded-lg font-title-sm text-title-sm inline-block">Chi tiết</a>
                            </td>
                        </tr>
                        <tr class="hover:bg-surface-container-low/40 transition-colors">
                            <td class="py-3.5 px-space-md font-title-sm text-title-sm text-primary">#ORD-9020</td>
                            <td class="py-3.5 px-space-md">
                                <div class="font-title-sm text-title-sm text-on-surface">Trần Minh Hoàng</div>
                                <div class="text-secondary font-body-sm text-body-sm">0918 882 ***</div>
                            </td>
                            <td class="py-3.5 px-space-md">
                                <span class="font-title-sm text-title-sm text-on-surface">Giỏ Mây Pastel Bloom</span>
                            </td>
                            <td class="py-3.5 px-space-md">
                                <span class="text-on-surface font-medium">16:30 Hôm nay</span>
                            </td>
                            <td class="py-3.5 px-space-md font-title-sm text-title-sm text-on-surface">2.200.000đ</td>
