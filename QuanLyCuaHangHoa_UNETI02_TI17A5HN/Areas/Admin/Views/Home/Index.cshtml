            </div>
            <a href="/Admin/DonDatHoa" class="flex items-center gap-space-xs bg-primary text-on-primary px-space-md py-2 rounded-xl font-title-sm text-title-sm shadow-sm hover:bg-primary-container transition-all">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span>Tạo đơn tại quầy</span>
            </a>
            <button type="button" class="flex items-center gap-space-xs bg-surface-container-high text-on-surface px-space-md py-2 rounded-xl font-title-sm text-title-sm hover:bg-surface-variant transition-all">
                <span class="material-symbols-outlined text-[18px]">refresh</span>
                <span>Đồng bộ LINQ</span>
            </button>
        </div>
    </div>

    <!-- Key Metrics (7 Real-time Indicators) -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-7 gap-space-sm">
