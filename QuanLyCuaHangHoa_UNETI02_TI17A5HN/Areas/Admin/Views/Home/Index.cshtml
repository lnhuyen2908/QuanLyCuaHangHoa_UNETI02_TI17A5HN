                <div class="absolute top-2 right-1 bg-surface-container text-on-surface px-2 py-1 rounded shadow-sm font-label-md text-label-md">
                    Tháng 10: <span class="text-tertiary font-bold">428.600.000đ</span>
                </div>
            </div>

            <div class="flex justify-between font-label-md text-label-md text-secondary mt-2 px-1">
                <span>T5</span>
                <span>T6</span>
                <span>T7</span>
                <span>T8</span>
                <span>T9 (Vu Lan)</span>
                <span>T10 (20/10)</span>
                <span class="text-tertiary font-bold">T11 Dự Báo</span>
            </div>
        </div>

