                    <span class="font-headline-sm text-headline-sm text-on-surface font-bold">94%</span>
                    <span class="font-label-md text-label-md text-secondary">Tỷ lệ xong</span>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-x-2 gap-y-1 font-body-sm text-body-sm text-secondary">
                <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-tertiary"></span><span>Hoàn tất (50%)</span></div>
                <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-primary"></span><span>Chờ duyệt (18%)</span></div>
                <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-primary-container"></span><span>Đang cắm (14%)</span></div>
                <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-tertiary-container"></span><span>Đang giao (12%)</span></div>
                <div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-error"></span><span>Hủy đơn (6%)</span></div>
