        <!-- Product Category Share -->
        <div class="lg:col-span-3 bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex flex-col justify-between">
            <div>
                <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Phân loại danh mục</span>
