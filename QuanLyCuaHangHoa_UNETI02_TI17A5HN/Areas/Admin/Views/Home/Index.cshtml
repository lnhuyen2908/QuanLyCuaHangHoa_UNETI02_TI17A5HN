                    <circle cx="50" cy="50" r="38" fill="transparent" stroke="#446435" stroke-dasharray="119 238" stroke-dashoffset="0" stroke-width="12"></circle>
                    <circle cx="50" cy="50" r="38" fill="transparent" stroke="#8a4853" stroke-dasharray="43 238" stroke-dashoffset="-119" stroke-width="12"></circle>
                    <circle cx="50" cy="50" r="38" fill="transparent" stroke="#a6606b" stroke-dasharray="33 238" stroke-dashoffset="-162" stroke-width="12"></circle>
                    <circle cx="50" cy="50" r="38" fill="transparent" stroke="#5b7e4b" stroke-dasharray="28 238" stroke-dashoffset="-195" stroke-width="12"></circle>
                    <circle cx="50" cy="50" r="38" fill="transparent" stroke="#ba1a1a" stroke-dasharray="15 238" stroke-dashoffset="-223" stroke-width="12"></circle>
                </svg>
