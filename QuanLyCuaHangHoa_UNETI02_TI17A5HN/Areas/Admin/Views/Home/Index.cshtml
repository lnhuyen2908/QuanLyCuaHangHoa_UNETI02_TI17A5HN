                <span class="material-symbols-outlined text-[20px] text-primary">pending_actions</span>
            </div>
            <div class="mt-space-md">
                <div class="font-headline-md text-headline-md text-on-surface">24</div>
                <div class="flex items-center gap-1 mt-1 font-body-sm text-body-sm text-primary">
