@model QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Bảng Điều Khiển Quản Trị";
    ViewBag.ActiveMenu = "Dashboard";
    ViewBag.Breadcrumb = "Bảng điều khiển hệ thống";
}

<div class="px-space-xl py-space-lg flex flex-col w-full space-y-space-md">
    <!-- Thông báo kết quả / cảnh báo quyền truy cập -->
    @if (TempData["Loi"] != null)
    {
        <div class="flex items-center gap-3 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 shadow-sm animate-fade-in">
            <span class="material-symbols-outlined text-[24px] text-rose-600">block</span>
            <div class="flex flex-col">
                <span class="font-title-sm text-title-sm font-bold text-rose-900">Từ chối truy cập</span>
                <span class="font-body-md text-body-md font-medium">@TempData["Loi"]</span>
            </div>
        </div>
    }

    @if (TempData["ThanhCong"] != null)
    {
        <div class="flex items-center gap-2 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 shadow-sm animate-fade-in">
            <span class="material-symbols-outlined text-[20px] text-emerald-600">check_circle</span>
            <span class="font-body-md text-body-md font-medium">@TempData["ThanhCong"]</span>
        </div>
    }

    <!-- Top Banner & Quick Status Bar -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md pb-space-xs">
        <div>
            <div class="flex items-center gap-space-xs mb-1">
                <span class="inline-flex items-center justify-center w-2 h-2 rounded-full bg-tertiary animate-pulse"></span>
                <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Hệ Thống Trực Tuyến • ASP.NET Core 10 Runtime</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Trung Tâm Điều Hành - Nhóm 2 Atelier</h1>
            <p class="font-body-md text-body-md text-on-surface-variant">Tổng quan hiệu suất bán lẻ, xử lý đơn hoa tươi và phê duyệt yêu cầu thiết kế theo yêu cầu trong ngày.</p>
        </div>
        <div class="flex flex-wrap items-center gap-space-sm">
            <div class="flex items-center gap-space-xs bg-surface-container px-space-md py-2 rounded-xl text-secondary">
                <span class="material-symbols-outlined text-[18px]">calendar_today</span>
                <span id="live-datetime" class="font-title-sm text-title-sm text-on-surface">Thứ Sáu, 02/10/2026 • 23:56:23</span>
            </div>
            <a href="/Admin/DonDatHoa" class="flex items-center gap-space-xs bg-primary text-on-primary px-space-md py-2 rounded-xl font-title-sm text-title-sm shadow-sm hover:bg-primary-container transition-all">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span>Tạo đơn tại quầy</span>
            </a>
            <a href="/Admin/Home/Index" class="flex items-center gap-space-xs bg-surface-container-high text-on-surface px-space-md py-2 rounded-xl font-title-sm text-title-sm hover:bg-surface-variant transition-all">
                <span class="material-symbols-outlined text-[18px]">refresh</span>
                <span>Đồng bộ LINQ</span>
            </a>
        </div>
    </div>

    <!-- Key Metrics (7 Real-time Indicators) -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-7 gap-space-sm">
        <!-- Card 1 -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between group hover:shadow-md transition-all">
            <div class="flex items-center justify-between text-secondary">
                <span class="font-label-md text-label-md uppercase tracking-wider">Chờ xác nhận</span>
                <span class="material-symbols-outlined text-[20px] text-primary">pending_actions</span>
            </div>
            <div class="mt-space-md">
                <div class="font-headline-md text-headline-md text-on-surface">@Model.ChoXacNhan</div>
                <div class="flex items-center gap-1 mt-1 font-body-sm text-body-sm text-primary">
                    <span class="material-symbols-outlined text-[14px]">arrow_upward</span>
                    <span>Cần kiểm tra và xác nhận</span>
                </div>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between group hover:shadow-md transition-all">
            <div class="flex items-center justify-between text-secondary">
                <span class="font-label-md text-label-md uppercase tracking-wider">Đang chuẩn bị</span>
                <span class="material-symbols-outlined text-[20px] text-primary-container">palette</span>
            </div>
            <div class="mt-space-md">
                <div class="font-headline-md text-headline-md text-on-surface">@Model.DangChuanBi</div>
                <div class="font-body-sm text-body-sm text-on-surface-variant mt-1">Đơn đang chuẩn bị</div>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between group hover:shadow-md transition-all">
            <div class="flex items-center justify-between text-secondary">
                <span class="font-label-md text-label-md uppercase tracking-wider">Đang giao</span>
                <span class="material-symbols-outlined text-[20px] text-tertiary">local_shipping</span>
            </div>
            <div class="mt-space-md">
                <div class="font-headline-md text-headline-md text-on-surface">@Model.DangGiao</div>
                <div class="flex items-center gap-1 mt-1 font-body-sm text-body-sm text-tertiary">
                    <span class="material-symbols-outlined text-[14px]">near_me</span>
                    <span>Đơn đang vận chuyển</span>
                </div>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between group hover:shadow-md transition-all">
            <div class="flex items-center justify-between text-secondary">
                <span class="font-label-md text-label-md uppercase tracking-wider">Đã hoàn thành</span>
                <span class="material-symbols-outlined text-[20px] text-tertiary">task_alt</span>
            </div>
            <div class="mt-space-md">
                <div class="font-headline-md text-headline-md text-on-surface">@Model.HoanThanh</div>
                <div class="font-body-sm text-body-sm text-on-surface-variant mt-1">Tổng đơn đã hoàn thành</div>
            </div>
        </div>

        <!-- Card 5 (Doanh thu) -->
        <div class="col-span-2 md:col-span-1 lg:col-span-1 bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between group hover:shadow-md transition-all">
            <div class="flex items-center justify-between text-secondary">
                <span class="font-label-md text-label-md uppercase tracking-wider">Doanh thu ngày</span>
                <span class="material-symbols-outlined text-[20px] text-primary">payments</span>
            </div>
            <div class="mt-space-md">
                <div class="font-headline-md text-headline-md text-primary font-bold">@Model.DoanhThuNgay.ToString("N0")₫</div>
                <div class="flex items-center gap-1 mt-1 font-body-sm text-body-sm text-tertiary">
                    <span class="material-symbols-outlined text-[14px]">trending_up</span>
                    <span>Tổng tiền thực thu hôm nay</span>
                </div>
            </div>
        </div>

        <!-- Card 6 -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between group hover:shadow-md transition-all">
            <div class="flex items-center justify-between text-secondary">
                <span class="font-label-md text-label-md uppercase tracking-wider">Giao hôm nay</span>
                <span class="material-symbols-outlined text-[20px] text-secondary">schedule_send</span>
            </div>
            <div class="mt-space-md">
                <div class="font-headline-md text-headline-md text-on-surface">@Model.GiaoHomNay</div>
                <div class="font-body-sm text-body-sm text-on-surface-variant mt-1">Phiếu giao dự kiến hôm nay</div>
            </div>
        </div>

        <!-- Card 7 -->
        <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-col justify-between group hover:shadow-md transition-all">
            <div class="flex items-center justify-between text-secondary">
                <span class="font-label-md text-label-md uppercase tracking-wider">Chưa thanh toán</span>
                <span class="material-symbols-outlined text-[20px] text-error">credit_card_off</span>
            </div>
            <div class="mt-space-md">
                <div class="font-headline-md text-headline-md text-error">@Model.DonConThieuTien</div>
                <div class="font-body-sm text-body-sm text-error mt-1">Đơn còn thiếu tiền</div>
            </div>
        </div>
    </div>

    
    @* Nguyễn Thị Đào - 23103100245
   Tính tọa độ biểu đồ doanh thu 7 ngày từ LINQ *@

    @{
        var duLieuBieuDo = Model.DoanhThu7Ngay
            .OrderBy(x => x.Ngay)
            .ToList();

        var doanhThuLonNhat = duLieuBieuDo.Count > 0
            ? duLieuBieuDo.Max(x => x.SoTien)
            : 0m;

        var mucChia = doanhThuLonNhat > 0
            ? doanhThuLonNhat
            : 1m;

        var diemBieuDo = duLieuBieuDo
            .Select((item, i) => new
            {
                X = 10 + i * 80,
                Y = (165 - (double)(item.SoTien / mucChia) * 135)
                    .ToString("0.##",
                        System.Globalization.CultureInfo.InvariantCulture)
            })
            .ToList();

        var duongBieuDo = string.Join(" ",
            diemBieuDo.Select(p => $"{p.X},{p.Y}"));

        var vungBieuDo = "10,165 " + duongBieuDo + " 490,165";
    }

    <!-- Analytics Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg">

        @* Nguyễn Thị Đào - 23103100245
           Biểu đồ doanh thu 7 ngày từ SQL Server *@

        <!-- Revenue Chart -->
        <div class="lg:col-span-6 bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex flex-col justify-between">

            <div class="flex items-center justify-between mb-space-md">
                <div>
                    <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">
                        Doanh thu thực tế • LINQ
                    </span>
                    <h2 class="font-headline-sm text-headline-sm text-on-surface mt-1">
                        Biểu đồ doanh thu 7 ngày
                    </h2>
                </div>

                <span class="bg-surface-container-low px-space-sm py-1 rounded-lg text-secondary">
                    7 ngày gần nhất
                </span>
            </div>

            <div class="w-full h-56 relative pt-4">

                <svg class="w-full h-full overflow-visible"
                     preserveAspectRatio="none"
                     viewBox="0 0 500 180">

                    <defs>
                        <linearGradient id="roseGradient"
                                        x1="0%" y1="0%"
                                        x2="0%" y2="100%">
                            <stop offset="0%"
                                  stop-color="#8a4853"
                                  stop-opacity="0.25" />
                            <stop offset="100%"
                                  stop-color="#8a4853"
                                  stop-opacity="0" />
                        </linearGradient>
                    </defs>

                    <line x1="0" y1="30" x2="500" y2="30"
                          stroke="#f5ecea" stroke-dasharray="3,3" />

                    <line x1="0" y1="75" x2="500" y2="75"
                          stroke="#f5ecea" stroke-dasharray="3,3" />

                    <line x1="0" y1="120" x2="500" y2="120"
                          stroke="#f5ecea" stroke-dasharray="3,3" />

                    <line x1="0" y1="165" x2="500" y2="165"
                          stroke="#f5ecea" />

                    <polygon points="@vungBieuDo"
                             fill="url(#roseGradient)" />

                    <polyline points="@duongBieuDo"
                              fill="none"
                              stroke="#8a4853"
                              stroke-width="3"
                              stroke-linejoin="round"
                              stroke-linecap="round" />

                    @foreach (var diem in diemBieuDo)
                    {
                        <circle cx="@diem.X"
                                cy="@diem.Y"
                                r="4"
                                fill="#8a4853" />
                    }

                </svg>

                <div class="absolute top-2 right-1 bg-surface-container text-on-surface px-2 py-1 rounded shadow-sm font-label-md text-label-md">
                    Tổng 7 ngày:
                    <span class="text-tertiary font-bold">
                        @(Model.DoanhThu7Ngay.Sum(x => x.SoTien).ToString("N0"))₫
                    </span>
                </div>
            </div>

            <div class="flex justify-between font-label-md text-label-md text-secondary mt-2 px-1">
                @foreach (var ngay in duLieuBieuDo)
                {
                    <span>@ngay.Ngay.ToString("dd/MM")</span>
                }
            </div>
        </div>


        
        @* Nguyễn Thị Đào - 23103100245
            Biểu đồ cơ cấu trạng thái đơn hàng bằng LINQ*@

        @{
            var cacTrangThai = new[]
            {
        new { Ten = "Chờ xác nhận", SoLuong = Model.ChoXacNhan, Mau = "#8a4853" },
        new { Ten = "Đã xác nhận", SoLuong = Model.DaXacNhan, Mau = "#c59054" },
        new { Ten = "Đang chuẩn bị", SoLuong = Model.DangChuanBi, Mau = "#a6606b" },
        new { Ten = "Sẵn sàng", SoLuong = Model.SanSang, Mau = "#759b69" },
        new { Ten = "Đang giao", SoLuong = Model.DangGiao, Mau = "#446435" },
        new { Ten = "Hoàn thành", SoLuong = Model.HoanThanh, Mau = "#298c68" },
        new { Ten = "Đã hủy", SoLuong = Model.DaHuy, Mau = "#ba1a1a" }
    };

            var tongDonBieuDo = Model.TongDon;
            var chuVi = 2 * Math.PI * 38;
            double doDaiDaVe = 0;

            double tyLeHoanThanh = tongDonBieuDo > 0
                ? Model.HoanThanh * 100.0 / tongDonBieuDo
                : 0;
        }

        <!-- Donut Chart Stage distribution -->
        <div class="lg:col-span-3 bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex flex-col justify-between">

            <div>
                <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">
                    Cơ cấu trạng thái • LINQ
                </span>

                <h2 class="font-headline-sm text-headline-sm text-on-surface mt-1">
                    Tổng @Model.TongDon đơn hàng
                </h2>
            </div>

            <div class="flex items-center justify-center my-space-md relative">

                <svg class="w-36 h-36 transform -rotate-90"
                     viewBox="0 0 100 100">

                    <!-- Vòng tròn nền -->
                    <circle cx="50" cy="50" r="38"
                            fill="transparent"
                            stroke="#f5ecea"
                            stroke-width="12" />

                    <!-- Các phần trạng thái -->
                    @foreach (var muc in cacTrangThai)
                    {
                        double doDai = tongDonBieuDo > 0
                            ? muc.SoLuong * chuVi / tongDonBieuDo
                            : 0;

                        double viTriBatDau = -doDaiDaVe;

                        doDaiDaVe += doDai;

                        if (muc.SoLuong > 0)
                        {
                            <circle cx="50" cy="50" r="38"
                                    fill="transparent"
                                    stroke="@muc.Mau"
                                    stroke-width="12"
                                    stroke-dasharray="@(
                                    doDai.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)
                                    + " " +
                                    chuVi.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)
                                    )"
                                    stroke-dashoffset="@(
                                    viTriBatDau.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)
                                    )" />
                        }
                    }
                </svg>

                <!-- Tỷ lệ hoàn thành ở giữa -->
                <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                    <span class="font-headline-sm text-headline-sm text-on-surface font-bold">
                        @(tyLeHoanThanh.ToString("0.#"))%
                    </span>
                    <span class="font-label-md text-label-md text-secondary">
                        Hoàn thành
                    </span>
                </div>
            </div>

            <!-- Chú thích 7 trạng thái -->
            <div class="grid grid-cols-2 gap-x-2 gap-y-2 font-body-sm text-body-sm text-secondary">

                @foreach (var muc in cacTrangThai)
                {
                    double phanTram = tongDonBieuDo > 0
                        ? muc.SoLuong * 100.0 / tongDonBieuDo
                        : 0;

                    <div class="flex items-start gap-1.5">

                        <span class="w-2 h-2 rounded-full shrink-0 mt-1"
                              style="background-color: @muc.Mau">
                        </span>

                        <span>
                            @muc.Ten
                            (@(phanTram.ToString("0.#"))%)
                        </span>

                    </div>
                }

            </div>
        </div>

        @* KẾT THÚC BỔ SUNG - NGUYỄN THỊ ĐÀO *@


        @* Nguyễn Thị Đào - 23103100245
           Thống kê sức tiêu thụ kiểu sản phẩm bằng LINQ*@

        <!-- Product Category Share -->
        <div class="lg:col-span-3 bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex flex-col justify-between">

            <div>
                <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">
                    Phân loại danh mục • LINQ
                </span>

                <h2 class="font-headline-sm text-headline-sm text-on-surface mt-1">
                    Sức tiêu thụ kiểu mẫu
                </h2>
            </div>

            <div class="space-y-space-md my-space-sm">

                @foreach (var item in Model.ThongKeKieuSanPham)
                {
                    string mauThanh = item.TenKieu switch
                    {
                        "Bó hoa" => "bg-primary",
                        "Giỏ hoa" => "bg-tertiary",
                        "Hộp hoa" => "bg-primary-container",
                        "Kệ hoa" => "bg-secondary",
                        _ => "bg-primary"
                    };

                    <div>
                        <div class="flex justify-between gap-2 font-title-sm text-title-sm text-on-surface mb-1">

                            <span>@item.TenKieu</span>

                            <span class="font-semibold whitespace-nowrap">
                                @(item.TyLe.ToString("0.#"))%
                            </span>

                        </div>

                        <div class="w-full bg-surface-container h-2 rounded-full overflow-hidden">

                            <div class="@mauThanh h-full rounded-full transition-all"
                                 style="width: @(item.TyLe.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%">
                            </div>

                        </div>

                        <div class="text-xs text-secondary mt-1">
                            @item.SoLuong sản phẩm đã đặt
                        </div>
                    </div>
                }

            </div>

            @{
                var kieuBanChay = Model.ThongKeKieuSanPham
                    .OrderByDescending(x => x.SoLuong)
                    .FirstOrDefault();
            }

            <div class="p-space-sm bg-surface-container rounded-lg flex items-start gap-space-xs text-secondary font-body-sm text-body-sm">

                <span class="material-symbols-outlined text-[18px] text-tertiary">
                    tips_and_updates
                </span>

                <span>
                    @if (kieuBanChay != null && kieuBanChay.SoLuong > 0)
                    {
                        <text>
                            Kiểu sản phẩm được đặt nhiều nhất:
                            <strong>@kieuBanChay.TenKieu</strong>
                            (@kieuBanChay.SoLuong sản phẩm).
                        </text>
                    }
                    else
                    {
                        <text>Chưa có dữ liệu đặt mẫu sản phẩm.</text>
                    }
                </span>

            </div>
        </div>

        @* KẾT THÚC PHẦN BỔ SUNG - NGUYỄN THỊ ĐÀO *@

    </div>

    <!-- Priority Dispatch Table & Bespoke Fast-track Queue -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
        <!-- Urgent Orders Table -->
        <div class="lg:col-span-8 bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
            <div class="p-space-lg flex flex-col md:flex-row md:items-center justify-between gap-space-sm bg-surface-container-low/50">
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="font-headline-sm text-headline-sm text-on-surface">Đơn hàng cần xử lý hôm nay</h2>
                        <span class="bg-primary text-on-primary font-label-md text-label-md px-2 py-0.5 rounded-full">@Model.DonCanXuLy.Count đơn hiển thị</span>
                    </div>
                    <p class="font-body-sm text-body-sm text-secondary mt-0.5">Kiểm soát tiến độ cắm hoa, đối soát tiền và giao hoa đúng khung giờ khách hẹn.</p>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/Admin/DonDatHoa" class="px-space-md py-1.5 rounded-lg bg-primary/10 text-primary font-title-sm text-title-sm hover:bg-primary/20 flex items-center gap-1">
                        <span class="material-symbols-outlined text-[18px]">list_alt</span>
                        <span>Quản lý đơn đặt</span>
                    </a>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-container-low text-secondary font-label-md text-label-md uppercase tracking-wider">
                            <th class="py-3 px-space-md">Mã đơn</th>
                            <th class="py-3 px-space-md">Người nhận</th>
                            <th class="py-3 px-space-md">Mẫu hoa đầu tiên</th>
                            <th class="py-3 px-space-md">Hẹn giao</th>
                            <th class="py-3 px-space-md">Tổng tiền</th>
                            <th class="py-3 px-space-md">Trạng thái</th>
                            <th class="py-3 px-space-md text-right">Thao tác</th>
                        </tr>
                    </thead>

                    @* Nguyễn Thị Đào - 23103100245
                       Hiển thị đơn cần xử lý hôm nay từ SQL Server*@
                    <tbody class="divide-y divide-surface-container font-body-sm text-body-sm">

                        @if (Model.DonCanXuLy.Count == 0)
                        {
                            <tr>
                                <td colspan="7"
                                    class="py-10 px-4 text-center text-secondary">
                                    Không có đơn hàng cần xử lý trong hôm nay.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var don in Model.DonCanXuLy)
                            {
                                <tr class="hover:bg-surface-container-low/40 transition-colors">

                                    <!-- Mã đơn -->
                                    <td class="py-3.5 px-space-md font-title-sm text-title-sm text-primary">
                                        #ORD-@don.MaDon.ToString("D4")
                                    </td>

                                    <!-- Người nhận -->
                                    <td class="py-3.5 px-space-md">
                                        <div class="font-title-sm text-title-sm text-on-surface">
