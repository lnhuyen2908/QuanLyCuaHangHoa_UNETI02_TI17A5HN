        </div>
    </div>

    <!-- Priority Dispatch Table & Bespoke Fast-track Queue -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
        <!-- Urgent Orders Table -->
        <div class="lg:col-span-8 bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden">
            <div class="p-space-lg flex flex-col md:flex-row md:items-center justify-between gap-space-sm bg-surface-container-low/50">
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="font-headline-sm text-headline-sm text-on-surface">Đơn Hàng Cần Xử Lý Gấp Hôm Nay</h2>
