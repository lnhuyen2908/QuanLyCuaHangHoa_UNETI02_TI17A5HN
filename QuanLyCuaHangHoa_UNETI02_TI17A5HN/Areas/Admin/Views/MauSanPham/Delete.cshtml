@*
    Họ và tên: Nguyễn Thị Phương Anh
    Mã sinh viên: 23103100267
    Nội dung thực hiện: Hiển thị thông tin và xác nhận xóa mẫu sản phẩm.
*@

@model QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.Entities.MauSanPham

@{
    ViewBag.Title = "Xóa mẫu sản phẩm";
    ViewBag.ActiveMenu = "MauSanPham";
    ViewBag.Breadcrumb = "Xóa mẫu sản phẩm";
}

<div class="px-space-xl py-space-lg flex flex-col w-full space-y-space-lg">
    @await Html.PartialAsync("_AdminPageHeader")

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg">
        <!-- LEFT COLUMN: Product information -->
        <div class="lg:col-span-7">
            <section class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm space-y-space-md">
                <div class="pb-space-sm border-b border-surface-container">
                    <h2 class="font-headline-sm text-headline-sm text-on-surface">Thông tin mẫu sản phẩm</h2>
                </div>

                <div class="space-y-space-md">
                    <div>
                        <label class="block font-title-sm text-title-sm text-secondary mb-1">Mã mẫu</label>
                        <div class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface">
                            @Model.MaMau
                        </div>
                    </div>

                    <div>
                        <label class="block font-title-sm text-title-sm text-secondary mb-1">Tên mẫu sản phẩm</label>
                        <div class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-semibold">
                            @Model.TenMau
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                        <div>
                            <label class="block font-title-sm text-title-sm text-secondary mb-1">Dịp sử dụng</label>
                            <div class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface">
                                @(Model.DipSuDung?.TenDip ?? "Chưa xác định")
                            </div>
                        </div>
                        <div>
                            <label class="block font-title-sm text-title-sm text-secondary mb-1">Kiểu sản phẩm</label>
                            <div class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface">
                                @Model.KieuSanPham
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block font-title-sm text-title-sm text-secondary mb-1">Giá cơ bản</label>
                        <div class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-primary font-bold">
                            @Model.GiaCoBan.ToString("N0")₫
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                        <div>
                            <label class="block font-title-sm text-title-sm text-secondary mb-1">Trạng thái</label>
                            <div class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface">
                                @(Model.TrangThai ? "Đang mở bán" : "Tạm ngưng bán")
                            </div>
                        </div>
                        <div>
                            <label class="block font-title-sm text-title-sm text-secondary mb-1">Ngày tạo</label>
                            <div class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface">
                                @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.MoTa))
                    {
                        <div>
                            <label class="block font-title-sm text-title-sm text-secondary mb-1">Mô tả</label>
                            <div class="w-full min-w-0 px-3.5 py-3 rounded-lg bg-surface-container-low text-on-surface whitespace-pre-wrap break-words">@Model.MoTa</div>
                        </div>
                    }
                </div>
            </section>
        </div>

        <!-- RIGHT COLUMN: Image and warning -->
        <div class="lg:col-span-5 space-y-space-lg">
            <section class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm space-y-space-md">
                <h3 class="font-headline-sm text-headline-sm text-on-surface border-b border-surface-container pb-space-xs">
                    Hình ảnh mẫu sản phẩm
                </h3>

                @if (!string.IsNullOrWhiteSpace(Model.HinhAnh))
                {
                    <img src="@Model.HinhAnh"
                         alt="@Model.TenMau"
                         class="w-full max-h-80 object-contain rounded-xl bg-surface-container-low p-2" />
                }
                else
                {
                    <div class="w-full min-h-48 rounded-xl bg-surface-container-low flex flex-col items-center justify-center text-secondary">
                        <span class="material-symbols-outlined text-[48px]">image</span>
                        <p class="font-body-sm text-body-sm mt-2">Mẫu này chưa có hình ảnh</p>
                    </div>
                }

                @if (Model.AnhMauSanPhams.Any())
                {
                    <div>
                        <p class="font-title-sm text-title-sm text-secondary mb-2">Ảnh phụ (@Model.AnhMauSanPhams.Count)</p>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var anh in Model.AnhMauSanPhams.OrderBy(a => a.ThuTu))
                            {
                                <img src="@anh.DuongDan" alt="@Model.TenMau"
                                        class="h-20 w-20 rounded-lg object-cover" />
                            }
                        </div>
                    </div>
                }

                <div class="rounded-xl border border-error/30 bg-error-container/30 p-4 flex gap-3">
                    <span class="material-symbols-outlined text-error">warning</span>
                    <div class="space-y-1">
                        <p class="font-title-sm text-title-sm text-on-surface">Bạn có chắc chắn muốn ngừng bán mẫu này?</p>
                        <p class="font-body-sm text-body-sm text-secondary">
                            Đây là thao tác xóa mềm. Mẫu sản phẩm và thành phần hoa không bị xóa khỏi cơ sở dữ liệu.
                        </p>
                    </div>
                </div>

                <form asp-area="Admin"
                      asp-controller="MauSanPham"
                      asp-action="Delete"
                      method="post"
                      onsubmit="return confirm('Bạn có chắc chắn muốn chuyển mẫu sản phẩm này sang trạng thái tạm ngưng bán?');"
                      class="pt-space-sm flex flex-col sm:flex-row gap-space-sm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.MaMau" />

                    <a asp-area="Admin"
                       asp-controller="MauSanPham"
                       asp-action="Index"
                       class="flex-1 py-3 text-center rounded-xl bg-surface-container text-on-surface font-title-sm hover:bg-surface-container-high transition-all">
                        Hủy bỏ
                    </a>

                    <button type="submit"
                            class="flex-1 py-3 text-center rounded-xl bg-error text-white font-title-sm hover:opacity-90 transition-all">
                        <span class="material-symbols-outlined text-[18px] align-middle mr-1">delete</span>
                        Xác nhận ngừng bán
                    </button>
                </form>
            </section>
        </div>
    </div>
</div>
