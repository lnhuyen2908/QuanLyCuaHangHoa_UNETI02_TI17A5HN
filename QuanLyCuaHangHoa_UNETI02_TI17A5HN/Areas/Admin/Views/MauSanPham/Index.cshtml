@* Họ và tên: Nguyễn Thị Phương Anh
Mã sinh viên: 23103100267
Nội dung thực hiện: Hiển thị danh sách, tìm kiếm, lọc và phân trang mẫu sản phẩm *@

@model QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels.MauSanPhamListViewModel

@{
    ViewBag.Title = "Quản Lý Mẫu Sản Phẩm";
    ViewBag.ActiveMenu = "MauSanPham";
    ViewBag.Breadcrumb = "Mẫu sản phẩm";
}

<div class="px-space-xl py-space-lg flex flex-col w-full space-y-space-md">
    <!-- Header Section -->
    @await Html.PartialAsync("_AdminPageHeader")

    <!-- Key Statistics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-md mb-space-lg">
        <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex flex-col justify-between">
            <div class="flex items-start justify-between">
                <div>
                    <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Tổng mẫu sản phẩm</span>
                    <div class="mt-2 flex items-baseline gap-2">
                        <span class="px-2.5 py-0.5 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md">
                            @ViewBag.TongMau mẫu hoa
                        </span>
                    </div>
                </div>
                <div class="p-3 rounded-full bg-surface-container text-primary">
                    <span class="material-symbols-outlined text-[24px]">local_florist</span>
                </div>
            </div>
            <div class="mt-4 flex items-center gap-1.5 text-tertiary font-title-sm text-title-sm">
                <span class="material-symbols-outlined text-[16px]">trending_up</span>
                <span>@ViewBag.TongMau mẫu trong hệ thống</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex flex-col justify-between">
            <div class="flex items-start justify-between">
                <div>
                    <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Đang mở bán</span>
                    <div class="mt-2 flex items-baseline gap-2">
                        <span class="font-display-lg text-display-lg text-tertiary">@ViewBag.DangMoBan</span>
                        <span class="font-title-sm text-title-sm text-secondary">mẫu sẵn sàng</span>
                    </div>
                </div>
                <span class="px-2.5 py-1 rounded-full bg-tertiary-fixed text-on-tertiary-fixed font-label-md text-label-md">@((ViewBag.TongMau == 0 ? 0 : Math.Round((double)ViewBag.DangMoBan * 100 / (int)ViewBag.TongMau, 1)))% Đang bật</span>
            </div>
            <div class="mt-4 flex items-center gap-2">
                <div class="w-full bg-surface-container h-1.5 rounded-full overflow-hidden">
                    <div class="bg-tertiary h-full rounded-full" style="width: @(ViewBag.TongMau == 0 ? 0 : (double)ViewBag.DangMoBan * 100 / (int)ViewBag.TongMau)%"></div>
                </div>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex flex-col justify-between">
            <div class="flex items-start justify-between">
                <div>
                    <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Tạm ngưng bán</span>
                    <div class="mt-2 flex items-baseline gap-2">
                        <span class="font-display-lg text-display-lg text-secondary">@ViewBag.TamNgung</span>
                        <span class="font-title-sm text-title-sm text-secondary">mẫu ngưng</span>
                    </div>
                </div>
                <span class="px-2.5 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md">Thiếu nguyên liệu</span>
            </div>
            <div class="mt-4 flex items-center gap-1.5 text-secondary font-title-sm text-title-sm">
                <span class="material-symbols-outlined text-[16px]">info</span>
                <span>Cần nhập bổ sung hoa tươi</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex flex-col justify-between">
            <div class="flex items-start justify-between">
                <div>
                    <span class="font-label-md text-label-md uppercase tracking-wider text-secondary">Thiết kế nổi bật</span>
                    <div class="mt-2 flex items-baseline gap-2">
                        <span class="font-display-lg text-display-lg text-primary">@ViewBag.SoDipSuDung</span>
                        <span class="font-title-sm text-title-sm text-secondary">dịp có mẫu hoa</span>
                    </div>
                </div>
                <div class="p-3 rounded-full bg-primary-fixed text-on-primary-fixed">
                    <span class="material-symbols-outlined text-[24px]">palette</span>
                </div>
            </div>
            <div class="mt-4 flex items-center gap-1.5 text-primary font-title-sm text-title-sm">
                <span class="material-symbols-outlined text-[16px]">auto_awesome</span>
                <span>Số dịp đang được sử dụng</span>
            </div>
        </div>
    </div>

    <!-- Bộ lọc tìm kiếm mẫu sản phẩm -->
    <form asp-area="Admin" asp-controller="MauSanPham" asp-action="Index" method="get"
          class="bg-surface-container-lowest rounded-xl shadow-sm p-space-md mb-space-md flex flex-wrap items-center gap-2">
        <input type="text" name="tuKhoa" value="@Model.TuKhoa"
               placeholder="Tìm tên mẫu, dịp sử dụng, kiểu sản phẩm..."
               autocomplete="off"
               class="flex-1 min-w-[220px] px-4 py-3 rounded-xl bg-surface-container-low text-on-surface focus:outline-none focus:ring-2 focus:ring-primary" />

        <select name="trangThai" class="px-3 py-3 rounded-xl bg-surface-container-low text-on-surface">
            <option value="">Tất cả trạng thái</option>
            <option value="true" selected="@(Model.TrangThai == "true")">Đang mở bán</option>
            <option value="false" selected="@(Model.TrangThai == "false")">Tạm ngưng bán</option>
        </select>

        <select name="sapXep" class="px-3 py-3 rounded-xl bg-surface-container-low text-on-surface">
            <option value="" selected="@(string.IsNullOrEmpty(Model.SapXep))">Mã mẫu tăng dần</option>
            <option value="ten_asc" selected="@(Model.SapXep == "ten_asc")">Tên A-Z</option>
            <option value="ten_desc" selected="@(Model.SapXep == "ten_desc")">Tên Z-A</option>
            <option value="gia_asc" selected="@(Model.SapXep == "gia_asc")">Giá tăng dần</option>
            <option value="gia_desc" selected="@(Model.SapXep == "gia_desc")">Giá giảm dần</option>
            <option value="cu_nhat" selected="@(Model.SapXep == "cu_nhat")">Mã mẫu tăng dần (cũ nhất)</option>
        </select>

        <select name="maDip" class="px-3 py-3 rounded-xl bg-surface-container-low text-on-surface">
            <option value="">Tất cả dịp sử dụng</option>
            @foreach (var dip in Model.DanhSachDip)
            {
                <option value="@dip.Value" selected="@(Model.MaDip?.ToString() == dip.Value)">@dip.Text</option>
            }
        </select>

        <select name="kieuSanPham" class="px-3 py-3 rounded-xl bg-surface-container-low text-on-surface">
            <option value="">Tất cả kiểu sản phẩm</option>
            @foreach (var kieu in Model.DanhSachKieu)
            {
                <option value="@kieu.Value" selected="@(Model.KieuSanPham == kieu.Value)">@kieu.Text</option>
            }
        </select>

        <input type="number" name="giaTu" value="@Model.GiaTu" min="0" placeholder="Giá từ"
               class="w-28 px-3 py-3 rounded-xl bg-surface-container-low text-on-surface" />
        <input type="number" name="giaDen" value="@Model.GiaDen" min="0" placeholder="Giá đến"
               class="w-28 px-3 py-3 rounded-xl bg-surface-container-low text-on-surface" />

        <button type="submit" class="px-5 py-3 rounded-xl bg-primary text-on-primary font-semibold hover:opacity-90">
            <span class="material-symbols-outlined align-middle text-[18px]">search</span> Tìm kiếm
        </button>
        <a asp-area="Admin" asp-controller="MauSanPham" asp-action="Index"
           class="px-4 py-3 rounded-xl bg-surface-container text-on-surface">Làm mới</a>
    </form>

    <!-- Products Table -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col">
        <!-- Table Top Bar -->
        <div class="p-space-md bg-surface-container-lowest flex items-center justify-between gap-space-sm border-b border-surface-container">
            <div class="flex items-center gap-space-sm">
                <span class="font-headline-sm text-headline-sm text-on-surface">Danh Sách Mẫu Sản Phẩm</span>
                <span class="px-2.5 py-0.5 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md">@Model.DanhSachMau.TongSoBanGhi mẫu hoa phù hợp</span>
            </div>
            <a asp-area="Admin"
               asp-controller="MauSanPham"
               asp-action="Create"
               class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-all shadow-sm">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span>Thêm Mẫu Sản Phẩm Mới</span>
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-on-surface">
                <thead>
                    <tr class="bg-surface-container-low font-label-md text-label-md text-secondary uppercase tracking-wider">
                        <th class="py-space-md px-space-md">Mã mẫu</th>
                        <th class="py-space-md px-space-md">Mẫu sản phẩm</th>
                        <th class="py-space-md px-space-md">Dịp sử dụng</th>
                        <th class="py-space-md px-space-md">Kiểu sản phẩm</th>
                        <th class="py-space-md px-space-md text-right">Giá cơ bản</th>
                        <th class="py-space-md px-space-md text-center">Trạng thái</th>
                        <th class="py-space-md px-space-md text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="font-body-md text-body-md divide-y divide-surface-container">
                    @if (Model.DanhSachMau.DuLieu != null && Model.DanhSachMau.DuLieu.Count > 0)
                    {
                        @foreach (var mau in Model.DanhSachMau.DuLieu)
                        {
                            <tr class="hover:bg-surface-container-low/70 transition-colors">
                                <td class="py-space-md px-space-md">
                                    @mau.MaMau
                                </td>
                                <td class="py-space-md px-space-md">                                   
                                    <div class="font-title-sm text-title-sm">
                                        <a asp-area="Admin"
                                           asp-controller="MauSanPham"
                                           asp-action="Details"
                                           asp-route-id="@mau.MaMau"
                                           class="hover:text-primary hover:underline">
                                            @mau.TenMau
                                        </a>
                                    </div>
                                    <div class="font-body-sm text-on-surface-variant">
                                        @mau.MoTa
                                    </div>
                                </td>
                                <td class="py-space-md px-space-md">
                                    @mau.DipSuDung?.TenDip
                                </td>
                                <td class="py-space-md px-space-md">
                                    @mau.KieuSanPham
                                </td>
                                <td class="py-space-md px-space-md text-right">
                                    @mau.GiaCoBan.ToString("N0")₫
                                </td>
                                <td class="py-space-md px-space-md text-center">
                                    @await Html.PartialAsync(
                                        "_AdminStatusBadge",
                                        mau.TrangThai ? "Đang mở bán" : "Tạm ngưng bán")
                                </td>

                                <td class="py-space-md px-space-md text-center">
                                    <div class="flex items-center justify-center gap-3">
                                        <a asp-area="Admin"
                                           asp-controller="MauSanPham"
                                           asp-action="Edit"
                                           asp-route-id="@mau.MaMau"
                                           title="Sửa mẫu sản phẩm"
                                           aria-label="Sửa mẫu sản phẩm"
                                           class="inline-flex items-center justify-center p-2 rounded-lg text-primary hover:bg-surface-container transition-colors">
                                            <span class="material-symbols-outlined text-[22px]">edit</span>
                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="MauSanPham"
                                           asp-action="DeleteConfirm"
                                           asp-route-id="@mau.MaMau"
                                           title="Xóa mẫu sản phẩm"
                                           class="text-error hover:opacity-70">
                                            <span class="material-symbols-outlined">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-8 text-center">
                                Không tìm thấy mẫu sản phẩm phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        @if (Model.DanhSachMau.TongSoBanGhi > Model.DanhSachMau.SoBanGhiMoiTrang)
        {
            var tongTrang = (int)Math.Ceiling(Model.DanhSachMau.TongSoBanGhi / (double)Model.DanhSachMau.SoBanGhiMoiTrang);
            <div class="flex flex-wrap items-center justify-between gap-3 p-space-md border-t border-surface-container">
                <span class="text-sm text-secondary">
                    Trang @Model.DanhSachMau.TrangHienTai / @tongTrang — @Model.DanhSachMau.TongSoBanGhi mẫu
                </span>
                <div class="flex items-center gap-2">
                    @if (Model.DanhSachMau.TrangHienTai > 1)
                    {
                        <a asp-area="Admin" asp-controller="MauSanPham" asp-action="Index"
                           asp-route-page="@(Model.DanhSachMau.TrangHienTai - 1)"
                           asp-route-tuKhoa="@Model.TuKhoa" asp-route-maDip="@Model.MaDip"
                           asp-route-kieuSanPham="@Model.KieuSanPham" asp-route-giaTu="@Model.GiaTu"
                           asp-route-giaDen="@Model.GiaDen" asp-route-trangThai="@Model.TrangThai"
                           asp-route-sapXep="@Model.SapXep"
                           class="px-3 py-2 rounded-lg bg-surface-container text-on-surface hover:bg-surface-container-high">Trước</a>
                    }
                    @for (var p = 1; p <= tongTrang; p++)
                    {
                        <a asp-area="Admin" asp-controller="MauSanPham" asp-action="Index"
                           asp-route-page="@p" asp-route-tuKhoa="@Model.TuKhoa"
                           asp-route-maDip="@Model.MaDip" asp-route-kieuSanPham="@Model.KieuSanPham"
                           asp-route-giaTu="@Model.GiaTu" asp-route-giaDen="@Model.GiaDen"
                           asp-route-trangThai="@Model.TrangThai" asp-route-sapXep="@Model.SapXep"
                           class="px-3 py-2 rounded-lg @(p == Model.DanhSachMau.TrangHienTai ? "bg-primary text-on-primary" : "bg-surface-container text-on-surface hover:bg-surface-container-high")">@p</a>
                    }
                    @if (Model.DanhSachMau.TrangHienTai < tongTrang)
                    {
                        <a asp-area="Admin" asp-controller="MauSanPham" asp-action="Index"
                           asp-route-page="@(Model.DanhSachMau.TrangHienTai + 1)"
                           asp-route-tuKhoa="@Model.TuKhoa" asp-route-maDip="@Model.MaDip"
                           asp-route-kieuSanPham="@Model.KieuSanPham" asp-route-giaTu="@Model.GiaTu"
                           asp-route-giaDen="@Model.GiaDen" asp-route-trangThai="@Model.TrangThai"
                           asp-route-sapXep="@Model.SapXep"
                           class="px-3 py-2 rounded-lg bg-surface-container text-on-surface hover:bg-surface-container-high">Sau</a>
                    }
                </div>
            </div>
        }
    </div>
</div>
