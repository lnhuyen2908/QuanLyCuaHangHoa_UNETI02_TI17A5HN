@* Họ và tên: Nguyễn Thị Phương Anh
Mã sinh viên: 23103100267
Nội dung thực hiện: Giao diện thêm mẫu sản phẩm và các hoa thành phần*@

@model QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels.MauSanPhamFormViewModel
@{
    ViewBag.Title = "Thêm Mẫu Sản Phẩm Mới";
    ViewBag.ActiveMenu = "MauSanPhamCreate";
    ViewBag.Breadcrumb = "Mẫu sản phẩm";
}

<div class="px-space-xl py-space-lg flex flex-col w-full space-y-space-lg">
    <!-- Header Section -->
    @await Html.PartialAsync("_AdminPageHeader")

    <form asp-area="Admin"
      asp-controller="MauSanPham"
      asp-action="Create"
      method="post"
      enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All"
                class="mb-4 rounded-xl border border-red-300 bg-red-50 p-4 text-red-700">
        </div>
    }

    <!-- Main Create Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg">
        <!-- LEFT COLUMN: Product Info & Floral Recipe -->
        <div class="lg:col-span-7 space-y-space-lg flex flex-col">
            <!-- Card 1: Basic Information -->
            <section class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm space-y-space-md">
                <div class="flex items-center justify-between pb-space-xs border-b border-surface-container">
                    <div class="flex items-center gap-2.5">
                        <span class="w-8 h-8 rounded-full bg-surface-container-low flex items-center justify-center text-primary">
                            <span class="material-symbols-outlined text-[19px]">spa</span>
                        </span>
                        <div>
                            <h2 class="font-headline-sm text-headline-sm text-on-surface">Thông Tin Cơ Bản Sản Phẩm</h2>
                            <p class="font-body-sm text-body-sm text-secondary">Định danh, kiểu sản phẩm và dịp sử dụng</p>
                        </div>
                    </div>
                </div>

                <div class="space-y-space-md pt-space-xs">
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-space-md">
                        <!-- Product Title -->
                        <div class="md:col-span-12 space-y-1.5">
                            <label class="block font-title-sm text-title-sm text-on-surface">Tên mẫu sản phẩm *</label>                           
                           <input  type="text"
                                   name="TenMau"
                                   required
                                   placeholder="VD: Bó Hoa Rosée Éternelle"
                                   class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low focus:bg-surface text-on-surface font-title-sm text-title-sm focus:outline-none shadow-sm" />
                            <span asp-validation-for="TenMau" class="text-error text-sm"></span>
                        </div>

                        <!-- Floral Type / Kind -->
                        <div class="md:col-span-6 space-y-1.5">
                            <label class="block font-title-sm text-title-sm text-on-surface">
                                Kiểu sản phẩm *
                            </label>

                            <select name="KieuSanPham"
                                    required
                                    class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface">
                                <option value="">-- Chọn kiểu sản phẩm --</option>
                                <option value="Bó hoa">Bó hoa</option>
                                <option value="Giỏ hoa">Giỏ hoa</option>
                                <option value="Hộp hoa">Hộp hoa</option>
                                <option value="Kệ hoa">Kệ hoa</option>
                                <option value="Mẫu khác">Mẫu khác</option>
                            </select>
                        </div>

                        
                        <!-- Occasions -->
                        <div class="md:col-span-6 space-y-1.5">
                            <label class="block font-title-sm text-title-sm text-on-surface">
                                Dịp sử dụng *
                            </label>

                            <select name="MaDip"
                                    required
                                    class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface">
                                <option value="">-- Chọn dịp sử dụng --</option>

                                @if (ViewBag.DanhSachDip != null)
                                {
                                    foreach (var dip in ViewBag.DanhSachDip)
                                    {
                                        <option value="@dip.MaDip">@dip.TenDip</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Description: nằm ngoài Grid 12 cột -->
                    <div class="w-full min-w-0 space-y-1.5">
                        <label class="block font-title-sm text-title-sm text-on-surface">
                            Mô tả nghệ thuật &amp; thông điệp
                        </label>

                        <textarea name="MoTa"
                                  required
                                  rows="4"
                                  placeholder="Nhập cảm hứng thiết kế, màu sắc chủ đạo và lời chúc..."
                                  class="block w-full p-3.5 rounded-lg bg-surface-container-low text-on-surface resize-y"></textarea>

                       <span asp-validation-for="MoTa" class="text-error text-sm"></span>
                    </div>
                </div>
            </section>

            <!-- Card 2: Floral Recipe / BOM (Chi Tiết Mẫu - Thành Phần Hoa) -->
            <section class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm space-y-space-md">
                <div class="flex items-center justify-between pb-space-xs border-b border-surface-container">
                    <div class="flex items-center gap-2.5">
                        <span class="w-8 h-8 rounded-full bg-secondary-container flex items-center justify-center text-primary">
                            <span class="material-symbols-outlined text-[19px]">receipt_long</span>
                        </span>
                        <div>
                            <h2 class="font-headline-sm text-headline-sm text-on-surface">Cấu Hình Thành Phần Hoa (ChiTietMau)</h2>
                            <p class="font-body-sm text-body-sm text-secondary">Quy định số lượng tiêu chuẩn các loại hoa thành phần trong mẫu</p>
                        </div>
                    </div>
                </div>
                
                <div class="overflow-x-auto rounded-lg bg-surface-container-low">
                    <div class="flex justify-end p-3">
                        <button type="button"
                                id="btnThemHoa"
                                class="rounded-lg bg-primary px-4 py-2 text-on-primary">
                            + Thêm loại hoa
                        </button>
                    </div>

                    <table class="w-full text-left font-body-md text-body-md text-on-surface">
                        <thead>
                            <tr class="font-label-md uppercase text-secondary tracking-wider bg-surface-container">
                                <th class="py-3 px-3.5">Hoa tươi thành phần</th>
                                <th class="py-3 px-2 text-center">ĐVT</th>
                                <th class="py-3 px-2 text-center">Số lượng TC</th>
                                <th class="py-3 px-3 text-right">Đơn giá</th>
                                <th class="py-3 px-3 text-right">Thành tiền</th>
                                    <th class="py-3 px-3">Ghi chú</th>
                                <th class="py-3 px-2 text-center">Xóa</th>
                            </tr>
                        </thead>

                        <tbody id="dsThanhPhanHoa"
                               class="font-title-sm divide-y divide-surface-container">
                            @for (int i = 0; i < Model.ChiTietMaus.Count; i++)
                            {
                                <tr class="dong-hoa">
                                    <td class="py-3 px-3.5">
                                        <select name="ChiTietMaus[@i].MaHoa"
                                                class="select-hoa w-full rounded-lg bg-surface-container-lowest p-2"
                                                required>
                                            <option value="">-- Chọn hoa --</option>
                                            @foreach (var hoa in Model.DanhSachHoa)
                                            {
                                                <option value="@hoa.Value"
                                                        selected="@(hoa.Value == Model.ChiTietMaus[i].MaHoa.ToString())">
                                                        @((hoa.Text ?? "").Split('|')[0])
                                                </option>
                                            }
                                        </select>
                                    </td>
                                    <td class="don-vi py-3 px-2 text-center text-secondary">—</td>
                                    <td class="py-3 px-2 text-center">
                                        <input type="number"
                                               name="ChiTietMaus[@i].SoLuongTieuChuan"
                                               value="@Model.ChiTietMaus[i].SoLuongTieuChuan"
                                               min="1" max="9999" required
                                               class="so-luong w-16 rounded bg-surface-container-lowest px-2 py-1 text-center font-bold" />
                                    </td>
                                    <td class="don-gia py-3 px-3 text-right text-secondary">—</td>
                                    <td class="thanh-tien py-3 px-3 text-right text-primary font-bold">—</td>
                                    <td class="py-3 px-2 min-w-40">
                                        <input type="text"
                                                name="ChiTietMaus[@i].GhiChu"
                                                value="@Model.ChiTietMaus[i].GhiChu"
                                                list="goiYGhiChu"
                                                maxlength="500"
                                                placeholder="VD: Hoa chính"
                                                class="ghi-chu w-full rounded-lg bg-surface-container-lowest px-2 py-1" />
                                    </td>
                                    <td class="py-3 px-2 text-center">
                                        <button type="button"
                                                class="btnXoaHoa text-red-600">✕</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <datalist id="goiYGhiChu">
                    <option value="Hoa chính"></option>
                    <option value="Hoa phụ"></option>
                    <option value="Hoa điểm xuyết"></option>
                    <option value="Lá phụ"></option>
                    <option value="Phụ liệu"></option>
                </datalist>
                @{
                    var danhSachHoaJson = System.Text.Json.JsonSerializer.Serialize(
                        Model.DanhSachHoa.Select(hoa =>
                        {
                            var parts = (hoa.Text ?? "").Split('|');

                            return new
                            {
                                value = hoa.Value,
                                tenHoa = parts.Length > 0 ? parts[0] : "",
                                donVi = parts.Length > 1 ? parts[1] : "",
                                donGia = parts.Length > 2
                                    && decimal.TryParse(parts[2], out var gia)
                                    ? gia : 0
                            };
                        }).ToList()
                    );
                }

                <script>
                    const danhSachHoa = @Html.Raw(danhSachHoaJson);
                    const tbodyHoa = document.getElementById("dsThanhPhanHoa");

                    function capNhatChiTiet() {
                        const rows = [...tbodyHoa.querySelectorAll(".dong-hoa")];
                        let tongTien = 0;

                        rows.forEach((row, index) => {
                            const select = row.querySelector(".select-hoa");
                            const inputSoLuong = row.querySelector(".so-luong");
                            const inputGhiChu = row.querySelector(".ghi-chu");

                            select.name = `ChiTietMaus[${index}].MaHoa`;
                            inputSoLuong.name = `ChiTietMaus[${index}].SoLuongTieuChuan`;
                            if (inputGhiChu) inputGhiChu.name = `ChiTietMaus[${index}].GhiChu`;

                            const hoa = danhSachHoa.find(x => x.value === select.value);
                            const soLuong = Number(inputSoLuong.value) || 0;
                            const thanhTien = hoa ? soLuong * hoa.donGia : 0;
                            tongTien += thanhTien;

                            row.querySelector(".don-vi").textContent = hoa ? hoa.donVi : "—";
                            row.querySelector(".don-gia").textContent =
                                hoa ? hoa.donGia.toLocaleString("vi-VN") + "đ" : "—";
                            row.querySelector(".thanh-tien").textContent =
                                hoa ? thanhTien.toLocaleString("vi-VN") + "đ" : "—";
                        });

                        const giaInput = document.getElementById("GiaCoBan");
                        if (giaInput) giaInput.value = Math.round(tongTien);
                    }

                    document.getElementById("btnThemHoa").addEventListener("click", () => {
                        const row = document.createElement("tr");
                        row.className = "dong-hoa";

                        const options = danhSachHoa.map(h =>
                            `<option value="${h.value}">${h.tenHoa}</option>`
                        ).join("");

                        row.innerHTML = `
                            <td class="py-3 px-3.5">
                                <select class="select-hoa w-full rounded-lg bg-surface-container-lowest p-2" required>
                                    <option value="">-- Chọn hoa --</option>
                                    ${options}
                                </select>
                            </td>
                            <td class="don-vi py-3 px-2 text-center text-secondary">—</td>
                            <td class="py-3 px-2 text-center">
                                <input type="number"
                                       class="so-luong w-16 rounded bg-surface-container-lowest px-2 py-1 text-center font-bold"
                                       value="1" min="1" max="9999" required />
                            </td>
                            <td class="don-gia py-3 px-3 text-right text-secondary">—</td>
                            <td class="thanh-tien py-3 px-3 text-right text-primary font-bold">—</td>
                            <td class="py-3 px-2 min-w-40">
                                <input type="text"
                                        class="ghi-chu w-full rounded-lg bg-surface-container-lowest px-2 py-1"
                                        list="goiYGhiChu" maxlength="500" placeholder="VD: Hoa chính" />
                            </td>
                            <td class="py-3 px-2 text-center">
                                <button type="button" class="btnXoaHoa text-red-600">✕</button>
                            </td>`;

                        tbodyHoa.appendChild(row);
                        capNhatChiTiet();
                    });

                    tbodyHoa.addEventListener("click", e => {
                        if (e.target.classList.contains("btnXoaHoa")) {
                            if (tbodyHoa.querySelectorAll(".dong-hoa").length <= 1) {
                                alert("Mẫu phải có ít nhất một thành phần hoa.");
                                return;
                            }

                            e.target.closest("tr").remove();
                            capNhatChiTiet();
                        }
                    });

                    tbodyHoa.addEventListener("change", e => {
                        if (!e.target.classList.contains("select-hoa")) return;

                        const selects = [...tbodyHoa.querySelectorAll(".select-hoa")];
                        const values = selects.map(s => s.value).filter(v => v);

                        if (new Set(values).size !== values.length) {
                            alert("Loại hoa này đã được chọn ở dòng khác.");
                            e.target.value = "";
                        }

                        capNhatChiTiet();
                    });
                    
                    tbodyHoa.addEventListener("input", e => {
                        if (e.target.classList.contains("so-luong")) {
                            capNhatChiTiet();
                        }
                    });

                document.addEventListener("DOMContentLoaded", capNhatChiTiet);
                </script>
            </section>
        </div>

        <!-- RIGHT COLUMN: Pricing & Image Upload -->
        <div class="lg:col-span-5 space-y-space-lg">
            <!-- Pricing Card -->
            <section class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm space-y-space-md">
                <h3 class="font-headline-sm text-headline-sm text-on-surface border-b border-surface-container pb-space-xs">Bảng Giá &amp; Trạng Thái</h3>
                
                <div class="space-y-space-md">
                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1">Giá cơ bản (VNĐ) *</label>
                            <input type="number"
                                   id="GiaCoBan"
                                   name="GiaCoBan"
                                   min="0"
                                   required
                                   readonly
                                   value="0"
                                   class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-primary font-headline-sm font-bold focus:outline-none" />
                            <span asp-validation-for="GiaCoBan" class="text-error text-sm"></span>
                    </div>

                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1">Trạng thái bán</label>
                        <select name="TrangThai"
                                class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface">
                            <option value="true">Mở bán</option>
                            <option value="false">Tạm ngưng</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-title-sm text-title-sm text-on-surface mb-1">Hình ảnh đại diện mẫu</label>                        
                        <div class="border-2 border-dashed border-outline-variant rounded-xl p-space-lg text-center bg-surface-container-low hover:bg-surface-container transition-colors">
                            <label for="TepAnh" class="block cursor-pointer">
                                <span class="material-symbols-outlined text-[36px] text-primary">
                                    add_a_photo
                                </span>
                                <p class="font-body-sm text-body-sm text-secondary mt-1">
                                    Chọn ảnh mẫu bó hoa tươi (PNG, JPG, WEBP)
                                </p>
                                <input type="file"
                                       required
                                        id="TepAnh"
                                        name="TepAnh"
                                        accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                        class="mt-3 block w-full text-sm"
                                        onchange="previewMauAnh(this)" />
                                <span asp-validation-for="TepAnh" class="text-error text-sm"></span>
                            </label>

                            <div id="previewAnhWrap" class="hidden relative mt-4 mx-auto w-fit">
                                <img id="previewAnh"
                                        src="#"
                                        alt="Ảnh xem trước"
                                        class="mx-auto max-h-56 rounded-xl object-contain" />
                                <button type="button"
                                        onclick="xoaAnhChinh()"
                                        title="Xóa ảnh"
                                        class="absolute -top-2 -right-2 flex h-7 w-7 items-center justify-center rounded-full bg-red-600 text-white shadow">
                                    ✕
                                </button>
                            </div>
                        </div>

                        <div class="mt-4">
                            <label class="block font-title-sm text-title-sm text-on-surface mb-1">
                                Ảnh phụ (tối đa 5 ảnh, JPG/PNG/WEBP, mỗi ảnh ≤ 5 MB)
                            </label>
                            <div class="border-2 border-dashed border-outline-variant rounded-xl p-space-lg text-center bg-surface-container-low hover:bg-surface-container transition-colors">
                                <label for="DanhSachAnh" class="block cursor-pointer">
                                    <span class="material-symbols-outlined text-[36px] text-primary">add_photo_alternate</span>
                                    <p class="font-body-sm text-body-sm text-secondary mt-1">
                                        Chọn tối đa 5 ảnh phụ (PNG, JPG, WEBP)
                                    </p>
                                    <input type="file"
                                            id="DanhSachAnh"
                                            name="DanhSachAnh"
                                            multiple
                                            accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                            class="mt-3 block w-full text-sm"
                                            onchange="previewAnhPhu(this)" />
                                </label>

                                <div id="previewAnhPhu" class="hidden mt-4 grid grid-cols-2 sm:grid-cols-3 gap-3"></div>
                            </div>
                            <span asp-validation-for="DanhSachAnh" class="text-error text-sm"></span>
                        </div>

                        <script>
                            function previewMauAnh(input) {
                                const wrap = document.getElementById('previewAnhWrap');
                                const preview = document.getElementById('previewAnh');

                                if (input.files && input.files[0]) {
                                    const file = input.files[0];
                                    const allowed = ['image/jpeg', 'image/png', 'image/webp'];

                                    if (!allowed.includes(file.type)) {
                                        alert('Chỉ được chọn ảnh JPG, PNG hoặc WEBP.');
                                        input.value = '';
                                        wrap.classList.add('hidden');
                                        return;
                                    }

                                    preview.src = URL.createObjectURL(file);
                                    wrap.classList.remove('hidden');
                                } else {
                                    wrap.classList.add('hidden');
                                }
                            }

                            function xoaAnhChinh() {
                                document.getElementById('TepAnh').value = '';
                                document.getElementById('previewAnhWrap').classList.add('hidden');
                            }

                            // ===== Ảnh phụ: có thể chọn thêm nhiều lần và xóa từng ảnh =====
                            let dsAnhPhu = [];

                            function previewAnhPhu(input) {
                                const allowed = ['image/jpeg', 'image/png', 'image/webp'];

                                for (const f of [...input.files]) {
                                    if (!allowed.includes(f.type)) {
                                        alert('Chỉ được chọn ảnh JPG, PNG hoặc WEBP.');
                                        continue;
                                    }
                                    if (f.size > 5 * 1024 * 1024) {
                                        alert('Ảnh "' + f.name + '" vượt quá 5 MB.');
                                        continue;
                                    }
                                    const trung = dsAnhPhu.some(x =>
                                        x.name === f.name && x.size === f.size && x.lastModified === f.lastModified);
                                    if (trung) continue;

                                    if (dsAnhPhu.length >= 5) {
                                        alert('Chỉ được chọn tối đa 5 ảnh phụ.');
                                        break;
                                    }
                                    dsAnhPhu.push(f);
                                }

                                veAnhPhu();
                            }

                            function xoaAnhPhu(index) {
                                dsAnhPhu.splice(index, 1);
                                veAnhPhu();
                            }

                            function veAnhPhu() {
                                const input = document.getElementById('DanhSachAnh');
                                const box = document.getElementById('previewAnhPhu');

                                // Đồng bộ lại danh sách file thật sẽ được gửi lên server
                                const dt = new DataTransfer();
                                dsAnhPhu.forEach(f => dt.items.add(f));
                                input.files = dt.files;

                                box.innerHTML = '';
                                if (dsAnhPhu.length === 0) {
                                    box.classList.add('hidden');
                                    return;
                                }

                                dsAnhPhu.forEach((f, i) => {
                                    const item = document.createElement('div');
                                    item.className = 'relative';

                                    const img = document.createElement('img');
                                    img.src = URL.createObjectURL(f);
                                    img.alt = f.name;
                                    img.className = 'w-full h-32 rounded-xl object-cover';

                                    const btn = document.createElement('button');
                                    btn.type = 'button';
                                    btn.title = 'Xóa ảnh';
                                    btn.textContent = '✕';
                                    btn.className = 'absolute -top-2 -right-2 flex h-7 w-7 items-center justify-center rounded-full bg-red-600 text-white shadow';
                                    btn.addEventListener('click', () => xoaAnhPhu(i));

                                    item.appendChild(img);
                                    item.appendChild(btn);
                                    box.appendChild(item);
                                });

                                box.classList.remove('hidden');
                            }
                        </script>

                    </div>
                </div>
                <div class="pt-space-md flex gap-space-sm">
                    <a href="/Admin/MauSanPham" class="flex-1 py-3 text-center rounded-xl bg-surface-container text-on-surface font-title-sm hover:bg-surface-container-high transition-all">Hủy bỏ</a>
                    <button type="submit" class="flex-1 py-3 text-center rounded-xl bg-primary text-on-primary font-title-sm hover:bg-primary-container transition-all shadow-sm">Lưu mẫu sản phẩm</button>
                </div>
            </section>
        </div>
    </div>
    </form>
</div>
