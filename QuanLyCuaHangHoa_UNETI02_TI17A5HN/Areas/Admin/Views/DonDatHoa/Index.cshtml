@* Họ và tên: Đặng Thị Mai Hương
  Mã sinh viên: 23103100293
 Nội dung thực hiện: Hiển thị dữ liệu thật, form GET lọc và POST có chống CSRF*@

@model QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels.DonDatHoaListViewModel
@* Model gồm bộ lọc, thống kê và danh sách đã phân trang tại Admin Controller. *@
@using QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models

@{
    ViewBag.Title = "Quản Lý Đơn Đặt Hoa";
    ViewBag.ActiveMenu = "DonDatHoa";
    ViewBag.Breadcrumb = "Bán hàng & Vận hành";
}

<div class="px-space-xl py-space-lg flex flex-col w-full space-y-space-md">
    <!-- Header Section -->
    @await Html.PartialAsync("_AdminPageHeader")

    @if (TempData["Error"] != null)
    {
        <p class="p-3 rounded-xl bg-error-container text-error">@TempData["Error"]</p>
    }
    @if (TempData["Success"] != null)
    {
        <p class="p-3 rounded-xl bg-tertiary-fixed text-tertiary">@TempData["Success"]</p>
    }

    <!-- Các thẻ thống kê lấy số liệu từ DB, không dùng số liệu mẫu trong HTML. -->

    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-space-md">
        @foreach (var metric in new[]
        {
        ("Đơn hôm nay", Model.DonHomNay.ToString() + " đơn", "local_florist"),
        ("Chờ xác nhận", Model.ChoXacNhan.ToString() + " đơn", "pending_actions"),
        ("Đang cắm hoa", Model.DangChuanBi.ToString() + " đơn", "handyman"),
        ("Sẵn sàng", Model.SanSang.ToString() + " đơn", "bolt"),
        ("Đang giao", Model.DangGiao.ToString() + " đơn", "local_shipping"),
        ("Hoàn tất tháng này", Model.HoanThanhThang.ToString() + " đơn", "task_alt")
    })
        {
            // Xác định màu sắc theo trạng thái đơn hàng
            var mau = metric.Item1 switch
            {
                "Chờ xác nhận" => "text-error",
                "Đang cắm hoa" => "text-on-surface",
                "Sẵn sàng" => "text-primary",
                "Đang giao" => "text-tertiary",
                _ => "text-primary"
            };

            <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm">
                <p class="text-secondary font-label-md uppercase text-xs">
                    @metric.Item1
                </p>

                <div class="flex justify-between items-center mt-2">
                    <strong class="font-headline-md text-headline-md font-semibold @mau">
                        @metric.Item2
                    </strong>

                    <span class="material-symbols-outlined @mau">
                        @metric.Item3
                    </span>
                </div>
            </div>
        }
    </div>

    <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm">
        Doanh số đơn đặt hôm nay (chỉ tính đơn đã hoàn thành):
        <strong class="text-primary">@Model.DoanhSoHomNay.ToString("N0")₫</strong>
    </div>

    @* Form GET: tìm kiếm/lọc không cập nhật dữ liệu; các tham số được giữ khi phân trang. *@
    <form method="get"
          asp-area="Admin"
          asp-controller="DonDatHoa"
          asp-action="Index"
          class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm flex flex-wrap gap-space-sm items-center">

        <input name="tuKhoa"
               value="@Model.TuKhoa"
               placeholder="Mã đơn, tên khách, SĐT"
               class="flex-1 min-w-36 p-2 rounded-lg bg-surface-container border border-outline-variant" />

        <select name="trangThai" class="p-2 rounded-lg bg-surface-container border border-outline-variant">
            <option value="">Tất cả trạng thái</option>
            @foreach (var tt in new[]
            {
                TrangThaiDon.ChoXacNhan,
                TrangThaiDon.DaXacNhan,
                TrangThaiDon.DangChuanBi,
                TrangThaiDon.SanSang,
                TrangThaiDon.DangGiao,
                TrangThaiDon.HoanThanh,
                TrangThaiDon.DaHuy
            })
            {
                <option value="@tt" selected="@(Model.TrangThai == tt)">@tt</option>
            }
        </select>

        <label class="text-xs">
            Từ ngày
            <input type="date" name="tuNgay" value="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                   class="p-2 rounded-lg bg-surface-container" />
        </label>

        <label class="text-xs">
            Đến ngày
            <input type="date" name="denNgay" value="@Model.DenNgay?.ToString("yyyy-MM-dd")"
                   class="p-2 rounded-lg bg-surface-container" />
        </label>

        <button class="px-4 py-2 bg-primary text-on-primary rounded-lg" type="submit">Tìm/Lọc</button>
        <a href="/Admin/DonDatHoa" class="px-4 py-2 bg-surface-container rounded-lg">Làm mới</a>
    </form>

    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col">

        <div class="p-space-md border-b border-surface-container font-headline-sm text-headline-sm">
            Danh Sách Đơn Đặt Hoa
            <span class="text-sm text-secondary">(@Model.TongBanGhi đơn phù hợp)</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low text-on-surface-variant font-label-md text-xs uppercase">
                        <th class="p-4">Mã/Ngày đặt</th>
                        <th class="p-4">Khách / Người nhận</th>
                        <th class="p-4">Hình thức</th>
                        <th class="p-4">Thời gian giao</th>
                        <th class="p-4">Tổng tiền</th>
                        <th class="p-4">Trạng thái</th>
                        <th class="p-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container">
                    @* Mỗi dòng là một đơn được lấy từ DB; bấm Chi tiết để xử lý POST ở trang Details. *@
                    @foreach (var d in Model.DanhSach)
                    {
                        <tr class="hover:bg-surface-container-low/60">
                            <td class="p-4">
                                <a class="text-primary font-semibold"
                                   asp-area="Admin"
                                   asp-controller="DonDatHoa"
                                   asp-action="Details"
                                   asp-route-id="@d.MaDon">#ORD-@d.MaDon.ToString("D4")</a>
                                <p class="text-xs text-secondary">@d.NgayDat.ToString("dd/MM/yyyy HH:mm")</p>
                            </td>
                            <td class="p-4">
                                <p class="font-semibold">@d.KhachHang.HoTen</p>
                                <p class="text-xs">Nhận: @d.NguoiNhan (@d.SoDienThoaiNguoiNhan)</p>
                                <p class="text-xs text-secondary">@d.DiaChiGiao</p>
                            </td>
                            <td class="p-4">@d.HinhThucNhan</td>
                            <td class="p-4">@d.ThoiGianNhanGiao.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="p-4 text-primary font-semibold">@d.TongTien.ToString("N0")₫</td>
                            <td class="p-4">@await Html.PartialAsync("_AdminStatusBadge", d.TrangThai)</td>
                            <td class="p-4">
                                <a class="text-primary font-semibold underline"
                                   asp-action="Details"
                                   asp-route-id="@d.MaDon">Xem chi tiết</a>
                            </td>
                        </tr>
                    }

                    @if (!Model.DanhSach.Any())
                    {
                        <tr>
                            <td colspan="7" class="p-8 text-center text-secondary">Không có đơn phù hợp bộ lọc.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="p-4 flex flex-wrap justify-between items-center gap-3">
            <span class="text-secondary text-sm">
                Trang @Model.Trang / @Model.TongTrang • @Model.TongBanGhi đơn
            </span>

            <div class="flex gap-2">
                @* Điều hướng trang dựa trên TongTrang, giữ lại từ khóa và điều kiện lọc. *@
                @if (Model.Trang > 1)
                {
                    <a class="px-3 py-2 rounded-lg bg-surface-container"
                       href="@Url.Action("Index", new
                       {
                           trang = Model.Trang - 1,
                           tuKhoa = Model.TuKhoa,
                           trangThai = Model.TrangThai,
                           tuNgay = Model.TuNgay?.ToString("yyyy-MM-dd"),
                           denNgay = Model.DenNgay?.ToString("yyyy-MM-dd")
                       })">Trước</a>
                }

                @for (int i = 1; i <= Model.TongTrang; i++)
                {
                    if (i == Model.Trang)
                    {
                        <span class="px-3 py-2 rounded-lg bg-primary text-on-primary">@i</span>
                    }
                    else if (Math.Abs(i - Model.Trang) <= 2 || i == 1 || i == Model.TongTrang)
                    {
                        <a class="px-3 py-2 rounded-lg bg-surface-container"
                           href="@Url.Action("Index", new
                           {
                               trang = i,
                               tuKhoa = Model.TuKhoa,
                               trangThai = Model.TrangThai,
                               tuNgay = Model.TuNgay?.ToString("yyyy-MM-dd"),
                               denNgay = Model.DenNgay?.ToString("yyyy-MM-dd")
                           })">@i</a>
                    }
                }

                @if (Model.Trang < Model.TongTrang)
                {
                    <a class="px-3 py-2 rounded-lg bg-surface-container"
                       href="@Url.Action("Index", new
                       {
                           trang = Model.Trang + 1,
                           tuKhoa = Model.TuKhoa,
                           trangThai = Model.TrangThai,
                           tuNgay = Model.TuNgay?.ToString("yyyy-MM-dd"),
                           denNgay = Model.DenNgay?.ToString("yyyy-MM-dd")
                       })">Sau</a>
                }
            </div>
        </div>
    </div>
</div>