@{
    ViewBag.Title = "Quản Lý Đơn Đặt Hoa";
    ViewBag.ActiveMenu = "DonDatHoa";
    ViewBag.Breadcrumb = "Bán hàng & Vận hành";
}

<div class="px-space-xl py-space-lg flex flex-col w-full space-y-space-md">
    <!-- Header Section -->
    @await Html.PartialAsync("_AdminPageHeader")

    <!-- Operational KPI Metric Strip -->
    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-space-md">
        <div class="bg-surface-container-lowest rounded-xl p-space-md flex flex-col justify-between shadow-sm">
            <div class="flex items-center justify-between text-on-surface-variant">
                <span class="font-label-md text-label-md uppercase tracking-wider">Tất cả hôm nay</span>
                <span class="material-symbols-outlined text-[18px] text-primary">local_florist</span>
            </div>
            <div class="my-space-xs">
                <div class="font-headline-md text-headline-md text-on-surface font-semibold">48 đơn</div>
                <p class="font-body-sm text-body-sm text-tertiary font-medium">42.800.000₫</p>
            </div>
        </div>

        <div class="bg-surface-container-lowest rounded-xl p-space-md flex flex-col justify-between shadow-sm">
            <div class="flex items-center justify-between text-on-surface-variant">
                <span class="font-label-md text-label-md uppercase tracking-wider">Chờ xác nhận</span>
                <span class="w-2 h-2 rounded-full bg-error animate-ping"></span>
            </div>
            <div class="my-space-xs">
                <div class="font-headline-md text-headline-md text-error font-semibold">06 đơn</div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Cần duyệt &lt; 15 phút</p>
            </div>
        </div>

        <div class="bg-surface-container-lowest rounded-xl p-space-md flex flex-col justify-between shadow-sm">
            <div class="flex items-center justify-between text-on-surface-variant">
                <span class="font-label-md text-label-md uppercase tracking-wider">Đang cắm hoa</span>
                <span class="material-symbols-outlined text-[18px] text-secondary">handyman</span>
            </div>
            <div class="my-space-xs">
                <div class="font-headline-md text-headline-md text-on-surface font-semibold">14 đơn</div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Thợ cắm đang thực hiện</p>
            </div>
        </div>

        <div class="bg-surface-container-lowest rounded-xl p-space-md flex flex-col justify-between shadow-sm">
            <div class="flex items-center justify-between text-on-surface-variant">
                <span class="font-label-md text-label-md uppercase tracking-wider">Sẵn sàng giao</span>
                <span class="material-symbols-outlined text-[18px] text-primary">bolt</span>
            </div>
            <div class="my-space-xs">
                <div class="font-headline-md text-headline-md text-primary font-semibold">08 đơn</div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Chờ giao nhận</p>
            </div>
        </div>

        <div class="bg-surface-container-lowest rounded-xl p-space-md flex flex-col justify-between shadow-sm">
            <div class="flex items-center justify-between text-on-surface-variant">
                <span class="font-label-md text-label-md uppercase tracking-wider">Đang giao</span>
                <span class="material-symbols-outlined text-[18px] text-tertiary">local_shipping</span>
            </div>
            <div class="my-space-xs">
                <div class="font-headline-md text-headline-md text-tertiary font-semibold">12 đơn</div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Đang trên đường giao</p>
            </div>
        </div>

        <div class="bg-surface-container-lowest rounded-xl p-space-md flex flex-col justify-between shadow-sm">
            <div class="flex items-center justify-between text-on-surface-variant">
                <span class="font-label-md text-label-md uppercase tracking-wider">Hoàn tất</span>
                <span class="material-symbols-outlined text-[18px] text-tertiary">task_alt</span>
            </div>
            <div class="my-space-xs">
                <div class="font-headline-md text-headline-md text-on-surface font-semibold">156 đơn</div>
                <p class="font-body-sm text-body-sm text-on-surface-variant">Tháng này</p>
            </div>
        </div>
    </div>

    <!-- Filter Component -->
    @await Html.PartialAsync("_AdminFilterBar")

    <!-- Orders Master Table -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col">
        <!-- Table Action Header -->
        <div class="p-space-md bg-surface-container-lowest flex items-center justify-between gap-space-sm border-b border-surface-container">
            <div class="flex items-center gap-space-sm">
                <span class="font-headline-sm text-headline-sm text-on-surface">Danh Sách Đơn Đặt Hoa</span>
                <span class="px-2.5 py-0.5 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md">48 đơn hôm nay</span>
            </div>
            <button type="button" onclick="openAddModal()" class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-all shadow-sm">
                <span class="material-symbols-outlined text-[18px]">add_shopping_cart</span>
                <span>Tạo Đơn Hàng Mới Tại Quầy</span>
            </button>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low text-on-surface-variant font-label-md text-label-md uppercase tracking-wider">
                        <th class="py-space-md px-space-md font-semibold">Mã đơn &amp; Ngày đặt</th>
                        <th class="py-space-md px-space-md font-semibold">Khách hàng / Người nhận</th>
                        <th class="py-space-md px-space-md font-semibold">Hình thức nhận</th>
                        <th class="py-space-md px-space-md font-semibold">Thời gian hẹn giao</th>
                        <th class="py-space-md px-space-md font-semibold text-right">Tổng tiền đơn</th>
                        <th class="py-space-md px-space-md font-semibold text-center">Trạng thái</th>
                        <th class="py-space-md px-space-md font-semibold text-right">Tác vụ</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container text-on-surface font-body-sm text-body-sm">
                    <tr class="hover:bg-surface-container-low/60 transition-colors">
                        <td class="py-space-md px-space-md">
                            <div class="font-title-sm text-title-sm text-primary font-bold">#ORD-9021</div>
                            <div class="text-on-surface-variant font-label-md text-label-md">04/10/2026 10:24</div>
                        </td>
                        <td class="py-space-md px-space-md">
                            <div class="font-semibold text-on-surface">Chị Hoàng Yến Nhi</div>
                            <div class="text-on-surface-variant font-body-sm text-body-sm">NĐT: Nguyễn Thu Thảo (0903 124 ***)</div>
                            <div class="text-outline text-[11px]">Q.1, TP. Hồ Chí Minh</div>
                        </td>
                        <td class="py-space-md px-space-md">Giao tận nơi</td>
                        <td class="py-space-md px-space-md font-medium text-primary">15:00 Hôm nay</td>
                        <td class="py-space-md px-space-md text-right font-title-sm text-title-sm font-bold text-primary">1.450.000₫</td>
                        <td class="py-space-md px-space-md text-center">
                            @await Html.PartialAsync("_AdminStatusBadge", "Chờ xác nhận")
                        </td>
                        <td class="py-space-md px-space-md text-right">
                            <div class="flex items-center justify-end gap-1">
                                <button type="button" onclick="alert('Đã xác nhận đơn hàng ORD-9021!')" class="px-3 py-1 rounded-lg bg-primary text-on-primary font-title-sm text-title-sm shadow-sm">Xác nhận</button>
                                <button type="button" onclick="alert('Đã hủy đơn hàng!')" class="p-1 rounded-lg text-secondary hover:text-error transition-colors" title="Hủy đơn">
                                    <span class="material-symbols-outlined text-[18px]">cancel</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr class="hover:bg-surface-container-low/60 transition-colors">
                        <td class="py-space-md px-space-md">
                            <div class="font-title-sm text-title-sm text-primary font-bold">#ORD-9020</div>
                            <div class="text-on-surface-variant font-label-md text-label-md">04/10/2026 09:15</div>
                        </td>
                        <td class="py-space-md px-space-md">
                            <div class="font-semibold text-on-surface">Trần Minh Hoàng</div>
                            <div class="text-on-surface-variant font-body-sm text-body-sm">SĐT: 0918 882 ***</div>
                            <div class="text-outline text-[11px]">Bình Thạnh, TP. Hồ Chí Minh</div>
                        </td>
                        <td class="py-space-md px-space-md">Giao tận nơi</td>
                        <td class="py-space-md px-space-md font-medium text-on-surface">16:30 Hôm nay</td>
                        <td class="py-space-md px-space-md text-right font-title-sm text-title-sm font-bold text-primary">2.200.000₫</td>
                        <td class="py-space-md px-space-md text-center">
                            @await Html.PartialAsync("_AdminStatusBadge", "Đang cắm hoa")
                        </td>
                        <td class="py-space-md px-space-md text-right">
                            <div class="flex items-center justify-end gap-1">
                                <button type="button" onclick="alert('Đơn hàng đã sẵn sàng giao!')" class="px-3 py-1 rounded-lg bg-tertiary text-on-tertiary font-title-sm text-title-sm shadow-sm">Sẵn sàng</button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_AdminPagination")
    </div>
</div>

<!-- Popup Modal: Tạo Đơn Hàng Mới Tại Quầy -->
<div id="donDatHoaModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-on-surface/50 backdrop-blur-sm p-4 overflow-y-auto transition-all">
    <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-2xl my-8 overflow-hidden flex flex-col max-h-[90vh]">
        <!-- Modal Header -->
        <div class="flex items-center justify-between px-space-lg py-space-md bg-surface-container-low border-b border-surface-container-high">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[22px]">add_shopping_cart</span>
                <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Tạo Đơn Hàng Mới Tại Quầy</h3>
            </div>
            <button type="button" onclick="closeDonDatHoaModal()" class="text-secondary hover:text-on-surface p-1.5 rounded-full hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <!-- Modal Body -->
        <form id="donDatHoaForm" onsubmit="handleDonDatHoaSubmit(event)" class="p-space-lg space-y-space-md font-body-md text-body-md overflow-y-auto">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Tên khách hàng đặt *</label>
                    <input type="text" id="inputTenKhach" placeholder="VD: Chị Hoàng Yến Nhi" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary border border-outline-variant/40" required />
                </div>
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Số điện thoại liên hệ *</label>
                    <input type="tel" id="inputSdtKhach" placeholder="0903 xxx xxx" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary border border-outline-variant/40" required />
                </div>
            </div>

            <div>
                <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Mẫu sản phẩm lựa chọn *</label>
                <select id="selectMauSanPhamDon" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-title-sm text-title-sm focus:outline-none border border-outline-variant/40">
                    <option value="1450000">Bó Hoa Sunset Romance — 1.450.000₫</option>
                    <option value="2200000">Giỏ Mây Pastel Bloom — 2.200.000₫</option>
                    <option value="1850000">Bó hoa thiết kế riêng Rosée Éternelle — 1.850.000₫</option>
                    <option value="3500000">Giỏ hoa Haute Couture Tím Khói — 3.500.000₫</option>
                </select>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Hình thức nhận hàng</label>
                    <select id="selectHinhThucNhan" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none border border-outline-variant/40">
                        <option value="Giao tận nơi">Giao tận nơi (Shipper)</option>
                        <option value="Nhận tại cửa hàng">Nhận trực tiếp tại Showroom</option>
                    </select>
                </div>
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Thời gian hẹn giao</label>
                    <input type="text" id="inputThoiGianGiao" value="15:00 Hôm nay" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none border border-outline-variant/40" />
                </div>
            </div>

            <div>
                <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Địa chỉ giao hàng &amp; Lời nhắn thiệp</label>
                <textarea id="inputDiaChiGiao" rows="2" placeholder="Nhập địa chỉ giao chi tiết và lời nhắn thiệp viết tay..." class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none border border-outline-variant/40"></textarea>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-end gap-space-sm pt-space-md border-t border-surface-container-high">
                <button type="button" onclick="closeDonDatHoaModal()" class="px-5 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-title-sm text-title-sm transition-all">
                    Hủy bỏ
                </button>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-all shadow-md flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">add_shopping_cart</span>
                    <span>Tạo đơn &amp; In hóa đơn</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openAddModal() {
        document.getElementById('inputTenKhach').value = '';
        document.getElementById('inputSdtKhach').value = '';
        document.getElementById('inputDiaChiGiao').value = '';
        document.getElementById('donDatHoaModal').classList.remove('hidden');
    }

    function closeDonDatHoaModal() {
        document.getElementById('donDatHoaModal').classList.add('hidden');
    }

    function handleDonDatHoaSubmit(e) {
        e.preventDefault();
        alert('Tạo đơn hàng mới thành công!');
        closeDonDatHoaModal();
    }
</script>
