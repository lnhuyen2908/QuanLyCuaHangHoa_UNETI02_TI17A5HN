@{
    ViewBag.Title = "Quản Lý Hoa Tươi";
    ViewBag.ActiveMenu = "HoaTuoi";
    ViewBag.Breadcrumb = "Quản lý hoa tươi";
}

<div class="px-space-xl py-space-lg flex flex-col w-full space-y-space-md">
    <!-- Header Section -->
    @await Html.PartialAsync("_AdminPageHeader")

    <!-- Bento Statistics Strip -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
        <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="font-label-lg text-label-lg uppercase tracking-wider text-secondary">Tổng loại hoa</span>
                <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[22px]">local_florist</span>
                </div>
            </div>
            <div class="mt-space-md flex items-baseline gap-space-xs">
                <span class="font-display-lg text-display-lg text-on-surface">48</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">giống hoa</span>
            </div>
            <div class="mt-2 text-on-surface-variant font-body-sm text-body-sm flex items-center gap-1">
                <span class="text-tertiary font-semibold flex items-center">
                    <span class="material-symbols-outlined text-[14px]">arrow_upward</span> +3
                </span>
                <span>nhập mới tuần này</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="font-label-lg text-label-lg uppercase tracking-wider text-secondary">Đang sử dụng</span>
                <div class="w-10 h-10 rounded-full bg-tertiary/15 flex items-center justify-center text-tertiary">
                    <span class="material-symbols-outlined text-[22px]">check_circle</span>
                </div>
            </div>
            <div class="mt-space-md flex items-baseline gap-space-xs">
                <span class="font-display-lg text-display-lg text-tertiary">42</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">sẵn có</span>
            </div>
            <div class="mt-2 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-tertiary"></span>
                <span class="font-label-md text-label-md text-tertiary uppercase">Kho sẵn sàng 87.5%</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="font-label-lg text-label-lg uppercase tracking-wider text-secondary">Tạm ngừng nhập</span>
                <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-on-secondary-container">
                    <span class="material-symbols-outlined text-[22px]">pause_circle</span>
                </div>
            </div>
            <div class="mt-space-md flex items-baseline gap-space-xs">
                <span class="font-display-lg text-display-lg text-on-surface">06</span>
                <span class="font-body-sm text-body-sm text-on-surface-variant">hết mùa</span>
            </div>
            <div class="mt-2 text-on-surface-variant font-body-sm text-body-sm">
                <span>Dự kiến có lại: Tháng 11</span>
            </div>
        </div>

        <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="font-label-lg text-label-lg uppercase tracking-wider text-secondary">Giá tham khảo TB</span>
                <div class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-[22px]">trending_up</span>
                </div>
            </div>
            <div class="mt-space-md flex items-baseline gap-space-xs">
                <span class="font-headline-lg text-headline-lg text-on-surface">68.500</span>
                <span class="font-title-sm text-title-sm text-on-surface-variant">₫/cành</span>
            </div>
            <div class="mt-2 text-on-surface-variant font-body-sm text-body-sm">
                <span>Biến động thị trường: ổn định</span>
            </div>
        </div>
    </div>

    <!-- Filter Component -->
    @await Html.PartialAsync("_AdminFilterBar")

    <!-- Data Table Container -->
    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col">
        <!-- Table Top Action Bar -->
        <div class="p-space-md bg-surface-container-lowest flex items-center justify-between gap-space-sm border-b border-surface-container">
            <div class="flex items-center gap-space-sm">
                <span class="font-headline-sm text-headline-sm text-on-surface">Kho Nguyên Liệu Hoa Tươi</span>
                <span class="px-2.5 py-0.5 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md">48 giống hoa</span>
            </div>
            <button type="button" onclick="openAddModal()" class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-all shadow-sm">
                <span class="material-symbols-outlined text-[18px]">add_circle</span>
                <span>Thêm Hoa Tươi Mới</span>
            </button>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-on-surface">
                <thead>
                    <tr class="bg-surface-container-low font-label-md text-label-md text-secondary uppercase tracking-wider">
                        <th class="py-space-md px-space-md">Mã hoa</th>
                        <th class="py-space-md px-space-md">Tên hoa tươi</th>
                        <th class="py-space-md px-space-md">Loại hoa</th>
                        <th class="py-space-md px-space-md">Màu sắc</th>
                        <th class="py-space-md px-space-md">Đơn vị</th>
                        <th class="py-space-md px-space-md text-right">Đơn giá tham khảo</th>
                        <th class="py-space-md px-space-md text-center">Trạng thái</th>
                        <th class="py-space-md px-space-md text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="font-body-md text-body-md divide-y divide-surface-container">
                    <tr class="hover:bg-surface-container-low/70 transition-colors">
                        <td class="py-space-md px-space-md font-mono text-body-sm text-primary font-semibold">HT-001</td>
                        <td class="py-space-md px-space-md">
                            <div class="font-title-sm text-title-sm text-on-surface">Hoa Hồng Ohara Pháp</div>
                            <div class="font-body-sm text-body-sm text-on-surface-variant italic">Rosa 'Pink O'Hara'</div>
                        </td>
                        <td class="py-space-md px-space-md font-body-sm text-on-surface">Hoa hồng</td>
                        <td class="py-space-md px-space-md">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container font-label-md text-label-md text-on-surface">
                                <span class="w-2.5 h-2.5 rounded-full bg-primary shrink-0"></span>
                                <span>Hồng phấn</span>
                            </span>
                        </td>
                        <td class="py-space-md px-space-md text-on-surface-variant">Cành</td>
                        <td class="py-space-md px-space-md text-right font-title-sm text-title-sm font-semibold text-primary">65.000₫</td>
                        <td class="py-space-md px-space-md text-center">
                            @await Html.PartialAsync("_AdminStatusBadge", "Đang dùng")
                        </td>
                        <td class="py-space-md px-space-md text-center">
                            <div class="flex items-center justify-center gap-1">
                                <button type="button" onclick="openEditModal('HT-001', 'Hoa Hồng Ohara Pháp', 'Hoa hồng', 'Hồng phấn', 'Cành', '65000', '1')" class="p-1.5 rounded-md hover:bg-surface-container text-on-surface-variant hover:text-primary transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">edit</span>
                                </button>
                                <button type="button" onclick="alert('Đã xóa mặt hàng hoa tươi!')" class="p-1.5 rounded-md hover:bg-surface-container text-on-surface-variant hover:text-error transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">delete</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr class="hover:bg-surface-container-low/70 transition-colors">
                        <td class="py-space-md px-space-md font-mono text-body-sm text-primary font-semibold">HT-002</td>
                        <td class="py-space-md px-space-md">
                            <div class="font-title-sm text-title-sm text-on-surface">Tulip Kép Trắng Hà Lan</div>
                            <div class="font-body-sm text-body-sm text-on-surface-variant italic">Tulipa gesneriana</div>
                        </td>
                        <td class="py-space-md px-space-md font-body-sm text-on-surface">Tulip</td>
                        <td class="py-space-md px-space-md">
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-surface-container font-label-md text-label-md text-on-surface">
                                <span class="w-2.5 h-2.5 rounded-full bg-slate-200 border border-slate-300 shrink-0"></span>
                                <span>Trắng tinh khôi</span>
                            </span>
                        </td>
                        <td class="py-space-md px-space-md text-on-surface-variant">Cành</td>
                        <td class="py-space-md px-space-md text-right font-title-sm text-title-sm font-semibold text-primary">85.000₫</td>
                        <td class="py-space-md px-space-md text-center">
                            @await Html.PartialAsync("_AdminStatusBadge", "Đang dùng")
                        </td>
                        <td class="py-space-md px-space-md text-center">
                            <div class="flex items-center justify-center gap-1">
                                <button type="button" onclick="openEditModal('HT-002', 'Tulip Kép Trắng Hà Lan', 'Tulip', 'Trắng tinh khôi', 'Cành', '85000', '1')" class="p-1.5 rounded-md hover:bg-surface-container text-on-surface-variant hover:text-primary transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">edit</span>
                                </button>
                                <button type="button" onclick="alert('Đã xóa mặt hàng hoa tươi!')" class="p-1.5 rounded-md hover:bg-surface-container text-on-surface-variant hover:text-error transition-colors">
                                    <span class="material-symbols-outlined text-[18px]">delete</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_AdminPagination")
    </div>
</div>

<!-- Popup Modal: Thêm / Chỉnh Sửa Hoa Tươi -->
<div id="hoaTuoiModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-on-surface/50 backdrop-blur-sm p-4 overflow-y-auto transition-all">
    <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-xl overflow-hidden flex flex-col">
        <!-- Modal Header -->
        <div class="flex items-center justify-between px-space-lg py-space-md bg-surface-container-low border-b border-surface-container-high">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[22px]">spa</span>
                <h3 id="modalHoaTuoiTitle" class="font-headline-sm text-headline-sm text-on-surface font-semibold">Thêm Hoa Tươi Mới</h3>
            </div>
            <button type="button" onclick="closeHoaTuoiModal()" class="text-secondary hover:text-on-surface p-1.5 rounded-full hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <!-- Modal Body -->
        <form id="hoaTuoiForm" onsubmit="handleHoaTuoiSubmit(event)" class="p-space-lg space-y-space-md font-body-md text-body-md">
            <div>
                <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Tên hoa tươi *</label>
                <input type="text" id="inputTenHoaTuoi" placeholder="VD: Hoa Hồng Ohara Pháp, Tulip Hà Lan..." class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary border border-outline-variant/40" required />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Loại hoa chủ đạo</label>
                    <select id="selectLoaiHoaTuoi" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none border border-outline-variant/40">
                        <option value="Hoa hồng">Hoa hồng</option>
                        <option value="Tulip">Tulip</option>
                        <option value="Cẩm tú cầu">Cẩm tú cầu</option>
                        <option value="Hoa Baby">Hoa Baby</option>
                        <option value="Mẫu đơn">Mẫu đơn</option>
                    </select>
                </div>
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Màu sắc chủ đạo</label>
                    <input type="text" id="inputMauSacHoaTuoi" placeholder="VD: Hồng phấn, Đỏ nhung..." class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none border border-outline-variant/40" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Đơn vị tính</label>
                    <input type="text" id="inputDonViHoaTuoi" value="Cành" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none border border-outline-variant/40" />
                </div>
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Đơn giá tham khảo (VNĐ) *</label>
                    <input type="number" id="inputGiaHoaTuoi" placeholder="65000" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-primary font-headline-sm font-bold focus:outline-none border border-primary/40" required />
                </div>
            </div>

            <div>
                <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Trạng thái kho hàng</label>
                <select id="selectTrangThaiHoaTuoi" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none border border-outline-variant/40">
                    <option value="1">Đang dùng (Sẵn có trong kho)</option>
                    <option value="0">Tạm ngưng nhập (Hết mùa)</option>
                </select>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-end gap-space-sm pt-space-md border-t border-surface-container-high">
                <button type="button" onclick="closeHoaTuoiModal()" class="px-5 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-title-sm text-title-sm transition-all">
                    Hủy bỏ
                </button>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-all shadow-md flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">save</span>
                    <span>Lưu hoa tươi</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openAddModal() {
        document.getElementById('modalHoaTuoiTitle').innerText = 'Thêm Hoa Tươi Mới';
        document.getElementById('inputTenHoaTuoi').value = '';
        document.getElementById('inputMauSacHoaTuoi').value = '';
        document.getElementById('inputGiaHoaTuoi').value = '';
        document.getElementById('hoaTuoiModal').classList.remove('hidden');
    }

    function openEditModal(code, name, type, color, unit, price, status) {
        document.getElementById('modalHoaTuoiTitle').innerText = 'Chỉnh Sửa Hoa Tươi #' + code;
        document.getElementById('inputTenHoaTuoi').value = name;
        document.getElementById('selectLoaiHoaTuoi').value = type;
        document.getElementById('inputMauSacHoaTuoi').value = color;
        document.getElementById('inputDonViHoaTuoi').value = unit;
        document.getElementById('inputGiaHoaTuoi').value = price;
        document.getElementById('selectTrangThaiHoaTuoi').value = status;
        document.getElementById('hoaTuoiModal').classList.remove('hidden');
    }

    function closeHoaTuoiModal() {
        document.getElementById('hoaTuoiModal').classList.add('hidden');
    }

    function handleHoaTuoiSubmit(e) {
        e.preventDefault();
        alert('Lưu hoa tươi thành công!');
        closeHoaTuoiModal();
    }
</script>
