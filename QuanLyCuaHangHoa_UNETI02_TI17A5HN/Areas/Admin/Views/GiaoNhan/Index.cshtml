
@* Họ và tên: Nguyễn Thị Đào
   Mã sinh viên: 23103100245
   Nội dung: Tuần 6 - Hiển thị danh sách giao nhận
   từ SQL Server, tìm kiếm, lọc, sắp xếp, phân trang. *@

@using QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models
@using QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels

@model GiaoNhanIndexViewModel

@{
    ViewBag.Title = "Quản Lý Giao & Nhận";
    ViewBag.ActiveMenu = "GiaoNhan";
    ViewBag.Breadcrumb = "Vận chuyển & Logistics";
}

<div class="px-space-xl py-space-lg flex flex-col w-full space-y-space-md">

    @await Html.PartialAsync("_AdminPageHeader")

    @if (TempData["Success"] != null)
    {
        <div class="p-4 rounded-xl bg-green-100 text-green-800">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="p-4 rounded-xl bg-red-100 text-red-800">
            @TempData["Error"]
        </div>
    }

    @* THỐNG KÊ GIAO NHẬN TỪ DATABASE *@

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">

        <div class="p-space-lg rounded-xl bg-surface-container-lowest shadow-sm">
            <div class="text-outline text-sm uppercase">
                Tổng giao nhận
            </div>
            <div class="font-display-lg text-display-lg text-primary mt-2">
                @Model.TongGiaoNhan
            </div>
            <div class="text-secondary text-sm">
                Tổng số phiếu trong hệ thống
            </div>
        </div>

        <div class="p-space-lg rounded-xl bg-surface-container-lowest shadow-sm">
            <div class="text-outline text-sm uppercase">
                Chờ xử lý
            </div>
            <div class="font-display-lg text-display-lg text-primary mt-2">
                @Model.ChoXuLy
            </div>
            <div class="text-secondary text-sm">
                Phiếu chưa bắt đầu giao
            </div>
        </div>

        <div class="p-space-lg rounded-xl bg-surface-container-lowest shadow-sm">
            <div class="text-outline text-sm uppercase">
                Đang giao
            </div>
            <div class="font-display-lg text-display-lg text-primary mt-2">
                @Model.DangGiao
            </div>
            <div class="text-secondary text-sm">
                Phiếu đang vận chuyển
            </div>
        </div>

        <div class="p-space-lg rounded-xl bg-surface-container-lowest shadow-sm">
            <div class="text-outline text-sm uppercase">
                Hoàn thành
            </div>
            <div class="font-display-lg text-display-lg text-primary mt-2">
                @Model.HoanThanh
            </div>
            <div class="text-secondary text-sm">
                Phiếu đã hoàn tất
            </div>
        </div>

    </div>

    @* SỬ DỤNG BỘ LỌC DÙNG CHUNG CỦA HƯƠNG *@

    @await Html.PartialAsync("_AdminFilterBar", new AdminFilterViewModel
    {
        Area = "Admin",
        Controller = "GiaoNhan",
        Action = "Index",

        TuKhoa = Model.TuKhoa,
        SapXep = Model.SapXep,

        HienThiTrangThai = false,
        HienThiTrangThaiGiaoNhan = true,
        TrangThaiGiaoNhan = Model.TrangThaiGiaoNhan,

        Placeholder = "Mã đơn (#ORD-0030), tên người nhận, địa chỉ...",

        SapXepOptions = new()
        {
            new() { Value = "date_new", Text = "Dự kiến mới nhất" },
            new() { Value = "date_old", Text = "Dự kiến cũ nhất" },
            new() { Value = "status", Text = "Theo trạng thái" }
        }
    })

    @* DANH SÁCH GIAO NHẬN *@

    <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col">

                @*  Đào - Nội dung: Tuần 6 - Bổ sung nút tạo phiếu giao nhận. *@

        <div class="p-space-md border-b border-surface-container
                    flex flex-wrap justify-between items-center gap-4">

            <div>
                <h3 class="font-headline-sm text-xl">
                    Danh sách giao nhận
                </h3>

                <p class="text-secondary text-sm mt-1">
                    Tìm thấy @Model.DanhSach.TongSoBanGhi phiếu phù hợp
                </p>
            </div>

            <a asp-area="Admin"
               asp-controller="GiaoNhan"
               asp-action="Create"
               class="inline-flex items-center gap-2
                      bg-primary text-on-primary
                      px-5 py-3 rounded-xl
                      font-semibold hover:opacity-90
                      transition-all shadow-sm">

                <span class="material-symbols-outlined text-[20px]">
                    add_circle
                </span>

                Thêm phiếu giao nhận
            </a>

        </div>

        @* KẾT THÚC PHẦN BỔ SUNG - Nguyễn Thị Đào *@

        <div class="overflow-x-auto">
            <table class="w-full min-w-[1440px] text-left text-on-surface">

                <thead>
                    <tr class="bg-surface-container-low text-secondary uppercase text-sm">
                        <th class="p-4">Mã giao nhận</th>
                        <th class="p-4">Mã đơn</th>
                        <th class="p-4">Người nhận</th>
                        <th class="p-4">Hình thức</th>
                        <th class="p-4">Thời gian dự kiến</th>
                        <th class="p-4">Địa chỉ</th>
                        <th class="p-4">Người giao</th>
                        <th class="p-4 text-center">Trạng thái</th>
                        <th class="p-4 text-right min-w-[300px] whitespace-nowrap">
                            Thao tác
                        </th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-surface-container">

                    @foreach (var g in Model.DanhSach.DuLieu)
                    {
                        <tr class="hover:bg-surface-container-low transition-colors">

                            <td class="p-4 font-semibold text-primary">
                                GN-@g.MaGiaoNhan.ToString("D4")
                            </td>

                            <td class="p-4">
                                #ORD-@g.MaDon.ToString("D4")
                            </td>

                            <td class="p-4">
                                @(g.DonDatHoa?.NguoiNhan ?? "Chưa có tên")
                            </td>

                            <td class="p-4">
                                @g.HinhThuc
                            </td>

                            <td class="p-4">
                                @g.ThoiGianDuKien.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td class="p-4">
                                @(string.IsNullOrWhiteSpace(g.DiaChi)
                                    ? "Nhận tại cửa hàng"
                                    : g.DiaChi)
                            </td>

                            <td class="p-4">
                                @(string.IsNullOrWhiteSpace(g.NguoiGiao)
                                    ? "Chưa phân công"
                                    : g.NguoiGiao)
                            </td>

                            <td class="p-4 text-center">
                                @await Html.PartialAsync(
                                    "_AdminStatusBadge", g.TrangThai)
                            </td>

                           
                        @* Nguyễn Thị Đào - 23103100245
                           Bổ sung nút sửa phiếu giao nhận. *@

                        <td class="p-3 text-right whitespace-nowrap">
                            <div class="flex items-center justify-end gap-3 flex-nowrap">

                                @* Nút xem đơn *@
                                <a asp-area="Admin"
                                   asp-controller="DonDatHoa"
                                   asp-action="Details"
                                   asp-route-id="@g.MaDon"
                                   class="inline-flex w-[92px] shrink-0 items-center justify-center gap-1
                                           h-9 rounded-lg
                                           bg-surface-container text-on-surface
                                           font-semibold text-sm hover:opacity-80 transition-all">

                                    <span class="material-symbols-outlined text-[17px]">
                                        visibility
                                    </span>
                                    Xem đơn
                                </a>

                                @* Nút sửa phiếu *@
                                @if (g.TrangThai == TrangThaiGiaoNhanConst.ChoXuLy &&
                                     (g.DonDatHoa.TrangThai == TrangThaiDon.DaXacNhan ||
                                      g.DonDatHoa.TrangThai == TrangThaiDon.DangChuanBi ||
                                      g.DonDatHoa.TrangThai == TrangThaiDon.SanSang))
                                {
                                    <a asp-area="Admin"
                                       asp-controller="GiaoNhan"
                                       asp-action="Edit"
                                       asp-route-id="@g.MaGiaoNhan"
                                       class="inline-flex w-[92px] shrink-0 items-center justify-center gap-1
                                               h-9 rounded-lg
                                               bg-primary text-on-primary
                                               font-semibold text-sm hover:opacity-90 transition-all">

                                        <span class="material-symbols-outlined text-[17px]">
                                            edit
                                        </span>
                                        Sửa
                                    </a>
                                }

                                @* Nút hoàn thành giao nhận *@
                                @if (
                                    (g.HinhThuc == HinhThucNhanConst.GiaoTanNoi &&
                                     g.DonDatHoa.TrangThai == TrangThaiDon.DangGiao &&
                                     g.TrangThai == TrangThaiGiaoNhanConst.DangGiao)
                                    ||
                                    (g.HinhThuc == HinhThucNhanConst.KhachDenNhan &&
                                     g.DonDatHoa.TrangThai == TrangThaiDon.SanSang &&
                                     g.TrangThai == TrangThaiGiaoNhanConst.ChoXuLy)
                                )
                                {
                                    <form asp-area="Admin"
                                          asp-controller="GiaoNhan"
                                          asp-action="HoanThanh"
                                          asp-route-id="@g.MaGiaoNhan"
                                          method="post"
                                          class="m-0 shrink-0"
                                          onsubmit="return confirm('Xác nhận khách đã nhận hoa?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                               class="inline-flex w-[120px] items-center justify-center gap-1
                                                       h-9 rounded-lg
                                                       bg-green-700 text-white
                                                       font-semibold text-sm whitespace-nowrap
                                                       hover:bg-green-800 transition-all">

                                            <span class="material-symbols-outlined text-[17px]">
                                                check_circle
                                            </span>
                                            Hoàn thành
                                        </button>
                                    </form>
                                }

                            </div>
                        </td>

                        @* KẾT THÚC PHẦN BỔ SUNG - NGUYỄN THỊ ĐÀO *@


                        </tr>
                    }

                    @if (!Model.DanhSach.DuLieu.Any())
                    {
                        <tr>
                            <td colspan="9" class="p-8 text-center text-secondary">
                                Không có phiếu giao nhận phù hợp.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>

        @* PHÂN TRANG DÙNG CHUNG CỦA NHÓM *@

        <div class="px-space-lg pb-space-md">
            @await Html.PartialAsync("_AdminPagination", new PaginationViewModel
            {
                TrangHienTai = Model.DanhSach.TrangHienTai,
                TongSoTrang = Model.DanhSach.TongSoTrang,
                TongSoBanGhi = Model.DanhSach.TongSoBanGhi,
                SoBanGhiMoiTrang = Model.DanhSach.SoBanGhiMoiTrang,

                Area = "Admin",
                Controller = "GiaoNhan",
                Action = "Index",

                BoLoc = new Dictionary<string, string?>
                {
                    ["tuKhoa"] = Model.TuKhoa,
                    ["trangThaiGiaoNhan"] = Model.TrangThaiGiaoNhan,
                    ["sapXep"] = Model.SapXep
                }
            })
        </div>

    </div>

</div>

@* KẾT THÚC PHẦN MODULE 4 - Nguyễn Thị Đào *@
