@* Họ và tên: Đặng Thị Mai Hương
   Mã sinh viên: 23103100293
   Nội dung thực hiện: Danh sách khách hàng từ Database, tìm kiếm, lọc, phân trang và thống kê.
*@

@using QuanLyCuaHangHoa_UNETI02_TI17A5HN.Helpers
@model QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels.KhachHangIndexViewModel
@using QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels
@{
    ViewBag.Title = "Quản Lý Khách Hàng";
    ViewBag.ActiveMenu = "KhachHang";
    ViewBag.Breadcrumb = "Quản lý khách hàng";
}
<div class="px-space-xl py-space-lg flex flex-col w-full space-y-space-md">
    @await Html.PartialAsync("_AdminPageHeader")
    @if (TempData["ThongBao"] != null)
    {
        <div class="bg-primary-fixed text-on-primary-fixed-variant px-space-lg py-space-md rounded-2xl shadow-sm">@TempData["ThongBao"]</div>
    }

    <!-- Giữ nguyên kiểu Bento 4 ô, thay dữ liệu mẫu bằng thống kê thực -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
        <div class="relative overflow-hidden bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="font-label-md text-label-md tracking-wider uppercase text-outline">Tổng khách hàng</span>
                <div class="w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-primary"><span class="material-symbols-outlined text-[20px]">groups</span></div>
            </div>
            <div class="mt-4"><div class="font-display-lg text-display-lg text-on-surface font-semibold">@Model.TongKhachHang.ToString("N0")</div><div class="font-body-sm text-body-sm text-on-surface-variant mt-2">Tổng số khách trong hệ thống</div></div>
        </div>
        <div class="relative overflow-hidden bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="font-label-md text-label-md tracking-wider uppercase text-outline">Đang hoạt động</span>
                <div class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center text-primary"><span class="material-symbols-outlined text-[20px]">person_check</span></div>
            </div>
            <div class="mt-4"><div class="font-display-lg text-display-lg text-on-surface font-semibold">@Model.TongDangHoatDong.ToString("N0")</div><div class="font-body-sm text-body-sm text-on-surface-variant mt-2">Khách hàng đang hoạt động</div></div>
        </div>
        <div class="relative overflow-hidden bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="font-label-md text-label-md tracking-wider uppercase text-outline">Đã khóa</span>
                <div class="w-10 h-10 rounded-full bg-surface-container-high flex items-center justify-center text-primary"><span class="material-symbols-outlined text-[20px]">person_off</span></div>
            </div>
            <div class="mt-4"><div class="font-display-lg text-display-lg text-on-surface font-semibold">@Model.TongBiKhoa.ToString("N0")</div><div class="font-body-sm text-body-sm text-on-surface-variant mt-2">Khách hàng bị khóa</div></div>
        </div>
        <div class="relative overflow-hidden bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between">
                <span class="font-label-md text-label-md tracking-wider uppercase text-outline">Kết quả tìm kiếm</span>
                <div class="w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-on-primary-fixed-variant"><span class="material-symbols-outlined text-[20px]">manage_search</span></div>
            </div>
            <div class="mt-4"><div class="font-display-lg text-display-lg text-on-surface font-semibold">@Model.DanhSach.TongSoBanGhi.ToString("N0")</div><div class="font-body-sm text-body-sm text-on-surface-variant mt-2">Phù hợp bộ lọc hiện tại</div></div>
        </div>
    </div>

    @await Html.PartialAsync("_AdminFilterBar", new AdminFilterViewModel
    {
        Area = "Admin",
        Controller = "KhachHang",
        Action = "Index",

        TuKhoa = Model.TuKhoa,
        TrangThai = Model.TrangThai,
        SapXep = Model.SapXep,

        Placeholder = "Tìm theo họ tên, số điện thoại, email...",

        SapXepOptions = new()
    {
        new() { Value = "name_asc", Text = "Tên (A-Z)" },
        new() { Value = "name_desc", Text = "Tên (Z-A)" },
        new() { Value = "date_new", Text = "Mã KH mới nhất" },
        new() { Value = "date_old", Text = "Mã KH cũ nhất" }
    }
    })

    <div class="bg-surface-container-lowest rounded-2xl shadow-sm overflow-hidden flex flex-col">
        <!-- Table Top Action Bar -->
        <div class="p-space-md bg-surface-container-lowest flex items-center justify-between gap-space-sm border-b border-surface-container">
            <div class="flex items-center gap-space-sm">
                <span class="font-headline-sm text-headline-sm text-on-surface">Danh Sách Khách Hàng</span>
                <span class="px-2.5 py-0.5 rounded-full bg-secondary-container text-on-secondary-container font-label-md text-label-md font-semibold">
                    @Model.DanhSach.TongSoBanGhi.ToString("N0") khách hàng
                </span>
            </div>
            <button type="button" onclick="openAddKhachHangModal()" class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-all shadow-sm">
                <span class="material-symbols-outlined text-[18px]">person_add</span>
                <span>Thêm Khách Hàng Mới</span>
            </button>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-surface-container-low text-outline uppercase font-label-md text-label-md tracking-wider">
                        <th class="py-space-md pl-space-lg pr-space-sm font-semibold">Mã KH</th>
                        <th class="py-space-md px-space-md font-semibold">Khách hàng</th>
                        <th class="py-space-md px-space-md font-semibold">Số điện thoại</th>
                        <th class="py-space-md px-space-md font-semibold">Email</th>
                        <th class="py-space-md px-space-md font-semibold">Địa chỉ</th>
                        <th class="py-space-md px-space-md font-semibold text-center">Trạng thái</th>
                        <th class="py-space-md pr-space-lg pl-space-sm font-semibold text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-surface-container font-body-sm text-body-sm">
                    @foreach (var kh in Model.DanhSach.DuLieu)
                    {
                        <tr class="hover:bg-surface-container-low/60 transition-colors">
                            <td class="py-space-md pl-space-lg pr-space-sm font-mono text-primary font-bold">KH-@kh.MaKhachHang.ToString("D3")</td>
                            <td class="py-space-md px-space-md"><div class="font-title-sm text-title-sm text-on-surface">@kh.HoTen</div><div class="text-secondary font-body-sm text-body-sm">Username: @(kh.TaiKhoan?.TenDangNhap ?? "Chưa có tài khoản")</div></td>
                            <td class="py-space-md px-space-md font-mono text-on-surface">@kh.SoDienThoai</td>
                            <td class="py-space-md px-space-md text-on-surface-variant">@kh.Email</td>
                            <td class="py-space-md px-space-md text-on-surface-variant">@(string.IsNullOrWhiteSpace(kh.DiaChi) ? "Chưa cập nhật" : kh.DiaChi)</td>
                            <td class="py-space-md px-space-md text-center">@await Html.PartialAsync("_AdminStatusBadge", kh.TrangThai ? "Hoạt động" : "Đã khóa")</td>
                            <td class="py-space-md pr-space-lg pl-space-sm text-right">
                                <div class="flex items-center justify-end gap-1">
                                    <button type="button"
                                            title="Chỉnh sửa khách hàng"
                                            data-id="@kh.MaKhachHang"
                                            data-hoten="@kh.HoTen"
                                            data-sdt="@kh.SoDienThoai"
                                            data-email="@kh.Email"
                                            data-diachi="@(kh.DiaChi ?? "")"
                                            onclick="openEditKhachHangModal(this)"
                                            class="inline-flex p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-all">
                                        <span class="material-symbols-outlined text-[18px]">edit</span>
                                    </button>
                                    @if (Context.Session.CoVaiTro(VaiTroConst.Admin))
                                    {
                                        <form asp-area="Admin" asp-controller="KhachHang" asp-action="DoiTrangThai"
                                              method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@kh.MaKhachHang" />
                                            <button type="submit" title="@(kh.TrangThai ? "Khóa khách hàng" : "Mở khóa khách hàng")"
                                                    onclick="return confirm('Bạn có chắc muốn @(kh.TrangThai ? "khóa" : "mở khóa") khách hàng này?')"
                                                    class="p-1.5 rounded-lg text-secondary hover:text-primary hover:bg-surface-container transition-all">
                                                <span class="material-symbols-outlined text-[18px]">@(kh.TrangThai ? "lock" : "lock_open")</span>
                                            </button>
                                        </form>

                                        <!-- Nút Xóa khách hàng đồng bộ tài khoản -->
                                        <form asp-area="Admin" asp-controller="KhachHang" asp-action="Delete"
                                              method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@kh.MaKhachHang" />
                                            <button type="submit" title="Xóa khách hàng"
                                                    onclick="return confirm('Bạn có chắc muốn XÓA VĨNH VIỄN khách hàng @kh.HoTen và tài khoản liên kết không?')"
                                                    class="p-1.5 rounded-lg text-secondary hover:text-error hover:bg-surface-container transition-all">
                                                <span class="material-symbols-outlined text-[18px]">delete</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.DanhSach.DuLieu.Any())
                    {
                        <tr><td colspan="7" class="py-space-lg px-space-lg text-center text-on-surface-variant">Không tìm thấy khách hàng phù hợp.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-space-lg pb-space-md">
            @await Html.PartialAsync("_AdminPagination", new PaginationViewModel
            {
                TrangHienTai = Model.DanhSach.TrangHienTai,
                TongSoTrang = Model.DanhSach.TongSoTrang,
                TongSoBanGhi = Model.DanhSach.TongSoBanGhi,
                SoBanGhiMoiTrang = Model.DanhSach.SoBanGhiMoiTrang,
                Area = "Admin",
                Controller = "KhachHang",
                Action = "Index",
                BoLoc = new Dictionary<string, string?>
                {
                    ["tuKhoa"] = Model.TuKhoa,
                    ["trangThai"] = Model.TrangThai?.ToString().ToLowerInvariant(),
                    ["sapXep"] = Model.SapXep
                }
            })
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- POPUP MODAL: THÊM KHÁCH HÀNG MỚI (TẠO TÀI KHOẢN) -->
<!-- ============================================== -->
<div id="addKhachHangModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-on-surface/50 backdrop-blur-sm p-4 overflow-y-auto transition-all">
    <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-xl overflow-hidden flex flex-col">
        <div class="flex items-center justify-between px-space-lg py-space-md bg-surface-container-low border-b border-surface-container-high">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[22px]">person_add</span>
                <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">Thêm Khách Hàng Mới</h3>
            </div>
            <button type="button" onclick="closeAddKhachHangModal()" class="text-secondary hover:text-on-surface p-1.5 rounded-full hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <form asp-area="Admin" asp-controller="KhachHang" asp-action="Create" method="post" class="p-space-lg space-y-space-md font-body-md text-body-md">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Tên đăng nhập *</label>
                    <input type="text" name="TenDangNhap" placeholder="VD: khachhang_lan" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md focus:outline-none focus:ring-1 focus:ring-primary border border-outline-variant/40" required minlength="4" maxlength="50" />
                </div>
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Mật khẩu khởi tạo *</label>
                    <input type="password" name="MatKhau" value="123456" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md focus:outline-none border border-outline-variant/40" required minlength="6" />
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Họ và tên *</label>
                    <input type="text" name="HoTen" placeholder="VD: Nguyễn Thị Lan" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md focus:outline-none focus:ring-1 focus:ring-primary border border-outline-variant/40" required maxlength="100" />
                </div>
                <div>
                    <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Số điện thoại *</label>
                    <input type="text" name="SoDienThoai" placeholder="VD: 0988776655" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md focus:outline-none border border-outline-variant/40" required />
                </div>
            </div>

            <div>
                <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Email *</label>
                <input type="email" name="Email" placeholder="lan@gmail.com" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md focus:outline-none border border-outline-variant/40" required />
            </div>

            <div>
                <label class="block font-title-sm text-title-sm text-on-surface mb-1 font-semibold">Địa chỉ liên hệ</label>
                <input type="text" name="DiaChi" placeholder="VD: Số 456 Hoàng Mai, Hà Nội" class="w-full px-3.5 py-2.5 rounded-lg bg-surface-container-low text-on-surface font-body-md focus:outline-none border border-outline-variant/40" />
            </div>

            <div class="flex items-center justify-end gap-space-sm pt-space-md border-t border-surface-container-high">
                <button type="button" onclick="closeAddKhachHangModal()" class="px-5 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-title-sm transition-all">
                    Hủy bỏ
                </button>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-primary text-on-primary font-title-sm hover:bg-primary-container transition-all shadow-md flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-[18px]">person_add</span>
                    <span>Lưu khách hàng</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- POPUP CHỈNH SỬA KHÁCH HÀNG -->
<div id="editKhachHangModal"
     class="hidden fixed inset-0 z-50 flex items-center justify-center bg-on-surface/50 backdrop-blur-sm p-4 overflow-y-auto">

    <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-xl overflow-hidden">

        <!-- Tiêu đề popup -->
        <div class="flex items-center justify-between px-space-lg py-space-md bg-surface-container-low border-b border-surface-container-high">
            <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-primary text-[22px]">edit</span>
                <h3 class="font-headline-sm text-headline-sm text-on-surface font-semibold">
                    Chỉnh sửa khách hàng <span id="editMaKH"></span>
                </h3>
            </div>

            <button type="button"
                    onclick="closeEditKhachHangModal()"
                    class="text-secondary hover:text-on-surface p-1.5 rounded-full hover:bg-surface-container">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <!-- Form dùng lại POST Edit hiện có -->
        <form id="editKhachHangForm"
              asp-area="Admin"
              asp-controller="KhachHang"
              asp-action="Edit"
              method="post"
              class="p-space-lg space-y-space-md">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" />
            <input type="hidden" name="MaKhachHang" />

            <!-- Họ tên và số điện thoại -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                <div>
                    <label class="block mb-2 font-label-md text-on-surface">
                        Họ và tên *
                    </label>
                    <input name="HoTen" type="text" required maxlength="100"
                           class="w-full p-3 bg-surface-container-low rounded-xl border border-outline-variant/40 focus:outline-none focus:border-primary" />
                </div>

                <div>
                    <label class="block mb-2 font-label-md text-on-surface">
                        Số điện thoại *
                    </label>
                    <input name="SoDienThoai" type="tel" required
                           class="w-full p-3 bg-surface-container-low rounded-xl border border-outline-variant/40 focus:outline-none focus:border-primary" />
                </div>
            </div>

            <!-- Email -->
            <div>
                <label class="block mb-2 font-label-md text-on-surface">
                    Email *
                </label>
                <input name="Email" type="email" required
                       class="w-full p-3 bg-surface-container-low rounded-xl border border-outline-variant/40 focus:outline-none focus:border-primary" />
            </div>

            <!-- Địa chỉ -->
            <div>
                <label class="block mb-2 font-label-md text-on-surface">
                    Địa chỉ liên hệ
                </label>
                <textarea name="DiaChi" rows="2"
                          class="w-full p-3 bg-surface-container-low rounded-xl border border-outline-variant/40 focus:outline-none focus:border-primary"></textarea>
            </div>

            <!-- Nút thao tác -->
            <div class="flex justify-end gap-space-sm pt-space-md border-t border-surface-container-high">
                <button type="button"
                        onclick="closeEditKhachHangModal()"
                        class="px-5 py-2.5 rounded-xl bg-surface-container text-on-surface hover:bg-surface-container-high">
                    Hủy bỏ
                </button>

                <button type="submit"
                        class="px-6 py-2.5 rounded-xl bg-primary text-on-primary hover:bg-primary-container">
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openAddKhachHangModal() {
        document.getElementById('addKhachHangModal').classList.remove('hidden');
    }
    function closeAddKhachHangModal() {
        document.getElementById('addKhachHangModal').classList.add('hidden');
    }

    // Mở popup và điền thông tin khách hàng được chọn.
    function openEditKhachHangModal(button) {
        const form = document.getElementById('editKhachHangForm');

        form.elements.namedItem('id').value = button.dataset.id;
        form.elements.namedItem('MaKhachHang').value = button.dataset.id;
        form.elements.namedItem('HoTen').value = button.dataset.hoten;
        form.elements.namedItem('SoDienThoai').value = button.dataset.sdt;
        form.elements.namedItem('Email').value = button.dataset.email;
        form.elements.namedItem('DiaChi').value = button.dataset.diachi || '';

        document.getElementById('editMaKH').textContent =
            'KH-' + button.dataset.id.padStart(3, '0');

        document.getElementById('editKhachHangModal')
            .classList.remove('hidden');
    }

    // Đóng popup.
    function closeEditKhachHangModal() {
        document.getElementById('editKhachHangModal')
            .classList.add('hidden');
    }
</script>
