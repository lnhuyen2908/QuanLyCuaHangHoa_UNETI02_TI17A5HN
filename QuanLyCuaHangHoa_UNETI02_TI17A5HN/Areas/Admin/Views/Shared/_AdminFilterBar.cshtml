@*
    Họ và tên: Đặng Thị Mai Hương - Mã sinh viên: 23103100293
    Họ và tên: Nguyễn Thị Phương Anh - Mã sinh viên: 23103100267
    Nội dung thực hiện: Thanh tìm kiếm/lọc/sắp xếp dùng chung cho Admin
*@
@using QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models
@model QuanLyCuaHangHoa_UNETI02_TI17A5HN.Models.ViewModels.AdminFilterViewModel

@if (Model != null)
{
    <form asp-area="@Model.Area"
          asp-controller="@Model.Controller"
          asp-action="@Model.Action"
          method="get"
          class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm mb-space-lg flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">

        @* Chỉ trang HoaTuoi sử dụng bố cục 2 hàng. Các trang khác giữ giao diện cũ. *@
        @if (Model.Controller == "HoaTuoi")
        {
            <div class="flex flex-col gap-space-md w-full">
                @* Hàng 1: Ô tìm kiếm + hai nút *@
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-space-sm w-full">
                    <div class="flex items-center gap-space-xs bg-surface-container px-space-md py-2 rounded-xl flex-1 min-w-0">
                        <span class="material-symbols-outlined text-[20px] text-on-surface-variant">search</span>
                        <input type="text"
                               name="tuKhoa"
                               value="@Model.TuKhoa"
                               placeholder="@Model.Placeholder"
                               class="bg-transparent font-body-sm text-body-sm text-on-surface placeholder:text-outline focus:outline-none flex-1 min-w-0 w-full" />
                    </div>
                    <button type="submit"
                            class="flex items-center justify-center gap-space-xs bg-primary text-on-primary px-3 py-2 rounded-xl font-title-sm text-title-sm hover:opacity-90 transition-all">
                        <span class="material-symbols-outlined text-[18px]">search</span>
                        Tìm kiếm
                    </button>
                    <a asp-area="@Model.Area"
                       asp-controller="@Model.Controller"
                       asp-action="@Model.Action"
                       class="flex items-center justify-center gap-space-xs bg-surface-container text-on-surface-variant px-3 py-2 rounded-xl font-title-sm text-title-sm hover:bg-surface-container-high transition-all">
                        <span class="material-symbols-outlined text-[18px]">refresh</span>
                        <span>Làm mới</span>
                    </a>
                </div>

                @* Hàng 2: Bộ lọc và sắp xếp *@
                <div class="flex flex-wrap items-center gap-2 w-full">
                    @if (Model.HienThiTrangThai)
                    {
                        <div class="flex items-center gap-1 bg-surface-container px-2 py-2 rounded-xl text-sm text-on-surface-variant min-w-0">
                            <span class="material-symbols-outlined text-[18px]">filter_list</span>
                            <select name="trangThai" class="bg-transparent text-on-surface text-sm focus:outline-none cursor-pointer min-w-0 max-w-full">
                                <option value="" selected="@(Model.TrangThai == null)">Tất cả trạng thái</option>
                                <option value="true" selected="@(Model.TrangThai == true)">Đang hoạt động</option>
                                <option value="false" selected="@(Model.TrangThai == false)">Đã khóa</option>
                            </select>
                        </div>
                    }

                    @if (Model.HienThiBoLocHoaTuoi)
                    {
                        <div class="flex items-center gap-1 bg-surface-container px-2 py-2 rounded-xl text-sm text-on-surface-variant min-w-0">
                            <span class="material-symbols-outlined text-[18px]">local_florist</span>
                            <select name="loaiHoaId" class="bg-transparent text-on-surface text-sm focus:outline-none cursor-pointer min-w-0 max-w-full">
                                <option value="">Tất cả loại hoa</option>
                                @foreach (var item in Model.DanhSachLoaiHoa)
                                {
                                    <option value="@item.Value" selected="@(Model.LoaiHoaId?.ToString() == item.Value)">@item.Text</option>
                                }
                            </select>
                        </div>

                        <div class="flex items-center gap-1 bg-surface-container px-2 py-2 rounded-xl text-sm text-on-surface-variant min-w-0">
                            <span class="material-symbols-outlined text-[18px]">palette</span>
                            <select name="mauSac" class="bg-transparent text-on-surface text-sm focus:outline-none cursor-pointer min-w-0 max-w-full">
                                <option value="">Tất cả màu sắc</option>
                                @foreach (var item in Model.DanhSachMauSac)
                                {
                                    <option value="@item.Value" selected="@(Model.MauSac == item.Value)">@item.Text</option>
                                }
                            </select>
                        </div>

                        <div class="flex items-center gap-1 bg-surface-container px-2 py-2 rounded-xl text-sm text-on-surface-variant min-w-0">
                            <span class="material-symbols-outlined text-[18px]">straighten</span>
                            <select name="donViTinh" class="bg-transparent text-on-surface text-sm focus:outline-none cursor-pointer min-w-0 max-w-full">
                                <option value="">Tất cả đơn vị tính</option>
                                @foreach (var item in Model.DanhSachDonViTinh)
                                {
                                    <option value="@item.Value" selected="@(Model.DonViTinh == item.Value)">@item.Text</option>
                                }
                            </select>
                        </div>
                    }

                    @if (Model.SapXepOptions != null && Model.SapXepOptions.Any())
                    {
                        <div class="flex items-center gap-1 bg-surface-container px-2 py-2 rounded-xl text-sm text-on-surface-variant min-w-0">
                            <span class="material-symbols-outlined text-[18px]">sort</span>
                            <select name="sapXep" class="bg-transparent text-on-surface text-sm focus:outline-none cursor-pointer min-w-0 max-w-full">
                                @foreach (var option in Model.SapXepOptions)
                                {
                                    var tenSapXep = option.Text.Replace("Mã KH", "Mã hoa");
                                    <option value="@option.Value" selected="@(Model.SapXep == option.Value)">@tenSapXep</option>
                                }
                            </select>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            @* Giao diện cũ cho các trang Admin khác: giữ nguyên bố cục *@
            <div class="flex items-center gap-space-xs bg-surface-container px-space-md py-2 rounded-xl flex-1 max-w-lg">
                <span class="material-symbols-outlined text-[20px] text-on-surface-variant">search</span>
                <input type="text"
                       name="tuKhoa"
                       value="@Model.TuKhoa"
                       placeholder="@Model.Placeholder"
                       class="bg-transparent font-body-sm text-body-sm text-on-surface placeholder:text-outline focus:outline-none w-full" />
            </div>

            <div class="flex flex-wrap items-center gap-space-sm">
                @if (Model.HienThiVaiTro)
                {
                    <div class="flex items-center gap-2 bg-surface-container px-3 py-2 rounded-xl font-title-sm text-title-sm text-on-surface-variant">
                        <span class="material-symbols-outlined text-[18px]">badge</span>
                        <select name="vaiTro" class="bg-transparent text-on-surface font-title-sm text-title-sm focus:outline-none cursor-pointer">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.VaiTro))">Tất cả vai trò</option>
                            <option value="@VaiTroConst.Admin" selected="@(Model.VaiTro == VaiTroConst.Admin)">Quản trị viên (Admin)</option>
                            <option value="@VaiTroConst.NhanVien" selected="@(Model.VaiTro == VaiTroConst.NhanVien)">Nhân viên</option>
                            <option value="@VaiTroConst.KhachHang" selected="@(Model.VaiTro == VaiTroConst.KhachHang)">Khách hàng</option>
                        </select>
                    </div>
                }

                @if (Model.HienThiTrangThai)
                {
                    <div class="flex items-center gap-2 bg-surface-container px-3 py-2 rounded-xl font-title-sm text-title-sm text-on-surface-variant">
                        <span class="material-symbols-outlined text-[18px]">filter_list</span>
                        <select name="trangThai" class="bg-transparent text-on-surface font-title-sm text-title-sm focus:outline-none cursor-pointer">
                            <option value="" selected="@(Model.TrangThai == null)">Tất cả trạng thái</option>
                            <option value="true" selected="@(Model.TrangThai == true)">Đang hoạt động</option>
                            <option value="false" selected="@(Model.TrangThai == false)">Đã khóa</option>
                        </select>
                    </div>
                }

                
                @* Họ và tên: Nguyễn Thị Đào
                   Mã sinh viên: 23103100245
                   Nội dung: Bộ lọc trạng thái giao nhận - Module 4 *@

                @if (Model.HienThiTrangThaiGiaoNhan)
                {
                    <div class="flex items-center gap-2 bg-surface-container px-3 py-2 rounded-xl font-title-sm text-title-sm text-on-surface-variant">
                        <span class="material-symbols-outlined text-[18px]">
                            local_shipping
                        </span>

                        <select name="trangThaiGiaoNhan"
                                class="bg-transparent text-on-surface font-title-sm text-title-sm focus:outline-none cursor-pointer">

                            <option value=""
                                    selected="@(string.IsNullOrEmpty(Model.TrangThaiGiaoNhan))">
                                Tất cả trạng thái
                            </option>

                            <option value="@TrangThaiGiaoNhanConst.ChoXuLy"
                                    selected="@(Model.TrangThaiGiaoNhan == TrangThaiGiaoNhanConst.ChoXuLy)">
                                Chờ xử lý
                            </option>

                            <option value="@TrangThaiGiaoNhanConst.DangGiao"
                                    selected="@(Model.TrangThaiGiaoNhan == TrangThaiGiaoNhanConst.DangGiao)">
                                Đang giao
                            </option>

                            <option value="@TrangThaiGiaoNhanConst.HoanThanh"
                                    selected="@(Model.TrangThaiGiaoNhan == TrangThaiGiaoNhanConst.HoanThanh)">
                                Hoàn thành
                            </option>

                        </select>
                    </div>
                }

                @* KẾT THÚC PHẦN BỔ SUNG CỦA ĐÀO *@

                @if (Model.SapXepOptions != null && Model.SapXepOptions.Any())
                {
                    <div class="flex items-center gap-2 bg-surface-container px-3 py-2 rounded-xl font-title-sm text-title-sm text-on-surface-variant">
                        <span class="material-symbols-outlined text-[18px]">sort</span>
                        <select name="sapXep" class="bg-transparent text-on-surface font-title-sm text-title-sm focus:outline-none cursor-pointer">
                            @foreach (var option in Model.SapXepOptions)
                            {
                                <option value="@option.Value" selected="@(Model.SapXep == option.Value)">@option.Text</option>
                            }
                        </select>
                    </div>
                }
                
                @if (Model.HienThiBoLocMauSanPham)
                {
                    <!-- Lọc theo dịp sử dụng -->
                    <div class="flex items-center gap-1 bg-surface-container px-3 py-2 rounded-xl">
                        <span class="material-symbols-outlined text-[18px]">event</span>
                        <select name="maDip"
                                class="bg-transparent text-on-surface text-sm focus:outline-none">
                            <option value="">Tất cả dịp sử dụng</option>
                            @foreach (var item in Model.DanhSachDip)
                            {
                                <option value="@item.Value"
                                        selected="@(Model.MaDip?.ToString() == item.Value)">
                                    @item.Text
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Lọc theo kiểu sản phẩm -->
                    <div class="flex items-center gap-1 bg-surface-container px-3 py-2 rounded-xl">
                        <span class="material-symbols-outlined text-[18px]">local_florist</span>
                        <select name="kieuSanPham"
                                class="bg-transparent text-on-surface text-sm focus:outline-none">
                            <option value="">Tất cả kiểu sản phẩm</option>
                            @foreach (var item in Model.DanhSachKieuSanPham)
                            {
                                <option value="@item.Value"
                                        selected="@(Model.KieuSanPham == item.Value)">
                                    @item.Text
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Lọc theo khoảng giá -->
                    <input type="number"
                           name="giaTu"
                           min="0"
                           value="@Model.GiaTu"
                           placeholder="Giá từ"
                           class="w-28 bg-surface-container px-3 py-2 rounded-xl text-sm" />

                    <input type="number"
                           name="giaDen"
                           min="0"
                           value="@Model.GiaDen"
                           placeholder="Giá đến"
                           class="w-28 bg-surface-container px-3 py-2 rounded-xl text-sm" />
                }

                <button type="submit"
                        class="flex items-center gap-space-xs bg-primary text-on-primary px-3 py-2 rounded-xl font-title-sm text-title-sm hover:opacity-90 transition-all">
                    <span class="material-symbols-outlined text-[18px]">search</span>
                    Tìm kiếm
                </button>

                <a asp-area="@Model.Area"
                   asp-controller="@Model.Controller"
                   asp-action="@Model.Action"
                   class="flex items-center gap-space-xs bg-surface-container text-on-surface-variant px-3 py-2 rounded-xl font-title-sm text-title-sm hover:bg-surface-container-high transition-all">
                    <span class="material-symbols-outlined text-[18px]">refresh</span>
                    <span class="hidden sm:inline">Làm mới</span>
                </a>
            </div>
        }
    </form>
}
