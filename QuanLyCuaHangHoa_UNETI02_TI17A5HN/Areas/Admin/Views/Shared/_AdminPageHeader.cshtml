@* 
    Reusable Admin Page Header Component
    Model: dynamic or ViewData parameters (Title, ModuleName, Description, BadgeText)
*@
@{
    string title = ViewData["Title"] as string ?? ViewBag.Title as string ?? "Quản Lý Hệ Thống";
    string moduleName = ViewData["ModuleName"] as string ?? "Quản trị Nhóm 2";
    string description = ViewData["Description"] as string ?? ViewBag.Description as string ?? "";
    string badgeText = ViewData["BadgeText"] as string ?? "ASP.NET Core 10 MVC";
}

<div class="relative overflow-hidden rounded-xl bg-surface-container-low p-space-lg shadow-sm mb-space-lg">
    <div class="absolute -right-12 -top-12 w-64 h-64 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>
    <div class="relative z-10 flex flex-col md:flex-row md:items-end justify-between gap-space-md">
        <div>
            <div class="flex items-center gap-space-xs font-label-md text-label-md text-secondary tracking-widest uppercase mb-1">
                <span>NHÓM 2 CMS</span>
                <span class="text-outline-variant">/</span>
                <span>@moduleName</span>
                <span class="text-outline-variant">/</span>
                <span class="text-primary font-semibold">@title</span>
            </div>
            <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">@title</h1>
            @if (!string.IsNullOrEmpty(description))
            {
                <p class="font-body-md text-body-md text-secondary mt-1 max-w-3xl">@description</p>
            }
        </div>
        <div class="flex items-center gap-space-sm shrink-0">
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container text-on-surface-variant font-label-md text-label-md">
                <span class="material-symbols-outlined text-[16px] text-tertiary">check_circle</span>
                <span>@badgeText</span>
            </span>
        </div>
    </div>
</div>
