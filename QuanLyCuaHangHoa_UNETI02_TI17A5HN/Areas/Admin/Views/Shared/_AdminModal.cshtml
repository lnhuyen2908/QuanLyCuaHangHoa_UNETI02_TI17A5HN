@* 
    Reusable Admin Modal Container Component
*@
@{
    string modalId = ViewData["ModalId"] as string ?? "adminModal";
    string modalTitle = ViewData["ModalTitle"] as string ?? "Thông tin chi tiết";
}

<div id="@modalId" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-on-surface/40 backdrop-blur-sm p-space-md transition-opacity">
    <div class="bg-surface-container-lowest rounded-2xl shadow-xl w-full max-w-lg overflow-hidden flex flex-col">
        <!-- Modal Header -->
        <div class="flex items-center justify-between px-space-lg py-space-md border-b border-surface-container-high">
            <h3 class="font-headline-sm text-headline-sm text-on-surface">@modalTitle</h3>
            <button type="button" onclick="document.getElementById('@modalId').classList.add('hidden')" class="text-secondary hover:text-on-surface p-1 rounded-full hover:bg-surface-container transition-colors">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <!-- Modal Body -->
        <div class="p-space-lg space-y-space-md font-body-md text-body-md">
            @RenderSection("ModalBody", required: false)
        </div>

        <!-- Modal Footer -->
        <div class="flex items-center justify-end gap-space-sm px-space-lg py-space-md bg-surface-container-low border-t border-surface-container-high">
            <button type="button" onclick="document.getElementById('@modalId').classList.add('hidden')" class="px-space-md py-2 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-title-sm text-title-sm transition-all">
                Hủy bỏ
            </button>
            <button type="button" class="px-space-md py-2 rounded-xl bg-primary text-on-primary font-title-sm text-title-sm hover:bg-primary-container transition-all shadow-sm">
                Xác nhận
            </button>
        </div>
    </div>
</div>
